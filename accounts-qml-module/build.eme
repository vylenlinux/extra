#!/bin/sh

# shellcheck disable=SC2034
description="Expose the Online Accounts API to QML applications"
homepage="https://gitlab.com/accounts-sso/accounts-qml-module"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=accounts-qml-module
version=0.7
release=1

commit=05e79ebb
source="https://gitlab.com/accounts-sso/${name}/-/archive/${commit}/${name}-${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"

    qmake6 \
        PREFIX=/usr \
        LIBDIR=/usr/lib

    make
    make INSTALL_ROOT="${PKG}" install_subtargets

    # shellcheck disable=SC2115
    rm -r "${PKG}/usr/bin"
}
