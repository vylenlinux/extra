#!/bin/sh

# shellcheck disable=SC2034
description="Intel ACPI Source Language compiler"
homepage="https://github.com/open-acpica/acpica"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=acpica
version=20260930
release=1
source="${name}-${version}.tar.gz::https://github.com/open-${name}/${name}/releases/download/${version}/${name}-unix-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-unix-${version}"
    export CFLAGS="${CFLAGS} -Wno-dangling-pointer"

    NOWERROR=TRUE make
    make DESTDIR="${PKG}" install
}
