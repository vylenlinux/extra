#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Extensible daemon for delivering ACPI events"
homepage="https://sourceforge.net/projects/acpid2/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=acpid
version=2.0.34
release=1

source="https://downloads.sourceforge.net/acpid2/${name}-${version}.tar.xz
    lid
    lid.sh"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/lid" -t "${PKG}/etc/acpi/events/"
    install -Dm755 "${SRC}/lid.sh" -t "${PKG}/etc/acpi/"

    do_service "${name}"
}
