#!/bin/sh

# shellcheck disable=SC2034
description="The typefaces for GNOME"
homepage="https://gitlab.gnome.org/GNOME/adwaita-fonts"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=adwaita-fonts
version=51.0
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
