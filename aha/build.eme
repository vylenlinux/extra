#!/bin/sh

# shellcheck disable=SC2034
description="ANSI color to HTML converter"
homepage="https://github.com/theZiz/aha"
maintainer="Vylen Linux Team"

name=aha
version=0.5.1
release=1
source="${name}-${version}.tar.gz::https://github.com/theZiz/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "${name}.1" -t "${PKG}/usr/share/man/man1/"
}
