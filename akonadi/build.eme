#!/bin/sh

# shellcheck disable=SC2034
description="An extensible cross-desktop storage service for PIM data and metadata"
homepage="https://userbase.kde.org/Akonadi"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=akonadi
version=26.08.3
release=1
source="https://download.kde.org/stable/release-service/${version}/src/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_PYTHON_BINDINGS="$(emerald is-installed pyside6 && printf "ON" || printf "OFF")" \
        -DBUILD_TESTING=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
