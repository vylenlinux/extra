#!/bin/sh

# shellcheck disable=SC2034
description="Plugins for various audio libraries and sound servers"
homepage="https://www.alsa-project.org/wiki/Main_Page"
maintainer="Vylen Linux Team"

name=alsa-plugins
version=1.2.12
release=2

source="ftp://ftp.alsa-project.org/pub/plugins/${name}-${version}.tar.bz2
    ffmpeg-9.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/ffmpeg-9.patch"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install
}
