#!/bin/sh

# shellcheck disable=SC2034
description="ALSA Use Case Manager configuration (and topologies)"
homepage="https://www.alsa-project.org/wiki/Main_Page"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=alsa-ucm-conf
version=1.2.16.1
release=1
source="https://www.alsa-project.org/files/pub/lib/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    find ucm2 -type f -iname "*.conf" -exec install -Dm644 {} "${PKG}/usr/share/alsa/{}" \;
    find ucm2 -type l -iname "*.conf" -exec cp -d {} "${PKG}/usr/share/alsa/{}" \;
}
