#!/bin/sh

# shellcheck disable=SC2034
description="Various utilities for controlling sound card"
homepage="https://www.alsa-project.org/wiki/Main_Page"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=alsa-utils
version=1.2.16
release=1
source="https://www.alsa-project.org/files/pub/utils/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --disable-alsaconf \
        --disable-bat \
        --disable-maintainer-mode \
        --disable-nls \
        --disable-xmlto \
        --with-udev-rules-dir=/usr/lib/udev/rules.d \
        --with-systemdsystemunitdir=/usr/lib/systemd/system

    make
    make DESTDIR="${PKG}" install

    do_tmpfiles "${name}"
}
