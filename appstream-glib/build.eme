#!/bin/sh

# shellcheck disable=SC2034
description="Objects and methods for reading and writing AppStream metadata"
homepage="https://people.freedesktop.org/~hughsient/appstream-glib/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=appstream-glib
version=0.8.4
release=1

_version="$(printf '%s' "${version}" | sed 's/\./_/g')"
source="${name}-${version}.tar.gz::https://github.com/hughsie/${name}/archive/appstream_glib_${_version}.tar.gz"

build() {
    vylen-meson "appstream-glib-appstream_glib_${_version}" build \
        -Dman=false \
        -Drpm=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
