#!/bin/sh

# shellcheck disable=SC2034
description="Provides a standard for creating app stores across distributions"
homepage="https://www.freedesktop.org/wiki/Distributions/AppStream/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=appstream
version=1.2.2
release=1
source="${name}-${version}.tar.xz::https://www.freedesktop.org/software/${name}/releases/AppStream-${version}.tar.xz"

build() {
    vylen-meson "AppStream-${version}" build \
        -Dcompose=true \
        -Dqt="$(emerald is-installed qt6-base && printf "true" || printf "false")" \
        -Dvapi=true \
        -Dblake3-support=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm -rf "${PKG}/usr/share/installed-tests/"
}
