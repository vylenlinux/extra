description="Provides a standard for creating app stores across distributions"
homepage="https://www.freedesktop.org/wiki/Distributions/AppStream/"
maintainer="Vylen Linux Team"

name=appstream
version=1.1.2
release=1
source="$name-$version.tar.xz::https://www.freedesktop.org/software/appstream/releases/AppStream-$version.tar.xz"

build() {
	export XML_CATALOG_FILES=/etc/xml/catalog

	vylen-meson AppStream-$version build \
		-Ddocs=false \
		-Dapidocs=false \
		-Dinstall-docs=false \
		-Dcompose=true \
		-Dgir=true \
		-Dqt=$(emerald isinstalled qt6-base && printf "true" || printf  "false") \
		-Dvapi=false \
		-Dstemming=false \
		-Dapt-support=false \
		-Dsystemd=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -rf $PKG/usr/share/installed-tests/
}
