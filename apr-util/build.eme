#!/bin/sh

# shellcheck disable=SC2034
description="Predictable and consistent interface to underlying client library interfaces"
homepage="https://apr.apache.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=apr-util
version=1.6.6
release=1
source="https://archive.apache.org/dist/apr/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --with-apr=/usr \
        --with-gdbm=/usr \
        --with-openssl=/usr \
        --with-crypto

    make
    make DESTDIR="${PKG}" install
}
