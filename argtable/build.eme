#!/bin/sh

# shellcheck disable=SC2034
description="argtable command line parser library"
homepage="https://argtable.sourceforge.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=argtable
version=2.13
release=1

_version="${version%.*}-${version##*.}"

source="${name}-${version}.tar.gz::https://sourceforge.net/projects/${name}/files/${name}/${name}-${version}/${name}${_version}.tar.gz
    ${name}-${version}-add-missing-includes.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}${_version}"
    patch -Np1 -i "${SRC}/${name}-${version}-add-missing-includes.patch"

    autoreconf -fi
    ./configure --prefix=/usr

    make PREFIX=/usr
    make PREFIX=/usr DESTDIR="${PKG}" install
}
