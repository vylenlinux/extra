#!/bin/sh

# shellcheck disable=SC2034
description="Text document format for short documents, articles, books and UNIX man pages"
homepage="https://asciidoc-py.github.io/"
maintainer="Vylen Linux Team"

name=asciidoc
version=10.2.1
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}-py3/archive/${version}/${name}-py3-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-py-${version}"
    autoconf

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install
}
