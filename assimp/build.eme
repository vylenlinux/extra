#!/bin/sh

# shellcheck disable=SC2034
description="Library to import various well-known 3D model formats in an uniform manner"
homepage="https://www.assimp.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=assimp
version=6.0.6
release=1
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DASSIMP_WARNINGS_AS_ERRORS=OFF \
        -DASSIMP_BUILD_ASSIMP_TOOLS=ON \
        -DASSIMP_BUILD_SAMPLES=OFF \
        -DASSIMP_BUILD_MINIZIP=True \
        -DASSIMP_BUILD_ZLIB=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    sed -i "s|includedir=.*|includedir=/usr/include/${name}|" "${PKG}/usr/lib/pkgconfig/${name}.pc"
}
