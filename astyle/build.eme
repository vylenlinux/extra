#!/bin/sh

# shellcheck disable=SC2034
description="astyle A Free, Fast, and Small Automatic Formatter for C, C++, C++/CLI, Objective‑C, C#, and Java Source Code"
homepage="https://sourceforge.net/projects/astyle/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=astyle
version=3.6.21
release=1
source="https://downloads.sourceforge.net/project/${name}/${name}/${name}%203.6/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cmake -B build-cli \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DINSTALL_DOC=ON \
        -Wno-author

    cmake -B build-shared \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -Wno-author

    cmake --build build-cli
    cmake --build build-shared

    DESTDIR="${PKG}" cmake --install build-cli
    DESTDIR="${PKG}" cmake --install build-shared

    install -Dm644 "src/${name}.h" -t "${PKG}/usr/include/"

    install -Dm644 "sh-completion/${name}.bash" "${PKG}/usr/share/bash-completion/completions/${name}"
    install -Dm644 "sh-completion/${name}.fish" -t "${PKG}/usr/share/fish/vendor_completions.d/"
    install -Dm644 "sh-completion/${name}.zsh" "${PKG}/usr/share/zsh/site-functions/_${name}"
}
