#!/bin/sh

# shellcheck disable=SC2034
description="astyle A Free, Fast, and Small Automatic Formatter for C, C++, C++/CLI, Objective‑C, C#, and Java Source Code"
homepage="https://sourceforge.net/projects/astyle/"
maintainer="Vylen Linux Team"

name=astyle
version=3.6.17
release=1

source="https://gitlab.com/saalen/${name}/-/archive/${version}/${name}-${version}.tar.bz2
    makefile-install.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}/AStyle/build/gcc"
    patch -Np1 -i "${SRC}/makefile-install.patch"

    make shared release
    DESTDIR="${PKG}" make INSTALL=install install
}
