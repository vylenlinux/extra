#!/bin/sh

# shellcheck disable=SC2034
description="A control daemon, CLI tools, and a collection of crates for interacting with ASUS ROG laptops"
homepage="https://asus-linux.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=asusctl
version=6.5.0
release=1
source="${name}-${version}.tar.gz::https://github.com/OpenGamingCollective/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build \
        --release \
        --locked

    make DESTDIR="${PKG}" \
        install-asusctl \
        install-asusd \
        install-asusd_user \
        install-asus-shutdown \
        install-data-asusd \
        install-data-asusd_user
}
