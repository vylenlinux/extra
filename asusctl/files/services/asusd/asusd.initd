#!/usr/bin/openrc-run

# shellcheck disable=SC2034
description="ASUS control daemon"

command=/usr/bin/asusd
command_background=yes
pidfile=/run/asusd.pid

depend() {
    need dbus
}

start() {
    ebegin "Starting asusd"

    start-stop-daemon \
        --start \
        --exec "${command}" \
        --env IS_SERVICE=1 \
        --make-pidfile \
        --pidfile "${pidfile}" \
        --background

    eend $?
}

stop() {
    ebegin "Stopping asusd"

    start-stop-daemon \
        --stop \
        --pidfile "${pidfile}"

    eend $?
}
