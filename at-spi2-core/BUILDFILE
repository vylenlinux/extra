description="Provides a Service Provider Interface for the Assistive Technologies available on the GNOME platform and a library against which applications can be linked"
homepage="https://gitlab.gnome.org/GNOME/at-spi2-core"
maintainer="Vylen Linux Team"

name=at-spi2-core
version=2.60.0
release=1
source="$name-$version.tar.bz2::https://gitlab.gnome.org/GNOME/$name/-/archive/AT_SPI2_CORE_2_54_0/$name-AT_SPI2_CORE_2_54_0.tar.bz2"

build() {
	
	vylen-meson $name-AT_SPI2_CORE_2_54_0 build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# remove junk files
	rm -fr $PKG/usr/lib/systemd/
}
