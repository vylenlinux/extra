#!/bin/sh

# shellcheck disable=SC2034
description="Provides a Service Provider Interface for the Assistive Technologies available on the GNOME platform and a library against which applications can be linked"
homepage="https://gitlab.gnome.org/GNOME/at-spi2-core"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=at-spi2-core
version=2.62.1
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Ddocs=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
