#!/usr/bin/env sh

# shellcheck disable=SC2034
description="MATE document viewer"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team"

name=atril
version=1.28.3
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}" \
        --disable-synctex

    make
    make DESTDIR="${PKG}" install
}
