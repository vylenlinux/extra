#!/bin/sh

pre_install() {
    getent group avahi >/dev/null || groupadd -r avahi
    getent passwd avahi >/dev/null || useradd -r -M -g avahi -G avahi -c "avahi system user" -d /run/avahi -s /usr/bin/nologin avahi
}

post_remove() {
    getent passwd avahi >/dev/null && userdel avahi
    getent group avahi >/dev/null && groupdel avahi
}
