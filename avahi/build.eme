#!/bin/sh

# shellcheck disable=SC2034
description="A system which facilitates service discovery on a local network via the mDNS/DNS-SD protocol suite"
homepage="https://www.avahi.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=avahi
version=0.9rc5
release=1
source="${name}-${version}.tar.gz::https://github.com/avahi/avahi/archive/refs/tags/v${version%rc*}-${version#"${version%rc*}"}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version%rc*}-${version#"${version%rc*}"}"
    NOCONFIGURE=1 ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --runstatedir=/run \
        --with-distro=gentoo \
        --with-autoipd-user=avahi \
        --with-autoipd-group=avahi \
        --with-avahi-priv-access-group=wheel \
        --enable-compat-libdns_sd \
        --disable-gtk \
        --disable-gtk3 \
        --disable-qt3 \
        --disable-qt4 \
        --disable-qt5 \
        --disable-python \
        --disable-manpages \
        --disable-static \
        --disable-pygobject \
        --disable-python-dbus \
        --disable-mono \
        --disable-mono-doc \
        --disable-nls \
        --disable-libsystemd \
        --with-systemdsystemunitdir=no

    make
    make DESTDIR="${PKG}" install

    ln -s avahi-compat-libdns_sd/dns_sd.h "${PKG}/usr/include/dns_sd.h"
    rm -rf "${PKG}/run"
}
