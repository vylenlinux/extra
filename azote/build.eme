#!/bin/sh

# shellcheck disable=SC2034
description="Wallpaper & color manager for wlroots-based compositors and some X11 WMs"
homepage="https://github.com/nwg-piotr/azote"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=azote
version=1.16.0
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    python3 -m build \
        --wheel \
        --no-isolation

    install -Dm644 "dist/${name}.svg" -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 dist/indicator*.png -t "${PKG}/usr/share/${name}/"
    install -Dm644 "dist/${name}.desktop" -t "${PKG}/usr/share/applications/"

    python3 -m installer --destdir="${PKG}" dist/*.whl
}
