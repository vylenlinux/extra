#!/bin/sh

# shellcheck disable=SC2034
description="A cat(1) clone with wings"
homepage="https://github.com/sharkdp/bat"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=bat
version=0.26.1
release=1
source="https://github.com/sharkdp/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo update

    cargo build \
        --release \
        --locked

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
