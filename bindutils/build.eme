#!/bin/sh

# shellcheck disable=SC2034
description="Bind tools"
homepage="https://www.isc.org/bind/"
maintainer="Vylen Linux Team"

name=bindutils
version=9.20.27
release=1

source="${name}-${version}.tar.xz::https://ftp.isc.org/isc/bind9/${version}/bind-${version}.tar.xz
    utils.patch"

build() {
    # shellcheck disable=SC2164
    cd "bind-${version}"
    patch -Np1 -i "${SRC}/utils.patch"
    cat bin/Makefile.in

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib/bindutils \
        --includedir=/usr/include/bindutils \
        --disable-linux-caps \
        --disable-doh \
        --with-openssl=yes \
        --with-libxml2=no \
        --with-gssapi=no

    make -C lib
    make bind.keys.h
    make -C bin/dig
    make -C bin/delv
    make -C doc

    make DESTDIR="${PKG}" -C lib install
    make DESTDIR="${PKG}" -C bin/dig install
    make DESTDIR="${PKG}" -C bin/delv install

    for f in delv dig host nslookup; do
        install -Dm644 "doc/man/${f}.1" -t "${PKG}/usr/share/man/man1/"
    done
}
