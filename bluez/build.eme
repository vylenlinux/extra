#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Bluetooth protocol stack for Linux"
homepage="http://www.bluez.org/"
maintainer="Vylen Linux Team"

name=bluez
version=5.86
release=1
source="https://www.kernel.org/pub/linux/bluetooth/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --localstatedir=/var \
        --enable-library \
        --enable-mesh \
        --enable-a2dp \
        --enable-experimental\
        --enable-hid2hci \
        --enable-library \
        --enable-tools \
        --disable-systemd

    make
    make DESTDIR="${PKG}" install

    install -d "${PKG}/usr/sbin"
    ln -svf ../lib/bluetooth/bluetoothd "${PKG}/usr/sbin/bluetoothd"
    ln -svf ../lib/bluetooth/bluetooth-meshd "${PKG}/usr/sbin/bluetooth-meshd"

    # main configuration
    install -v -dm755 "${PKG}/etc/bluetooth"
    install -v -m644 src/main.conf "${PKG}/etc/bluetooth/main.conf"

    cat > "${PKG}/etc/bluetooth/rfcomm.conf" <<"EOF"
# Start rfcomm.conf
# Set up the RFCOMM configuration of the Bluetooth subsystem in the Linux kernel.
# Use one line per command
# See the rfcomm man page for options

# End of rfcomm.conf
EOF

    cat > "${PKG}/etc/bluetooth/uart.conf" << "EOF"
# Start uart.conf
# Attach serial devices via UART HCI to BlueZ stack
# Use one line per device
# See the hciattach man page for options
#
# End of uart.conf
EOF

    openrc_add bluetoothd
}
