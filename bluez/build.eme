#!/bin/sh

# shellcheck disable=SC2034
description="Bluetooth protocol stack for Linux"
homepage="http://www.bluez.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=bluez
version=5.88
release=1

source="https://www.kernel.org/pub/linux/bluetooth/${name}-${version}.tar.xz
    rfcomm.conf
    uart.conf
    ${name}-${version}-external-ell-install.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/${name}-${version}-external-ell-install.patch"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --localstatedir=/var \
        --with-udevdir=/usr/lib/udev \
        --enable-library \
        --enable-mesh \
        --enable-a2dp \
        --enable-experimental \
        --enable-hid2hci \
        --enable-tools \
        --enable-systemd \
        --enable-external-ell

    make
    make DESTDIR="${PKG}" install

    ln -s /usr/lib/bluetooth/bluetoothd -t "${PKG}/usr/bin/"
    ln -s /usr/lib/bluetooth/bluetooth-meshd -t "${PKG}/usr/bin/"

    # main configuration
    install -Dm644 src/main.conf -t "${PKG}/etc/bluetooth/"
    install -Dm644 "${SRC}/rfcomm.conf" -t "${PKG}/etc/bluetooth/"
    install -Dm644 "${SRC}/uart.conf" -t "${PKG}/etc/bluetooth/"
}
