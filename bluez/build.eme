#!/bin/sh

# shellcheck disable=SC2034
description="Bluetooth protocol stack for Linux"
homepage="http://www.bluez.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=bluez
version=5.87
release=1

source="https://www.kernel.org/pub/linux/bluetooth/${name}-${version}.tar.xz
    rfcomm.conf
    uart.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --localstatedir=/var \
        --with-udevdir=/usr/lib/udev \
        --enable-library \
        --enable-mesh \
        --enable-a2dp \
        --enable-experimental\
        --enable-hid2hci \
        --enable-tools \
        --disable-systemd \
        ICAL_LIBS="$(pkgconf --libs libicalvcal)"

    make
    make DESTDIR="${PKG}" install

    ln -sf ../lib/bluetooth/bluetoothd "${PKG}/usr/bin/bluetoothd"
    ln -sf ../lib/bluetooth/bluetooth-meshd "${PKG}/usr/bin/bluetooth-meshd"

    # main configuration
    install -Dm644 src/main.conf -t "${PKG}/etc/bluetooth/"
    install -Dm644 "${SRC}/rfcomm.conf" -t "${PKG}/etc/bluetooth/"
    install -Dm644 "${SRC}/uart.conf" -t "${PKG}/etc/bluetooth/"

    do_service bluetoothd
}
