#!/bin/sh

# shellcheck disable=SC2034
description="A set of free peer-reviewed portable C++ source libraries"
homepage="https://www.boost.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=boost
version=1.92.0
release=1
_version="$(printf "%s" "${version}" | sed 's/\./_/g')"

source="${name}-${version}.tar.bz2::https://archives.boost.io/release/${version}/source/${name}_${_version}.tar.bz2
    ${name}-${version}-gcc16.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}_${_version}"
    patch -Np1 -d libs/mpi -i "${SRC}/${name}-${version}-gcc16.patch"

    ./bootstrap.sh \
        --prefix=/usr \
        --with-python=python3

    ./b2 stage "${MAKEFLAGS}" threading=multi link=shared

    # Older cmake directories need to be explicitly removed
    rm -rf /usr/lib/cmake/[Bb]oost*
    ./b2 install --prefix="${PKG}/usr" threading=multi link=shared

    ln -s detail/sha1.hpp -t "${PKG}/usr/include/boost/uuid/"
}
