#!/bin/sh

# shellcheck disable=SC2034
description="Administration and debugging tools for the B-tree file system (btrfs)"
homepage="https://btrfs.readthedocs.io/en/latest/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=btrfs-progs
version=7.3
release=1
source="${name}-${version}.tar.xz::https://www.kernel.org/pub/linux/kernel/people/kdave/${name}/${name}-v${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --disable-documentation \
        --disable-backtrace \
        --disable-python

    make
    make DESTDIR="${PKG}" install

    # install bash completion (FS#44618)
    install -Dm644 btrfs-completion "${PKG}/usr/share/bash-completion/completions/btrfs"

    do_service btrfs-scrub
}
