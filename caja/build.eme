#!/bin/sh

# shellcheck disable=SC2034
description="The file manager for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=caja
version=1.29.1
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-update-mimedb \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
