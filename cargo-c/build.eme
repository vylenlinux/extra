#!/bin/sh

# shellcheck disable=SC2034
description="A cargo subcommand to build and install C-ABI compatibile dynamic and static libraries"
homepage="https://github.com/lu-zero/cargo-c/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cargo-c
version=0.10.26
release=1

source="https://github.com/lu-zero/${name}/archive/v${version}/${name}-${version}.tar.gz
    ${name}-${version}.Cargo.lock::https://github.com/lu-zero/${name}/releases/download/v${version}/Cargo.lock"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cp "${SRC}/${name}-${version}.Cargo.lock" Cargo.lock
    export RUSTUP_TOOLCHAIN=stable

    cargo fetch --locked

    cargo build \
        --release \
        --frozen

    find target/release -maxdepth 1 -type f -executable -exec install -Dm755 -t "${PKG}/usr/bin/" {} +
}
