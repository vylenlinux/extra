#!/bin/sh

# shellcheck disable=SC2034
description="A cargo subcommand to build and install C-ABI compatibile dynamic and static libraries"
homepage="https://github.com/lu-zero/cargo-c/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cargo-c
version=0.10.28
release=1
source="https://github.com/lu-zero/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo build --release

    for f in cinstall cbuild capi ctest; do
        install -Dm755 "target/release/cargo-${f}" -t "${PKG}/usr/bin/"
    done
}
