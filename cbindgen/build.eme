#!/bin/sh

# shellcheck disable=SC2034
description="A tool for generating C bindings for Rust code"
homepage="https://github.com/mozilla/cbindgen"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cbindgen
version=0.29.4
release=1
source="https://github.com/eqrion/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo fetch --target x86_64-unknown-linux-gnu

    cargo build \
        --release \
        --frozen \
        --bins

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
