description="CD audio extraction tool"
homepage="https://www.xiph.org/paranoia/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cdparanoia
version=10.2
release=1
source="$name-$version.tgz::https://downloads.xiph.org/releases/$name/$name-III-$version.src.tgz
	$name-$version-gcc_fixes-1.patch::http://www.linuxfromscratch.org/patches/blfs/svn/$name-III-$version-gcc_fixes-1.patch"

build() {
	cd $name-III-$version

	patch -Np1 -i ../$name-$version-gcc_fixes-1.patch

	./configure --prefix=/usr --mandir=/usr/share/man
	make -j1
	make prefix=$PKG/usr install

	chmod -v 755 $PKG/usr/lib/libcdda_*.so.0.10.2
}

