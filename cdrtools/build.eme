#!/bin/sh

# shellcheck disable=SC2034
description="Original cdrtools supporting CD, DVD and BluRay burning"
homepage="https://sourceforge.net/projects/cdrtools/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cdrtools
version=3.02a09
release=1
source="https://downloads.sourceforge.net/${name}/alpha/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version%%a*}"

    sed -i 's|INSDIR=\s*sbin|INSDIR=bin|' rscsi/Makefile
    export GMAKE_NOWARN=true

    export CFLAGS="${CFLAGS} \
        -std=gnu89 \
        -fno-strict-aliasing"

    make -j1 INS_BASE=/usr DEFINSUSR=root DEFINSGRP=root
    make -j1 INS_BASE=/usr DEFINSUSR=root DEFINSGRP=root DESTDIR="${PKG}" install

    # remove unneeded files that may cause conflicts
    rm "${PKG}/usr/lib"/*.a

    rm -rf "${PKG}/usr/include" \
        "${PKG}/usr/lib/profiled" \
        "${PKG}/usr/share/man/man3"

    # Patch binary permissions, by default it's swx--x--x
    chmod a+rx "${PKG}/usr/bin"/*

    # create symlinks for cdrkit compatibility
    ln -s cdrecord "${PKG}/usr/bin/wodim"
    ln -s readcd "${PKG}/usr/bin/readom"
    ln -s mkisofs "${PKG}/usr/bin/genisoimage"
    ln -s cdda2wav "${PKG}/usr/bin/icedax"
}
