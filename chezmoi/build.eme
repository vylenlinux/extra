#!/bin/sh

# shellcheck disable=SC2034
description="Manage your dotfiles across multiple machines"
homepage="https://www.chezmoi.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=chezmoi
version=2.74.1
release=1
source="${name}-${version}.tar.gz::https://github.com/twpayne/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # shellcheck disable=SC2086
    go build \
        -buildmode=pie \
        -mod=readonly \
        -tags noupgrade \
        -ldflags "-compressdwarf=false \
            -X github.com/twpayne/${name}/cmd.DocsDir=/usr/share/doc/${name} \
            -X main.version=${version} \
            -X main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date=@${SOURCE_DATE_EPOCH}) \
            -extldflags \"${LDFLAGS}\"" .

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"

    install -Dm644 "completions/${name}-completion.bash" "${PKG}/usr/share/bash-completion/completions/${name}"
    install -Dm644 "completions/${name}.fish" -t "${PKG}/usr/share/fish/vendor_completions.d/"
    install -Dm644 "completions/${name}.zsh" "${PKG}/usr/share/zsh/site-functions/_${name}"
}
