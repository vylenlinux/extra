#!/bin/sh

# shellcheck disable=SC2034
description="Offline NT Password Editor - reset passwords in a Windows NT SAM user database file"
homepage="https://pogostick.net/~pnh/ntpasswd/"
maintainer="Vylen Linux Team"

name=chntpw
version=140201
release=1
source="${name}-${version}.zip::https://pogostick.net/~pnh/ntpasswd/${name}-source-${version}.zip"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed -i 's/^CFLAGS= \(.*\) -m32 $/CFLAGS= \1 -Wno-incompatible-pointer-types/' Makefile
    export CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types"

    make
    install -Dm755 "${name}" reged cpnt -t "${PKG}/usr/bin/"
}
