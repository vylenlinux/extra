#!/bin/sh

# shellcheck disable=SC2034
description="CIFS filesystem user-space tools"
homepage="https://wiki.samba.org/index.php/LinuxCIFS_utils"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cifs-utils
version=7.9
release=1
source="https://download.samba.org/pub/linux-cifs/${name}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --disable-systemd

    make
    make DESTDIR="${PKG}" ROOTSBINDIR=/usr/bin install

    chmod +s "${PKG}/usr/bin/mount.cifs"
}
