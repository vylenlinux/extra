#!/bin/sh

# shellcheck disable=SC2034
description="Library with common API for various Cinnamon modules"
homepage="https://github.com/linuxmint/cinnamon-desktop"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cinnamon-desktop
version=6.8.0
release=1
source="https://github.com/linuxmint/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
