#!/bin/sh

# shellcheck disable=SC2034
description="The Cinnamon Settings daemon"
homepage="https://github.com/linuxmint/cinnamon-settings-daemon"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cinnamon-settings-daemon
version=6.8.1
release=1
source="${name}-${version}.tar.gz::https://github.com/linuxmint/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
