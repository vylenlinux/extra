#!/bin/sh

# shellcheck disable=SC2034
description="Collection of modular and reusable compiler and toolchain technologies"
homepage="https://clang.llvm.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=clang
version=23.1.5
release=1
source="llvm-${version}.tar.xz::https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/llvm-project-${version}.src.tar.xz"

build() {
    mv "llvm-project-${version}.src/${name}-tools-extra" "llvm-project-${version}.src/${name}/tools/extra"

    LLVM_TARGETS="AArch64;AMDGPU;ARM;AVR;BPF;Hexagon;Lanai;LoongArch;Mips;MSP430;NVPTX;PowerPC"
    LLVM_TARGETS="${LLVM_TARGETS};RISCV;Sparc;SPIRV;SystemZ;VE;WebAssembly;X86;XCore"

    cmake -S "llvm-project-${version}.src/${name}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR="/usr/lib/${name}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCLANG_BUILD_EXAMPLES=OFF \
        -DCLANG_DEFAULT_PIE_ON_LINUX=ON \
        -DCLANG_INCLUDE_DOCS=OFF \
        -DCLANG_INCLUDE_TESTS=OFF \
        -DCLANG_LINK_CLANG_DYLIB=YES \
        -DLLVM_ENABLE_EH=ON \
        -DLLVM_ENABLE_LIBXML2=OFF \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_TARGETS_TO_BUILD="${LLVM_TARGETS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
