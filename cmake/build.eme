#!/bin/sh

# shellcheck disable=SC2034
description="Modern toolset used for generating Makefiles"
homepage="https://www.cmake.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cmake
version=4.5.0
release=1
source="https://www.cmake.org/files/v${version%.*}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed '/"lib64"/s/64//' -i Modules/GNUInstallDirs.cmake
    # shellcheck disable=SC2016
    sed 's|share/cmake-${CMake_VERSION_MAJOR}.${CMake_VERSION_MINOR}|share/cmake|' -i Source/CMakeInstallDestinations.cmake

    ./bootstrap \
        --prefix=/usr \
        --datadir="/share/${name}" \
        --no-system-jsoncpp \
        --no-system-cppdap \
        --no-system-librhash \
        --system-libs \
        -- \
        -DCmake_BUILD_LTO=ON \
        -DBUILD_TESTING=OFF

    make
    make DESTDIR="${PKG}" install
}
