#!/bin/sh

# shellcheck disable=SC2034
description="System activated daemon that maps devices to color profiles"
homepage="https://www.freedesktop.org/software/colord"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=colord
version=1.4.8
release=1
source="https://www.freedesktop.org/software/${name}/releases/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        --libexecdir="/usr/lib/${name}" \
        -Ddaemon_user=colord \
        -Dvapi=true \
        -Dlibcolordcompat=true \
        -Dargyllcms_sensor=false \
        -Dbash_completion=false \
        -Ddocs=false \
        -Dman=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # backport
    if [ -d "${PKG}/lib" ]; then
        mv "${PKG}/lib/udev" -t "${PKG}/usr/lib/"
        rmdir "${PKG}/lib"
    fi
}
