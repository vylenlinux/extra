#!/bin/sh

# shellcheck disable=SC2034
description="Applets for COSMIC Panel"
homepage="https://github.com/pop-os/cosmic-applets"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cosmic-applets
version=1.11.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pop-os/${name}/archive/refs/tags/epoch-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-epoch-${version}"
    cargo fetch --locked

    sed 's/lto = "fat"/lto = "thin"/' -i Cargo.toml
    export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=mold"

    just build-release --frozen
    just rootdir="${PKG}" install
}
