#!/bin/sh

# shellcheck disable=SC2034
description="COSMIC Initial Setup"
homepage="https://github.com/pop-os/cosmic-initial-setup"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cosmic-initial-setup
version=1.11.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pop-os/${name}/archive/refs/tags/epoch-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-epoch-${version}"
    cargo fetch --locked

    just build-release
    just rootdir="${PKG}" install
}
