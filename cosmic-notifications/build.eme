#!/bin/sh

# shellcheck disable=SC2034
description="Layer Shell notifications daemon which integrates with COSMIC"
homepage="https://github.com/pop-os/cosmic-notifications"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cosmic-notifications
version=1.12.0
release=1
source="https://github.com/pop-os/${name}/archive/epoch-${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-epoch-${version}"
    cargo fetch --locked

    just build-release --frozen
    just rootdir="${PKG}" install
}
