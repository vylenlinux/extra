#!/bin/sh

# shellcheck disable=SC2034
description="Library and utility for displaying and configuring Wayland outputs"
homepage="https://github.com/pop-os/cosmic-randr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cosmic-randr
version=1.11.0
release=1

source="${name}-${version}.tar.gz::https://github.com/pop-os/${name}/archive/refs/tags/epoch-${version}.tar.gz
    ${name}-lto.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-epoch-${version}"
    patch -Np1 -i "${SRC}/${name}-lto.patch"

    cargo fetch --locked
    export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=lld"

    just build-release --frozen
    just rootdir="${PKG}" install
}
