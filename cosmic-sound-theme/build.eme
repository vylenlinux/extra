#!/bin/sh

# shellcheck disable=SC2034
description="Sound theme for the COSMIC desktop environment"
homepage="https://github.com/pop-os/cosmic-sound-theme"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cosmic-sound-theme
version=1.11.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pop-os/${name}/archive/refs/tags/epoch-${version}.tar.gz"

build() {
    vylen-meson "${name}-epoch-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
