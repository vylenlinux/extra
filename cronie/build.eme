#!/bin/sh

# shellcheck disable=SC2034
description="Daemon that runs specified programs at scheduled times and related tools"
homepage="https://github.com/cronie-crond/cronie/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cronie
version=1.7.2
release=1

source="https://github.com/${name}-crond/${name}/releases/download/${name}-${version}/${name}-${version}.tar.gz
    gcc15.patch
    remove-sysconfig.patch
    ${name}.deny"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/gcc15.patch"
    patch -Np1 -i "${SRC}/remove-sysconfig.patch"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --sbindir=/usr/bin \
        --enable-anacron \
        --with-inotify \
        --with-pam

    make
    make DESTDIR="${PKG}" install

    chmod u+s "${PKG}/usr/bin/crontab"

    install -d "${PKG}/var/spool/anacron" \
        "${PKG}/var/spool/cron" \
        "${PKG}/etc/cron.d" \
        "${PKG}/etc/cron.hourly" \
        "${PKG}/etc/cron.daily" \
        "${PKG}/etc/cron.weekly" \
        "${PKG}/etc/cron.monthly"

    install -Dm644 "${SRC}/${name}.deny" "${PKG}/etc/cron.deny"
    install -Dm644 contrib/anacrontab -t "${PKG}/etc/"
    install -Dm644 contrib/0hourly -t "${PKG}/etc/cron.d/"
    install -Dm755 contrib/0anacron -t "${PKG}/etc/cron.hourly/"
    install -Dm644 contrib/cronie.systemd "${PKG}/usr/lib/systemd/system/${name}.service"
    install -Dm644 pam/crond -t "${PKG}/etc/pam.d/"
}
