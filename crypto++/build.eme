#!/bin/sh

# shellcheck disable=SC2034
description="A free C++ class library of cryptographic schemes"
homepage="https://www.cryptopp.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=crypto++
version=8.9.0
release=1

_version="$(printf "%s" "${version}" | sed 's/\./_/g')"
source="${name}-${version}.tar.gz::https://github.com/weidai11/cryptopp/archive/CRYPTOPP_${_version}.tar.gz"
        
build() {
    # shellcheck disable=SC2164
    cd "cryptopp-CRYPTOPP_${_version}"
    export PREFIX=/usr

    make all libcryptopp.pc
    make DESTDIR="${PKG}" install
}
