#!/bin/sh

# shellcheck disable=SC2034
description="Used to set up transparent encryption of block devices using the kernel crypto API"
homepage="https://gitlab.com/cryptsetup/cryptsetup/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cryptsetup
version=2.8.8
release=1
source="https://www.kernel.org/pub/linux/utils/${name}/v${version%.*}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --with-crypto_backend=openssl \
        --disable-asciidoc \
        --disable-ssh-token

    make
    make DESTDIR="${PKG}" install
}
