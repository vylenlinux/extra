#!/bin/sh

# shellcheck disable=SC2034
description="A Unit Testing Framework for C"
homepage="https://cunit.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cunit
version=2.1.3
release=1

_version="${version%.*}-${version##*.}"

source="${name}-${version}.tar.bz2::https://downloads.sourceforge.net/project/${name}/CUnit/${_version}/CUnit-${_version}.tar.bz2
    ${name}-2.1_p3-ncurses-format-security.patch
    ${name}-2.1_p3-ncurses-opaque.patch"

build() {
    # shellcheck disable=SC2164
    cd "CUnit-${_version}"

    patch -Np1 -i "${SRC}/${name}-2.1_p3-ncurses-format-security.patch"
    patch -Np1 -i "${SRC}/${name}-2.1_p3-ncurses-opaque.patch"

    libtoolize \
        --force \
        --copy

    aclocal
    autoheader

    automake \
        --add-missing \
        --include-deps \
        --copy

    autoconf

    ./configure \
        --prefix=/usr \
        --enable-automated \
        --enable-basic \
        --enable-console \
        --enable-test \
        --enable-shared \
        --enable-static

    make
    make DESTDIR="${PKG}" install

    rm -r "${PKG}/usr/share/CUnit"
    mv "${PKG}/usr/doc" -t "${PKG}/usr/share/"
}
