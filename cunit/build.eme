description="A Unit Testing Framework for C "
homepage="http://cunit.sourceforge.net"
maintainer="Vylen Linux Team"

name=cunit
_name=CUnit
version=2.1.3
vrsn="${version%.*}-${version##*.}"
release=1
source="$name-$version.tar.bz2::https://downloads.sourceforge.net/project/cunit/$_name/$vrsn/$_name-$vrsn.tar.bz2
	cunit-2.1_p3-ncurses-format-security.patch
	cunit-2.1_p3-ncurses-opaque.patch"

build() {
	cd $_name-$vrsn

	patch -Np1 -i $SRC/cunit-2.1_p3-ncurses-format-security.patch
	patch -Np1 -i $SRC/cunit-2.1_p3-ncurses-opaque.patch

	libtoolize --force --copy
	aclocal
	autoheader
	automake --add-missing --include-deps --copy
	autoconf

	./configure \
		--prefix=/usr \
		--enable-automated \
		--enable-basic \
		--enable-console \
		--enable-test \
		--enable-shared \
		--enable-static
	make
	make DESTDIR=$PKG install

	rm -r "${PKG}/usr/share/CUnit"
	mv "${PKG}/usr/doc" "${PKG}/usr/share/"
}
