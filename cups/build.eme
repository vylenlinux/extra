#!/bin/sh

# shellcheck disable=SC2034
description="Print spooler and associated utilities"
homepage="https://openprinting.github.io/cups/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cups
version=2.4.20
release=1
source="${name}-${version}.tar.gz::https://github.com/OpenPrinting/${name}/archive/v${version}/${name}-${version}-source.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --with-menudir=/usr/share/applications \
        --with-icondir=/usr/share/icons \
        --with-logdir=/var/log/cups \
        --with-docdir=/usr/share/cups \
        --with-rundir=/run/cups \
        --with-cupsd-file-perm=0755 \
        --with-cups-user=lp \
        --with-cups-group=lp \
        --with-domainsocket=/run/cups/cups.sock \
        --disable-launchd \
        --enable-acl \
        --enable-dbus \
        --with-dbusdir=/usr/share/dbus-1 \
        --enable-gnutls \
        --enable-libusb \
        --enable-raw-printing \
        --enable-relro \
        --enable-ssl=yes \
        --with-optim="${CFLAGS}" \
        --without-php \
        --without-rcdir

    make
    make BUILDROOT="${PKG}" install-data install-exec

    # this one we ship in the libcups pkg
    # remove client.conf man page
    rm -f "${PKG}/usr/bin/cups-config" \
        "${PKG}/usr/share/man/man5/client.conf.5"

    # cleanup
    rm -rf "${PKG}/tmp" \
        "${PKG}/run" \
        "${PKG}/var/run" \
        "${PKG}/etc/pam.d"

    ## no longer works since CUPS >= 1.6 (http://www.cups.org/str.php?L4120)
    rm -rf "${PKG}/usr/share/cups/banners"/* \
        "${PKG}/usr/share/cups/data/testprint"

    chmod -R +w "${PKG}"

    do_pam "${name}"
    do_sysusers "${name}"
}
