#!/bin/sh

pre_install() {
    getent group lpadmin >/dev/null || groupadd -g 19 lpadmin
    getent group lp >/dev/null || groupadd -r lp
    getent passwd lp >/dev/null || useradd -r -M -g lp -G lp -c "Print Service User" -d /var/spool/cups -s /usr/bin/nologin -u 9 lp
}

post_remove() {
    getent passwd lp >/dev/null && userdel lp
    getent group lp >/dev/null && groupdel lp
}
