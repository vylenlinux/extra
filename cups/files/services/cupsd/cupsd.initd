#!/usr/bin/openrc-run

# shellcheck disable=SC2034
description="The Common Unix Printing System daemon"
command="/usr/bin/cupsd"
command_args="-f -c /etc/cups/cupsd.conf -s /etc/cups/cups-files.conf"
pidfile="/run/cupsd.pid"
start_stop_daemon_args="-b -m --pidfile ${pidfile}"

depend() {
    use net
    need dbus
    before nfs
    after logger
}

start_pre() {
    checkpath -q -dm775 -o root:lp /var/cache/cups
    checkpath -q -dm775 -o root:lp /var/cache/cups/rss
    checkpath -q -dm755 -o root:lp /run/cups
    checkpath -q -dm511 -o lp:lpadmin /run/cups/certs
}
