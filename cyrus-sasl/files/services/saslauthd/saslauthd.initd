#!/usr/bin/openrc-run

depend() {
    need net
}

start() {
    ebegin "Starting saslauthd"

    start-stop-daemon \
        --start \
        --quiet \
        --exec /usr/bin/saslauthd \
		-- \
		"${SASLAUTHD_OPTS}"

    eend $?
}

stop() {
    ebegin "Stopping saslauthd"

    start-stop-daemon \
        --stop \
        --quiet \
        --pidfile /run/saslauthd/saslauthd.pid

    eend $?
}
