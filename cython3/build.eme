#!/bin/sh

# shellcheck disable=SC2034
description="C-Extensions for Python3"
homepage="https://cython.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cython3
version=3.3.2+1
release=1

_version="$(printf '%s' "${version}" | tr '+' '-')"
source="https://github.com/cython/cython/archive/${_version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "cython-${_version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
