description="The Berkeley DB embedded database system"
homepage="https://www.oracle.com/technology/software/products/berkeley-db/index.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=db
version=6.2.32
release=1
source="http://download.oracle.com/berkeley-db/${name}-${version}.tar.gz"

build() {
	cd $name-$version
	cd build_unix
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"
	../dist/configure \
		--prefix=/usr \
		--enable-compat185 \
		--disable-static \
		--enable-cxx \
		--enable-dbm
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/docs
}
