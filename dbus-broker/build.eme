#!/bin/sh

# shellcheck disable=SC2034
description="Linux D-Bus Message Broker"
homepage="https://github.com/bus1/dbus-broker/wiki"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dbus-broker
version=37
release=1

source="https://github.com/bus1/${name}/releases/download/v${version}/${name}-${version}.tar.xz
    0001-units-Enable-statically.patch
    0002-test-sockopt-loosen-verification-of-stale-pidfds.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/0001-units-Enable-statically.patch"
    patch -d "${name}-${version}" -Np1 -i "${SRC}/0002-test-sockopt-loosen-verification-of-stale-pidfds.patch"

    vylen-meson "${name}-${version}" build \
        -Dlinux-4-17=true \
        -Dsystem-console-users=gdm,sddm,lightdm,lxdm

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
