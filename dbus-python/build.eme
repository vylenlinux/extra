#!/bin/sh

# shellcheck disable=SC2034
description="Python3 bindings to the D-Bus"
homepage="https://dbus.freedesktop.org/releases/dbus-python/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dbus-python
version=1.5.1
release=1
source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/dbus/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build -Dtests=disabled
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    python3 "${name}-${name}-${version}/tools/generate-pkginfo.py" "${version}" PKG-INFO
    python3 -m compileall -d /usr/lib "${PKG}/usr/lib"
    python3 -O -m compileall -d /usr/lib "${PKG}/usr/lib"
}
