#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Message bus system, a simple way for applications to talk to one another"
homepage="https://www.freedesktop.org/wiki/Software/dbus/"
maintainer="Vylen Linux Team"

name=dbus
version=1.16.2
release=2
source="https://${name}.freedesktop.org/releases/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dsystem_pid_file=/run/dbus/dbus.pid
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    do_service "${name}" "${name}.user"
}
