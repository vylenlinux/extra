#!/bin/sh

# shellcheck disable=SC2034
description="Message bus system, a simple way for applications to talk to one another"
homepage="https://www.freedesktop.org/wiki/Software/dbus/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dbus
version=1.16.4
release=1
source="https://dbus.freedesktop.org/releases/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # provided by dbus-broker
    rm -f "${PKG}/usr/lib/systemd/system/${name}.service" \
        "${PKG}/usr/lib/systemd/user/${name}.service"
}
