#!/bin/sh

set_dbus_permissions() {
    # Set the correct permissions
    chown root:messagebus /usr/lib/dbus-daemon-launch-helper
    chmod 4750 /usr/lib/dbus-daemon-launch-helper
}

ensure_machine_id() {
    printf ':: checking /etc/machine-id...\n'
    dbus-uuidgen --ensure=/etc/machine-id
}

pre_install() {
    getent group messagebus >/dev/null || groupadd -g 18 messagebus
    getent passwd messagebus >/dev/null || useradd -r -M -g messagebus -G messagebus -c "D-Bus Daemon User" -d /dev/null -s /usr/bin/nologin messagebus
}

post_install() {
    set_dbus_permissions
    ensure_machine_id
}

post_upgrade() {
    set_dbus_permissions
}

post_remove() {
    getent passwd messagebus >/dev/null && userdel messagebus
    getent group messagebus >/dev/null && groupdel messagebus
}
