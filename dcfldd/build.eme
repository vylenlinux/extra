#!/bin/sh

# shellcheck disable=SC2034
description="DCFL (DoD Computer Forensics Lab) dd replacement with hashing"
homepage="https://github.com/resurrecting-open-source-projects/dcfldd/"
maintainer="Vylen Linux Team"

name=dcfldd
version=1.9.3
release=1
source="${name}-${version}.tar.gz::https://github.com/resurrecting-open-source-projects/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man

    make
    make DESTDIR="${PKG}" install
}
