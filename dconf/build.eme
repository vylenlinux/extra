#!/bin/sh

# shellcheck disable=SC2034
description="Configuration database system"
homepage="https://wiki.gnome.org/Projects/dconf"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dconf
version=51.0
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build --libexecdir="/usr/lib/${name}"
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
