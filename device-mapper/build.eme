#!/bin/sh

# shellcheck disable=SC2034
description="Device mapper userspace library and tools"
homepage="https://sourceware.org/dm/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=device-mapper
version=2.03.44
release=1
source="lvm2-${version}.tgz::https://sourceware.org/pub/lvm2/LVM2.${version}.tgz"

build() {
    # shellcheck disable=SC2164
    cd "LVM2.${version}"

    export CONFIG_SHELL=/usr/bin/bash
    sed -i -e '/^\[Install\]$/,$d' scripts/dm_event_systemd_red_hat.socket.in

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libdir=/usr/lib \
        --with-udevdir=/usr/lib/udev \
        --with-systemdsystemunitdir=/usr/lib/systemd/system \
        --enable-cmdlib \
        --enable-pkgconfig \
        --enable-udev_sync \
        --enable-dmeventd \
        --enable-write_install

    make
    make DESTDIR="${PKG}" install_device-mapper install_systemd_units

    install -dm755 "${PKG}/usr/lib/systemd/system/sockets.target.wants"
    ln -sf ../dm-event.socket -t "${PKG}/usr/lib/systemd/system/sockets.target.wants/"

    # moved to lvm2
    rm -f "${PKG}/usr/lib/systemd/system/blk-availability.service" \
        "${PKG}/usr/lib/systemd/system"/lvm*
}
