#!/bin/sh

# shellcheck disable=SC2034
description="Display file system space usage using graphs and colors"
homepage="https://github.com/Rolinh/dfc"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dfc
version=3.1.1
release=1
source="${name}-${version}.tar.gz::https://github.com/Rolinh/${name}/archive/v${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
