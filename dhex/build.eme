#!/bin/sh

# shellcheck disable=SC2034
description="Ncurses hex editor that can show differences"
homepage="https://www.dettus.net/dhex"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dhex
version=0.69
release=1

source="${name}-${version}.tar.gz::http://www.dettus.net/${name}/${name}_${version}.tar.gz
    gcc-15-fix.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}_${version}"

    patch -p1 -i "${SRC}/gcc-15-fix.patch"
    make all

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "${name}.1" -t "${PKG}/usr/share/man/man1/"
    install -Dm644 dhexrc.5 dhex_markers.5 dhex_searchlog.5 -t "${PKG}/usr/share/man/man5/"
}
