#!/bin/sh

# shellcheck disable=SC2034
description="A tool to display dialog boxes from shell scripts"
homepage="https://invisible-island.net/dialog/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dialog
version=1.3_20260721
release=1

_version="$(printf "%s" "${version}" | sed 's/_/-/')"
source="${name}-${version}.tgz::https://invisible-mirror.net/archives/${name}/${name}-${_version}.tgz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${_version}"

    ./configure \
        --prefix=/usr \
        --with-ncursesw \
        --with-libtool

    make
    make DESTDIR="${PKG}" install
}
