#!/bin/sh

# shellcheck disable=SC2034
description="C implementation of John Gruber's Markdown markup language"
homepage="https://github.com/Orc/discount"
maintainer="Vylen Linux Team"

name=discount
version=3.0.1.3
release=1
source="https://github.com/Orc/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure.sh \
        --prefix=/usr \
        --enable-all-features \
        --with-fenced-code \
        --shared

    sed -i '/ldconfig/d' librarian.sh

    make
    make DESTDIR="${PKG}" install
}
