#!/bin/sh

# shellcheck disable=SC2034
description="Library for reading DjVu files"
homepage="https://djvu.sourceforge.net"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=djvulibre
version=3.5.30.1
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib

    make
    make DESTDIR="${PKG}" install
}
