#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Dynamic Kernel Modules System"
homepage="https://github.com/dell/dkms"
maintainer="Vylen Linux Team"

name=dkms
version=3.4.0
release=1
backup="etc/dkms/framework.conf"

source="${name}-${version}.tar.gz::https://github.com/dell/${name}/archive/v${version}.tar.gz
    buildmodules-template.sh"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make DESTDIR="${PKG}" install

    mkdir -pv "${PKG}/usr/lib/dkms"
    install -m644 "${SRC}/buildmodules-template.sh" "${PKG}/usr/lib/dkms/"
}
