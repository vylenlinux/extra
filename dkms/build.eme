#!/bin/sh

# shellcheck disable=SC2034
description="Dynamic Kernel Modules System"
homepage="https://github.com/dkms-project/dkms"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dkms
version=3.4.5
release=1
backup="etc/${name}/framework.conf"

source="${name}-${version}.tar.gz::https://github.com/dkms-project/${name}/archive/v${version}.tar.gz
    buildmodules-template.sh.in"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make DESTDIR="${PKG}" SBIN=/usr/bin install
    install -Dm644 "${SRC}/buildmodules-template.sh.in" -t "${PKG}/usr/lib/${name}/"
}
