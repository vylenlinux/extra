#!/bin/sh

MODULE=@MODULE@

dkms_install() {
    kernel_version="$(find /usr/lib/modules -maxdepth 1 -type d -iname '*-linux' -printf "%f\n" | sort -V | tail -n1)"
    [ -n "${kernel_version}" ] || kernel_version="$(uname -r)"

    dkms add     -m "${MODULE}/%version%"
    dkms build   -m "${MODULE}/%version%" -k "${kernel_version}"
    dkms install -m "${MODULE}/%version%" -k "${kernel_version}"
}

dkms_remove() {
    dkms remove -m "${MODULE}" --all
}

case "${1}" in
    install) dkms_install ;;
    remove) dkms_remove ;;

    *)
        dkms_remove
        dkms_install
    ;;
esac
