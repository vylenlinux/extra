#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight, easy to configure DNS forwarder and DHCP server"
homepage="https://thekelleys.org.uk/dnsmasq/doc.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dnsmasq
version=2.93
release=1
source="http://www.thekelleys.org.uk/${name}/${name}-${version}.tar.xz"
backup="etc/${name}.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # need to pass COPTS here to avoid rebuilding the binary.
    make COPTS="-DHAVE_DNSSEC -DHAVE_DBUS" PREFIX=/usr BINDIR=/usr/bin DESTDIR="${PKG}" install-i18n

    install -Dm644 dnsmasq.conf.example "${PKG}/etc/dnsmasq.conf"
    install -Dm644 trust-anchors.conf -t "${PKG}/usr/share/dnsmasq/"

    do_service "${name}"
    do_sysusers "${name}"
}
