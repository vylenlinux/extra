#!/bin/sh

update_xml_catalog() {
    [ -e /etc/xml/catalog.preserve ] && mv /etc/xml/catalog.preserve /etc/xml/catalog
    [ -e /etc/xml/catalog ] || xmlcatalog --noout --create /etc/xml/catalog

    xmlcatalog --noout --add "delegatePublic" \
        "-//OASIS//ENTITIES DocBook XML" \
        "file:///etc/xml/docbook-xml" /etc/xml/catalog

    xmlcatalog --noout --add "delegatePublic" \
        "-//OASIS//DTD DocBook XML" \
        "file:///etc/xml/docbook-xml" /etc/xml/catalog

    xmlcatalog --noout --add "delegateSystem" \
        "http://www.oasis-open.org/docbook/" \
        "file:///etc/xml/docbook-xml" /etc/xml/catalog

    xmlcatalog --noout --add "delegateURI" \
        "http://www.oasis-open.org/docbook/" \
        "file:///etc/xml/docbook-xml" /etc/xml/catalog

    for _prefix in http://docbook.org/xml/ https://docbook.org/xml/ http://www.docbook.org/xml/ https://www.docbook.org/xml/ https://www.oasis-open.org/docbook/xml/; do
        xmlcatalog --noout --add "delegateSystem" \
            "${_prefix}" \
            "file:///etc/xml/docbook-xml" /etc/xml/catalog

        xmlcatalog --noout --add "delegateURI" \
            "${_prefix}" \
            "file:///etc/xml/docbook-xml" /etc/xml/catalog
    done
}

post_install() {
    update_xml_catalog
}

post_upgrade() {
    update_xml_catalog
}
