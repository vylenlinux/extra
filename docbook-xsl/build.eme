#!/bin/sh

# shellcheck disable=SC2034
description="XML stylesheets for Docbook-xml transformations"
homepage="https://docbook.org/"
maintainer="Vylen Linux Team"

name=docbook-xsl
version=1.79.2
release=1

source="${name}-${version}.tar.gz::https://github.com/docbook/xslt10-stylesheets/releases/download/release/${version}/${name}-nons-${version}.tar.bz2
    docbook-xsl-stack_fix-1.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-nons-${version}"
    patch -Np1 -i "${SRC}/docbook-xsl-stack_fix-1.patch"

    for i in xsl-stylesheets xsl-stylesheets-nons; do
        install -dm755 "${PKG}/usr/share/xml/docbook/${i}-${version}"

        cp -R VERSION assembly common eclipse epub epub3 extensions fo \
            highlighting html htmlhelp images javahelp lib manpages params \
            profiling roundtrip slides template tests tools webhelp website \
            xhtml xhtml-1_1 xhtml5 \
        "${PKG}/usr/share/xml/docbook/${i}-${version}"

        ln -s VERSION "${PKG}/usr/share/xml/docbook/${i}-${version}/VERSION.xsl"
    done

    install -dm755 "${PKG}/etc/xml"
}
