#!/bin/sh

update_xsl_catalog() {
    current_version="${1}"
    prev_version="${2}"

    CATALOG=/etc/xml/catalog

    [ -d /etc/xml ] || install -dm755 /etc/xml
    [ -f "${CATALOG}" ] || xmlcatalog --noout --create "${CATALOG}"

    if [ -n "${prev_version}" ]; then
        xmlcatalog --noout --del "/usr/share/xml/docbook/xsl-stylesheets-${prev_version}" "${CATALOG}"
    fi

    xmlcatalog --noout --add "rewriteSystem" \
        "http://docbook.sourceforge.net/release/xsl/${current_version}" \
        "/usr/share/xml/docbook/xsl-stylesheets" "${CATALOG}"

    xmlcatalog --noout --add "rewriteURI" \
        "http://docbook.sourceforge.net/release/xsl/${current_version}" \
        "/usr/share/xml/docbook/xsl-stylesheets" "${CATALOG}"

    xmlcatalog --noout --add "rewriteSystem" \
        "http://docbook.sourceforge.net/release/xsl/current" \
        "/usr/share/xml/docbook/xsl-stylesheets" "${CATALOG}"

    xmlcatalog --noout --add "rewriteURI" \
        "http://docbook.sourceforge.net/release/xsl/current" \
        "/usr/share/xml/docbook/xsl-stylesheets" "${CATALOG}"

    xmlcatalog --noout --add "rewriteSystem" \
        "http://docbook.sourceforge.net/release/xsl-ns/current" \
        "/usr/share/xml/docbook/xsl-stylesheets" "${CATALOG}"

    xmlcatalog --noout --add "rewriteURI" \
        "http://docbook.sourceforge.net/release/xsl-ns/current" \
        "/usr/share/xml/docbook/xsl-stylesheets" "${CATALOG}"
}

post_install() {
    update_xsl_catalog "${1}"
}

post_upgrade() {
    update_xsl_catalog "${2}" "${1}"
}
