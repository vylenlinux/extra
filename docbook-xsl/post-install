#!/bin/sh

_xml_catalog() {
    xmlcatalog --noout "${@}" /etc/xml/catalog
}

version=1.79.2
[ -f /etc/xml/catalog ] || _xml_catalog --create

for _version in "${version}" current; do
    for x in rewriteSystem rewriteURI; do
        _xml_catalog --add "${x}" "http://cdn.docbook.org/release/xsl/${_version}" "/usr/share/xml/docbook/xsl-stylesheets-${version}"
        _xml_catalog --add "${x}" "http://docbook.sourceforge.net/release/xsl-ns/${_version}" "/usr/share/xml/docbook/xsl-stylesheets-${version}"
        _xml_catalog --add "${x}" "http://docbook.sourceforge.net/release/xsl/${_version}" "/usr/share/xml/docbook/xsl-stylesheets-nons-${version}"
    done
done
