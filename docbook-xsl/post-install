#!/bin/sh

_xml_catalog() {
    xmlcatalog --noout "${@}" /etc/xml/catalog
}

version=1.79.2
[ -f /etc/xml/catalog ] || _xml_catalog --create

for _version in "${version}" current; do
    for rw in rewriteSystem rewriteURI; do
        for proto in http https; do
            _xml_catalog --add "${rw}" "${proto}://cdn.docbook.org/release/xsl-nons/${_version}" "/usr/share/xml/docbook/xsl-stylesheets-nons-${version}"
        done
    done
done

for _version in current "${version}"; do
    for rw in rewriteSystem rewriteURI; do
        _xml_catalog --add "${rw}" "http://docbook.sourceforge.net/release/xsl/${_version}" "/usr/share/xml/docbook/xsl-stylesheets-nons-${version}"
    done
done
