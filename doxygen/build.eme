description="Source code documentation generator tool"
homepage="https://www.doxygen.nl/"
maintainer="Vylen Linux Team"

name=doxygen
version=1.16.1
vrsn=$(printf "$version" | sed 's/\./_/g')
release=1
source="$name-$version.tar.gz::https://github.com/doxygen/doxygen/archive/Release_$vrsn.tar.gz"

bsdtar() {
	tar $@
}

build() {

	cmake -S ${name}-Release_${vrsn} -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
		-D CMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build

	install -D -m 0755 $SRC/${name}-Release_${vrsn}/doc/${name}.1 \
				$PKG/usr/share/man/man1/${name}.1
}
