#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Source code documentation generator tool"
homepage="https://www.doxygen.nl/"
maintainer="Vylen Linux Team"

name=doxygen
version=1.17.0
release=1

_version="$(printf "%s" "${version}" | sed 's/\./_/g')"
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/Release_${_version}.tar.gz"

build() {
    cmake -S "${name}-Release_${_version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    install -Dm755 "${SRC}/${name}-Release_${_version}/doc/${name}.1" -t "${PKG}/usr/share/man/man1/"
}
