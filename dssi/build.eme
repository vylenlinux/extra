#!/bin/sh

# shellcheck disable=SC2034
description="An API for audio processing plugins & softsynths with UIs"
homepage="https://dssi.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dssi
version=1.1.1
release=1

source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.gz
    ${name}-${version}-gcc14-fixes.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/${name}-${version}-gcc14-fixes.patch"

    autoreconf -fi
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
