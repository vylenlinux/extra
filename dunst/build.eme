#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Customizable and lightweight notification-daemon"
homepage="https://dunst-project.org/"
maintainer="Vylen Linux Team"

name=dunst
version=1.13.2
release=1
source="https://github.com/dunst-project/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # shellcheck disable=SC2015
    emerald is-installed wayland && make all || export WAYLAND=0 make

    make PREFIX=/usr SYSCONFDIR=/etc DESTDIR="${PKG}" install
    install -Dm755 dunstify "${PKG}/usr/bin/dunstify"
}
