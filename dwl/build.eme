#!/bin/sh

# shellcheck disable=SC2034
description="Simple, hackable dynamic tiling Wayland compositor (dwm for Wayland)"
homepage="https://codeberg.org/dwl/dwl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=dwl
version=0.9
release=1
source="${name}-${version}.tar.gz::https://codeberg.org/${name}/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}"

    # Uncomment to compile with XWayland support
    # sed -i -e '/-DXWAYLAND/s/^#//' config.mk

    make PREFIX=/usr
    make PREFIX=/usr DESTDIR="${PKG}" install
}
