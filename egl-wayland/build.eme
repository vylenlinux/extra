#!/bin/sh

# shellcheck disable=SC2034
description="The EGLStream-based Wayland external platform"
homepage="https://github.com/NVIDIA/egl-wayland/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=egl-wayland
version=1.1.24
release=1
source="${name}-${version}.tar.gz::https://github.com/NVIDIA/${name}/archive/${version}/${name}-${version}-${release}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
