#!/usr/bin/env sh

# shellcheck disable=SC2034
description="utilities and libraries for handling ELF files"
homepage="https://sourceware.org/elfutils/"
maintainer="Vylen Linux Team"

name=elfutils
version=0.195
release=1
source="https://sourceware.org/ftp/${name}/${version}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    CFLAGS="${CFLAGS} -ffat-lto-objects" ./configure \
        --prefix=/usr \
        --program-prefix="eu-" \
        --sysconfdir=/etc \
        --disable-debuginfod \
        --disable-libdebuginfod \
        --disable-nls \
        --enable-deterministic-archives \
        --without-zstd

    make
    make DESTDIR="${PKG}" install
}
