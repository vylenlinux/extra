#!/bin/sh

# shellcheck disable=SC2034
description="An advanced and well-established feature-rich text mode web browser"
homepage="https://github.com/rkd77/elinks"
maintainer="Vylen Linux Team"

name=elinks
version=0.20.0
release=1
source="https://github.com/rkd77/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dgettext=true \
        -Dhtml-highlight=true \
        -Dbacktrace=false \
        -D256-colors=true \
        -Dtrue-color=true \
        -Dtre=false \
        -Dlibcss=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
