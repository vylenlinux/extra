#!/bin/sh

# shellcheck disable=SC2034
description="Embedded Linux library"
homepage="https://git.kernel.org/pub/scm/libs/ell/ell.git/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ell
version=0.83
release=1
source="https://mirrors.edge.kernel.org/pub/linux/libs/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
