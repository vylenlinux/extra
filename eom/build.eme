#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An image viewing and cataloging program for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team"

name=eom
version=1.28.1
release=1
source="${name}-${version}.tar.gz::https://github.com/mate-desktop/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
