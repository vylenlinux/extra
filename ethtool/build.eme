#!/bin/sh

# shellcheck disable=SC2034
description="Utility for controlling network drivers and hardware"
homepage="https://www.kernel.org/pub/software/network/ethtool/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ethtool
version=7.2
release=1
source="https://git.kernel.org/pub/scm/network/${name}/${name}.git/snapshot/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install
}
