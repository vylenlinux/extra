#!/bin/sh

# shellcheck disable=SC2034
description="Utilities for exFAT file system"
homepage="https://github.com/relan/exfat"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=exfat-utils
version=1.4.0
release=1
source="https://github.com/relan/exfat/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "exfat-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install

    # Fix exfatprogs files conflicts
    rm -f "${PKG}/usr/share/man/man8"/exfatlabel.8* \
        "${PKG}/usr/bin/mkfs.exfat" \
        "${PKG}/usr/bin/exfatlabel" \
        "${PKG}/usr/bin/fsck.exfat"
}
