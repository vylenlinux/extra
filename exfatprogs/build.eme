#!/bin/sh

# shellcheck disable=SC2034
description="exFAT filesystem userspace utilities for the Linux Kernel exfat driver"
homepage="https://github.com/exfatprogs/exfatprogs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=exfatprogs
version=1.4.4
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib

    make
    make DESTDIR="${PKG}" install
}
