#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A stream oriented C library for parsing XML"
homepage="https://libexpat.github.io"
maintainer="Vylen Linux Team"

name=expat
version=2.8.1
release=1

_version="$(printf "%s" "${version}" | sed 's/\./_/g')"
source="https://github.com/libexpat/libexpat/archive/R_${_version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "libexpat-R_${_version}/${name}"
    ./buildconf.sh

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
