#!/bin/sh

# shellcheck disable=SC2034
description="Userland tools for the Flash-Friendly File System (F2FS)"
homepage="https://archive.kernel.org/oldwiki/f2fs.wiki.kernel.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=f2fs-tools
version=1.17.0
release=1
source="https://git.kernel.org/pub/scm/linux/kernel/git/jaegeuk/${name}.git/snapshot/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install
}
