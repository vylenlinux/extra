#!/bin/sh

# shellcheck disable=SC2034
description="Tool for simulating superuser privileges"
homepage="https://wiki.debian.org/FakeRoot"
maintainer="Vylen Linux Team"

name=fakeroot
version=2.1.4
release=1
source="${name}-${version}.tar.gz::http://ftp.debian.org/debian/pool/main/f/${name}/${name}_${version}.orig.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed -i '/^SUBDIRS/d' doc/Makefile.am
    ./bootstrap

    ./configure \
        --prefix=/usr \
        --disable-static \
        --with-ipc=sysv

    make
    make DESTDIR="${PKG}" install
}
