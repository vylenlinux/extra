#!/bin/sh

# shellcheck disable=SC2034
description="Simple library for font loading and glyph rasterization using FontConfig, FreeType and pixman."
homepage="https://codeberg.org/dnkl/fcft"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fcft
version=3.3.3
release=1
source="${name}-${version}.tar.gz::https://codeberg.org/dnkl/${name}/archive/${version}.tar.gz"

build() {
    vylen-meson "${name}" build \
        -Dgrapheme-shaping=enabled \
        -Drun-shaping=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
