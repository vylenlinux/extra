#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Base Vylen Linux files"
homepage="https://vylen.gitlab.io/"
maintainer="Vylen Linux Team"

name=filesystem
version=20260416
release=1

source="fstab
    group
    hostname
    hosts
    issue
    locale.conf
    locale.sh
    os-release
    passwd
    resolv.conf
    shells
    ld.so.conf
    vylenlinux-logo.png::https://gitlab.com/vylen/artworks/-/raw/main/png/round_colored.png"

backup="etc/fstab
    etc/group
    etc/hostname
    etc/hosts
    etc/locale.conf
    etc/passwd
    etc/resolv.conf
    etc/shells
    etc/ld.so.conf"

build() {
    # root dirs
    for d in bin boot dev etc/opt etc/skel home lib mnt opt run sbin srv var; do
        mkdir -p "${PKG}/${d}"
    done

    install -dm 0750 "${PKG}/root"

    install -dm555 "${PKG}/proc" \
        "${PKG}/sys"

    install -dm 1777 "${PKG}/tmp" \
        "${PKG}/var/tmp"

    # /usr and /usr/local dirs
    for d in bin include lib sbin src; do
        mkdir -p "${PKG}/usr/${d}"
        mkdir -p "${PKG}/usr/local/${d}"
    done

    # man page dirs
    for d in 1 2 3 4 5 6 7 8; do
        mkdir -p "${PKG}/usr/share/man/man${d}"
        mkdir -p "${PKG}/usr/local/share/man/man${d}"
    done

    for d in cache lib/misc local lock log opt spool/mail; do
        mkdir -p "${PKG}/var/${d}"
    done

    ln -sfv ../run "${PKG}/var/run"
    ln -s /proc/self/mounts "${PKG}/etc/mtab"
    ln -sv lib "${PKG}/lib64"

    for f in btmp faillog lastlog wtmp; do
        touch "${PKG}/var/log/${f}"
    done

    chgrp utmp "${PKG}/var/log/lastlog"

    chmod 664 "${PKG}/var/log/lastlog"
    chmod 600 "${PKG}/var/log/btmp"

    for e in fstab group hosts hostname locale.conf os-release passwd resolv.conf shells issue ld.so.conf; do
        install -m644 "${e}" -t "${PKG}/etc/"
    done

    install -Dm644 locale.sh -t "${PKG}/etc/profile.d/"
    install -Dm644 "${SRC}/vylenlinux-logo.png" -t "${PKG}/usr/share/pixmaps/"
}
