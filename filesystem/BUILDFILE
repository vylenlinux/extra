#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Base Vylen Linux files"
homepage="https://vylen.gitlab.io/"
maintainer="Vylen Linux Team"

name=filesystem
version=20260331
release=1

backup="etc/fstab
    etc/group
    etc/hostname
    etc/hosts
    etc/locale.conf
    etc/passwd
    etc/resolv.conf
    etc/shells"

source="fstab
    group
    hostname
    hosts
    issue
    locale.conf
    locale.sh
    os-release
    passwd
    resolv.conf
    shells
    vylen.png::https://gitlab.com/vylen/artworks/-/raw/main/png/round_colored.png"

build() {
    # root dirs
    for d in bin boot dev etc/opt home lib mnt opt proc run sbin srv sys var; do
        mkdir -p "${PKG}/${d}"
    done

    install -d -m 555 proc
    install -d -m 555 sys
    install -d -m 0750 "${PKG}/root"
    install -d -m 1777 "${PKG}/tmp" "${PKG}/var/tmp"

    # /usr and /usr/local dirs
    for d in bin include lib sbin src; do
        mkdir -p "${PKG}/usr/${d}"
        mkdir -p "${PKG}/usr/local/${d}"
    done

    # man page dirs
    for d in 1 2 3 4 5 6 7 8; do
        mkdir -p "${PKG}/usr/share/man/man${d}"
        mkdir -p "${PKG}/usr/local/share/man/man${d}"
    done

    # /var dirs
    for d in cache lib/misc local lock log opt spool/mail; do
        mkdir -p "${PKG}/var/${d}"
    done

    ln -sfv ../run "${PKG}/var/run"
    ln -s /proc/self/mounts "${PKG}/etc/mtab"

    # log files
    for f in btmp faillog lastlog wtmp; do
        touch "${PKG}/var/log/${f}"
    done

    chgrp utmp "${PKG}/var/log/lastlog"

    chmod 664 "${PKG}/var/log/lastlog"
    chmod 600 "${PKG}/var/log/btmp"

    # /etc files
    for e in fstab group hosts hostname locale.conf os-release passwd resolv.conf shells; do
        install -m644 "${e}" "${PKG}/etc"
    done

    install -dm0755 "${PKG}/etc/profile.d"
    install -m644 locale.sh "${PKG}/etc/profile.d"

    install -d "${PKG}/etc/skel"
    install -m644 issue "${PKG}/etc"

    install -Dm644 "${SRC}/vylen.png" -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 "${SRC}/vylen.png" "${PKG}/usr/share/pixmaps/vylen-logo.png"
}
