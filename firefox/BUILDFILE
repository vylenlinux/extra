#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Standalone web browser from mozilla.org"
homepage="https://www.mozilla.org/firefox/"
maintainer="Vylen Linux Team"

name=firefox
version=149.0
release=1

source="${name}-${version}.tar.xz::https://archive.mozilla.org/pub/${name}/releases/${version}/source/${name}-${version}.source.tar.xz
    ${name}.desktop
    0001-Install-under-remoting-name.patch
    0002-Patch-glsl-optimizer-to-build-with-glibc-2.43.patch
    0003-Bug-2016618-Fix-Linux-sandbox-build-breakage-on-glib.patch
    0004-Use-wasm32-wasip1-target.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
 
    # Make different channels installable in parallel
    patch -Np1 -i "${SRC}/0001-Install-under-remoting-name.patch"

    # Prevent WebRTC crash
    # https://bugzilla.mozilla.org/show_bug.cgi?id=2012006
    patch -Np1 -i "${SRC}/0002-Bug-2012006-WebRTC-backport-PipeWire-capture-clear-e.patch"

    # Fix build with glibc 2.43
    # https://bugzilla.mozilla.org/show_bug.cgi?id=1999625
    patch -Np1 -i "${SRC}/0003-Patch-glsl-optimizer-to-build-with-glibc-2.43.patch"

    # https://bugzilla.mozilla.org/show_bug.cgi?id=2016618
    patch -Np1 -i "${SRC}/0004-Fix-sandbox-to-build-with-glibc-2.43.patch"
    sed -i 's/icu-i18n/icu-uc &/' js/moz.configure

    mkdir "${SRC}/rust"
    export CARGO_HOME="${SRC}/rust"

    cat <<- EOF > .mozconfig
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj
unset MOZ_TELEMETRY_REPORTING
ac_add_options --prefix=/usr
ac_add_options --libdir=/usr/lib
ac_add_options --disable-bootstrap
ac_add_options --disable-crashreporter
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-elf-hack
ac_add_options --disable-install-strip
ac_add_options --disable-necko-wifi
ac_add_options --disable-parental-controls
ac_add_options --disable-strip
ac_add_options --disable-tests
ac_add_options --disable-updater
ac_add_options --enable-application=browser
ac_add_options --enable-audio-backends=alsa
ac_add_options --enable-av1
ac_add_options --enable-dbus
ac_add_options --enable-ffmpeg
ac_add_options --enable-hardening
ac_add_options --enable-install-strip
ac_add_options --enable-linker=lld
ac_add_options --enable-official-branding
ac_add_options --enable-optimize
ac_add_options --enable-release
ac_add_options --enable-update-channel=release
ac_add_options --enable-rust-simd
ac_add_options --enable-sandbox
ac_add_options --enable-strip
ac_add_options --enable-system-pixman
ac_add_options --with-distribution-id=org.vylenlinux
ac_add_options --with-system-ffi
ac_add_options --with-system-icu
ac_add_options --with-system-jpeg
ac_add_options --with-system-libevent
ac_add_options --with-system-libvpx
ac_add_options --with-system-nspr
ac_add_options --with-system-nss
ac_add_options --with-system-png
ac_add_options --with-system-webp
ac_add_options --with-system-zlib
ac_add_options --without-wasm-sandboxed-libraries
EOF

    # audio
    emerald isinstalled alsa-lib && echo 'ac_add_options --enable-alsa' >> .mozconfig
    emerald isinstalled jack && echo 'ac_add_options --enable-jack' >> .mozconfig
    emerald isinstalled pulseaudio && echo 'ac_add_options --enable-pulseaudio' >> .mozconfig

    # wayland
    emerald isinstalled wayland-protocols && \
        echo 'ac_add_options --enable-default-toolkit=cairo-gtk3-wayland' >> .mozconfig || \
        echo 'ac_add_options --enable-default-toolkit=cairo-gtk3' >> .mozconfig

    # build configuration
    #export CC=gcc CXX=g++ # build with GCC
    export CFLAGS="${CFLAGS} -w"
    export CXXFLAGS="${CXXFLAGS} -w" # disable warnings
    export RUSTFLAGS="-C opt-level=2 ${RUSTFLAGS}"
    export BUILD_OFFICIAL=1
    export MOZILLA_OFFICIAL=1
    export MOZ_APP_REMOTINGNAME=firefox
    export MOZ_NOSPAM=1
    export MOZBUILD_STATE_PATH="${SRC}/mozbuild"

    unset CARGO_PROFILE_RELEASE_OPT_LEVEL
    unset CARGO_PROFILE_RELEASE_LTO

    # python configuration
    export SHELL='/bin/sh'
    export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
    export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=pip
 
    ./mach build
    DESTDIR="${PKG}" ./mach install

    unset MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE MOZBUILD_STATE_PATH

    # vendor
    vendorjs="${PKG}/usr/lib/${name}/browser/defaults/preferences/vendor.js"

    install -Dvm644 /dev/stdin "${vendorjs}" <<END
// Use LANG environment variable to choose locale
pref("intl.locale.requested", "");

// Disable default browser checking.
pref("browser.shell.checkDefaultBrowser", false);

// Don't disable extensions in the application directory
pref("extensions.autoDisableScopes", 11);
END
  
	# distribution
	distini="${PKG}/usr/lib/${name}/distribution/distribution.ini"

    install -Dvm644 /dev/stdin "${distini}" <<END
[Global]
id=vylenlinux
version=148.0.2
about=Mozilla Firefox for Vylen Linux

[Preferences]
app.distributor=vylenlinux
app.distributor.channel=${name}
app.partner.vylenlinux=vylenlinux
END

    # add icons
    for i in 16 22 24 32 48 64 128 256; do
        install -Dm644 "browser/branding/official/default${i}.png" "${PKG}/usr/share/icons/hicolor/${i}x${i}/apps/${name}.png"
    done

    install -Dm644 "${SRC}/${name}.desktop" "${PKG}/usr/share/applications/${name}.desktop"

    # remove crap
    # rm -r $PKG/usr/lib/firefox/browser/features
    rm -f "${PKG}/usr/lib/firefox/removed-files"

    # exclude library for revdep.
    install -d "${PKG}/etc/revdep.d"
    echo "/usr/lib/firefox/" > "${PKG}/etc/revdep.d/${name}.conf"
}
