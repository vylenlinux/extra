#!/bin/sh

# shellcheck disable=SC2034
description="Standalone web browser from mozilla.org"
homepage="https://www.mozilla.org/firefox/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=firefox
version=159.0
release=1

source="${name}-${version}.tar.xz::https://archive.mozilla.org/pub/${name}/releases/${version}/source/${name}-${version}.source.tar.xz
    ${name}.desktop
    config
    distribution.ini
    vendor.js
    fix-target-detection.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/fix-target-detection.patch"

    sed -i 's/icu-i18n/icu-uc &/' js/moz.configure
    install -Dm644 "${SRC}/config" .mozconfig

    # audio
    emerald is-installed alsa-lib && printf 'ac_add_options --enable-alsa\n' >> .mozconfig
    emerald is-installed jack && printf 'ac_add_options --enable-jack\n' >> .mozconfig
    emerald is-installed pulseaudio && printf 'ac_add_options --enable-pulseaudio\n' >> .mozconfig

    # wayland
    emerald is-installed wayland-protocols && \
        printf 'ac_add_options --enable-default-toolkit=cairo-gtk3-wayland\n' >> .mozconfig || \
        printf 'ac_add_options --enable-default-toolkit=cairo-gtk3\n' >> .mozconfig

    # build configuration
    # export CC=gcc CXX=g++ # build with GCC
    export CFLAGS="${CFLAGS} -w"
    export CXXFLAGS="${CXXFLAGS} -w" # disable warnings
    export RUSTFLAGS="${RUSTFLAGS} -C opt-level=2"
    export BUILD_OFFICIAL=1
    export MOZILLA_OFFICIAL=1
    export MOZ_APP_REMOTINGNAME="${name}"
    export MOZ_NOSPAM=1
    export MOZBUILD_STATE_PATH="${SRC}/mozbuild"

    unset CARGO_PROFILE_RELEASE_OPT_LEVEL
    unset CARGO_PROFILE_RELEASE_LTO

    # python configuration
    export SHELL=/bin/sh
    export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
    export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=pip

    ./mach build
    DESTDIR="${PKG}" ./mach install

    unset MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE \
        MOZBUILD_STATE_PATH

    # vendor
    install -Dm644 "${SRC}/vendor.js" -t "${PKG}/usr/lib/${name}/browser/defaults/preferences/"

    # distribution
    sed \
         -e "s|@VERSION@|${version}|" \
         -e "s|@NAME@|${name}|" \
    -i "${SRC}/distribution.ini" | install -Dm644 /dev/stdin "${SRC}/distribution.ini" -t "${PKG}/usr/lib/${name}/distribution/"

    # add icons
    for i in 16 22 24 32 48 64 128 256; do
        install -Dm644 "browser/branding/official/default${i}.png" "${PKG}/usr/share/icons/hicolor/${i}x${i}/apps/${name}.png"
    done

    install -Dm644 "${SRC}/${name}.desktop" -t "${PKG}/usr/share/applications/"

    # remove crap
    rm -f "${PKG}/usr/lib/${name}/removed-files"

    # exclude library for revdep.
    do_revdep
}
