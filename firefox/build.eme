#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Standalone web browser from mozilla.org"
homepage="https://www.mozilla.org/firefox/"
maintainer="Vylen Linux Team"

name=firefox
version=150.0
release=2

source="${name}-${version}.tar.xz::https://archive.mozilla.org/pub/${name}/releases/${version}/source/${name}-${version}.source.tar.xz
    ${name}.desktop
    0002-Bug-2033279-Make-enable-rust-simd-work-with-Rust-1.9.patch
    0003-Patch-glsl-optimizer-to-build-with-glibc-2.43.patch
    0004-Bug-2023597-Use-wasm32-wasip1-target-for-clang-22.1-.patch
    config
    distribution.ini
    vendor.js"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # Make different channels installable in parallel
    patch -Np1 -i "${SRC}/0001-Install-under-remoting-name.patch"

    # Fix build with Rust 1.95.0
    # https://bugzilla.mozilla.org/show_bug.cgi?id=2033279
    patch -Np1 -i "${SRC}/0002-Bug-2033279-Make-enable-rust-simd-work-with-Rust-1.9.patch"

    # Fix build with glibc 2.43
    # https://bugzilla.mozilla.org/show_bug.cgi?id=1999625
    patch -Np1 -i "${SRC}/0003-Patch-glsl-optimizer-to-build-with-glibc-2.43.patch"

    # Fix build with Clang 22
    # https://bugzilla.mozilla.org/show_bug.cgi?id=2023597
    patch -Np1 -i "${SRC}/0004-Bug-2023597-Use-wasm32-wasip1-target-for-clang-22.1-.patch"
    sed -i 's/icu-i18n/icu-uc &/' js/moz.configure

    mkdir "${SRC}/rust"
    export CARGO_HOME="${SRC}/rust"

    install -Dm644 "${SRC}/config" .mozconfig

    # audio
    emerald isinstalled alsa-lib && echo 'ac_add_options --enable-alsa' >> .mozconfig
    emerald isinstalled jack && echo 'ac_add_options --enable-jack' >> .mozconfig
    emerald isinstalled pulseaudio && echo 'ac_add_options --enable-pulseaudio' >> .mozconfig

    # wayland
    emerald isinstalled wayland-protocols && \
        echo 'ac_add_options --enable-default-toolkit=cairo-gtk3-wayland' >> .mozconfig || \
        echo 'ac_add_options --enable-default-toolkit=cairo-gtk3' >> .mozconfig

    # build configuration
    #export CC=gcc CXX=g++ # build with GCC
    export CFLAGS="${CFLAGS} -w"
    export CXXFLAGS="${CXXFLAGS} -w" # disable warnings
    export RUSTFLAGS="-C opt-level=2 ${RUSTFLAGS}"
    export BUILD_OFFICIAL=1
    export MOZILLA_OFFICIAL=1
    export MOZ_APP_REMOTINGNAME=firefox
    export MOZ_NOSPAM=1
    export MOZBUILD_STATE_PATH="${SRC}/mozbuild"

    unset CARGO_PROFILE_RELEASE_OPT_LEVEL
    unset CARGO_PROFILE_RELEASE_LTO

    # python configuration
    export SHELL='/bin/sh'
    export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
    export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=pip

    ./mach build
    DESTDIR="${PKG}" ./mach install

    unset MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE MOZBUILD_STATE_PATH

    # vendor
    vendorjs="${PKG}/usr/lib/${name}/browser/defaults/preferences/"
    install -Dvm644 /dev/stdin "${SRC}/vendor.js" -t "${vendorjs}"

    # distribution
    distini="${PKG}/usr/lib/${name}/distribution/"

    sed -i \
         -e "s|@VERSION@|${version}|" \
         -e "s|@NAME@|${name}|" \
         "${SRC}/distribution.ini" \
    | install -Dvm644 /dev/stdin "${SRC}/distribution.ini" -t "${distini}"

    # add icons
    for i in 16 22 24 32 48 64 128 256; do
        install -Dm644 "browser/branding/official/default${i}.png" "${PKG}/usr/share/icons/hicolor/${i}x${i}/apps/${name}.png"
    done

    install -Dm644 "${SRC}/${name}.desktop" -t "${PKG}/usr/share/applications/"

    # remove crap
    # rm -r $PKG/usr/lib/firefox/browser/features
    rm -f "${PKG}/usr/lib/firefox/removed-files"

    # exclude library for revdep.
    install -d "${PKG}/etc/revdep.d"
    echo "/usr/lib/firefox/" > "${PKG}/etc/revdep.d/${name}.conf"
}
