#!/usr/bin/env sh

# shellcheck disable=SC2034
description="ALinux application sandboxing and distribution framework (formerly xdg-app)"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://flatpak.org"

name=flatpak
version=1.18.3
release=1

source="https://github.com/${name}/${name}/releases/download/${version}/${name}-${version}.tar.xz
    https://dl.flathub.org/repo/flathub.flatpakrepo
    ${name}-bindir.sh"

build() {
    vylen-meson "${name}-${version}" build \
        --auto-features=disabled \
        -Ddbus_config_dir=/usr/share/dbus-1/system.d \
        -Dsystem_bubblewrap=bwrap \
        -Dsystem_dbus_proxy=xdg-dbus-proxy \
        -Dsystem_helper_user=_flatpak \
        -Dselinux_module=disabled \
        -Dlibzstd=enabled \
        -Ddconf=enabled \
        -Dgdm_env_file=true \
        -Dtests=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 "${name}-bindir.sh" -t "${PKG}/etc/profile.d/"
    install -Dm644 flathub.flatpakrepo -t "${PKG}/usr/share/${name}/remotes.d/"
}
