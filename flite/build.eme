description="A small run-time speech synthesis engine"
homepage="https://github.com/festvox/flite/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=flite
version=2.2
release=1
source="https://github.com/festvox/flite/archive/v${version}/flite-$version.tar.gz"

build() {
	cd $name-$version
	./configure --prefix=/usr --enable-shared
	make -j1
	make DESTDIR=$PKG install
}
