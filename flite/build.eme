#!/bin/sh

# shellcheck disable=SC2034
description="A small run-time speech synthesis engine"
homepage="https://github.com/festvox/flite/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=flite
version=2.2
release=1
source="https://github.com/festvox/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --enable-shared

    make -j1
    make DESTDIR="${PKG}" install
}
