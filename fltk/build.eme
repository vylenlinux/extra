#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Graphical user interface toolkit for X"
homepage="https://www.fltk.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fltk
version=1.4.5
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/release-${version}.tar.gz"

build() {
    cmake -S "${name}-release-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DFLTK_BUILD_SHARED_LIBS=ON \
        -DFLTK_BUILD_HTML_DOCS=OFF \
        -DFLTK_INSTALL_HTML_DOCS=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
