#!/bin/sh

# shellcheck disable=SC2034
description="A lightweight window manager"
homepage="https://fluxbox.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fluxbox
version=1.3.7
release=1

source="https://downloads.sourceforge.net/fluxbox/fluxbox-${version}.tar.xz
    ${name}-${version}-c++17.patch
    ${name}.desktop"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/${name}-${version}-c++17.patch"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.desktop" -t "${PKG}/usr/share/xsessions/"
}
