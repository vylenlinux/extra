description="X.org jis-misc fonts"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=font-jis-misc
version=1.0.4
release=1
source="https://www.x.org/archive/individual/font/$name-$version.tar.xz"

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
