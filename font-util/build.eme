#!/usr/bin/env sh

# shellcheck disable=SC2034
description="X.Org font utilities"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=font-util
version=1.4.2
release=1
source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/xorg/font/util/-/archive/${name}-${version}/util-${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "util-${name}-${version}"
    NOCONFIGURE=1 ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --with-mapdir=/usr/share/fonts/util \
        --with-fontrootdir=/usr/share/fonts

    make
    make DESTDIR="${PKG}" install
}
