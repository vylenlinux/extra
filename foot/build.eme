#!/bin/sh

# shellcheck disable=SC2034
description="A fast, lightweight and minimalistic Wayland terminal emulator"
homepage="https://codeberg.org/dnkl/foot"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=foot
version=1.28.0
release=1
source="${name}-${version}.tar.gz::https://codeberg.org/dnkl/${name}/archive/${version}.tar.gz"

build() {
    # doing the lto dance
    export CFLAGS="-O3 \
        -Wno-missing-profile \
        -Wno-error"

    vylen-meson "${name}" build \
        -Dgrapheme-clustering=enabled \
        -Dtests=false

    find . -name "*.gcda" -delete
    meson compile -C build

    meson configure -Db_pgo=use build
    meson compile -C build

    DESTDIR="${PKG}" meson install --no-rebuild -C build

    mv "${PKG}/usr/share/terminfo/f/foot" "${PKG}/usr/share/terminfo/f/foot-extra"
    mv "${PKG}/usr/share/terminfo/f/foot-direct" "${PKG}/usr/share/terminfo/f/foot-extra-direct"
}
