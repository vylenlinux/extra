#!/bin/sh

# shellcheck disable=SC2034
description="Library project for developers who would like to support popular graphics image formats"
homepage="https://github.com/danoli3/FreeImage"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=freeimage
version=3.19.29
release=1
source="${name}-${version}.tar.gz::https://github.com/danoli3/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cmake -S "FreeImage-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_STANDARD=20 \
        -DFREEIMAGE_STATIC=OFF \
        -DFREEIMAGE_LINUX_PACKAGE_LAYOUT=ON \
        -DFREEIMAGE_USE_SYSTEM_LIBS=ON \
        -DBUILD_JXR=ON \
        -DBUILD_TESTS=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
