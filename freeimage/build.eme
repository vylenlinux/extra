#!/bin/sh

# shellcheck disable=SC2034
description="Library project for developers who would like to support popular graphics image formats"
homepage="http://freeimage.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=freeimage
version=3.18.0
release=1

_version="$(printf "%s" "${version}" | sed 's/\.//g')"

source="${name}-${version}.zip::https://downloads.sourceforge.net/project/${name}/Source%20Distribution/${version}/FreeImage${_version}.zip
    ${name}-unbundle.patch
    ${name}-libraw-0.20.patch
    ${name}-libraw-0.21.patch
    JXRVersion.h"

build() {
    # shellcheck disable=SC2164
    cd FreeImage
    install -Dm644 "${SRC}/JXRVersion.h" -t Source/

    rm -r Source/Lib* \
        Source/ZLib \
        Source/OpenEXR

    : > Source/FreeImage/PluginG3.cpp
    : > Source/FreeImageToolkit/JPEGTransform.cpp

    patch -Np1 -i "${SRC}/${name}-unbundle.patch"    # Unbundle libraries
    patch -Np1 -i "${SRC}/${name}-libraw-0.20.patch" # Fix build with libraw 0.20
    patch -Np1 -i "${SRC}/${name}-libraw-0.21.patch" # Fix build with libraw 0.21

    sh gensrclist.sh
    sh genfipsrclist.sh

    make -f Makefile.gnu
    make -f Makefile.fip

    make -f Makefile.gnu DESTDIR="${PKG}" install
    make -f Makefile.fip DESTDIR="${PKG}" install INCLUDE="-ISource -IWrapper/FreeImagePlus -IDist"
}
