#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Minimalistic plugin API for video effects"
homepage="https://frei0r.dyne.org/"
maintainer="Vylen Linux Team"

name=frei0r-plugins
version=3.4.3
release=1
source="${name}-${version}.tar.gz::https://github.com/dyne/frei0r/archive/v${version}.tar.gz"

build() {
    # Fix build with znver4 or newer
    export CFLAGS="${CFLAGS} \
        -march=x86-64"

    # Disable plugins that still depend on removed OpenCV APIs
    sed -i '/facebl0r/d;/facedetect/d' "frei0r-${version}/src/filter/CMakeLists.txt"

    cmake -S "frei0r-${version}" -B build -G Ninja \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DWITHOUT_OPENCV="$(emerald is-installed opencv && printf "OFF" || printf "ON")" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
