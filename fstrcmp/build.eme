#!/bin/sh

# shellcheck disable=SC2034
description="fstrcmp - a library that is used to make fuzzy comparisons of strings and byte arrays"
homepage="https://fstrcmp.sourceforge.net/"
maintainer="Vylen Linux Team"

name=fstrcmp
version=0.7.D001
release=1
source="https://fstrcmp.sourceforge.net/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
