#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A simple interface for userspace programs to export a virtual filesystem to the Linux kernel"
homepage="https://github.com/libfuse/libfuse"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fuse
version=3.18.3
release=1
source="${name}-${version}.tar.gz::https://github.com/libfuse/libfuse/archive/refs/tags/${name}-${version}.tar.gz"

build() {
    vylen-meson "libfuse-${name}-${version}" build -Dudevrulesdir=/usr/lib/udev/rules.d
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # static device nodes are handled by eudev
    # shellcheck disable=SC2115
    rm -r "${PKG}/dev" \
        "${PKG}/etc/init.d"

    # move to fuse-common
    rm -f "${PKG}/etc/${name}.conf"
    do_service "${name}"
}
