#!/bin/sh

# shellcheck disable=SC2034
description="Simple interface for userspace programs to export a virtual filesystem to the Linux kernel"
homepage="https://github.com/libfuse/libfuse"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fuse2
version=2.9.9
release=1

source="https://github.com/libfuse/libfuse/releases/download/fuse-${version}/fuse-${version}.tar.gz
    glibc-2.34-fix.patch"

build() {
    # shellcheck disable=SC2164
    cd "fuse-${version}"

    export UDEV_RULES_PATH=/usr/lib/udev/rules.d
    export MOUNT_FUSE_PATH=/usr/bin

    autoreconf -fi -I /usr/share/gettext/m4
    patch -Np1 -i "${SRC}/glibc-2.34-fix.patch"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --disable-static

    make
    make DESTDIR="${PKG}" install

    # static device nodes are handled by udev
    # shellcheck disable=SC2115
    rm -rf "${PKG}/dev"

    # remove unused (empty) dir
    # shellcheck disable=SC2115
    rm -rf "${PKG}/etc"
}
