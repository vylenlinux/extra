#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A simple interface for userspace programs to export a virtual filesystem to the Linux kernel"
homepage="https://github.com/libfuse/libfuse"
maintainer="Vylen Linux Team"

name=fuse3
version=3.18.2
release=2
source="${name}-${version}.tar.gz::https://github.com/libfuse/libfuse/archive/refs/tags/fuse-${version}.tar.gz"

build() {
    vylen-meson "libfuse-fuse-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # static device nodes are handled by eudev
    # shellcheck disable=SC2115
    rm -r "${PKG}/dev"

    # move to fuse-common
    rm -f "${PKG}/etc/fuse.conf"
}
