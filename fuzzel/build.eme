#!/bin/sh

# shellcheck disable=SC2034
description="Application launcher for wlroots based Wayland compositors"
homepage="https://codeberg.org/dnkl/fuzzel"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fuzzel
version=1.15.0
release=1
source="${name}-${version}.tar.gz::https://codeberg.org/dnkl/${name}/archive/${version}.tar.gz"

build() {
    vylen-meson "${name}" build \
        -Denable-cairo=enabled \
        -Dpng-backend=libpng \
        -Dsvg-backend=nanosvg

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
