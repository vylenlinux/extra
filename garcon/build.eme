#!/bin/sh

# shellcheck disable=SC2034
description="Freedesktop.org compliant menu implementation based on GLib and GIO"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=garcon
version=4.21.0
release=1
source="https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
