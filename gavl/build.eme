#!/bin/sh

# shellcheck disable=SC2034
description="Low level library that handles the details of audio and video formats"
homepage="https://github.com/bplaum/gavl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gavl
version=2.0.1
release=1

commit=82f103205b3b378702008092c8716a0e64733047
source="${name}-${version}-${commit}.tar.gz::https://github.com/bplaum/${name}/archive/${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --without-doxygen \
        --with-cpuflags=none

    make
    make DESTDIR="${PKG}" install
}
