#!/bin/sh

# shellcheck disable=SC2034
description="Libraries used for displaying certificates and accessing key stores"
homepage="https://gitlab.gnome.org/GNOME/gcr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gcr
version=4.4.1
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.bz2"

build() {
    vylen-meson "${name}-${version}" build \
        -Dgtk_doc=false \
        -Dgtk4="$(emerald is-installed gtk4 && printf "true" || printf "false")"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
