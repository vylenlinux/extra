description="Libraries used for displaying certificates and accessing key stores"
homepage="https://gitlab.gnome.org/GNOME/gcr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gcr3
version=3.41.2
release=1
source="$name-$version.tar.xz::https://gitlab.gnome.org/GNOME/${name%3}/-/archive/$version/${name%3}-$version.tar.bz2"

build() {
	cd ${name%3}-$version

	sed -i -r 's:"(/desktop):"/org/gnome\1:' schema/*.xml

	vylen-meson build -Dgtk_doc=false -Dssh_agent=false 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
