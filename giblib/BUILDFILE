description="A library that feh uses as a wrapper to imlib2"
homepage="http://freshmeat.net/projects/giblib/"
maintainer="Vylen Linux Team"

name=giblib
version=1.2.4
release=1
source="https://sourceforge.net/projects/slackbuildsdirectlinks/files/giblib/giblib-$version.tar.gz"

build() {
	cd giblib-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG docsdir=/usr/share/doc/giblib install
	rm -r $PKG/usr/share
}
