#!/bin/sh

# shellcheck disable=SC2034
description="A library that feh uses as a wrapper to imlib2"
homepage="https://sourceforge.net/directory/software-development/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=giblib
version=1.2.4
release=1
source="https://sourceforge.net/projects/slackbuildsdirectlinks/files/${name}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" docsdir=/usr/share/doc/giblib install
}
