#!/bin/sh

# shellcheck disable=SC2034
description="Low-level core library that forms the basis for projects such as GTK+ and GNOME"
homepage="https://gitlab.gnome.org/GNOME/glib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=glib
version=2.90.0
release=1

_gi_version="$(emerald info --field=version gobject-introspection)"

source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz
    https://download.gnome.org/sources/gobject-introspection/${_gi_version%.*}/gobject-introspection-${_gi_version}.tar.xz"

build() {
    _prefix="${PWD}/boostrap-glib"
    mkdir "${_prefix}"

    msg_info "build bootstrap glib"

    meson setup "${name}-${version}" output \
        --default-library=shared \
        --prefix="${_prefix}" \
        --libdir="${_prefix}/lib" \
        --libexecdir="${_prefix}/lib" \
        \
        -Dman-pages=disabled \
        -Dlibmount=disabled \
        -Dtests=false \
        -Dintrospection=disabled \
        -Dnls=disabled \
        -Db_lto=false \
        -Dglib_debug=disabled

    meson compile -C output
    meson install --no-rebuild -C output

    msg_info "build bootstrap gobject-introspection"

    meson setup "gobject-introspection-${_gi_version}" gi_output \
        --prefix="${_prefix}" \
        --pkg-config-path="${_prefix}/lib/pkgconfig" \
        --libdir="${_prefix}/lib" \
        --libexecdir="${_prefix}/lib" \
        \
        -Dbuild_introspection_data=false \
        -Dcairo=disabled \
        -Ddoctool=disabled \
        -Db_lto=false

    meson compile -C gi_output
    meson install --no-rebuild -C gi_output

    msg_info "re-build glib with introspection"

    export PATH="${PATH}:${_prefix}/bin"
    export LD_LIBRARY_PATH="${_prefix}/lib"

    vylen-meson "${name}-${version}" build \
        --pkg-config-path="${_prefix}/lib/pkgconfig" \
        --default-library=shared \
        \
        -Ddocumentation=false \
        -Dintrospection=enabled \
        -Dnls=disabled \
        -Dselinux=disabled \
        -Dtests=false \
        -Db_lto=false \
        -Dglib_debug=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
