#!/bin/sh

# shellcheck disable=SC2034
description="Low-level core library that forms the basis for projects such as GTK+ and GNOME"
homepage="https://gitlab.gnome.org/GNOME/glib"
maintainer="Vylen Linux Team"

name=glib
version=2.88.1
release=1

girv=1.86.0

source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz
    https://download.gnome.org/sources/gobject-introspection/${girv%.*}/gobject-introspection-${girv}.tar.xz"

build() {
    _prefix="${PWD}/boostrap-glib"
    mkdir "${_prefix}"

    echo "build bootstrap glib"

    meson setup "${name}-${version}" output \
        --default-library=shared \
        --prefix="${_prefix}" \
        --libdir="${_prefix}/lib" \
        --libexecdir="${_prefix}/lib" \
        -Dman-pages=disabled \
        -Dlibmount=disabled \
        -Dtests=false \
        -Dintrospection=disabled \
        -Dnls=disabled \
        -Db_lto=false \
        -Dglib_debug=disabled

    meson compile -C output
    meson install --no-rebuild -C output

    echo "build bootstrap gobject-introspection"

    meson setup "gobject-introspection-${girv}" gioutput \
        --pkg-config-path="${_prefix}/lib/pkgconfig" \
        --prefix="${_prefix}" \
        --libdir="${_prefix}/lib" \
        --libexecdir="${_prefix}/lib" \
        -Dbuild_introspection_data=false \
        -Dcairo=disabled \
        -Ddoctool=disabled \
        -Db_lto=false

    meson compile -C gioutput
    meson install --no-rebuild -C gioutput

    echo "re-build glib with introspection"

    PATH="${_prefix}/bin:${PATH}" LD_LIBRARY_PATH="${_prefix}/lib" meson setup "${name}-${version}" build \
        --reconfigure \
        --pkg-config-path="${_prefix}/lib/pkgconfig" \
        --prefix=/usr \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --default-library=shared \
        -Ddocumentation=false \
        -Dintrospection=enabled \
        -Dnls=disabled \
        -Dselinux=disabled \
        -Dtests=false \
        -Db_lto=false \
        -Dglib_debug=disabled

    PATH="${_prefix}/bin:${PATH}" LD_LIBRARY_PATH="${_prefix}/lib" meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
