#!/usr/bin/env sh

# shellcheck disable=SC2034
description="GNU C Library (32-bit)"
maintainer="Vylen Linux Team"
homepage="https://www.gnu.org/software/libc"

name=glibc-32
version=2.43
release=1
source="https://ftp.gnu.org/gnu/glibc/glibc-${version}.tar.xz"

nostrip="lib.*/ld-.*\.so$
    lib.*/libc-.*\.so$
    lib.*/libpthread-.*\.so$
    lib.*/libthread_db-.*\.so$"

build() {
    # shellcheck disable=SC2164
    cd "glibc-${version}"

    export CC="gcc -m32 -mstackrealign"
    export CXX="g++ -m32 -mstackrealign"
    export CFLAGS="${CFLAGS} -Wno-error=parentheses"

    mkdir build
    # shellcheck disable=SC2164
    cd build

    ../configure \
        --libdir=/usr/lib32 \
        --libexecdir=/usr/lib32 \
        libc_cv_slibdir=/usr/lib32 \
        i686-pc-linux-gnu \
        --prefix=/usr \
        --with-headers=/usr/include \
        --disable-nscd \
        --disable-profile \
        --disable-werror \
        --enable-bind-now \
        --enable-kernel=4.14 \
        --enable-stack-protector=strong \
        --enable-multi-arch \
        libc_cv_include_x86_isa_level=no

    make

    # shellcheck disable=SC2016
    sed '/test-installation/s@$(PERL)@echo not running@' -i ../Makefile
    make install_root="${PWD}/DESTDIR" install

    install -dm755 "${PKG}/usr/lib32"
    cp -R DESTDIR/usr/lib32/* "${PKG}/usr/lib32/"

    install -Dm644 DESTDIR/usr/include/gnu/lib-names-32.h DESTDIR/usr/include/gnu/stubs-32.h -t "${PKG}/usr/include/gnu/"

    install -d "${PKG}/lib"
    install -d "${PKG}/etc/ld.so.conf.d"

    ln -s ../usr/lib32/ld-linux.so.2 "${PKG}/lib/ld-linux.so.2"
    ln -s ../lib/locale "${PKG}/usr/lib32/locale"

    echo "/usr/lib32" > "${PKG}/etc/ld.so.conf.d/lib32.conf"
}
