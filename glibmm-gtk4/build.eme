#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Set of C++ bindings for GLib"
homepage="https://www.gtkmm.org/"
maintainer="Vylen Linux Team"

name=glibmm-gtk4
version=2.88.0
release=1
source="${name}-${version}.tar.bz2::https://gitlab.gnome.org/GNOME/${name%-*}/-/archive/${version}/${name%-*}-${version}.tar.bz2"

build() {
    vylen-meson "${name%-*}-${version}" build -Dmaintainer-mode=true
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
