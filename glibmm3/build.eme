#!/bin/sh

# shellcheck disable=SC2034
description="Set of C++ bindings for GLib"
maintainer="Vylen Linux Team"
homepage="https://www.gtkmm.org/"

name=glibmm3
version=2.66.10
release=1
source="${name}-${version}.tar.bz2::https://gitlab.gnome.org/GNOME/glibmm/-/archive/${version}/glibmm-${version}.tar.bz2"

build() {
    vylen-meson "glibmm-${version}" build -Dmaintainer-mode=true
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
