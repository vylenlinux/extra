#!/bin/sh

# shellcheck disable=SC2034
description="A C/C++ MIME creation and parser library with support for S/MIME, PGP, and Unix mbox spools"
homepage="https://github.com/jstedfast/gmime"
maintainer="Vylen Linux Team"

name=gmime3
version=3.2.15
release=1
source="https://github.com/jstedfast/gmime/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "gmime-${version}"

    sed -i '/AM_INIT_AUTOMAKE/s/]/ foreign]/' configure.ac
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --program-prefix=gmime3 \
        --enable-smime \
        --enable-gtk-doc \
        --disable-static

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

    make
    make DESTDIR="${PKG}" install
}
