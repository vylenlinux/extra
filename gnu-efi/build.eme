#!/bin/sh

# shellcheck disable=SC2034
description="Develop EFI applications using the GNU toolchain and the EFI development environment"
homepage="https://github.com/ncroxon/gnu-efi"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gnu-efi
version=4.0.4
release=1
source="https://github.com/ncroxon/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    sed 's/-Werror//g' -i Make.defaults

    export CFLAGS="-O2"
    # shellcheck disable=SC2155
    export LDFLAGS="$(printf '%s\n' "${LDFLAGS}" | sed 's/-Wl//g; s/,/ /g')"

    make PREFIX=/usr
    make PREFIX=/usr INSTALLROOT="${PKG}" install
}
