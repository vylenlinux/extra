#!/usr/bin/env sh

# shellcheck disable=SC2034
description="GNU's tool for secure communication and data storage"
homepage="https://gnupg.org"
maintainer="Vylen Linux Team"

name=gnupg
version=2.5.22
release=1
source="https://gnupg.org/ftp/gcrypt/${name}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}" \
        --disable-ldap \
        --disable-nls \
        --disable-tests

    make
    make DESTDIR="${PKG}" install

    rm -f "${PKG}/usr/share/gnupg/FAQ" \
        "${PKG}/usr/share/gnupg/faq.html" \
        "${PKG}/usr/share/gnupg/qualified.txt" \
        "${PKG}/usr/share/gnupg"/help*
}
