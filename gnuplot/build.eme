#!/bin/sh

# shellcheck disable=SC2034
description="GNUPlot, a graph plotting software"
homepage="http://www.gnuplot.info/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gnuplot
version=6.0.6
release=1
source="https://downloads.sourceforge.net/project/${name}/${name}/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    #export CFLAGS="${CFLAGS} \
    #    -std=gnu17"

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --with-x \
        --with-qt=no

    make
    make DESTDIR="${PKG}" install

    rm "${PKG}/usr/share/gnuplot/${version%.*}/js/README"
}
