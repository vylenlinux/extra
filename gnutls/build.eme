#!/bin/sh

# shellcheck disable=SC2034
description="Libraries and userspace tools which provide a secure layer over a reliable transport layer"
homepage="https://www.gnutls.org/"
maintainer="Vylen Linux Team"

name=gnutls
version=3.8.13
release=1
source="https://www.gnupg.org/ftp/gcrypt/${name}/v$(printf "%s" "${version}" | awk -F. '{print $1"."$2}')/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version%.1}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-default-trust-store-pkcs11="pkcs11:" \
        --disable-guile \
        --disable-static \
        --with-zlib \
        --without-tpm \
        --without-tpm2

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

    make
    make DESTDIR="${PKG}" install

    rm -r "${PKG}/usr/share/doc" \
        "${PKG}/usr/share/info" \
        "${PKG}/usr/share/locale"
}
