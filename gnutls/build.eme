#!/bin/sh

# shellcheck disable=SC2034
description="Libraries and userspace tools which provide a secure layer over a reliable transport layer"
homepage="https://www.gnutls.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gnutls
version=3.8.14
release=1
source="https://www.gnupg.org/ftp/gcrypt/${name}/v${version%.*}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-default-trust-store-pkcs11="pkcs11:" \
        --disable-static \
        --with-zlib \
        --without-tpm \
        --without-tpm2

    make
    make DESTDIR="${PKG}" install
}
