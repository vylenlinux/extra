#!/bin/sh

# shellcheck disable=SC2034
description="The Go Programming Language"
homepage="https://golang.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=go
version=1.27.4
release=1

source="${name}-${version}.tar.gz::https://golang.org/dl/${name}${version}.src.tar.gz
    ${name}-${version}.linux-amd64.tar.gz::https://golang.org/dl/${name}${version}.linux-amd64.tar.gz"

NO_STRIP=yes

build() {
    export GOROOT_BOOTSTRAP="${name}-${version}"
    export GOROOT_FINAL="/usr/lib/${name}"
    export GOARCH=amd64
    export GOOS=linux

    # shellcheck disable=SC2164
    cd "${name}/src"
    ./make.bash

    install -d "${PKG}/usr/lib"
    mv "${SRC}/${name}" -t "${PKG}/usr/lib/"

    install -d "${PKG}/usr/bin"
    ln -s /usr/lib/go/bin/go -t "${PKG}/usr/bin/"
    ln -s /usr/lib/go/bin/gofmt -t "${PKG}/usr/bin/"

    rm -rf "${SRC}/go/pkg/obj/go-build"/* \
        "${PKG}/usr/lib/go/test" \
        "${PKG}/usr/lib/go/api"

    find "${PKG}" \( \
        -name "README*" -o \
        -name "AUTHORS" -o \
        -name "TODO" -o \
        -name "LICENSE" -o \
        -name "PATENTS" -o \
        -name "SECURITY*" -o \
        -name "CONTRIBUTING*" \
    \) -delete

    rm "${PKG}/usr/lib/go/src"/*.bat
}
