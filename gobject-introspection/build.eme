#!/bin/sh

# shellcheck disable=SC2034
description="Introspection system for GObject-based libraries"
homepage="https://wiki.gnome.org/Projects/GObjectIntrospection"
maintainer="Vylen Linux Team"

name=gobject-introspection
version=1.86.0
release=2

glib_version="$(emerald info --field=version glib)"

source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz
    https://download.gnome.org/sources/glib/${glib_version%.*}/glib-${glib_version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dglib_src_dir="${SRC}/glib-${glib_version}"
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
