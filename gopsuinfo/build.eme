#!/bin/sh

# shellcheck disable=SC2034
description="A gopsutil-based command to display customizable system info, intended for nwg-panel or Tint2"
homepage="https://github.com/nwg-piotr/gopsuinfo"
maintainer="Vylen Linux Team"

name=gopsuinfo
version=0.1.9
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    # shellcheck disable=SC2035
    go build -o "bin/${name}" *.go

    install -Dm644 icons_light/* -t "${PKG}/usr/share/${name}/icons_light/"
    install -Dm644 icons_dark/* -t "${PKG}/usr/share/${name}/icons_dark/"
    install -Dm755 "bin/${name}" -t "${PKG}/usr/bin/"
}
