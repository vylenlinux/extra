#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Mouse server for the console and xterm"
homepage="https://www.nico.schottelius.org/software/gpm/"
maintainer="Vylen Linux Team"

name=gpm
version=1.20.7
release=2

source="https://www.nico.schottelius.org/software/${name}/archives/${name}-${version}.tar.bz2
    gpm-1.20.7-consolidated-1.patch
    gpm.sh"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/gpm-1.20.7-consolidated-1.patch"

    # fix build with gcc-15
    export CFLAGS="${CLFAGS} -std=gnu17"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install

    ln -sfv libgpm.so.2.1.0 "${PKG}/usr/lib/libgpm.so"
    install -v -m644 conf/gpm-root.conf "${PKG}/etc"

    install -Dm644 "${SRC}/gpm.sh" -t "${PKG}/etc/profile.d/"
    runit_add "${name}"
}
