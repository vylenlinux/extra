description="Rendering engine for graphite fonts"
homepage="https://github.com/silnrsi/graphite"
maintainer="Vylen Linux Team"

name=graphite2
version=1.3.14
release=1
source="https://github.com/silnrsi/graphite/releases/download/$version/$name-$version.tgz
	graphite2-1.3.14-gcc15.patch"

build() {
	cd $name-$version

	patch -Np1 -i $SRC/graphite2-1.3.14-gcc15.patch

  	sed -i '/cmptest/d' tests/CMakeLists.txt

	cmake -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
