#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Graph visualization software"
homepage="https://www.graphviz.org/"
maintainer="Vylen Linux Team"

name=graphviz
version=14.1.4
release=1
source="https://gitlab.com/graphviz/graphviz/-/archive/${version}/${name}-${version}.tar.bz2"

build() {
	# shellcheck disable=SC2164
	cd "${name}-${version}"
	./autogen.sh NOCONFIG

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --disable-perl \
        --disable-python \
        --enable-python3=yes

    make
    make DESTDIR="${PKG}" install

    mv -f "${PKG}/usr/lib64"/* "${PKG}/usr/lib/"
    rm -rf "${PKG}/usr/lib64"
}
