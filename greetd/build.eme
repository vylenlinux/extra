#!/bin/sh

# shellcheck disable=SC2034
description="Generic greeter daemon"
homepage="https://git.sr.ht/~kennylevinsen/greetd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=greetd
version=0.10.3
release=1
backup="etc/${name}/config.toml"
source="${name}-${version}.tar.gz::https://git.sr.ht/~kennylevinsen/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo fetch \
        --locked \
        --target "$(rustc --print host-tuple)"

    cargo build \
        --frozen \
        --release \
        --all-features

    make -C man all

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
    install -Dm755 target/release/agreety -t "${PKG}/usr/bin/"

	install -Dm644 "${name}.service" -t "${PKG}/usr/lib/systemd/system/"
	install -Dm644 config.toml -t "${PKG}/etc/${name}/"

	make -C man DESTDIR="${PKG}" PREFIX=/usr install

    do_pam "${name}"
    do_sysusers "${name}"
}
