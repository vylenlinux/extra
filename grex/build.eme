#!/bin/sh

# shellcheck disable=SC2034
description="A command-line tool for generating regular expressions from user-provided input strings"
homepage="https://github.com/pemistahl/grex"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=grex
version=1.4.6
release=1
source="${name}-${version}.tar.gz::https://github.com/pemistahl/${name}/archive/v${version}.tar.gz"

build() {
	# shellcheck disable=SC2164
	cd "${name}-${version}"
	cargo fetch --locked

	cargo build \
	    --frozen \
	    --release

	install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
	install -Dm644 README.md -t "${PKG}/usr/share/${name}/"
}
