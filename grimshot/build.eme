#!/bin/sh

# shellcheck disable=SC2034
description="A helper for screenshots within sway"
homepage="https://github.com/OctopusET/sway-contrib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=grimshot
version=1.12
release=1
source="sway-contrib-${version}.tar.gz::https://github.com/OctopusET/sway-contrib/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "sway-contrib-${version}/${name}"

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "${name}.1" -t "${PKG}/usr/share/man/man1/"
}
