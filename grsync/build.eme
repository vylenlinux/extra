#!/bin/sh

# shellcheck disable=SC2034
description="GTK+ GUI for rsync to synchronize folders, files and make backups"
homepage="https://www.opbyte.it/grsync/"
maintainer="Vylen Linux Team"

name=grsync
version=1.3.1
release=1
source="https://www.opbyte.it/release/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-unity

    make
    make DESTDIR="${PKG}" install
}
