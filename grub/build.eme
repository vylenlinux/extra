#!/bin/sh

# shellcheck disable=SC2034
description="GNU GRand Unified Bootloader"
homepage="https://www.gnu.org/software/grub/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=grub
version=2.16
release=1
backup="etc/default/${name}"

source="https://gitlab.freedesktop.org/api/v4/projects/26558/packages/generic/source-assets/${name}-${version}/${name}-${version}.tar.xz
    initrd.patch
    ${name}.default
    ${name}.cfg
    extra_deps.lst"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # Unset any environment variables which may affect the build
    unset CFLAGS \
        CPPFLAGS \
        CXXFLAGS \
        LDFLAGS

    patch -Np1 -i "${SRC}/initrd.patch"

    # Add a file missing from the release tarball
    install -Dm644 "${SRC}/extra_deps.lst" -t grub-core/

    # Fix os name
    sed 's|GNU/Linux|Linux|' -i util/grub.d/10_linux.in

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --disable-efiemu \
        --disable-werror \
        --enable-device-mapper \
        --enable-grub-mount

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.default" "${PKG}/etc/default/${name}"
    install -Dm644 "${SRC}/${name}.cfg" -t "${PKG}/usr/share/${name}/"
}
