#!/bin/sh

# shellcheck disable=SC2034
description="GNU GRand Unified Bootloader"
homepage="https://www.gnu.org/software/grub/"
maintainer="Vylen Linux Team"

name=grub
version=2.14
release=1

source="https://ftp.gnu.org/gnu/${name}/${name}-${version}.tar.xz
    initrd.patch
    ${name}.default
    ${name}.cfg"

backup="etc/default/${name}"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # Unset any environment variables which may affect the build
    unset CFLAGS \
        CPPFLAGS \
        CXXFLAGS \
        LDFLAGS

    patch -Np1 -i "${SRC}/initrd.patch"

	# Add a file missing from the release tarball
	printf "depends bli part_gpt\n" > grub-core/extra_deps.lst

    # Fix os name
    sed 's|GNU/Linux|Linux|' -i "util/grub.d/10_linux.in"

    ./configure \
        --prefix=/usr \
        --sbindir=/sbin \
        --sysconfdir=/etc \
        --disable-efiemu \
        --disable-werror \
        --enable-device-mapper \
        --enable-grub-mount

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.default" "${PKG}/etc/default/${name}"
    cp "${SRC}/${name}.cfg" -t "${PKG}/usr/share/${name}/"
}
