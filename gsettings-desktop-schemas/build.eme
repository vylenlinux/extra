#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Collection of GSettings schemas for settings shared by various components of a GNOME Desktop"
homepage="https://www.gnome.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gsettings-desktop-schemas
version=51.0
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    sed -i -r 's:"(/system):"/org/gnome\1:g' "${name}-${version}/schemas"/*.in

    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
