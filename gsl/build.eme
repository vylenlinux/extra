description="Numerical library for C and C++ programmers"
homepage="https://www.gnu.org/software/gsl/gsl.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gsl
version=2.8
release=1
source="https://ftp.gnu.org/gnu/gsl/$name-$version.tar.gz"

build() {
	cd $name-$version
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install

}
