description="A flexible API to implement the spell checking in a GTK+ application"
homepage="https://wiki.gnome.org/Projects/gspell"
maintainer="Vylen Linux Team"

name=gspell
version=1.14.2
release=1
source="https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2"

build() {
	vylen-meson $name-$version build \
		-Dgtk_doc=false \
		-Dtests=false \
		-Dinstall_tests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
