#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A set of plug-ins considered by the GStreamer developers to have good quality code, correct functionality, and the preferred license"
homepage="https://gstreamer.freedesktop.org/"
maintainer="Vylen Linux Team"

name=gst-plugins-good
version=1.28.7
release=1
source="https://gstreamer.freedesktop.org/src/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddoc=disabled \
        -Dpackage-name="GStreamer Good Plugins ${version} (Vylen Linux)"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
