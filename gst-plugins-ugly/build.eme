#!/bin/sh

# shellcheck disable=SC2034
description="A set of plug-ins considered by the GStreamer developers to have good quality and correct functionality, but distributing them might pose problems"
homepage="https://gstreamer.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gst-plugins-ugly
version=1.29.2
release=1
source="https://gstreamer.freedesktop.org/src/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddoc=disabled \
        -Dgpl=enabled \
        -Dpackage-name="GStreamer Ugly Plugins ${version} (Vylen Linux)"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
