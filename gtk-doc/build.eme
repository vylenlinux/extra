#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Documentation tool for public library API"
homepage="https://www.gtk.org/gtk-doc/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gtk-doc
version=1.37.0
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.bz2"

KEEP_DOC=yes

build() {
    vylen-meson "${name}-${version}" build \
        -Dyelp_manual=false \
        -Dtests=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
