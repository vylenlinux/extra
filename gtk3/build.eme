#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Libraries used for creating graphical user interfaces for applications"
homepage="https://archlinux.org/packages/extra/x86_64/gtk3/"
maintainer="Vylen Linux Team"

name=gtk3
version=3.24.52
release=1
source="${name}-${version}.tar.gz::https://gitlab.gnome.org/GNOME/gtk/-/archive/${version}/gtk-${version}.tar.gz"

build() {
    vylen-meson gtk-$version build \
        -Dbroadway_backend=true \
        -Dcolord="$(emerald isinstalled colord && echo "yes" || echo "no")" \
        -Dwayland_backend="$(emerald isinstalled libxkbcommon && emerald isinstalled wayland-protocols && printf "true" || printf "false")" \
        -Dman=false \
        -Dgtk_doc=false \
        -Dexamples=false \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Ddemos=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    cat > "${PKG}/etc/gtk-3.0/settings.ini" <<"EOF"
[Settings]
gtk-icon-theme-name = Adwaita
gtk-theme-name = Adwaita
gtk-font-name = Cantarell 10
EOF
}
