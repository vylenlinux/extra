#!/bin/sh

# shellcheck disable=SC2034
description="Libraries used for creating graphical user interfaces for applications"
homepage="https://gitlab.gnome.org/GNOME/gtk"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gtk3
version=3.24.52
release=2

source="${name}-${version}.tar.gz::https://gitlab.gnome.org/GNOME/gtk/-/archive/${version}/gtk-${version}.tar.gz
    settings.ini"

build() {
    vylen-meson gtk-$version build \
        -Dbroadway_backend=true \
        -Dcolord="$(emerald is-installed colord && echo "yes" || echo "no")" \
        -Dwayland_backend=true \
        -Dman=false \
        -Dgtk_doc=false \
        -Dexamples=false \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Ddemos=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 "${SRC}/settings.ini" -t "${PKG}/etc/gtk-3.0/"
}
