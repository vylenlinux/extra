#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A multi-platform toolkit for creating graphical user interfaces, version 4"
homepage="https://www.gtk.org/"
maintainer="Vylen Linux Team"

name=gtk4
version=4.22.3
release=1
source="${name}-${version}.tar.bz2::https://gitlab.gnome.org/GNOME/gtk/-/archive/${version}/gtk-${version}.tar.bz2"

build() {
    export XML_CATALOG_FILES=/etc/xml/catalog

    vylen-meson "gtk-${version}" build \
        -Dbroadway-backend=true \
        -Dwayland-backend="$(emerald isinstalled wayland-protocols && printf "true" || printf "false")" \
        -Dintrospection=enabled \
        -Dman-pages=false \
        -Dbuild-tests=false \
        -Dbuild-testsuite=false \
        -Dbuild-examples=false \
        -Dbuild-demos=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
