#!/bin/sh

# shellcheck disable=SC2034
description="Userspace virtual filesystem designed to work with the I/O abstractions of GLib's GIO library"
homepage="https://gitlab.gnome.org/GNOME/gvfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gvfs-nfs
version=1.62.0
release=1
source="https://download.gnome.org/sources/gvfs/${version%.*}/gvfs-${version}.tar.xz"

build() {
    vylen-meson "gvfs-${version}" build \
        -Dafc=false \
        -Dbluray=false \
        -Dcdda=false \
        -Ddnssd=false \
        -Dgoa=false \
        -Dgoogle=false \
        -Dgphoto2=false \
        -Dmtp=false \
        -Dnfs=true \
        -Donedrive=false \
        -Dsftp=false \
        -Dsmb=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # Remove gvfs conflicts
    for f in $(emerald files gvfs | grep -v /$); do
        rm "${PKG}/${f}" || true
    done

    for d in $(emerald files gvfs | grep /$ | tac); do
        rmdir "${PKG}/${d}" || true
    done
}
