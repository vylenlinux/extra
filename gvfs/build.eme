#!/bin/sh

# shellcheck disable=SC2034
description="Userspace virtual filesystem designed to work with the I/O abstractions of GLib's GIO library"
homepage="https://gitlab.gnome.org/GNOME/gvfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gvfs
version=1.60.2
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dafc=false \
        -Dbluray=false \
        -Dcdda=false \
        -Ddnssd=false \
        -Dgoa=false \
        -Dgoogle=false \
        -Dgphoto2=false \
        -Dlogind=false \
        -Dmtp=false \
        -Dnfs=false \
        -Donedrive=false \
        -Dsftp=false \
        -Dsmb=false \
        -Dsystemduserunitdir=no \
        -Dtmpfilesdir=no

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    do_revdep
}
