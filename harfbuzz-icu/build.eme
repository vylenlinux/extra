#!/bin/sh

# shellcheck disable=SC2034
description="OpenType text shaping engine (ICU integration)"
homepage="https://harfbuzz.github.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=harfbuzz-icu
version=15.1.0
release=1
source="https://github.com/harfbuzz/harfbuzz/releases/download/${version}/harfbuzz-${version}.tar.xz"

build() {
    vylen-meson "harfbuzz-${version}" build \
        -Ddocs=disabled \
        -Dgraphite=auto \
        -Dbenchmark=disabled \
        -Dcpp_std=c++17

    meson compile -C build
    DESTDIR="${PWD}/DESTDIR" meson install --no-rebuild -C build

    mkdir -p "${PKG}/usr/lib/pkgconfig" \
        "${PKG}/usr/include/harfbuzz"

    mv DESTDIR/usr/include/harfbuzz/hb-icu.h -t "${PKG}/usr/include/harfbuzz/"
    mv DESTDIR/usr/lib/libharfbuzz-icu* -t "${PKG}/usr/lib/"
    mv DESTDIR/usr/lib/pkgconfig/harfbuzz-icu.pc -t "${PKG}/usr/lib/pkgconfig/"
}
