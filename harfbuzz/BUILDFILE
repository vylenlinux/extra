#!/usr/bin/env sh

# shellcheck disable=SC2034
description="OpenType text shaping engine"
homepage="https://harfbuzz.github.io/"
maintainer="Vylen Linux Team"

name=harfbuzz
version=13.2.0
release=1
source="https://github.com/${name}/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -D docs=disabled \
        -D graphite=auto \
        -D benchmark=disabled \
        -D icu=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm -f "${PKG}/usr/include/${name}/hb-icu.h"
    rm -f "${PKG}/usr/lib"/libharfbuzz-icu*
    rm -f "${PKG}/usr/lib/pkgconfig/${name}-icu.pc"
}
