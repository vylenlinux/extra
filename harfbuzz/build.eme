#!/bin/sh

# shellcheck disable=SC2034
description="OpenType text shaping engine"
homepage="https://harfbuzz.github.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=harfbuzz
version=15.1.0
release=1
source="https://github.com/${name}/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddocs=disabled \
        -Dgraphite=auto \
        -Dbenchmark=disabled \
        -Dicu=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # moved to harfbuzz-icu
    rm -f \
        "${PKG}/usr/include/${name}/hb-icu.h" \
        "${PKG}/usr/lib"/libharfbuzz-icu* \
        "${PKG}/usr/lib/pkgconfig/${name}-icu.pc"
}
