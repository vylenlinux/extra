#!/bin/sh

# shellcheck disable=SC2034
description="Video player built with Qt/QML on top of libmpv"
homepage="https://apps.kde.org/haruna/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=haruna
version=1.9.0
release=1
source="https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
