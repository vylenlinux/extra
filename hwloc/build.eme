#!/bin/sh

# shellcheck disable=SC2034
description="Portable Hardware Locality is a portable abstraction of hierarchical architectures"
homepage="https://www.open-mpi.org/projects/hwloc"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=hwloc
version=2.14.0
release=1
source="https://www.open-mpi.org/software/${name}/v${version%.*}/downloads/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --enable-plugins \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install
}
