#!/bin/sh

# shellcheck disable=SC2034
description="Library for high quality hyphenation and justification"
homepage="https://hunspell.sf.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=hyphen
version=2.8.10
release=1
source="https://github.com/hunspell/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
	# shellcheck disable=SC2164
	cd "${name}-${version}"

	./configure \
        --prefix=/usr \
        --disable-static

	make
	make DESTDIR="${PKG}" install
}
