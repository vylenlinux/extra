#!/bin/sh

# shellcheck disable=SC2034
description="Define blocks for your i3bar status line"
homepage="https://github.com/vivien/i3blocks"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=i3blocks
version=1.5
release=1
backup="etc/${name}.conf"
source="${name}-${version}.tar.gz::https://github.com/vivien/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install
}
