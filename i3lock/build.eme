#!/bin/sh

# shellcheck disable=SC2034
description="Improved screenlocker based upon XCB and PAM"
homepage="https://i3wm.org/i3lock"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=i3lock
version=2.16
release=1

source="https://i3wm.org/${name}/${name}-${version}.tar.xz
    pam-config.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/pam-config.patch"

    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
