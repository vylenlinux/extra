#!/bin/sh

# shellcheck disable=SC2034
description="Generates status bar to use with i3bar, dzen2 or xmobar"
homepage="https://i3wm.org/i3status/"
maintainer="Vylen Linux Team"

name=i3status
version=2.15
release=1
backup="etc/${name}.conf"
source="https://i3wm.org/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dmans=true
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
