#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Provides data for network services and protocols"
homepage="https://www.iana.org/protocols"
maintainer="Vylen Linux Team"

name=iana-etc
version=20260530
release=1

source="services
    protocols"

build() {
    install -Dm644 services  -t "${PKG}/etc/"
    install -Dm644 protocols -t "${PKG}/etc/"
}
