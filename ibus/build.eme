#!/bin/sh

# shellcheck disable=SC2034
description="Intelligent Input Bus"
homepage="https://github.com/ibus/ibus/wiki"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ibus
version=1.5.35_rc1
release=1

_version="$(printf '%s' "${version}" | tr '_' '-')"

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${_version}.tar.gz
    fix-deprecated-gschema-key.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${_version}"

    patch -Np1 -i "${SRC}/fix-deprecated-gschema-key.patch"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --libexecdir="/usr/lib/${name}" \
        --disable-memconf \
        --disable-gtk4 \
        --disable-gtk2 \
        --disable-emoji-dict \
        --disable-unicode-dict \
        --disable-systemd-services

    rm -f tools/main.c

    make
    make DESTDIR="${PKG}" install
}
