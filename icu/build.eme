#!/bin/sh

# shellcheck disable=SC2034
description="International Components for Unicode library"
homepage="https://icu.unicode.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=icu
version=79.1
release=1
source="${name}-${version}.tar.gz::https://github.com/unicode-org/${name}/archive/refs/tags/release-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-release-${version}/icu4c/source"

    # icu tries to use clang by default
    export CC=gcc
    export CXX=g++

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --disable-samples \
        --disable-tests

    make
    make DESTDIR="${PKG}" install
}
