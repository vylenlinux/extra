description="International Components for Unicode library"
homepage="https://icu.unicode.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=icu
version=78.3
vrsn=$(printf "$version" | sed 's/\./-/g')
release=1
source="$name-$version.tar.gz::https://github.com/unicode-org/icu/archive/refs/tags/release-$version.tar.gz"

build() {
	# icu tries to use clang by default
	export CC=gcc CXX=g++

	cd $name-release-$version/icu4c/source

	./configure \
		--prefix=/usr \
		--disable-samples \
		--disable-tests
	make
	make DESTDIR=$PKG install
}
