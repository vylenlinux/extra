#!/bin/sh

# shellcheck disable=SC2034
description="ImageMagick is a collection of tools and libraries to read, write, and manipulate an image in various image formats"
homepage="https://imagemagick.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=imagemagick
version=7.1.2.35
release=1

_version="${version%.*}-${version##*.}"
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${_version}.tar.gz"

KEEP_LIBTOOL=yes

build() {
    # shellcheck disable=SC2164
    cd "ImageMagick-${_version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --enable-hdri \
        --with-modules \
        --with-perl \
        --disable-static \
        --without-openexr

    make
    make DESTDIR="${PKG}" install
}
