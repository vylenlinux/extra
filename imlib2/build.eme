#!/bin/sh

# shellcheck disable=SC2034
description="Graphics library for fast file loading, saving, rendering and manipulation"
homepage="https://sourceforge.net/projects/enlightenment/"
maintainer="Vylen Linux Team"

name=imlib2
version=1.12.7
release=1
source="https://sourceforge.net/projects/enlightenment/files/${name}-src/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
