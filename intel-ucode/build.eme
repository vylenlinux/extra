#!/bin/sh

# shellcheck disable=SC2034
description="microcode update files for intel CPUs"
homepage="https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=intel-ucode
version=20261110
release=1
source="${name}-${version}.tar.gz::https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/archive/microcode-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Intel-Linux-Processor-Microcode-Data-Files-microcode-${version}"

    rm -f intel-ucode/list \
        intel-ucode-with-caveats/list

    mkdir -p kernel/x86/microcode

    iucode_tool --write-earlyfw=intel-ucode.img \
        intel-ucode/ \
        intel-ucode-with-caveats/

    install -Dm644 intel-ucode.img -t "${PKG}/boot/"
}
