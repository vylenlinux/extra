#!/bin/sh

# shellcheck disable=SC2034
description="Top like program to display I/O load."
homepage="https://github.com/Tomas-M/iotop"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iotop
version=1.31
release=1
source="${name}-${version}.tar.gz::https://github.com/Tomas-M/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    make DESTDIR="${PKG}" BINDIR="${PKG}/usr/bin" install
}
