#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Programs for basic and advanced IPV4-based networking"
homepage="https://git.kernel.org/pub/scm/network/iproute2/iproute2.git"
maintainer="Vylen Linux Team"

name=iproute2
version=7.0.0
release=1
source="${name}-${version}.tar.xz::https://www.kernel.org/pub/linux/utils/net/${name}/${name}-v${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"

    make
    make DESTDIR="${PKG}" install
}
