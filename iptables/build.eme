#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The principal firewall tool for Linux (using nft interface)"
homepage="https://www.netfilter.org/projects/iptables/index.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iptables
version=1.8.13
release=3
source="https://www.netfilter.org/projects/${name}/files/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/sbin \
        --enable-libipq \
        --enable-nftables

    make
    make DESTDIR="${PKG}" install

    ln -sf iptables-nft "${PKG}/sbin/iptables"
}
