#!/bin/sh

# shellcheck disable=SC2034
description="List of country, language and currency names"
homepage="https://salsa.debian.org/iso-codes-team/iso-codes"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iso-codes
version=4.20.1
release=1
source="${name}-${version}.tar.xz::https://deb.debian.org/debian/pool/main/i/${name}/${name}_${version}.orig.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
