#!/bin/sh

# shellcheck disable=SC2034
description="Tool to manipulate intel IA-32/X86-64 microcode bundles"
homepage="https://gitlab.com/iucode-tool/iucode-tool/wikis/home"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iucode-tool
version=2.3.1
release=1
source="${name}-${version}.tar.gz::https://gitlab.com/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install
}
