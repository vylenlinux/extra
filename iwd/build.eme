#!/bin/sh

# shellcheck disable=SC2034
description="Wireless daemon for Linux"
homepage="https://iwd.wiki.kernel.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=iwd
version=3.12
release=1
source="https://www.kernel.org/pub/linux/network/wireless/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/bin \
        --localstatedir=/var \
        --sysconfdir=/etc \
        --enable-external-ell \
        --enable-wired \
        --enable-ofono \
        --enable-hwsim \
        --disable-tools

    make
    make DESTDIR="${PKG}" install
}
