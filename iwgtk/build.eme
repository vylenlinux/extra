#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight GTK frontend for iwd (WiFi)"
homepage="https://github.com/J-Lentz/iwgtk"
maintainer="Vylen Linux Team"

name=iwgtk
version=0.9
release=1
source="${name}-${version}.tar.gz::https://github.com/J-Lentz/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
