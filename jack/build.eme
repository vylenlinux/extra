#!/bin/sh

# shellcheck disable=SC2034
description="A low-latency audio server"
homepage="https://github.com/jackaudio/jack2"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jack
version=1.9.22
release=1

source="https://github.com/jackaudio/jack2/archive/v${version}/${name}-${version}.tar.gz
    waf-escape-seq.patch
    waf-imp.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}2-$version"

    patch -Np1 -i "${SRC}/waf-escape-seq.patch"
    patch -Np1 -i "${SRC}/waf-imp.patch"

    ./waf configure \
        --prefix=/usr \
        --mandir=/usr/share/man/man1 \
        --libdir=/usr/lib \
        --autostart=none \
        --dbus \
        --classic \
        --systemd-unit

    ./waf build
    ./waf --destdir="${PKG}" install
}
