#!/bin/sh

# shellcheck disable=SC2034
description="A low-latency audio server"
homepage="https://github.com/jackaudio/jack2"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jack
version=1.9.22
release=1
backup="etc/security/limits.d/99-audio.conf"

source="https://github.com/jackaudio/jack2/archive/v${version}/${name}-${version}.tar.gz
    99-audio.conf
    40-hpet-permissions.rules
    waf-escape-seq.patch
    waf-imp.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}2-$version"

    patch -Np1 -i "${SRC}/waf-escape-seq.patch"
    patch -Np1 -i "${SRC}/waf-imp.patch"

    ./waf configure \
        --prefix=/usr \
        --mandir=/usr/share/man/man1 \
        --libdir=/usr/lib \
        --dbus \
        --alsa \
        --classic

    ./waf build
    ./waf --destdir="${PKG}" install

    install -Dm644 "${SRC}/99-audio.conf" -t "${PKG}/etc/security/limits.d/"
    install -Dm644 "${SRC}/40-hpet-permissions.rules" -t "${PKG}/usr/lib/udev/rules.d/"
}
