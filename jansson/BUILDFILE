description="C library for encoding, decoding and manipulating JSON data"
homepage="https://www.digip.org/jansson/"
maintainer="Vylen Linux Team"

name=jansson
version=2.15.0
release=1
source="https://github.com/akheron/jansson/releases/download/v$version/jansson-$version.tar.gz"

build() {
	cd $name-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}

