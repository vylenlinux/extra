#!/bin/sh

# shellcheck disable=SC2034
description="General-purpose scalable concurrent malloc implementation"
homepage="http://www.canonware.com/jemalloc/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jemalloc
version=5.4.0
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-cxx \
        --enable-prof \
        --enable-autogen

    make
    make DESTDIR="${PKG}" install
}
