#!/bin/sh

# shellcheck disable=SC2034
description="Administration and debugging tools for the jfs file system"
homepage="https://jfs.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jfsutils
version=1.1.15
release=1

source="https://jfs.sourceforge.net/project/pub/${name}-${version}.tar.gz
    inttypes.patch
    sysmacros.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    export CFLAGS="${CFLAGS} -fcommon"

    patch -Np1 -i "${SRC}/inttypes.patch"
    patch -Np1 -i "${SRC}/sysmacros.patch"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install
}
