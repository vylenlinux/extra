#!/bin/sh

# shellcheck disable=SC2034
description="A simple X11 menu intended to be use with openbox and tint2"
homepage="https://www.github.com/johanmalm/jgmenu"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jgmenu
version=4.7.1
release=1
source="https://github.com/johanmalm/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
