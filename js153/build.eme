#!/bin/sh

# shellcheck disable=SC2034
description="Mozilla's JavaScript and WebAssembly Engine, written in C++ and Rust"
homepage="https://spidermonkey.dev/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=js153
version=153.7.0
release=1

source="${name}-${version}.tar.xz::https://archive.mozilla.org/pub/firefox/releases/${version}esr/source/firefox-${version}esr.source.tar.xz
    mozjs128-128.6.0-fix_error_on_delete_declared_private.patch
    mozjs140-140.3.1-pc-does-not-contain-DXP_UNIX.patch
    mozjs153-153.0-icu_sources_data-Write-command-output-to-our-stderr.patch
    mozjs-91.8.0-init_patch.patch
    mozjs140-140.3.1-icu_sources_data.py-Decouple-from-Mozilla-build-system.patch
    mozjs153-153.0-emitter.patch
    mozjs-91.8.0-fix-soname.patch
    mozjs-91.8.0-spidermonkey_checks_disable.patch"

build() {
    # shellcheck disable=SC2164
    cd "firefox-${version}"

    patch -Np1 -i "${SRC}/mozjs128-128.6.0-fix_error_on_delete_declared_private.patch"
    patch -Np1 -i "${SRC}/mozjs140-140.3.1-pc-does-not-contain-DXP_UNIX.patch"
    patch -Np1 -i "${SRC}/mozjs153-153.0-icu_sources_data-Write-command-output-to-our-stderr.patch"
    patch -Np1 -i "${SRC}/mozjs-91.8.0-init_patch.patch"
    patch -Np1 -i "${SRC}/mozjs140-140.3.1-icu_sources_data.py-Decouple-from-Mozilla-build-system.patch"
    patch -Np1 -i "${SRC}/mozjs153-153.0-emitter.patch"
    patch -Np1 -i "${SRC}/mozjs-91.8.0-fix-soname.patch"
    patch -Np1 -i "${SRC}/mozjs-91.8.0-spidermonkey_checks_disable.patch"

    mkdir obj
    # shellcheck disable=SC2164
    cd obj

    ../js/src/configure \
        --prefix=/usr \
        --with-intl-api \
        --with-system-zlib \
        --with-system-icu \
        --disable-jemalloc \
        --disable-debug-symbols \
        --enable-readline

    make
    make DESTDIR="${PKG}" install

    rm "${PKG}/usr/lib/libjs_static.ajs"
    sed '/@NSPR_CFLAGS@/d' -i "${PKG}/usr/bin/${name}-config"
}
