description="library providing serialization and deserialization support for the JavaScript Object Notation (JSON) format"
homepage="https://gnome.pages.gitlab.gnome.org/json-glib/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=json-glib
version=1.10.8
release=1
source="https://gitlab.gnome.org/GNOME/json-glib/-/archive/$version/$name-$version.tar.gz"

build() {
	cd $name-$version
	vylen-meson \
	--libexecdir=/usr/lib/$name \
	-Dgtk_doc=disabled \
	-Dtests=false \
	build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
