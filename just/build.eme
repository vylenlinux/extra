#!/bin/sh

# shellcheck disable=SC2034
description="A handy way to save and run project-specific commands"
homepage="https://github.com/casey/just"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=just
version=1.59.0
release=1
source="${name}-${version}.tar.gz::https://github.com/casey/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo fetch --locked

    export CARGO_PROFILE_RELEASE_DEBUG=2
    export CARGO_PROFILE_RELEASE_STRIP=false
    export CARGO_PROFILE_RELEASE_LTO=true
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
    export CARGO_PROFILE_RELEASE_OPT_LEVEL=3

    cargo build \
        --frozen \
        --release

    install -dm755 "${PKG}/usr/share/man/man1"

    cargo run \
        --frozen \
        --release \
        -- \
        --man \
    > "${PKG}/usr/share/man/man1/${name}.1"

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "completions/${name}.bash" "${PKG}/usr/share/bash-completion/completions/${name}"
    install -Dm644 "completions/${name}.fish" -t "${PKG}/usr/share/fish/vendor_completions.d/"
    install -Dm644 "completions/${name}.zsh" "${PKG}/usr/share/zsh/site-functions/_${name}"
}
