#!/bin/sh

# shellcheck disable=SC2034
description="Open source implementation of jpegxr"
homepage="https://github.com/mircomir/jxrlib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jxrlib
version=1.4.6
release=1

source="${name}-${version}.tar.gz::https://github.com/mircomir/${name}/archive/refs/tags/${version}.tar.gz
    wmspecstringce.h"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    install -Dm644 "${SRC}/wmspecstringce.h" -t common/include/

    sed \
        -e "s|^CC=cc|CC=cc ${CFLAGS} ${LDFLAGS}|" \
        -e "s|@python|@python3|" \
    -i Makefile

    make SHARED=1 DIR_INSTALL=/usr
    make SHARED=1 DIR_INSTALL="${PKG}/usr" install

    sed -i 's|^prefix=.*|prefix=/usr|' "${PKG}/usr/lib/pkgconfig/libjxr.pc"
}
