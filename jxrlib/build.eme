#!/bin/sh

# shellcheck disable=SC2034
description="Open source implementation of jpegxr"
homepage="https://archive.codeplex.com/?p=jxrlib"
maintainer="Vylen Linux Team"

name=jxrlib
version=1.4.2
release=1

source="${name}-${version}.tar.gz::https://github.com/mircomir/${name}/archive/refs/tags/${version}.tar.gz
    CMakeLists.txt"

build() {
    export CFLAGS="${CFLAGS} \
        -Wno-implicit-function-declaration \
        -Wno-incompatible-pointer-types"

    mv "${SRC}/CMakeLists.txt" -t "${name}-${version}/"

    cmake -S "${name}-${version}" -B build \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
