#!/bin/sh

# shellcheck disable=SC2034
description="Key-table files, console fonts, and keyboard utilities"
homepage="http://www.kbd-project.org/"
maintainer="Vylen Linux Team"

name=kbd
version=2.10.0
release=1

source="https://www.kernel.org/pub/linux/utils/${name}/${name}-${version}.tar.xz
    ${name}-backspace-1.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/${name}-backspace-1.patch"

    sed -i 's/\(RESIZECONS_PROGS=\)yes/\1no/g' configure
    sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in

    ./configure \
        --prefix=/usr \
        --disable-vlock \
        --disable-nls

    make
    make DESTDIR="${PKG}" install

    mkdir -p "${PKG}/bin"

    mv "${PKG}/usr/bin/dumpkeys" \
        "${PKG}/usr/bin/kbd_mode" \
        "${PKG}/usr/bin/loadkeys" \
        "${PKG}/usr/bin/setfont" \
        "${PKG}/bin"
}
