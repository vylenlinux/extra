#!/bin/sh

# shellcheck disable=SC2034
description="Dock Widgets Library by KDAB for Qt6"
homepage="https://github.com/KDAB/KDDockWidgets/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kddockwidgets
version=2.5.1
release=1
source="https://github.com/KDAB/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "KDDockWidgets-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DKDDockWidgets_FRONTENDS='qtwidgets;qtquick' \
        -DKDDockWidgets_QT6=true \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
