description="Dock Widgets Library by KDAB for Qt6"
homepage="https://github.com/KDAB/KDDockWidgets/"
maintainer="Vylen Linux Team"

name=kddockwidgets
version=2.4.0
release=1
source="https://github.com/KDAB/KDDockWidgets/releases/download/v$version/kddockwidgets-$version.tar.gz"

build() {
	cmake -S KDDockWidgets-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D KDDockWidgets_FRONTENDS='qtwidgets;qtquick' \
            -D KDDockWidgets_QT6=true \
            -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build

}
