#!/bin/sh

# shellcheck disable=SC2034
description="A non-linear video editor for Linux using the MLT video framework"
homepage="https://apps.kde.org/kdenlive/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kdenlive
version=26.08.3
release=1
source="https://download.kde.org/stable/release-service/${version}/src/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DKDE_INSTALL_PLUGINDIR=/usr/lib/qt6/plugins \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_RUN_QMLLINT=OFF \
        -DBUILD_TESTING=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
