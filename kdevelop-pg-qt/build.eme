#!/bin/sh

# shellcheck disable=SC2034
description="KDevelop Parser Generator, a LL(1) parser generator used by KDevelop language plugins"
homepage="https://invent.kde.org/kdevelop/kdevelop-pg-qt"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kdevelop-pg-qt
version=2.4.0
release=1
source="${name}-${version}.tar.gz::https://invent.kde.org/kdevelop/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cmake -S "${name}-v${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
