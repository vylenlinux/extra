#!/bin/sh

# shellcheck disable=SC2034
description="utility to manage SSH and GPG keys in a convenient and secure manner"
homepage="https://www.funtoo.org/Keychain"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=keychain
version=3.0.9
release=1
source="${name}-${version}.tar.gz::https://github.com/funtoo/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    install -Dm755 "${name}.pyz" "${PKG}/usr/bin/${name}"
}
