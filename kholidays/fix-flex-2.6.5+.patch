From: Vylen Linux Team <wonkru-dev@proton.me>
Date: Fri, 13 Nov 2026 21:00:30 +0100
Subject: [PATCH] Fix kholidays scanner build with Flex 2.6.5 and newer

---
 src/parsers/plan2/FlexLexer.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/parsers/plan2/FlexLexer.h b/src/parsers/plan2/FlexLexer.h
--- a/src/parsers/plan2/FlexLexer.h
+++ b/src/parsers/plan2/FlexLexer.h
@@ -104,6 +104,7 @@ class yyFlexLexer : public FlexLexer
     void yypush_buffer_state(yy_buffer_state *new_buffer);
     void yypop_buffer_state();

+    virtual int yyread(char *buf, size_t);
     int yylex() override;
     void switch_streams(std::istream &new_in, std::ostream &new_out) override;
     void switch_streams(std::istream *new_in = nullptr, std::ostream *new_out = nullptr) override;
@@ -115,7 +116,7 @@ class yyFlexLexer : public FlexLexer
     virtual int LexerInput(char *buf, int max_size);
     virtual void LexerOutput(const char *buf, int size);
     virtual void LexerError(const char *msg);

-    void yyunput(int c, char *buf_ptr);
+    void yyunput_r(int c, char *buf_ptr);
     int yyinput();

     void yy_load_buffer_state();
