#!/usr/bin/env sh

# shellcheck disable=SC2034
description="MIT Kerberos V5 is a network authentication protocol"
homepage="https://web.mit.edu/kerberos/"
maintainer="Vylen Linux Team"

name=krb5
version=1.22.2
release=2

_version="$(printf "%s" "${version}" | awk -F. '{print $1"."$2}')"

source="https://kerberos.org/dist/${name}/$(printf "%s" "${version}" | awk -F. '{printf "%s.%s", $1, $2;}')/${name}-${version}.tar.gz
    mitkrb-${version}-upstream_fix-1.patch
    ${name}-${version}-openssl4.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}/src"

    patch -Np2 -i "${SRC}/mitkrb-1.22.2-upstream_fix-1.patch"
    patch -Np2 -i "${SRC}/${name}-${version}-openssl4.patch"

    # increases the width of the virtual terminal used for some tests to
    # prevent some spurious text in the output which is taken as a failure
    sed -i -e '/eq 0/{N;s/12 //}' plugins/kdb/db2/libdb2/test/run.test
    # autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var/lib \
        --runstatedir=/run \
        --with-system-et \
        --with-system-ss \
        --with-system-verto=no \
        --enable-dns-for-realm \
        --disable-nls \
        --without-tcl \
        --disable-rpath

    make
    make DESTDIR="${PKG}" install

    mkdir -p "${PKG}/lib"
    mv "${PKG}/usr/lib"/libkrb5.so.3* "${PKG}/lib"
    mv "${PKG}/usr/lib"/libk5crypto.so.3* "${PKG}/lib"
    mv "${PKG}/usr/lib"/libkrb5support.so.0* "${PKG}/lib"

    ln -sf ../../lib/libkrb5.so.3.3 "${PKG}/usr/lib/libkrb5.so"
    ln -sf ../../lib/libk5crypto.so.3.1 "${PKG}/usr/lib/libk5crypto.so"
    ln -sf ../../lib/libkrb5support.so.0.1 "${PKG}/usr/lib/libkrb5support.so"

    mkdir -p "${PKG}/bin"
    mv "${PKG}/usr/bin/ksu" "${PKG}/bin"

    rm -rf "${PKG}/usr/share/examples" \
        "${PKG}/usr/share/man"/cat* \
        "${PKG}/run"
}
