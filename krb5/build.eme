#!/bin/sh

# shellcheck disable=SC2034
description="MIT Kerberos V5 is a network authentication protocol"
homepage="https://web.mit.edu/kerberos/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=krb5
version=1.22.3
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${name}-${version}-final.tar.gz
    ${name}-${version}-autoconf-2.73.patch
    ${name}-${version}-openssl4-k5tls.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${name}-${version}-final/src"

    patch -Np2 -i "${SRC}/${name}-${version}-autoconf-2.73.patch"
    patch -Np2 -i "${SRC}/${name}-${version}-openssl4-k5tls.patch"

    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --localstatedir=/var/lib \
        --runstatedir=/run \
        --with-system-et \
        --with-system-ss \
        --with-system-verto=no \
        --enable-dns-for-realm \
        --disable-nls \
        --without-tcl \
        --disable-rpath

    make
    make DESTDIR="${PKG}" install

    do_service "${name}-kadmind" \
        "${name}-kdc" \
        "${name}-kpropd"

    install -Dm644 "config-files/${name}.conf" -t "${PKG}/etc/"
    install -Dm644 config-files/kdc.conf -t "${PKG}/var/lib/krb5kdc/"
    install -Dm644 util/ac_check_krb5.m4 -t "${PKG}/usr/share/aclocal/"

    rm -rf "${PKG}/usr/share/examples" \
        "${PKG}/usr/share/man"/cat* \
        "${PKG}/run"
}
