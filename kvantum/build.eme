#!/bin/sh

# shellcheck disable=SC2034
description="Theme engine for Qt4/Qt5 and KDE"
homepage="https://github.com/tsujan/Kvantum/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kvantum
version=1.1.9
release=1
source="${name}-${version}.tar.gz::https://github.com/tsujan/${name}/archive/V${version}/Kvantum-v${version}.tar.gz"

build() {
    cmake -S "Kvantum-${version}/Kvantum" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
