#!/bin/sh

# shellcheck disable=SC2034
description="Small-footprint color management engine, with special focus on accuracy and performance"
homepage="https://www.littlecms.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lcms2
version=2.20
release=1
source="https://github.com/mm2/Little-CMS/releases/download/lcms${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
