#!/bin/sh

# shellcheck disable=SC2034
description="Terminal file manager"
homepage="https://github.com/gokcehan/lf"
maintainer="Vylen Linux Team"

name=lf
version=42
release=1
source="${name}-${version}.tar.gz::https://github.com/gokcehan/${name}/archive/r${version}/${name}-r${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-r${version}"

    go mod tidy
    go build -o "bin/${name}"

    install -Dm755 "bin/${name}" -t "${PKG}/usr/bin/"
}
