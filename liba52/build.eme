description="Free library for decoding ATSC A/52 (also known as AC-3) streams"
homepage="https://git.adelielinux.org/community/a52dec/"
maintainer="Vylen Linux Team"

name=liba52
version=0.8.0
release=1
source="$name-$version.tar.gz::https://distfiles.adelielinux.org/source/a52dec/a52dec-$version.tar.gz"

build() {
	cd a52dec-$version

	./configure --prefix=/usr \
		    --mandir=/usr/share/man \
		    --enable-shared \
		    --disable-static \
		    CFLAGS="-g -O2 -fPIC"
	make
	make DESTDIR=$PKG install

	cp liba52/a52_internal.h $PKG/usr/include/a52dec
}
