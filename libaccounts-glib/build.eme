#!/bin/sh

# shellcheck disable=SC2034
description="GLib-based client library for the accounts database"
homepage="https://gitlab.com/accounts-sso/libaccounts-glib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libaccounts-glib
version=1.27
release=1
source="${name}-${version}.tar.bz2::https://gitlab.com/accounts-sso/${name}/-/archive/VERSION_${version}/${name}-VERSION_${version}.tar.bz2"

build() {
    sed \
        -e '/docs/d' \
        -e '/tests/d' \
    -i "${name}-VERSION_${version}/meson.build"

    vylen-meson "${name}-VERSION_${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install -C build
}
