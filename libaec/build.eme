#!/bin/sh

# shellcheck disable=SC2034
description="Adaptive Entropy Coding library"
homepage="https://gitlab.dkrz.de/dkrz-sw/libaec"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libaec
version=1.1.8
release=1
source="${name}-${version}.tar.gz::https://gitlab.dkrz.de/dkrz-sw/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cmake -S "${name}-v${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DBUILD_STATIC_LIBS=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
