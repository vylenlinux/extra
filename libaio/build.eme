#!/bin/sh

# shellcheck disable=SC2034
description="The Linux-native asynchronous I/O facility (aio) library"
homepage="https://codeberg.org/jmoyer/libaio"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libaio
version=0.3.113
release=1
source="https://codeberg.org/jmoyer/${name}/releases/download/${name}-${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    make prefix="${PKG}/usr" install
}
