description="Reading/writing various compression formats"
homepage="https://libarchive.org/"
maintainer="Vylen Linux Team"

name=libarchive
version=3.8.6
release=1
source="https://libarchive.org/downloads/$name-$version.tar.xz"

build() {
	cd $name-$version
	
	autoreconf -fvi
	./configure \
		--prefix=/usr \
		--disable-bsdcat \
		--without-lz4 \
		--without-zstd \
		--without-nettle \
		--without-xml2 \
		--disable-static
	make
	make DESTDIR=$PKG install

	# Remove iconv from pc file
	sed -i "s/iconv//" "$PKG/usr/lib/pkgconfig/libarchive.pc"
}
