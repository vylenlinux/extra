#!/bin/sh

# shellcheck disable=SC2034
description="C library supporting GObject introspection for manipulation of block devices"
homepage="https://github.com/storaged-project/libblockdev/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libblockdev
version=3.6.0
release=1
source="https://github.com/storaged-project/${name}/releases/download/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-python3 \
        --without-escrow \
        --without-gtk-doc \
        --without-nvdimm \
        --without-dm

    make
    make DESTDIR="${PKG}" install
}
