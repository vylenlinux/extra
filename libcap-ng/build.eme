#!/bin/sh

# shellcheck disable=SC2034
description="A library for Linux that makes using posix capabilities easy"
homepage="https://people.redhat.com/sgrubb/libcap-ng/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libcap-ng
version=0.9.6
release=1
source="https://github.com/stevegrubb/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # make stupid autotools happy -_-
    touch NEWS
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --without-python \
        --without-python3 \
        --enable-static=no

    make
    make DESTDIR="${PKG}" install
}
