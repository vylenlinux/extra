#!/bin/sh

# shellcheck disable=SC2034
description="libclc is an implementation of the library requirements of the OpenCL C programming language"
homepage="https://libclc.llvm.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libclc
version=23.1.5
release=1

source="llvm-${version}.tar.xz::https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/llvm-project-${version}.src.tar.xz
    ${name}.pc"

build() {
    export CC=clang
    export CXX=clang++
    export AR=llvm-ar
    export NM=llvm-nm
    export RANLIB=llvm-ranlib

    multibuild_variants="spirv32-unknown-unknown
        spirv64-unknown-unknown
        spirv64-unknown-vulkan
        nvptx64-nvidia-cuda
        amdgcn-amd-amdhsa-llvm"

    for variant in ${multibuild_variants}; do
        cmake -S "llvm-project-${version}.src/${name}" -B "build/${variant}" -G Ninja \
            -DCMAKE_INSTALL_PREFIX=/usr \
            -DCMAKE_INSTALL_LIBDIR=lib \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
            -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
            -DLLVM_SPIRV=/usr/bin/llvm-spirv \
            -DLLVM_DEFAULT_TARGET_TRIPLE="${variant}" \
            -Wno-author

        cmake --build "build/${variant}"
        DESTDIR="${PKG}" cmake --install "build/${variant}"
    done

    install -Dm644 "${name}.pc" -t "${PKG}/usr/share/pkgconfig/"
}
