#!/bin/sh

# shellcheck disable=SC2034
description="C/C++ Configuration File Library"
homepage="https://github.com/hyperrealm/libconfig"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libconfig
version=1.8.3
release=1
source="${name}-${version}.tar.gz::https://github.com/hyperrealm/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    autoreconf -i
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
