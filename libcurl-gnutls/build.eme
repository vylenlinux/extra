#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An URL retrieval library (linked against gnutls)"
homepage="https://curl.se/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libcurl-gnutls
version=8.22.0
release=1
source="https://curl.haxx.se/download/curl-${version}.tar.xz"

lib_version=4.8.0

build() {
    # shellcheck disable=SC2164
    cd "curl-${version}"

    ./configure \
        --prefix=/usr \
        --disable-ldap \
        --disable-ldaps \
        --disable-manual \
        --disable-versioned-symbols \
        --enable-ipv6 \
        --enable-threaded-resolver \
        --without-gssapi \
        --without-libidn \
        --with-gnutls=/usr \
        --with-random=/dev/urandom \
        --with-ca-bundle=/etc/ssl/ca-bundle.crt

    make -C lib
    make -C lib DESTDIR="${PKG}" install

    mv "${PKG}/usr/lib/libcurl.so.${lib_version}" "${PKG}/usr/lib/${name}.so.${lib_version}"
    rm "${PKG}/usr/lib"/libcurl.a* "${PKG}/usr/lib"/libcurl.so*

    for versions in 3 4 4.0.0 4.1.0 4.2.0 4.3.0 4.4.0; do
        ln -s "${name}.so.${lib_version}" "${PKG}/usr/lib/${name}.so.${versions}"
    done
}
