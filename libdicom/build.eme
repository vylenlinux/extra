#!/bin/sh

# shellcheck disable=SC2034
description="C library and tools for reading DICOM data sets"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/ImagingDataCommons/libdicom"

name=libdicom
version=1.3.0
release=1
source="https://github.com/ImagingDataCommons/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dtests=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
