#!/bin/sh

# shellcheck disable=SC2034
description="Provides a user space library for accessing the DRM, direct rendering manager, on operating systems that support the ioctl interface"
homepage="https://dri.freedesktop.org/wiki/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libdrm
version=2.4.134
release=1
source="https://dri.freedesktop.org/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dman-pages=disabled \
        -Dvalgrind=disabled \
        -Dcairo-tests=disabled \
        -Dintel=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
