#!/bin/sh

# shellcheck disable=SC2034
description="A portable middleware for email access"
homepage="https://www.etpan.org/libetpan.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libetpan
version=2.0.1
release=1
source="https://github.com/dinhvh/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    NOCONFIGURE=1 ./autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-db \
        --with-openssl=no \
        --with-gnutls=yes

    make
    make DESTDIR="${PKG}" install
}
