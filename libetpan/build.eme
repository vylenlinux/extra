#!/bin/sh

# shellcheck disable=SC2034
description="A portable middleware for email access"
homepage="https://www.etpan.org/libetpan.html"
maintainer="Vylen Linux Team"

name=libetpan
version=1.10.1
release=1
source="${name}-${version}.tar.gz::https://github.com/dinhviethoa/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    NOCONFIGURE=1 ./autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-db \
        --with-openssl=no \
        --with-gnutls=yes

    make
    make DESTDIR="${PKG}" install
}
