#!/bin/sh

# shellcheck disable=SC2034
description="Asynchronous event notification software library"
homepage="https://libevent.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libevent
version=2.1.13
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/releases/download/release-${version}-stable/${name}-${version}-stable.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}-stable"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
