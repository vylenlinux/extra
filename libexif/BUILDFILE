description="Library for parsing, editing, and saving EXIF data"
homepage="https://github.com/libexif/libexif"
maintainer="Vylen Linux Team"

name=libexif
version=0.6.25
release=1
source="https://github.com/libexif/libexif/releases/download/v$version/$name-$version.tar.xz"

build() {
	cd $name-$version

	./configure --prefix=/usr \
	            --disable-static \
		    --disable-nls
	make
	make DESTDIR=$PKG install

}
