#!/bin/sh

# shellcheck disable=SC2034
description="X11 font encoding library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libfontenc"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libfontenc
version=1.1.10
release=1
source="https://ftp.x.org/pub/individual/lib/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
