description="X11 font encoding library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libfontenc"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libfontenc
version=1.1.9
release=1
source="http://ftp.x.org/pub/individual/lib/$name-$version.tar.xz"

build() {
	cd libfontenc-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
