description="A collection library providing GObject-based interfaces and classes for commonly used data structures"
homepage="https://gitlab.gnome.org/GNOME/libgee"
maintainer="Vylen Linux Team"

name=libgee
version=0.20.8
release=1
source="https://gitlab.gnome.org/GNOME/libgee/-/archive/$version/$name-$version.tar.gz"

build() {
	cd $name-$version

	autoreconf -fvi
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}

