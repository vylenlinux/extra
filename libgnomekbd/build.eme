description="Keyboard management library"
homepage="https://gitlab.gnome.org/GNOME/libgnomekbd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libgnomekbd
version=3.28.1
release=1
source="https://gitlab.gnome.org/Archive/$name/-/archive/$version/$name-$version.tar.gz"

build() {
	vylen-meson $name-$version build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
