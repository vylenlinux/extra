#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Extensible I/O abstraction library for dealing with structured file formats"
homepage="https://gitlab.gnome.org/GNOME/libgsf"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libgsf
version=1.14.59
release=1

_version="$(printf "%s" "${version}" | sed 's/\./_/g')"
source="${name}-${version}.tar.gz::https://gitlab.gnome.org/GNOME/${name}/-/archive/LIBGSF_${_version}/${name}-LIBGSF_${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-LIBGSF_${_version}"

    NOCONFIGURE=1 ./autogen.sh
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
