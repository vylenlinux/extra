description="A library that reads information about processes and the running system"
homepage="https://gitlab.gnome.org/GNOME/libgtop"
maintainer="Vylen Linux Team"

name=libgtop
version=2.41.3
release=1
source="https://ftp.gnome.org/pub/gnome/sources/libgtop/${version%.*}/$name-$version.tar.xz"

build() {
	cd $name-$version
	./configure --prefix=/usr --libdir=/usr/lib --libexecdir=/usr/lib --disable-nls
	make
	make DESTDIR=$PKG install

}
