#!/bin/sh

# shellcheck disable=SC2034
description="Implementation of the iCalendar protocols and data formats"
homepage="https://archlinux.org/packages/extra/x86_64/libical/"
maintainer="Vylen Linux Team"

name=libical
version=4.0.1
release=1
source="https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DLIBICAL_JAVA_BINDINGS=OFF \
        -DICAL_BUILD_DOCS=OFF \
        -DLIBICAL_GLIB_BUILD_DOCS=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
