description="Free software implementation of IDNA2008, Punycode and TR46"
homepage="https://www.gnu.org/software/libidn/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libidn2
version=2.3.8
release=1
source="https://ftp.gnu.org/gnu/libidn/libidn2-$version.tar.gz"

build() {
	cd $name-$version
	./configure --prefix=/usr --disable-doc
	make
	make DESTDIR=$PKG install
}
