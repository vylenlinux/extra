#!/bin/sh

# shellcheck disable=SC2034
description="Set of symbols and convenience functions for Ayatana indicators"
homepage="https://launchpad.net/libindicator"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libindicator
version=12.10.1
release=1
source="https://launchpad.net/libindicator/${version%.*}/${version}/+download/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed 's/-Werror//' -i \
        libindicator/Makefile.am \
        tools/Makefile.am

    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --localstatedir=/var \
        --libexecdir="/usr/lib/${name}" \
        --sysconfdir=/etc \
        --with-gtk=3 \
        --disable-static \
        --disable-tests

    make
    make DESTDIR="${PKG}" install
}
