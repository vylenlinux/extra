#!/bin/sh

# shellcheck disable=SC2034
description="Instrument file software library"
homepage="https://github.com/swami/libinstpatch"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libinstpatch
version=1.1.8
release=1
source="${name}-${version}.tar.gz::https://github.com/swami/${name}/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
