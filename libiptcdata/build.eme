#!/bin/sh

# shellcheck disable=SC2034
description="Library for manipulating the IPTC metadata"
homepage="https://github.com/ianw/libiptcdata"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libiptcdata
version=1.0.5
release=1

_version=$(printf '%s' "${version}" | sed 's/\./_/g')
source="https://github.com/ianw/${name}/releases/download/release_${_version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
