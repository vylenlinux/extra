#!/bin/sh

# shellcheck disable=SC2034
description="frontend for libraries libburn and libisofs"
homepage="https://dev.lovelyhq.com/libburnia"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libisoburn
version=1.5.8.pl02
release=1
source="https://files.libburnia-project.org/releases/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version%.*}"

    ./configure \
        --prefix=/usr \
        --disable-static \
        --enable-pkg-check-modules

    make
    make DESTDIR="${PKG}" install
}
