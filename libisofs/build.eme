#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Library to create an ISO-9660 filesystem with extensions like RockRidge or Joliet"
homepage="https://archlinux.org/packages/extra/x86_64/libisofs/"
maintainer="Vylen Linux Team"

name=libisofs
version=1.5.8.pl01
release=1
source="https://files.libburnia-project.org/releases/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version%.pl*}"
    ./bootstrap

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
