#!/bin/sh

# shellcheck disable=SC2034
description="A fork of the original IJG libjpeg which uses SIMD to accelerate baseline JPEG compression and decompression"
homepage="https://libjpeg-turbo.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libjpeg-turbo
version=3.2.1
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DWITH_JPEG8=ON \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
