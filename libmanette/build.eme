#!/bin/sh

# shellcheck disable=SC2034
description="Simple GObject game controller library"
homepage="https://gnome.pages.gitlab.gnome.org/libmanette/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libmanette
version=0.2.13
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Ddoc="$(emerald is-installed gi-docgen && printf 'true' || printf 'false')"
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
