#!/bin/sh

# shellcheck disable=SC2034
description="A fork of libgnomekbd"
homepage="https://github.com/mate-desktop/libmatekbd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libmatekbd
version=1.28.0
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
