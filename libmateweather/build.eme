#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A library for accessing weather information from online services"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team"

name=libmateweather
version=1.28.2
release=1
source="${name}-${version}.tar.gz::https://github.com/mate-desktop/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fiv

    ./configure \
        --prefix=/usr \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
