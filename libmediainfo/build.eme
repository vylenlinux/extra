#!/bin/sh

# shellcheck disable=SC2034
description="Shared library for mediainfo"
homepage="https://mediaarea.net"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libmediainfo
version=26.10
release=1
source="${name}-${version}.tar.xz::https://mediaarea.net/download/source/${name}/${version}/${name}_${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd MediaInfoLib/Project/GNU/Library
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --enable-shared \
        --disable-static \
        --with-libcurl \
        --with-libmms \
        --with-libtinyxml2

    make
    make DESTDIR="${PKG}" install
}
