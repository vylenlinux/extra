description="A minimalistic user-space library oriented to Netlink developers"
homepage="https://www.netfilter.org/projects/libmnl/"
maintainer="Vylen Linux Team"

name=libmnl
version=1.0.5
release=1
source="https://www.netfilter.org/projects/$name/files/$name-$version.tar.bz2"

build() {
	cd $name-$version
	./configure --prefix=/usr --without-doxygen
	make
	make DESTDIR=$PKG install
}
