#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A library for the arithmetic of complex numbers with arbitrarily high precision and correct rounding of the result"
homepage="http://www.multiprecision.org/"
maintainer="Vylen Linux Team"

name=libmpc
version=1.4.1
release=1
source="${name}-${version}.tar.xz::https://ftp.gnu.org/gnu/mpc/mpc-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "mpc-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
