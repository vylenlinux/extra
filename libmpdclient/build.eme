#!/bin/sh

# shellcheck disable=SC2034
description="Asynchronous API library for interfacing MPD in the C, C++ & Objective C languages"
homepage="https://www.musicpd.org/libs/libmpdclient/"
maintainer="Vylen Linux Team"

name=libmpdclient
version=2.25
release=1
source="${name}-${version}.tar.gz::https://github.com/MusicPlayerDaemon/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    vylen-meson build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
