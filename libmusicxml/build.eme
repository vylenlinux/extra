#!/bin/sh

# shellcheck disable=SC2034
description="Portable C++ library around the MusicXML format"
homepage="https://github.com/grame-cncm/libmusicxml"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libmusicxml
version=3.22
release=1
source="https://github.com/grame-cncm/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}/build" -B build \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
