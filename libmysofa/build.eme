#!/bin/sh

# shellcheck disable=SC2034
description="C library to read HRTFs if they are stored in the AES69-2015 SOFA format"
homepage="https://github.com/hoene/libmysofa/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libmysofa
version=1.3.5
release=1
source="https://github.com/hoene/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCODE_COVERAGE:BOOL='OFF' \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
