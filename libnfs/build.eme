#!/bin/sh

# shellcheck disable=SC2034
description="LIBNFS is a client library for accessing NFS shares over a network."
homepage="https://github.com/sahlberg/libnfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libnfs
version=7.0.2
release=1
source="https://github.com/sahlberg/${name}/archive/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DENABLE_DOCUMENTATION=ON \
        -DENABLE_UTILS=ON \
        -DENABLE_MULTITHREADING=ON \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
