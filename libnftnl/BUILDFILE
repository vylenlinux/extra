description="A userspace library providing a low-level netlink programming interface (API) to the in-kernel nf_tables subsyste"
homepage="https://netfilter.org/projects/libnftnl/"
maintainer="Vylen Linux Team"

name=libnftnl
version=1.3.1
release=1
source="https://www.netfilter.org/pub/$name/$name-$version.tar.xz"

build() {
    cd $name-$version

    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install
}
