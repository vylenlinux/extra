#!/bin/sh

# shellcheck disable=SC2034
description="A userspace library providing a low-level netlink programming interface (API) to the in-kernel nf_tables subsystem"
homepage="https://netfilter.org/projects/libnftnl/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libnftnl
version=1.3.2
release=1
source="https://www.netfilter.org/pub/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
