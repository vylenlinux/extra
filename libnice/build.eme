#!/bin/sh

# shellcheck disable=SC2034
description="An implementation of the IETF's draft ICE (for p2p UDP data streams)"
homepage="https://nice.freedesktop.org"
maintainer="Vylen Linux Team"

name=libnice
version=0.1.24
release=1
source="https://libnice.freedesktop.org/releases/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Dtests=disabled
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
