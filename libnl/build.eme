description="Collection of libraries providing APIs to netlink protocol based Linux kernel interfaces"
homepage="https://github.com/thom311/libnl/"
maintainer="Vylen Linux Team"

name=libnl
version=3.12.0
vrsn=$(printf "$version" | tr '.' '_')
release=1
source="https://github.com/thom311/libnl/releases/download/${name}${vrsn}/$name-$version.tar.gz"

build() {
	cd $name-$version

  	./configure --prefix=/usr     \
	            --sysconfdir=/etc \
	            --disable-static
	make
	make DESTDIR=$PKG install
}
