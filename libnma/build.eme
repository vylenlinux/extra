#!/bin/sh

# shellcheck disable=SC2034
description="NetworkManager GUI client library"
homepage="https://gitlab.gnome.org/GNOME/libnma"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libnma
version=1.10.6
release=1
source="https://github.com/GNOME/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Dgtk_doc="$(emerald is-installed gtk-doc && printf 'true' || printf 'false')"
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # conflict with network-manager-applet
    rm "${PKG}/usr/share/glib-2.0/schemas/org.gnome.nm-applet.gschema.xml"
}
