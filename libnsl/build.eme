#!/bin/sh

# shellcheck disable=SC2034
description="Public client interface library for NIS(YP)"
maintainer="Vylen Linux Team"
homepage="https://github.com/thkukuk/libnsl"

name=libnsl
version=2.0.1
release=1
source="${name}-${version}.tar.gz::https://github.com/thkukuk/${name}/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    DESTDIR="${PKG}" make install
}
