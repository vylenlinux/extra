#!/bin/sh

# shellcheck disable=SC2034
description="A system-independent interface for user-level packet capture"
homepage="https://www.tcpdump.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libpcap
version=1.10.7
release=1

source="https://www.tcpdump.org/release/${name}-${version}.tar.gz
    ${name}-1.9.1-enable_bluetooth-1.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/${name}-1.9.1-enable_bluetooth-1.patch"

    ./configure --prefix=/usr
    make

    sed -i '/INSTALL_DATA.*libpcap.a\|RANLIB.*libpcap.a/ s/^/#/' Makefile
    make DESTDIR="${PKG}" install install-shared
}
