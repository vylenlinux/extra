description="X11 PCI access library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libpciaccess"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libpciaccess
version=0.19
release=1
source="http://ftp.x.org/pub/individual/lib/libpciaccess-$version.tar.xz"

build() {
	vylen-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
