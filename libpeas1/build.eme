#!/bin/sh

# shellcheck disable=SC2034
description="GObject based plugins engine"
homepage="https://wiki.gnome.org/Projects/Libpeas"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libpeas1
version=1.38.1
release=1
source="https://gitlab.gnome.org/GNOME/libpeas/-/archive/libpeas-${version}/libpeas-libpeas-${version}.tar.gz"

build() {
    vylen-meson "libpeas-libpeas-${version}" build \
        -Dgtk_doc=false \
        -Dlua51=false \
        -Dpython3=false \
        -Dvapi=true

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
