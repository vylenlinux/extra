#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A collection of routines used to create PNG format graphics files"
homepage="http://www.libpng.org/pub/png/libpng.html"
maintainer="Vylen Linux Team"

name=libpng
version=1.6.56
release=1

source="${name}-${version}.tar.gz::https://github.com/pnggroup/${name}/archive/v${version}.tar.gz
    https://downloads.sourceforge.net/sourceforge/libpng-apng/${name}-${version}-apng.patch.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    gzip -cd "${SRC}/${name}-${version}-apng.patch.gz" | patch -p1

    autoreconf -fiv
    ./configure --prefix=/usr --disable-static

    make
    make DESTDIR="${PKG}" install

    # shellcheck disable=SC2164
    cd contrib/pngminus
    make PNGLIB_SHARED="-L${PKG}/usr/lib -lpng" CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" png2pnm pnm2png
    install -m0755 png2pnm pnm2png "${PKG}/usr/bin/"
}
