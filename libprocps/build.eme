description="Utilities for monitoring your system and processes on your system"
homepage="https://gitlab.com/procps-ng/procps"
maintainer="Vylen Linux Team"

name=libprocps
version=3.3.17
release=1
source="https://downloads.sourceforge.net/project/procps-ng/Production/procps-ng-${version}.tar.xz"

build() {
	cd procps-${version}

	./configure \
		--prefix=/usr \
		--exec-prefix=/ \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--bindir=/usr/bin \
		--sbindir=/usr/bin \
		--enable-watch8bit \
		--disable-modern-top \
		--disable-kill
	make
	make DESTDIR="${PKG}" install

	rm -rf "${PKG}"/usr/bin "${PKG}"/usr/share
}
