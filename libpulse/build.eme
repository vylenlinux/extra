#!/bin/sh

# shellcheck disable=SC2034
description="iSound system for POSIX OSes (client library)"
homepage="https://www.freedesktop.org/wiki/Software/PulseAudio/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libpulse
version=17.0
release=2
backup="etc/pulse/client.conf"
source="https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-${version}.tar.xz"

build() {
    vylen-meson "pulseaudio-${version}" build \
        -Dtests=false \
        -Ddoxygen="$(emerald is-installed doxygen && printf 'true' || printf 'false')" \
        -Dbluez5="$(emerald is-installed bluez && printf 'enabled' || printf 'disabled')" \
        -Delogind=disabled

    meson compile -C build
    DESTDIR="${PWD}/DESTDIR" meson install --no-rebuild -C build

    install -dm755 "${PKG}/etc/pulse" \
        "${PKG}/usr/bin" \
        "${PKG}/usr/lib/pulseaudio" \
        "${PKG}/usr/share/man/man1" \
        "${PKG}/usr/share/man/man5" \
        "${PKG}/usr/share/bash-completion/completions"

    mv DESTDIR/etc/pulse/client.conf -t "${PKG}/etc/pulse/"
    mv DESTDIR/usr/lib/pulseaudio/libpulsedsp.so -t "${PKG}/usr/lib/pulseaudio/"
    mv DESTDIR/usr/share/man/man5/pulse-client.conf.5 -t "${PKG}/usr/share/man/man5/"

    for bin in pacat pactl padsp pamon paplay parec parecord; do
        mv "DESTDIR/usr/bin/${bin}" -t "${PKG}/usr/bin/"
        mv "DESTDIR/usr/share/man/man1/${bin}.1" -t "${PKG}/usr/share/man/man1/"
        mv "DESTDIR/usr/share/bash-completion/completions/${bin}" -t "${PKG}/usr/share/bash-completion/completions/"
    done

    mv DESTDIR/usr/lib/libpulse.so* -t "${PKG}/usr/lib/"
    mv DESTDIR/usr/lib/libpulse-simple.so* -t "${PKG}/usr/lib/"
    mv DESTDIR/usr/lib/libpulse-mainloop-glib.so* -t "${PKG}/usr/lib/"
    mv DESTDIR/usr/lib/pulseaudio/libpulsecommon-*.so -t "${PKG}/usr/lib/pulseaudio/"
    mv DESTDIR/usr/lib/cmake -t "${PKG}/usr/lib/"
    mv DESTDIR/usr/lib/pkgconfig -t "${PKG}/usr/lib/"
    mv DESTDIR/usr/include -t "${PKG}/usr/"
    mv DESTDIR/usr/share/vala -t "${PKG}/usr/share/"

    # Superseded by socket activation
    sed '/autospawn/iautospawn = no' -i "${PKG}/etc/pulse/client.conf"
}
