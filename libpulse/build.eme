#!/bin/sh

# shellcheck disable=SC2034
description="iSound system for POSIX OSes (client library)"
homepage="https://www.freedesktop.org/wiki/Software/PulseAudio/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libpulse
version=17.0
release=1
backup="etc/pulse/client.conf"
source="https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-${version}.tar.xz"

build() {
    _copy_files() {
        for file; do
            for source in "${PWD}/DESTDIR"/${file}; do
                [ -e "${source}" ] || [ -L "${source}" ] || continue
                relative="${source#"${PWD}/DESTDIR/"}"

                mkdir -p "${PKG}/${relative%/*}"
                cp -a "${source}" "${PKG}/${relative}"
            done
        done
    }

    vylen-meson "pulseaudio-${version}" build \
        -Dtests=false \
        -Ddoxygen="$(emerald is-installed doxygen && printf 'true' || printf 'false')" \
        -Dbluez5="$(emerald is-installed bluez && printf 'enabled' || printf 'disabled')"

    meson compile -C build
    DESTDIR="${PWD}/DESTDIR" meson install --no-rebuild -C build

    _copy_files \
        etc/pulse/client.conf \
        usr/bin/pacat \
        usr/bin/pactl \
        usr/bin/padsp \
        usr/bin/pamon \
        usr/bin/paplay \
        usr/bin/parec \
        usr/bin/parecord \
        usr/lib/libpulse.so* \
        usr/lib/libpulse-simple.so* \
        usr/lib/libpulse-mainloop-glib.so* \
        usr/lib/pulseaudio/libpulsedsp.so \
        usr/lib/pulseaudio/libpulsecommon-*.so \
        usr/share/man/man1/pacat.1 \
        usr/share/man/man1/pactl.1 \
        usr/share/man/man1/padsp.1 \
        usr/share/man/man1/pamon.1 \
        usr/share/man/man1/paplay.1 \
        usr/share/man/man1/parec.1 \
        usr/share/man/man1/parecord.1 \
        usr/share/man/man5/pulse-client.conf.5 \
        usr/share/bash-completion/completions/pacap \
        usr/share/bash-completion/completions/pactl \
        usr/share/bash-completion/completions/padsp \
        usr/share/bash-completion/completions/paplay \
        usr/share/bash-completion/completions/parec \
        usr/share/bash-completion/completions/parecord \
        usr/lib/cmake \
        usr/lib/pkgconfig \
        usr/include \
        usr/share/vala

    # Superseded by socket activation
    sed -e '/autospawn/iautospawn = no' -i "${PKG}/etc/pulse/client.conf"
}
