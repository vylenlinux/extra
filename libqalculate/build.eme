#!/bin/sh

# shellcheck disable=SC2034
description="Multi-purpose desktop calculator"
homepage="https://qalculate.github.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libqalculate
version=5.13.2
release=1
source="${name}-${version}.tar.gz::https://github.com/Qalculate/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./autogen.sh
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
