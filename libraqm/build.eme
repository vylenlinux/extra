#!/bin/sh

# shellcheck disable=SC2034
description="A library that encapsulates the logic for complex text layout"
homepage="https://github.com/HOST-Oman/libraqm/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libraqm
version=0.11.0
release=1
source="https://github.com/HOST-Oman/${name}/releases/download/v${version}/raqm-${version}.tar.xz"

build() {
    vylen-meson "raqm-${version}" build -Ddocs=false
    meson compile -C build
    meson install -C build --destdir "${PKG}"
}
