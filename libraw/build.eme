#!/bin/sh

# shellcheck disable=SC2034
description="Library for reading RAW files obtained from digital photo cameras"
homepage="https://www.libraw.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libraw
version=0.22.3
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "LibRaw-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --enable-jpeg \
        --enable-jasper \
        --enable-lcms \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
