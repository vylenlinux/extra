#!/bin/sh

# shellcheck disable=SC2034
description="FREE version of the SSL/TLS protocol forked from OpenSSL"
homepage="https://www.libressl.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libressl
version=4.4.1
release=1
source="https://cdn.openbsd.org/pub/OpenBSD/LibreSSL/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install

    rm -f "${PKG}/etc/ssl/cert.pem"
}
