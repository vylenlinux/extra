description="Gives more easily access to internet services which says be 'RESTful'"
homepage="https://www.gnome.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=librest
version=0.10.2
release=1

source="https://gitlab.gnome.org/GNOME/librest/-/archive/$version/$name-$version.tar.gz"

build() {
	vylen-meson $name-$version build -Dgtk_doc=false -Dvapi=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build 
}
