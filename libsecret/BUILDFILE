description="GObject based library for accessing the Secret Service API"
homepage="https://gnome.pages.gitlab.gnome.org/libsecret/"
maintainer="Vylen Linux Team"

name=libsecret
version=0.21.7
release=1
source="https://gitlab.gnome.org/GNOME/libsecret/-/archive/$version/$name-$version.tar.bz2"

build() {
	vylen-meson $name-$version build \
		-D manpage=false \
		-D gtk_doc=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
