#!/bin/sh

# shellcheck disable=SC2034
description="GObject based library for accessing the Secret Service API"
homepage="https://gnome.pages.gitlab.gnome.org/libsecret/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libsecret
version=0.21.8
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.bz2"

build() {
    vylen-meson "${name}-${version}" build \
        -Dmanpage=false \
        -Dgtk_doc=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
