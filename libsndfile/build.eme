#!/bin/sh

# shellcheck disable=SC2034
description="Library of C routines for reading and writing files containing sampled audio data"
homepage="https://libsndfile.github.io/libsndfile/"
maintainer="Vylen Linux Team"

name=libsndfile
version=1.2.2
release=1

source="https://github.com/${name}/${name}/releases/download/${version}/${name}-${version}.tar.xz
    CVE-2024-50612.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/CVE-2024-50612.patch"

    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
