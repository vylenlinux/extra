#!/bin/sh

# shellcheck disable=SC2034
description="HTTP client/server library for GNOME"
homepage="https://wiki.gnome.org/Projects/libsoup"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libsoup2
version=2.74.3
release=1
source="${name}-${version}.tar.gz::https://gitlab.gnome.org/GNOME/libsoup/-/archive/${version}/libsoup-${version}.tar.gz"

build() {
    # Fix a build failure caused by libxml2-2.12.x:
    sed -i '/tree/a #include <libxml/parser.h>' "libsoup-${version}/libsoup"/soup-xmlrpc*.c

    vylen-meson "libsoup-${version}" build \
        -Dgssapi=disabled \
        -Dvapi=enabled \
        -Dbrotli=disabled \
        -Dsysprof=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
