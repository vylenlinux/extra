#!/bin/sh

# shellcheck disable=SC2034
description="A library that provides cross platform access to statistics about the system on which it's run"
homepage="https://libstatgrab.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libstatgrab
version=0.92.2
release=1

_version="$(printf '%s' "${version}" | tr '.' '_')"
source="https://github.com/${name}/${name}/archive/LIBSTATGRAB_${_version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-LIBSTATGRAB_${_version}"

    autoreconf -fi
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
