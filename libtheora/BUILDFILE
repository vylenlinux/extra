description="Reference implementation of the Theora video compression format"
homepage="https://www.theora.org/"
maintainer="Vylen Linux Team"

name=libtheora
version=1.2.0
release=1
source="https://gitlab.xiph.org/xiph/theora/-/archive/v$version/theora-v$version.tar.gz"

build() {
	cd theora-v$version
	autoreconf -fvi
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share
}
