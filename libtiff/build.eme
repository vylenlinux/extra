description="TIFF libraries and associated utilities"
homepage="https://gitlab.com/libtiff/libtiff "
maintainer="Vylen Linux Team"

name=libtiff
version=4.7.1
release=1
source="https://gitlab.com/libtiff/libtiff/-/archive/v$version/$name-v$version.tar.gz"

build() {
	cmake -S $name-v$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
                -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_INSTALL_DOCDIR=/usr/share/doc/libtiff \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
