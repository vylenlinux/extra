#!/bin/sh

# shellcheck disable=SC2034
description="Libraries that support programs that use the Remote Procedure Call (RPC) API"
homepage="https://git.linux-nfs.org/cgit/steved/libtirpc.git/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libtirpc
version=1.3.8
release=1
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-gssapi

    make
    make DESTDIR="${PKG}" install
}
