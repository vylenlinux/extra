#!/bin/sh

# shellcheck disable=SC2034
description="Library to enable user space application programs to communicate with USB devices"
homepage="https://libusb.info/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libusb-compat
version=0.1.9
release=1
source="https://github.com/libusb/${name}-0.1/releases/download/v${version}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    autoreconf -fi
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
