#!/bin/sh

# shellcheck disable=SC2034
description="Intel VA-API Media Applications and Scripts for libva"
homepage="https://www.intel.com/content/www/us/en/developer/topic-technology/open/overview.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libva-utils
version=2.24.0
release=1
source="https://github.com/intel/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Dtests=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
