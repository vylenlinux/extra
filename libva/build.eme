#!/bin/sh

# shellcheck disable=SC2034
description="Library which provides access to hardware accelerated video processing"
homepage="https://01.org/linuxmedia/vaapi"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libva
version=2.24.1
release=1
source="https://github.com/intel/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
