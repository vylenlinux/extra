description="Python bindings for libvirt"
homepage="https://libvirt.org/"
maintainer="Vylen Linux Team"

name=libvirt-python
version=12.1.0
release=1
source="$name-$version.tar.gz::https://gitlab.com/libvirt/libvirt-python/-/archive/v$version/$name-v$version.tar.gz"
build() {
	cd $name-v$version
	/usr/bin/python3 setup.py build
	/usr/bin/python3 setup.py install --root $PKG
}

