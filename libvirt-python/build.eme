#!/bin/sh

# shellcheck disable=SC2034
description="Python bindings for libvirt"
homepage="https://libvirt.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libvirt-python
version=12.9.0
release=1
source="${name}-${version}.tar.gz::https://gitlab.com/libvirt/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"

    python3 setup.py build
    python3 setup.py install --root "${PKG}"
}
