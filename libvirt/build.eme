#!/bin/sh

# shellcheck disable=SC2034
description="API for virtualization"
homepage="https://libvirt.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libvirt
version=12.9.0
release=1

backup="etc/libvirt/libvirtd.conf
    etc/libvirt/qemu.conf"

source="https://libvirt.org/sources/${name}-${version}.tar.xz
    libvirtd.conf
    qemu.conf"

build() {
    vylen-meson "${name}-${version}" build \
        --libexecdir="/usr/lib/${name}" \
        -Drunstatedir=/run \
        -Ddriver_qemu=enabled \
        -Dqemu_user=libvirt \
        -Dqemu_group=libvirt \
        -Dtests=disabled \
        -Dnetcf=disabled \
        -Dopenwsman=disabled \
        -Dapparmor=disabled \
        -Dapparmor_profiles=disabled \
        -Dselinux=disabled \
        -Dwireshark_dissector=disabled \
        -Ddriver_bhyve=disabled \
        -Ddriver_hyperv=disabled \
        -Ddriver_libxl=disabled \
        -Ddriver_vz=disabled \
        -Dsanlock=disabled \
        -Dsecdriver_apparmor=disabled \
        -Dsecdriver_selinux=disabled \
        -Dstorage_vstorage=disabled \
        -Ddtrace=disabled \
        -Dnumad=disabled \
        -Dstorage_zfs=disabled \
        -Dstorage_rbd=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    do_sysusers "${name}-qemu"
    do_tmpfiles "${name}"

    printf 'u! libvirt-qemu /var/lib/libvirt "Libvirt QEMU user"' >> "${PKG}/usr/lib/sysusers.d/libvirt.conf"
    printf 'm libvirt-qemu kvm' >> "${PKG}/usr/lib/sysusers.d/libvirt.conf"

    install -Dm644 "${SRC}/libvirtd.conf" "${SRC}/qemu.conf" -t "${PKG}/etc/${name}/"

    rm -rf "${PKG}/run" \
        "${PKG}/var/lib/${name}/qemu" \
        "${PKG}/var/cache/${name}/qemu" \
        "${PKG}/etc/logrotate.d/libvirtd.libxl"

    rm -f "${PKG}/etc/${name}/qemu/networks/autostart/default.xml"
}
