#!/bin/sh

pre_install() {
    getent group libvirt >/dev/null || groupadd -r libvirt
    getent passwd libvirt >/dev/null || useradd -r -M -g libvirt -G libvirt -c "libvirt service user" -d /etc/libvirt -s /usr/bin/nologin libvirt
}

post_remove() {
    getent passwd libvirt >/dev/null && userdel libvirt
    getent group libvirt >/dev/null && groupdel libvirt
}
