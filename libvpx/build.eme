#!/bin/sh

# shellcheck disable=SC2034
description="Implementations of the VP8 Codec, used in most current html5 video, and of the next-generation VP9 Codec"
homepage="https://www.webmproject.org/"
maintainer="Vylen Linux Team"

name=libvpx
version=1.17.0
release=1
source="${name}-${version}.tar.gz::https://github.com/webmproject/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --enable-shared \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
