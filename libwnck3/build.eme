description="Window Navigator Construction Kit"
homepage="https://gitlab.gnome.org/GNOME/libwnck"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libwnck3
version=43.3
release=1
source="https://gitlab.gnome.org/GNOME/libwnck/-/archive/$version/libwnck-$version.tar.gz"

build() {
	vylen-meson libwnck-$version build -Dgtk_doc=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
