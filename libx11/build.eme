description="X11 client-side library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libx11"
maintainer="Vylen Linux Team"

name=libx11
version=1.8.13
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libX11-$version.tar.xz"

build() {
	cd libX11-$version
	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static \
		--disable-specs
	make
	make DESTDIR=$PKG install
}
