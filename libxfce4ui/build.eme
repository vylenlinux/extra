#!/bin/sh

# shellcheck disable=SC2034
description="Widgets library for the Xfce desktop environment"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libxfce4ui
version=4.21.9
release=1
source="https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dgtk-doc="$(emerald is-installed gtk-doc && printf 'true' || printf 'false')" \
        -Dx11=enabled \
        -Dwayland=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
