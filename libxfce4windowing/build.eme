#!/bin/sh

# shellcheck disable=SC2034
description="Windowing concept abstraction library for X11 and Wayland"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libxfce4windowing
version=4.20.7
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
