#!/bin/sh

# shellcheck disable=SC2034
description="X11 font rasterisation library"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=libxfont2
version=2.0.8
release=1
source="${name}-${version}.tar.xz::http://ftp.x.org/pub/individual/lib/libXfont2-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "libXfont2-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --disable-devel-docs

    make
    make DESTDIR="${PKG}" install
}
