#!/bin/sh

# shellcheck disable=SC2034
description="keymap compiler and support library"
homepage="https://xkbcommon.org/"
maintainer="Vylen Linux Team"

name=libxkbcommon
version=1.13.2
release=1
source="${name}-${version}.tar.gz::https://github.com/xkbcommon/${name}/archive/xkbcommon-${version}.tar.gz"

build() {
    vylen-meson "${name}-xkbcommon-${version}" build \
        -Denable-docs=false \
        -Denable-wayland="$(emerald isinstalled wayland-protocols && printf "true" || printf "false")"

    meson compile -C build
    DESTDIR=$PKG meson install --no-rebuild -C build
}
