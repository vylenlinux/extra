description="Utility library for X keyboard"
homepage="https://www.freedesktop.org/wiki/Software/LibXklavier/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libxklavier
version=5.4
release=1
source="https://people.freedesktop.org/~svu/$name-$version.tar.bz2"

build() {
	cd $name-$version

	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install

}
