#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Contains libraries and utilities used for parsing XML files"
homepage="https://gitlab.gnome.org/GNOME/libxml2"
maintainer="Vylen Linux Team"

name=libxml2
version=2.15.4
release=1
source="${name}-${version}.tar.gz::https://gitlab.gnome.org/GNOME/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    vylen-meson "${name}-v${version}" build \
        -Dhistory=enabled \
        -Dhttp=enabled \
        -Dicu=enabled \
        -Dlegacy=enabled \
        -Dpython=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install -C build

    # fix symlink to lixml2.so.2
    ln -s libxml2.so.16 "${PKG}/usr/lib/libxml2.so.2"
}
