description="X11 miscellaneous micro-utility library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxmu"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libxmu
version=1.3.1
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXmu-$version.tar.xz"

build() {
	cd libXmu-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install

}
