#!/bin/sh

# shellcheck disable=SC2034
description="X11 pixmap library"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libxpm
version=3.5.20
release=1
source="${name}-${version}.tar.xz::https://ftp.x.org/pub/individual/lib/libXpm-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "libXpm-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-open-zfile \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
