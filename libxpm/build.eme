description="X11 pixmap library"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=libxpm
version=3.5.18
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXpm-$version.tar.xz"

build() {
	cd libXpm-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
		--disable-open-zfile \
                --disable-static
	make
	make DESTDIR=$PKG install
}
