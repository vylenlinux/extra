#!/bin/sh

# shellcheck disable=SC2034
description="X11 Testing - Resource extension library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxtst"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libxtst
version=1.2.6
release=1
source="${name}-${version}.tar.xz::https://ftp.x.org/pub/individual/lib/libXtst-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "libXtst-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
