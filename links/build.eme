#!/bin/sh

# shellcheck disable=SC2034
description="Text and graphics mode WWW browser"
homepage="http://links.twibright.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=links
version=2.30
release=1

source="http://links.twibright.com/download/${name}-${version}.tar.bz2
    0001-fix-build-with-recent-gcc.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/0001-fix-build-with-recent-gcc.patch"

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man

    make
    make DESTDIR="${PKG}" install
}
