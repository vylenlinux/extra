#!/bin/sh

# shellcheck disable=SC2034
description="Expose the kernel's API for use by Glibc"
homepage="https://www.kernel.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=linux-lts-api-headers
version=6.18.59
release=1
source="https://www.kernel.org/pub/linux/kernel/v${version%%.*}.x/linux-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "linux-${version}"

    make mrproper
    make headers

    find usr/include -name '.*' -delete
    rm usr/include/Makefile

    mkdir -p "${PKG}/usr/include"
    cp -r usr/include/* -t "${PKG}/usr/include/"
}
