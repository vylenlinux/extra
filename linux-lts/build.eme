#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Linux LTS kernel, sources and modules"
homepage="https://www.kernel.org/"
maintainer="Vylen Linux Team"

name=linux-lts
version=6.18.32
release=1

source="https://cdn.kernel.org/pub/linux/kernel/v${version%%.0}.x/linux-${version%.*}.tar.xz
    x86_64-dotconfig"

build() {
    # shellcheck disable=SC2164
    cd "${name%-*}-${version%.0}"
    make mrproper

    cbuild_restore "${SRC}/${name}-${version%.0}/.config" || cp "${SRC}/x86_64-dotconfig" .config
    make olddefconfig

    sed '/^CONFIG_LOCALVERSION=/d' -i .config
    echo 'CONFIG_LOCALVERSION="-'${name}'"' >> .config

    # Defines build options exporting the value/values for the KCFLAGS and KCPPFLAGS before calling make.
    # More info: https://docs.kernel.org/kbuild/kbuild.html
    # CBUILD: add custom KCFLAGS and KCPPFLAGS, source linux.opt
    CBUILD_LINUX_KCFLAGS="${CFLAGS}"
    CBUILD_LINUX_KCPPFLAGS="${CXXFLAGS}"

    cbuild_options

    export KCFLAGS="${CBUILD_LINUX_KCFLAGS}"
    export KCPPFLAGS="${CBUILD_LINUX_KCPPFLAGS}"

    make bzImage modules
    make INSTALL_MOD_PATH="${PKG}" modules_install

    cbuild_save "${SRC}/${name%-*}-${version%.0}/.config"
    mkdir -p "${PKG}/boot"

    cp arch/x86/boot/bzImage "${PKG}/boot/vmlinuz-${name}"
    cp .config "${PKG}/boot/config-${name}"

    make clean
    make prepare

    rm -rf "${PKG}/lib/firmware"

    # shellcheck disable=SC2045
    for file in $(ls arch); do
        case "${file}" in
            x86 | Kconfig) continue ;;
            *) rm -fr "arch/${file}" ;;
        esac
    done

    # strip down sources
    # don't package the kernel in the sources directory
    find . -name "*Image" -exec rm "{}" \;
    find . -name "*.cmd" -exec rm -f "{}" \;

    rm -f .*.d

    rm -fr firmware ipc .config.old .version .cocciconfig \
        .get_maintainer.ignore .gitattributes .gitignore .mailmap \
        COPYING CREDITS MAINTAINERS README Documentation

    find . -name ".gitignore" -exec rm "{}" \;

    for dir in block certs crypto drivers fs init kernel lib mm net samples security sound usr virt; do
        find "${dir}" -type f \( -name "*.c" -o -name "*.h" \) -exec rm "{}" \;
    done

    # shellcheck disable=SC2045
    for i in $(ls tools); do
        [ "${i}" = "objtool" ] || rm -fr "tools/${i}"
    done

    # shellcheck disable=SC2045
    for i in $(ls tools/objtool); do
        [ "${i}" = "objtool" ] || rm -fr "tools/objtool/${i}"
    done

    kernver="${version}-${name}"
    rm "${PKG}/lib/modules/${kernver}/build"
    mv "${SRC}/linux-${version%.0}" "${PKG}/lib/modules/${kernver}/build"
    ln -sv build "${PKG}/lib/modules/${kernver}/source"

    # remove now broken symlinks
    find -L "${PKG}/lib/modules/${kernver}/build" -type l -exec rm -f "{}" \;
}
