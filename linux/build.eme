#!/bin/sh

# shellcheck disable=SC2034
description="Linux kernel, sources and modules"
homepage="https://www.kernel.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=linux
version=7.3.4
release=1

_version="${version%.0}"

source="https://cdn.kernel.org/pub/${name}/kernel/v${version%%.*}.x/${name%-*}-${_version}.tar.xz
    x86_64-dotconfig"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${_version}"
    make mrproper

    cp "${SRC}/x86_64-dotconfig" .config
    make olddefconfig

    # Defines build options exporting the value/values for the KCFLAGS and KCPPFLAGS before calling make.
    # More info: https://docs.kernel.org/kbuild/kbuild.html
    # shellcheck disable=SC2153
    export KCFLAGS="${CFLAGS}"
    export KCPPFLAGS="${CXXFLAGS}"

    make bzImage modules
    make INSTALL_MOD_PATH="${PKG}/usr" modules_install

    mkdir -p "${PKG}/boot"

    cp arch/x86/boot/bzImage "${PKG}/boot/vmlinuz-${name}"
    cp .config "${PKG}/boot/config-${name}"

    make clean
    make prepare

    # moved to linux-firmware
    rm -rf "${PKG}/usr/lib/firmware"

    # shellcheck disable=SC2045
    for file in $(ls arch); do
        case "${file}" in
            x86 | Kconfig) continue ;;
            *) rm -rf "arch/${file}" ;;
        esac
    done

    # strip down sources
    # don't package the kernel in the sources directory
    find . -name "*Image" -exec rm "{}" \;
    find . -name "*.cmd" -exec rm -f "{}" \;

    rm -f .*.d

    rm -rf firmware ipc .config.old .version .cocciconfig \
        .get_maintainer.ignore .gitattributes .gitignore .mailmap \
        COPYING CREDITS MAINTAINERS README Documentation

    find . -name ".gitignore" -exec rm "{}" \;

    for dir in block certs crypto drivers fs init kernel lib mm net samples security sound usr virt; do
        find "${dir}" -type f \( \
            -name "*.c" -o \
            -name "*.h" \
        \) -exec rm "{}" \;
    done

    # shellcheck disable=SC2045
    for i in $(ls tools); do
        [ "${i}" = "objtool" ] || rm -rf "tools/${i}"
    done

    # shellcheck disable=SC2045
    for i in $(ls tools/objtool); do
        [ "${i}" = "objtool" ] || rm -rf "tools/objtool/${i}"
    done

    kernel_version="$(make -s kernelrelease)"
    rm -f "${PKG}/usr/lib/modules/${kernel_version}/build"
    mv "${SRC}/${name}-${_version}" "${PKG}/usr/lib/modules/${kernel_version}/build"
    ln -s build "${PKG}/usr/lib/modules/${kernel_version}/source"

    # remove now broken symlinks
    find -L "${PKG}/usr/lib/modules/${kernel_version}/build" -type l -exec rm -f "{}" \;
}
