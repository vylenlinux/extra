#!/bin/sh

initrd_file=/boot/initrd-linux.img

update_kernel() {
    kernel_version="${1}-linux"

    # removing other vylen kernel
    for i in /usr/lib/modules/*; do
        [ -d "${i}" ] || continue

        case "${i##*/}" in
            "${kernel_version}") continue ;;

            *-linux)
                [ -d "${i}/build/include" ] && continue

                printf ":: removing kernel %s\n" "${i##*/}"
                rm -rf "${i}"
            ;;
        esac
    done

    if command -v mkinitramfs >/dev/null 2>&1; then
        printf "mkinitramfs: generating initramfs for kernel %s...\n" "${kernel_version}"
        mkinitramfs -k "${kernel_version}" -o "${initrd_file}"
    fi

    # load kernel modules
    depmod "${kernel_version}"

    # run all dkms scripts
    if command -v dkms >/dev/null 2>&1; then
        for i in /var/lib/dkms/buildmodules-*.sh; do
            [ -f "${i}" ] && sh "${i}"
        done
    fi
}

post_install() {
    update_kernel "${1}"
}

post_upgrade() {
    update_kernel "${2}"
}

post_remove() {
    # clean initrd
    if [ -f "${initrd_file}" ]; then
        printf ":: '%s' found! Cleaning...\n" "${initrd_file}"
        rm -f "${initrd_file}"

        printf "==> '%s' removed!\n" "${initrd_file}"
    fi
}
