#!/bin/sh

initrd_file=/boot/initrd-linux.img

update_kernel() {
    kernver=$(find /usr/lib/modules -maxdepth 1 -type d -iname '*-linux' -printf "%f\n" | sort -V | tail -n1)

    # removing other vylen kernel
    for i in /usr/lib/modules/*; do
        [ -d "${i}" ] || continue

        case "${i##*/}" in
            "${kernver}") continue ;;

            *-linux)
                [ -d "${i}/build/include" ] && continue

                printf "post-install: removing kernel %s\n" "${i##*/}"
                rm -rf "${i}"
            ;;
        esac
    done

    # check if kernel was build with initrd support
    initrd_enabled=0

    if grep -q "^CONFIG_BLK_DEV_INITRD=y" /boot/config-linux 2>/dev/null; then
        initrd_enabled=1
    fi

    if [ "${initrd_enabled}" -eq 1 ] && [ "$(command -v mkinitramfs)" ]; then
        printf "mkinitramfs: generating initramfs for kernel %s...\n" "${kernver}"
        mkinitramfs -k "${kernver}" -o "${initrd_file}"
    fi

    # load kernel modules
    depmod "${kernver}"

    # run all dkms scripts
    if [ "$(command -v dkms)" ]; then
        for i in /var/lib/dkms/buildmodules-*.sh; do
            [ -f "${i}" ] && sh "${i}"
        done
    fi
}

post_install() {
    update_kernel
}

post_upgrade() {
    update_kernel
}

post_remove() {
    # clean initrd
    if [ -f "${initrd_file}" ]; then
        printf "'%s' found! Cleaning...\n" "${initrd_file}"
        rm -f "${initrd_file}"

        printf "==> '%s' removed!\n" "${initrd_file}"
    fi
}
