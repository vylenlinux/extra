#!/bin/sh

# shellcheck disable=SC2034
description="Collection of modular and reusable compiler and toolchain technologies"
homepage="https://llvm.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=llvm
version=23.1.5
release=1

source="${name}-${version}.tar.xz::https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/${name}-project-${version}.src.tar.xz
    ${name}-config.h"

build() {
    # shellcheck disable=SC2164
    cd "${name}-project-${version}.src/${name}"

    # Fix Python scripts which use /usr/bin/env python to access the system Python:
    grep -rl '#!.*python' | xargs sed -i '1s/python$/python3/'

    LLVM_TARGETS="AArch64;AMDGPU;ARM;AVR;BPF;Hexagon;Lanai;LoongArch;Mips;MSP430;NVPTX;PowerPC"
    LLVM_TARGETS="${LLVM_TARGETS};RISCV;Sparc;SPIRV;SystemZ;VE;WebAssembly;X86;XCore"

    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DLLVM_BINUTILS_INCDIR=/usr/include \
        -DLLVM_BUILD_DOCS=OFF \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_BUILD_TESTS=OFF \
        -DLLVM_ENABLE_ASSERTIONS=OFF \
        -DLLVM_ENABLE_FFI=ON \
        -DLLVM_ENABLE_LIBCXX=OFF \
        -DLLVM_ENABLE_LIBEDIT=OFF \
        -DLLVM_ENABLE_LIBXML2=OFF \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_ENABLE_SPHINX=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INSTALL_UTILS=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_TARGETS_TO_BUILD="${LLVM_TARGETS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # multilib stub
    mv "${PKG}/usr/include/${name}/Config/${name}-config.h" "${PKG}/usr/include/${name}/Config/${name}-config-64.h"
    cp "${SRC}/${name}-config.h" -t "${PKG}/usr/include/${name}/Config/"
}
