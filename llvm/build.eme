#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Collection of modular and reusable compiler and toolchain technologies"
homepage="https://llvm.org/"
maintainer="Vylen Linux Team"

name=llvm
version=23.1.1
release=1

source="https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/${name}-project-${version}.src.tar.xz
    llvm-config.h"

build() {
    # shellcheck disable=SC2164
    cd "${name}-project-${version}.src/${name}"

    # Fix Python scripts which use /usr/bin/env python to access the system Python:
    grep -rl '#!.*python' | xargs sed -i '1s/python$/python3/'

    # CBUILD: enable o disable LLVM_TARGETS_TO_BUILD, source CBUILD_LLVM_TARGETS from "llvm.opt" file
    CBUILD_LLVM_TARGETS="AArch64;AMDGPU;ARM;AVR;BPF;Hexagon;Lanai;LoongArch;Mips;MSP430;NVPTX;PowerPC"
    CBUILD_LLVM_TARGETS="${CBUILD_LLVM_TARGETS};RISCV;Sparc;SPIRV;SystemZ;VE;WebAssembly;X86;XCore"

    cbuild_options

    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DLLVM_BINUTILS_INCDIR=/usr/include \
        -DLLVM_BUILD_DOCS=OFF \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_BUILD_TESTS=OFF \
        -DLLVM_ENABLE_ASSERTIONS=OFF \
        -DLLVM_ENABLE_FFI=ON \
        -DLLVM_ENABLE_LIBCXX=OFF \
        -DLLVM_ENABLE_LIBEDIT=OFF \
        -DLLVM_ENABLE_LIBXML2=OFF \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_ENABLE_SPHINX=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INSTALL_UTILS=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_TARGETS_TO_BUILD="${CBUILD_LLVM_TARGETS}" \
        -Wno-dev

    jobs=

    while :; do
        printf "Try %s parallel jobs ...\n" "${jobs:-default}"
        cmake --build build -j "${jobs}" && break

        # Try few parallel jobs to avoid OOM
        if [ -z "${jobs}" ]; then
            # shellcheck disable=SC2003
            jobs="$(expr "$(free -g | grep Mem: | awk '{print $2;}')" / 2 + 1)"
            continue
        elif [ "${jobs}" -gt 2 ]; then
            # shellcheck disable=SC2003
            jobs="$(expr "${jobs}" - 2)"
            continue
        elif [ "${jobs}" = 1 ]; then
            exit 1
        else
            jobs=1
        fi
    done

    DESTDIR="${PKG}" cmake --install build

    # multilib stub
    mv "${PKG}/usr/include/llvm/Config/llvm-config.h" "${PKG}/usr/include/llvm/Config/llvm-config-64.h"
    cp "${SRC}/llvm-config.h" -t "${PKG}/usr/include/llvm/Config/"
}
