description="Script that gives information about the Linux Standards Base (LSB) status of the distribution"
homepage="https://refspecs.linuxfoundation.org/lsb.shtml"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lsb-release
version=12.1
release=1
source="https://salsa.debian.org/gioele/lsb-release-minimal/-/archive/v$version/$name-minimal-v$version.tar.gz"

build() {
	cd $name-minimal-v$version
	make
	make DESTDIR=$PKG install
}

