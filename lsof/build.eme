#!/bin/sh

# shellcheck disable=SC2034
description="LiSt Open Files"
homepage="https://lsof.readthedocs.io/en/latest/"
maintainer="Vylen Linux Team"

name=lsof
version=4.99.7
release=1
source="https://github.com/lsof-org/${name}/releases/download/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
