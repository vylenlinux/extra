description="Light-weight programming language designed for extending applications"
homepage="https://www.lua.org"
maintainer="Vylen Linux Team"

name=lua
version=5.4.8
release=1
source="https://www.lua.org/ftp/$name-$version.tar.gz
	lua-5.4.7-shared_library-1.patch"

build() {
	cd $name-$version

cat > lua.pc << "EOF"
V=${version%.*}
R=$version

prefix=/usr
INSTALL_BIN=${prefix}/bin
INSTALL_INC=${prefix}/include
INSTALL_LIB=${prefix}/lib
INSTALL_MAN=${prefix}/share/man/man1
INSTALL_LMOD=${prefix}/share/lua/${V}
INSTALL_CMOD=${prefix}/lib/lua/${V}
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Lua
Description: An Extensible Extension Language
Version: ${R}
Requires:
Libs: -L${libdir} -llua -lm -ldl
Cflags: -I${includedir}
EOF

	patch -Np1 -i $SRC/lua-5.4.7-shared_library-1.patch

	make linux

	make \
	INSTALL_TOP=$PKG/usr \
	INSTALL_DATA="cp -d" \
	INSTALL_MAN=$PKG/usr/share/man/man1 \
	TO_LIB="liblua.so liblua.so.${version%.*} liblua.so.$version" \
	install

	# create symlinks
	ln -s lua $PKG/usr/bin/lua${version%.*}
	ln -s luac $PKG/usr/bin/luac${version%.*}
	ln -s liblua.so.$version $PKG/usr/lib/liblua${version%.*}.so

	vrsn=$(printf "$version" | cut -d '.' -f 1,2 | tr -d '.')

	install -v -m644 -D lua.pc $PKG/usr/lib/pkgconfig/lua${vrsn}.pc
	ln -s lua${vrsn}.pc $PKG/usr/lib/pkgconfig/lua.pc
	ln -s lua${vrsn}.pc $PKG/usr/lib/pkgconfig/lua.${version%.*}.pc
	ln -s lua${vrsn}.pc $PKG/usr/lib/pkgconfig/lua-${version%-*}.pc
}
