#!/bin/sh

# shellcheck disable=SC2034
description="Light-weight programming language designed for extending applications"
homepage="https://www.lua.org"
maintainer="Vylen Linux Team"

name=lua
version=5.4.8
release=1

source="https://www.lua.org/ftp/${name}-${version}.tar.gz
    lua-5.4.7-shared_library-1.patch
    lua.pc"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/lua-5.4.7-shared_library-1.patch"
    make linux

    make \
        INSTALL_TOP="${PKG}/usr" \
        INSTALL_DATA="cp -d" \
        INSTALL_MAN="${PKG}/usr/share/man/man1" \
        TO_LIB="liblua.so liblua.so.${version%.*} liblua.so.${version}" install

    # create symlinks
    ln -s lua "${PKG}/usr/bin/lua${version%.*}"
    ln -s luac "${PKG}/usr/bin/luac${version%.*}"
    ln -s "liblua.so.${version}" "${PKG}/usr/lib/liblua${version%.*}.so"

    _version="$(printf "%s" "${version}" | cut -d '.' -f 1,2 | tr -d '.')"
    install -Dm644 "${SRC}/lua.pc" "${PKG}/usr/lib/pkgconfig/lua${_version}.pc"

    ln -s "lua${_version}.pc" "${PKG}/usr/lib/pkgconfig/lua.pc"
    ln -s "lua${_version}.pc" "${PKG}/usr/lib/pkgconfig/lua.${version%.*}.pc"
    ln -s "lua${_version}.pc" "${PKG}/usr/lib/pkgconfig/lua-${version%-*}.pc"
}
