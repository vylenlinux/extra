#!/bin/sh

# shellcheck disable=SC2034
description="Filter that can be run between an arbitrary application and a UTF-8 terminal emulator"
homepage="https://invisible-island.net/luit/luit.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=luit
version=20260907
release=1
source="https://invisible-mirror.net/archives/${name}/${name}-${version}.tgz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --enable-fontenc

    make
    make DESTDIR="${PKG}" install
}
