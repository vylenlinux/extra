#!/bin/sh

# shellcheck disable=SC2034
description="Set of tools that manage logical partitions"
homepage="https://sourceware.org/lvm2/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lvm2
version=2.03.43
release=2

backup="etc/lvm/lvm.conf
    etc/lvm/lvmlocal.conf"

source="${name}-${version}.tgz::https://sourceware.org/pub/${name}/LVM2.${version}.tgz"

build() {
    # shellcheck disable=SC2164
    cd "LVM2.${version}"
    export CONFIG_SHELL=/bin/bash

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libdir=/usr/lib \
        --with-libexecdir="/usr/lib/${name}" \
        --with-udevdir=/usr/lib/udev \
        --enable-cmdlib \
        --enable-pkgconfig \
        --enable-udev_sync \
        --enable-write_install

    make
    make DESTDIR="${PKG}" install_lvm2
}
