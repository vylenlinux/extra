description="Desktop-independent theme switcher for GTK+"
homepage="https://wiki.lxde.org/en/LXAppearance"
maintainer="Vylen Linux Team"

name=lxappearance
version=0.6.4
release=1
source="https://github.com/lxde/lxappearance/archive/refs/tags/$version/$name-$version.tar.gz"

build() {
	cd $name-$version
	./autogen.sh
	./configure --prefix=/usr     \
		--sysconfdir=/etc \
		--disable-static  \
		--enable-dbus \
		   
	make
	make DESTDIR=$PKG install

}
