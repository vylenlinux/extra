#!/bin/sh

# shellcheck disable=SC2034
description="Desktop-independent theme switcher for GTK+"
homepage="https://wiki.lxde.org/en/LXAppearance"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lxappearance
version=0.6.4
release=2

source="https://github.com/lxde/${name}/archive/${version}/${name}-${version}.tar.gz
    https://github.com/lxde/${name}/commit/9472f8236f30d363af89e290aacc9d03b1df36dd.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/9472f8236f30d363af89e290aacc9d03b1df36dd.patch"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --enable-dbus

    make
    make DESTDIR="${PKG}" install
}
