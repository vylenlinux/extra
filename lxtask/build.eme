description="Lightweight and desktop-independent task manager"
homepage="https://lxde.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lxtask
version=0.1.12
release=1
source="$name-$version.tar.gz::https://github.com/lxde/lxtask/archive/refs/tags/$version.tar.gz"

build() {
	cd $name-$version
	export CFLAGS="$CFLAGS -fcommon"
	autoreconf -fvi
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install

}
