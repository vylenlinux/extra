#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A lightweight TUI (ncurses-like) display manager for Linux and BSD."
homepage="https://codeberg.org/fairyglade/ly"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ly
version=1.4.1
release=3
source="${name}-${version}.tar.gz::https://codeberg.org/fairyglade/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}"

    # shellcheck disable=SC2016
    sed -i 's|shutdown_cmd = /sbin/shutdown $PLATFORM_SHUTDOWN_ARG now|shutdown_cmd = /sbin/shutdown -p now|' res/config.ini

    zig build \
        --search-prefix /usr \
        --build-id=sha1 \
        \
        -Ddest_directory="${PKG}" \
        -Dname="ly-dm" \
        -Dtarget=native \
        -Dcpu=baseline \
        -Doptimize=ReleaseSafe installexe

    do_service "${name}"
    do_pam "${name}"
}
