#!/bin/sh

# shellcheck disable=SC2034
description="Notification daemon for wayland"
homepage="https://github.com/emersion/mako"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mako
version=1.11.0
release=1

source="https://github.com/emersion/${name}/archive/v${version}/${name}-${version}.tar.gz
    systemd-dbus-activation.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/systemd-dbus-activation.patch"

    vylen-meson build -Dsd-bus-provider=libsystemd
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 contrib/systemd/mako.service -t "${PKG}/usr/lib/systemd/user/"
}
