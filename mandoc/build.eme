#!/bin/sh

# shellcheck disable=SC2034
description="mandoc - a document processor for mdoc and man"
homepage="https://mdocml.bsd.lv/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mandoc
version=1.14.6
release=1

source="http://mandoc.bsd.lv/snapshots/${name}-${version}.tar.gz
    configure.local"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    install -Dm644 "${SRC}/configure.local" -t .
    ./configure

    make
    make DESTDIR="${PKG}" install
}
