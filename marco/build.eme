#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The MATE window manager, a fork of metacity"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team"

name=marco
version=1.29.0
release=1
source="${name}-${version}.tar.gz::https://github.com/mate-desktop/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-update-mimedb \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
