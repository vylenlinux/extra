#!/bin/sh

# shellcheck disable=SC2034
description="Faenza icon theme for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mate-icon-theme-faenza
version=1.20.0
release=1
source="https://github.com/mate-desktop-legacy-archive/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./autogen.sh
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
