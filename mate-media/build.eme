#!/bin/sh

# shellcheck disable=SC2034
description="MATE Media Tools"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mate-media
version=1.29.0
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir="/usr/lib/${name}" \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
