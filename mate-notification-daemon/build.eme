#!/bin/sh

# shellcheck disable=SC2034
description="Notification daemon for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mate-notification-daemon
version=1.29.0
release=1
source="${name}-${version}.tar.gz::https://github.com/mate-desktop/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}"

    make
    make DESTDIR="${PKG}" install
}
