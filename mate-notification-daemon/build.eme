#!/bin/sh

# shellcheck disable=SC2034
description="Notification daemon for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mate-notification-daemon
version=1.28.5
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}"

    make
    make DESTDIR="${PKG}" install
}
