#!/bin/sh

# shellcheck disable=SC2034
description="Screensaver for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mate-screensaver
version=1.28.1
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --localstatedir=/var \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
