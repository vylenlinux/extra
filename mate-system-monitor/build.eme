#!/bin/sh

# shellcheck disable=SC2034
description="A system monitor for MATE"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mate-system-monitor
version=1.28.2
release=1
source="${name}-${version}.tar.gz::https://github.com/mate-desktop/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --disable-nls

    make
    make DESTDIR="${PKG}" install
}
