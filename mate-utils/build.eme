#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Common MATE utilities for viewing disk usage, logs and fonts, taking screenshots, managing dictionaries and searching files"
homepage="https://mate-desktop.org"
maintainer="Vylen Linux Team"

name=mate-utils
version=1.28.1
release=1
source="https://github.com/mate-desktop/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    rm -r gsearchtool/help/pt

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir="/usr/lib/${name}"

    make
    make DESTDIR="${PKG}" install
}
