#!/bin/sh

# shellcheck disable=SC2034
description="A JavaScript display engine for mathematics that works in all browsers"
homepage="https://www.mathjax.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mathjax
version=4.1.3
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/${version}/MathJax-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "MathJax-${version}"

    mkdir -p "${PKG}/usr/share/${name}"
    # shellcheck disable=SC2035
    cp -ar * "${PKG}/usr/share/${name}/"

    rm -f "${PKG}/usr/share/${name}/LICENSE" \
        "${PKG}/usr/share/${name}/CONTRIBUTING.md" \
        "${PKG}/usr/share/${name}/README.md"
}
