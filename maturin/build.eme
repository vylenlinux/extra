#!/bin/sh

# shellcheck disable=SC2034
description="Build and publish crates with pyo3, rust-cpython and cffi bindings"
homepage="https://github.com/PyO3/maturin"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=maturin
version=1.16.0
release=1
source="https://github.com/PyO3/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo fetch \
        --locked \
        --target "$(rustc --print host-tuple)"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
