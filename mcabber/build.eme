#!/bin/sh

# shellcheck disable=SC2034
description="A small Jabber console client, includes features: SSL, PGP, MUC, UTF8"
homepage="https://www.lilotux.net/~mikael/mcabber/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mcabber
version=1.1.2
release=1
source="https://www.lilotux.net/~mikael/${name}/files/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    export CFLAGS="${CFLAGS} -fcommon"

    ./configure \
        --prefix=/usr \
        --enable-hgcset \
        --mandir=/usr/share/man \
        --enable-aspell \
        --enable-otr

    make
    make DESTDIR="${PKG}" install

    mkdir -p "${PKG}/usr/share/mcabber/example"
    cp -a mcabberrc.example "${PKG}/usr/share/mcabber/example/mcabberrc"
}
