description="Caching mechanism for freedesktop.org compliant menus"
homepage="https://lxde.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=menu-cache
version=1.1.1
release=1
source="$name-$version.tar.gz::https://github.com/lxde/menu-cache/archive/$version.tar.gz"

build() {
	cd $name-$version
	./autogen.sh
	./configure --prefix=/usr \
	            --libexecdir=/usr/lib \
	            --disable-static
	make
	make DESTDIR=$PKG install
}
