#!/bin/sh

# shellcheck disable=SC2034
description="Caching mechanism for freedesktop.org compliant menus"
homepage="https://lxde.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=menu-cache
version=1.1.1
release=2

source="https://github.com/lxde/${name}/archive/${version}/${name}-${version}.tar.gz
    https://github.com/lxde/${name}/commit/70e45065178032a186a998440dd577f4f1a8b087.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/70e45065178032a186a998440dd577f4f1a8b087.patch"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
