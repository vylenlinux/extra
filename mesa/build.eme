#!/bin/sh

# shellcheck disable=SC2034
description="Open-source OpenGL drivers"
homepage="https://www.mesa3d.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mesa
version=26.3.0
release=1

### BEGIN Rust crates
rust_crates="paste 1.0.14
    proc-macro2 1.0.86
    quote 1.0.35
    rustc-hash 2.1.1
    syn 2.0.87
    unicode-ident 1.0.12"

crates=""

while IFS= read -r line; do
    # shellcheck disable=SC2086
    set -- ${line}

    crate_name="${1}"
    crate_version="${2}"

    crates="${crates}
        ${crate_name}-${crate_version}.tar.gz::https://static.crates.io/crates/${crate_name}/${crate_version}/download"
done <<EOF
${rust_crates}
EOF
### END Rust crates

source="https://mesa.freedesktop.org/archive/${name}-${version}.tar.xz
    ${crates}"

build() {
    emerald is-installed vulkan-icd-loader && OPT_MESA_GALLIUM='zink,'
    emerald is-installed wayland-protocols && OPT_MESA_PLATFORMS='wayland,x11' || OPT_MESA_PLATFORMS='x11'

    MESA_OPTS="-Dshared-llvm=enabled \
        -Dglx=dri \
        -Dgallium-drivers=${OPT_MESA_GALLIUM}crocus,iris,nouveau,r300,r600,radeonsi,svga,virgl,i915,tegra \
        -Dplatforms=${OPT_MESA_PLATFORMS} \
        -Dgallium-mediafoundation=disabled \
        -Dintel-rt=enabled \
        -Dgallium-rusticl=true \
        -Dvulkan-drivers=amd,intel,intel_hasvk,nouveau,swrast \
        -Dgallium-va=$(emerald is-installed libva && printf 'enabled' || printf 'disabled')"

    # shellcheck disable=SC2086
    vylen-meson "${name}-${version}" build \
        -Db_lto=false \
        -Degl=enabled \
        -Dgbm=enabled \
        -Dgles1=disabled \
        -Dgles2=enabled \
        -Dllvm=enabled \
        -Dglvnd=enabled \
        -Dvideo-codecs=vc1dec,h264dec,h264enc,h265dec,h265enc \
        -Dvulkan-layers=device-select,overlay \
        ${MESA_OPTS}

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # Indirect rendering symlink
    ln -s libGLX_mesa.so.0 "${PKG}/usr/lib/libGLX_indirect.so.0"
}
