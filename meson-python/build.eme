#!/bin/sh

# shellcheck disable=SC2034
description="Meson PEP 517 Python build backend"
homepage="https://github.com/mesonbuild/meson-python"
maintainer="Vylen Linux Team"

name=meson-python
version=0.21.0
release=1
source="${name}-${version}.tar.gz::https://pypi.org/packages/source/m/meson_python/meson_python-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "meson_python-${version}"

    python3 -m build \
        --wheel \
        --skip-dependency-check \
        --no-isolation

    python3 -m installer \
        --compile-bytecode 2 \
        --destdir="${PKG}" dist/*.whl
}
