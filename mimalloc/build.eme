#!/bin/sh

# shellcheck disable=SC2034
description="General-purpose allocator with excellent performance characteristics"
homepage="https://github.com/microsoft/mimalloc"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mimalloc
version=3.6.1
release=1
source="https://github.com/microsoft/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DMI_BUILD_OBJECT=OFF \
        -DMI_INSTALL_TOPLEVEL=ON \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
