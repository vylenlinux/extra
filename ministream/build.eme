#!/bin/sh

# shellcheck disable=SC2034
description="Minimal (subset) appstream metadata parser"
homepage="https://gitlab.gnome.org/GNOME/ministream"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ministream
version=0.99.1
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Dtests=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
