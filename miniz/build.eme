#!/bin/sh

# shellcheck disable=SC2034
description="Compression library implementing zlib (RFC 1950) & deflate (RFC 1951) specifications"
homepage="https://github.com/richgel999/miniz"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=miniz
version=3.1.2
release=1
source="${name}-${version}.tar.gz::https://github.com/richgel999/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
