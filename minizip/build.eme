#!/bin/sh

# shellcheck disable=SC2034
description="Mini zip and unzip based on zlib"
homepage="https://www.zlib.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=minizip
version=1.4
release=1
source="https://zlib.net/zlib-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "zlib-${version}/contrib/${name}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --enable-static=no

    make
    make DESTDIR="${PKG}" install

    rm "${PKG}/usr/include/${name}/crypt.h"
}
