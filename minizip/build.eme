#!/bin/sh

# shellcheck disable=SC2034
description="Mini zip and unzip based on zlib"
homepage="https://www.zlib.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=minizip
version=1.3.2
release=1

source="https://zlib.net/zlib-${version}.tar.gz
    36ff1be48ef696cc67b0855f7c8537ce0276210d.patch
    df84af25dc1942490e1d1c899a07619152a46148.patch"

build() {
    patch -d "zlib-${version}" -Np1 -i "${SRC}/36ff1be48ef696cc67b0855f7c8537ce0276210d.patch"
    patch -d "zlib-${version}" -Np1 -i "${SRC}/df84af25dc1942490e1d1c899a07619152a46148.patch"

    # shellcheck disable=SC2164
    cd "zlib-${version}/contrib/minizip"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --enable-static=no

    make
    make DESTDIR="${PKG}" install

    rm "${PKG}/usr/include/minizip/crypt.h"
}
