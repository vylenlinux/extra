description="Create an index of scalable font files for X"
homepage="https://gitlab.freedesktop.org/xorg/app/mkfontscale"
maintainer="Vylen Linux Team"

name=mkfontscale
version=1.2.3
release=1
source="http://ftp.x.org/pub/individual/app/mkfontscale-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
