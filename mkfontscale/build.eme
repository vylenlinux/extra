#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Create an index of scalable font files for X"
homepage="https://gitlab.freedesktop.org/xorg/app/mkfontscale"
maintainer="Vylen Linux Team"

name=mkfontscale
version=1.2.4
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
