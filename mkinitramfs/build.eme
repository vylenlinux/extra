#!/bin/sh

# shellcheck disable=SC2034
description="Modular initramfs image creation utility"
homepage="https://gitlab.com/vylen/mkinitramfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mkinitramfs
version=20260928
release=1
backup="etc/${name}.conf"
source="https://gitlab.com/vylen/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
