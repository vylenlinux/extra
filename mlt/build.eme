#!/bin/sh

# shellcheck disable=SC2034
description="An open source multimedia framework"
homepage="https://www.mltframework.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mlt
version=7.40.0
release=2

source="https://github.com/mltframework/${name}/releases/download/v${version}/${name}-${version}.tar.gz
    ffmpeg-9.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/ffmpeg-9.patch"

    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DMOD_MOVIT=OFF \
        -DMOD_PLUS=OFF \
        -DMOD_RTAUDIO=OFF \
        -DMOD_RUBBERBAND=OFF \
        -DMOD_QT6=ON \
        -DMOD_QT=OFF \
        -DSWIG_PYTHON=ON \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
