#!/bin/sh

# shellcheck disable=SC2034
description="APN configuration presets for mobile broadband connections"
homepage="https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mobile-broadband-provider-info
version=20261111
release=1
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
