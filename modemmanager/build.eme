#!/bin/sh

# shellcheck disable=SC2034
description="Mobile broadband modem management service"
homepage="https://www.freedesktop.org/wiki/Software/ModemManager/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=modemmanager
version=1.24.2
release=2

source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/mobile-broadband/${name}/-/archive/${version}/ModemManager-${version}.tar.gz
    ${name}-disable-info-logging.patch"

build() {
    patch -d "ModemManager-${version}" -Np1 -i "${SRC}/modemmanager-disable-info-logging.patch"

    vylen-meson "ModemManager-${version}" build \
        -Dat_command_via_dbus=true \
        -Dpolkit=permissive \
        -Dsystemdsystemunitdir=no \
        -Dsystemd_suspend_resume=false \
        -Dsystemd_journal=false \
        -Dudevdir=/usr/lib/udev

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
