#!/bin/sh

# shellcheck disable=SC2034
description="Music playback daemon"
homepage="https://www.musicpd.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mpd
version=0.24.19
release=1

source="${name}-${version}.tar.gz::https://github.com/MusicPlayerDaemon/${name}/archive/v${version}.tar.gz
    00-vylen.conf"

build() {
    vylen-meson "MPD-${version}" build \
        --auto-features disabled \
        -Dsystemd=enabled \
        -Dadplug=disabled \
        -Dcurl=enabled \
        -Dbzip2=enabled \
        -Diconv=enabled \
        -Dipv6=enabled \
        -Dpcre=enabled \
        -Dsqlite=enabled \
        -Dalsa=enabled \
        -Dsndfile=enabled \
        -Daudiofile="$(emerald is-installed audiofile && printf "enabled" || printf "disabled")" \
        -Ddbus="$(emerald is-installed dbus && printf "enabled" || printf "disabled")" \
        -Dflac="$(emerald is-installed flac && printf "enabled" || printf "disabled")" \
        -Dfluidsynth="$(emerald is-installed fluidsynth && printf "enabled" || printf "disabled")" \
        -Dicu="$(emerald is-installed icu && printf "enabled" || printf "disabled")" \
        -Djack="$(emerald is-installed jack && printf "enabled" || printf "disabled")" \
        -Dlame="$(emerald is-installed lame && printf "enabled" || printf "disabled")" \
        -Dcdio_paranoia="$(emerald is-installed libcdio-paranoia  && printf "enabled" || printf "disabled")" \
        -Did3tag="$(emerald is-installed libid3tag && printf "enabled" || printf "disabled")" \
        -Diso9660="$(emerald is-installed libisofs && printf "enabled" || printf "disabled")" \
        -Dmad="$(emerald is-installed libmad && printf "enabled" || printf "disabled")" \
        -Dlibsamplerate="$(emerald is-installed libsamplerate && printf "enabled" || printf "disabled")" \
        -Dsoxr="$(emerald is-installed libsoxr && printf "enabled" || printf "disabled")" \
        -Dmpcdec=disabled \
        -Dmpg123="$(emerald is-installed mpg123 && printf "enabled" || printf "disabled")" \
        -Dpulse="$(emerald is-installed pulseaudio && printf "enabled" || printf "disabled")" \
        -Dpipewire="$(emerald is-installed pipewire && printf "enabled" || printf "disabled")" \
        -Dsmbclient="$(emerald is-installed samba && printf "enabled" || printf "disabled")" \
        -Dtwolame="$(emerald is-installed twolame && printf "enabled" || printf "disabled")" \
        -Dvorbis="$(emerald is-installed libvorbis && printf "enabled" || printf "disabled")" \
        -Dwavpack="$(emerald is-installed wavpack && printf "enabled" || printf "disabled")" \
        -Dhtml_manual=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    do_sysusers "${name}"
    do_tmpfiles "${name}"

    install -Dm644 00-vylen.conf -t "${PKG}/usr/lib/systemd/system/mpd.service.d/"
}
