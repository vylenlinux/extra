description="A collection of utilities to access MS-DOS disks"
homepage="https://www.gnu.org/software/mtools/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mtools
version=4.0.49
release=1
source="ftp://ftp.gnu.org/gnu/mtools/$name-$version.tar.bz2"

build() {
	cd $name-$version

	./configure --prefix=/usr \
	          --sysconfdir=/etc \
	          --disable-floppyd
	make
	sed -i Makefile -e 's|install-scripts install-info|install-scripts|'
	make -j1 prefix=$PKG/usr install
}
