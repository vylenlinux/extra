#!/bin/sh

# shellcheck disable=SC2034
description="Cinnamon window manager based on Mutter"
homepage="https://github.com/linuxmint/muffin"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=muffin
version=6.6.3
release=2

source="${name}-${version}.tar.gz::https://github.com/linuxmint/${name}/archive/refs/tags/${version}.tar.gz
    muffin.conf"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 "${SRC}/muffin.conf" -t "${PKG}/etc/ld.so.conf.d/"
}
