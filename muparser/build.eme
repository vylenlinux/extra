description="A fast math parser library"
homepage="https://sourceforge.net/projects/muparser/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=muparser
version=2.3.5
release=1
source="https://github.com/beltoforion/muparser/archive/v$version/$name-$version.tar.gz"

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-author 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
