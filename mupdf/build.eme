#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight PDF and XPS viewer"
homepage="https://mupdf.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mupdf
version=1.28.6
release=1
source="${name}-${version}.tar.gz::https://mupdf.com/downloads/archive/${name}-${version}-source.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}-source"
    export USE_SYSTEM_LIBS=yes

    make install \
        prefix="${PKG}/usr" \
        mandir="${PKG}/usr/share/man" \
        \
        XCFLAGS="-fpic -fcommon" \
        USE_SYSTEM_JBIG2DEC=no \
        USE_SYSTEM_OPENJPEG=no \
        USE_SYSTEM_GLUT=no \
        USE_SYSTEM_GUMBO=no

    ln -s mupdf-gl "${PKG}/usr/bin/${name}"
}
