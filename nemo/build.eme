#!/bin/sh

# shellcheck disable=SC2034
description="File manager for the Cinnamon desktop environment"
homepage="https://github.com/linuxmint/nemo"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nemo
version=6.8.0
release=1

source="${name}-${version}.tar.gz::https://github.com/linuxmint/${name}/archive/refs/tags/${version}.tar.gz
    https://github.com/linuxmint/${name}/commit/325e8df11e1f39683021c9052729ab9561619f90.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/325e8df11e1f39683021c9052729ab9561619f90.patch"

    vylen-meson "${name}-${version}" build \
        -Dxmp=false \
        -Dselinux=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
