description="Panel applet used to configure wired and wireless network connections"
homepage="https://gitlab.gnome.org/GNOME/network-manager-applet"
maintainer="Vylen Linux Team"

name=network-manager-applet
version=1.36.0
release=1
source="https://gitlab.gnome.org/GNOME/network-manager-applet/-/archive/$version/$name-$version.tar.gz"

build() {
	vylen-meson $name-$version build \
		-Dselinux=false \
		-Dteam=false \
		-Dwwan=$(emerald isinstalled modemmanager && printf "true" || printf "false")
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
