#!/bin/sh

# shellcheck disable=SC2034
description="Panel applet used to configure wired and wireless network connections"
homepage="https://gitlab.gnome.org/GNOME/network-manager-applet"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=network-manager-applet
version=1.36.0
release=2
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dselinux=false \
        -Dwwan="$(emerald is-installed libmm-glib && printf "true" || printf "false")"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # moved to nm-connection-editor
    rm -f "${PKG}/usr/bin/nm-connection-editor" \
        "${PKG}/usr/share/applications/nm-connection-editor.desktop" \
        "${PKG}/usr/share/icons/hicolor/22x22/apps/nm-device-wwan.png" \
        "${PKG}/usr/share/icons/hicolor/scalable/apps/nm-device-wwan-symbolic.svg" \
        "${PKG}/usr/share/man/man1/nm-connection-editor.1"

    rm -rf "${PKG}/usr/share/metainfo"
}
