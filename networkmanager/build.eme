#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Network connection manager and user applications"
homepage="https://networkmanager.dev/"
maintainer="Vylen Linux Team"

name=networkmanager
version=1.56.1
release=1

source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/${name}/${name}/-/archive/${version}/NetworkManager-${version}.tar.gz
    NetworkManager.conf"

backup="etc/NetworkManager/NetworkManager.conf"

build() {
    vylen-meson "NetworkManager-${version}" build \
        -Ddocs=false \
        -Dlibaudit=no \
        -Dmodem_manager="$(emerald isinstalled modemmanager && printf "true" || printf "false")" \
        -Dmodify_system=true \
        -Dnmtui=true \
        -Dovs=false \
        -Dpolkit_noauth_group=wheel \
        -Dppp=false \
        -Dqt=false \
        -Dselinux=false \
        -Dsession_tracking=no \
        -Dsystemd_journal=false \
        -Dsystemdsystemunitdir=no \
        -Dtests=no \
        -Dudev_dir=/lib/udev \
        -Dvapi=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 "${SRC}/NetworkManager.conf" -t "${PKG}/etc/NetworkManager/"
    do_service "${name}"
}
