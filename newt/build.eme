#!/bin/sh

# shellcheck disable=SC2034
description="Not Erik's Windowing Toolkit - text mode windowing with slang"
homepage="http://ftp.kaist.ac.kr/macports/distfiles/libnewt/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=newt
version=0.52.25
release=1
source="https://ftp.kaist.ac.kr/macports/distfiles/libnewt/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # shellcheck disable=SC2016
    sed \
        -e 's/^LIBNEWT =/#&/' \
        -e '/install -m 644 $(LIBNEWT)/ s/^/#/' \
        -e 's/$(LIBNEWT)/$(LIBNEWTSONAME)/g' \
    -i Makefile.in

    ./configure \
        --prefix=/usr \
        --with-gpm-support  \
        --without-tcl

    make
    make DESTDIR="${PKG}" install
}
