description="Firewalling, NAT, and packet mangling for linux"
homepage="https://netfilter.org/projects/nftables/"
maintainer="Vylen Linux Team"

name=nftables
version=1.1.6
release=1
source="https://www.netfilter.org/pub/nftables/nftables-$version.tar.xz
    nftables.nft
    run.$name"

build() {
    cd $name-$version

    CONFIG_SHELL=/bin/bash ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/usr/share \
        --with-cli=readline \
        --with-json \
        --disable-debug
    make
    make DESTDIR=$PKG install

    cd py

    gpep517 build-wheel \
        --wheel-dir $SRC/$name-$version/.dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "$PKG" \
        $SRC/$name-$version/.dist/*.whl

    install -D -m 600 $SRC/nftables.nft $PKG/etc/nftables.nft
	install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run

	ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
    rm -r $PKG/usr/share/doc
}
