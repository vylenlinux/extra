#!/isr/bin/env sh

# shellcheck disable=SC2034
description="Firewalling, NAT, and packet mangling for linux"
homepage="https://netfilter.org/projects/nftables/"
maintainer="Vylen Linux Team"

name=nftables
version=1.1.6
release=1

source="https://www.netfilter.org/pub/${name}/${name}-${version}.tar.xz
    ${name}.nft"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    CONFIG_SHELL=/bin/bash ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/usr/share \
        --with-cli=readline \
        --with-json \
        --disable-debug

    make
    make DESTDIR="${PKG}" install

    # shellcheck disable=SC2164
    cd py

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
    install -Dm600 "${SRC}/${name}.nft" -t "${PKG}/etc/"

    openrc_add "${name}"
}
