#!/bin/sh

# shellcheck disable=SC2034
description="JavaScript runtime built on Chrome's V8 JavaScript engine"
homepage="https://nodejs.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nodejs
version=26.13.1
release=1

source="${name}-${version}.tar.xz::https://nodejs.org/dist/v${version}/node-v${version}.tar.xz
    fix-build-with-icu-79.patch"

build() {
    # shellcheck disable=SC2164
    cd "node-v${version}"
    patch -Np1 -i "${SRC}/fix-build-with-icu-79.patch"

    ./configure \
        --prefix=/usr \
        --shared-cares \
        --shared-zlib \
        --shared-libuv \
        --with-intl=system-icu

    make
    make DESTDIR="${PKG}" install
}
