#!/bin/sh

# shellcheck disable=SC2034
description="JavaScript runtime built on Chrome's V8 JavaScript engine"
homepage="https://nodejs.org"
maintainer="Vylen Linux Team"

name=nodejs
version=26.7.0
release=1
source="${name}-${version}.tar.xz::https://nodejs.org/dist/v${version}/node-v${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "node-v${version}"

    # fix build with ICU 76
    sed '/pkgicu/s/icu-i18n/& icu-uc/' -i configure.py

    ./configure \
        --prefix=/usr \
        --shared-cares \
        --shared-zlib \
        --shared-libuv \
        --with-intl=system-icu

    make
    make DESTDIR="${PKG}" install

    find "${PKG}" -type f \( \
        -name 'README.md' -o \
        -name 'AUTHORS.md' -o \
        -name 'INSTALL.md' -o \
        -name 'TODO.org' -o \
        -name 'ChangeLog' -o \
        -name 'NEWS' \
    \) -delete
}
