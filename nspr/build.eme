#!/bin/sh

# shellcheck disable=SC2034
description="Netscape Portable Runtime"
homepage="https://firefox-source-docs.mozilla.org/nspr/index.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nspr
version=4.40
release=1
source="https://archive.mozilla.org/pub/${name}/releases/v${version}/src/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}/${name}"

    # disables installing two unneeded scripts
    sed -ri 's#^(RELEASE_BINS =).*#\1#' pr/src/misc/Makefile.in

    # disables installing the static libraries
    # shellcheck disable=SC2016
    sed -i 's#$(LIBRARY) ##' config/rules.mk

    ./configure \
        --prefix=/usr \
        --with-mozilla \
        --with-pthreads \
        --enable-64bit

    make
    make DESTDIR="${PKG}" install
}
