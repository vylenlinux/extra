#!/bin/sh

# shellcheck disable=SC2034
description="Netscape Portable Runtime"
homepage="https://firefox-source-docs.mozilla.org/nspr/index.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nspr
version=4.41
release=1

_version="$(printf '%s' "${version}" | tr '.' '_')"
source="https://github.com/mozilla/${name}/archive/NSPR_${_version}_RTM/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-NSPR_${_version}_RTM"

    # disables installing two unneeded scripts
    sed 's#^(RELEASE_BINS =).*#\1#' -ri pr/src/misc/Makefile.in

    # disables installing the static libraries
    # shellcheck disable=SC2016
    sed 's#$(LIBRARY) ##' -i config/rules.mk

    ./configure \
        --prefix=/usr \
        --with-mozilla \
        --with-pthreads \
        --enable-64bit

    make
    make DESTDIR="${PKG}" install
}
