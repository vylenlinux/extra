#!/bin/sh

# shellcheck disable=SC2034
description="Network Security Services"
homepage="https://firefox-source-docs.mozilla.org/security/nss/index.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nss
version=3.132
release=1

source="https://ftp.mozilla.org/pub/security/${name}/releases/NSS_$(printf "%s" "${version}" | sed 's/\./_/g')_RTM/src/${name}-${version}.tar.gz
    ${name}-standalone.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # taken from LFS
    patch -Np1 -i "${SRC}/${name}-standalone.patch"

    # shellcheck disable=SC2164
    cd "${name}"
        make \
            BUILD_OPT=1 \
            NSPR_INCLUDE_DIR=/usr/include/nspr \
            USE_SYSTEM_ZLIB=1 \
            ZLIB_LIBS=-lz \
            NSS_ENABLE_WERROR=0 \
            USE_64=1 \
            NSS_USE_SYSTEM_SQLITE=1 \
            NSS_DISABLE_GTESTS=1
    # shellcheck disable=SC2164
    cd ../dist

    for xx in Linux*/lib/*.chk Linux*/lib/libfreebl.a Linux*/lib/*.so; do
        install -Dm644 "${xx}" -t "${PKG}/usr/lib/"
    done

    install -dm755 "${PKG}/usr/include/nss"
    cp -RL public/nss/* -t "${PKG}/usr/include/nss/"
    cp -RL private/nss/* -t "${PKG}/usr/include/nss/"
    chmod 644 "${PKG}/usr/include/nss"/*

    for xx in certutil nss-config pk12util; do
        install -Dm755 Linux*/"bin/${xx}" -t "${PKG}/usr/bin/"
    done

    install -Dm644 Linux*/lib/pkgconfig/nss.pc -t "${PKG}/usr/lib/pkgconfig/"
}
