#!/usr/bin/env sh

# shellcheck disable=SC2034
description="NTFS filesystem driver and utilities"
homepage="https://www.tuxera.com/community/open-source-ntfs-3g/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ntfs-3g
version=2026.9.18
release=1
source="${name}-${version}.tar.gz::https://github.com/tuxera/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    # shellcheck disable=SC2016
    sed -i 's|$(DESTDIR)/sbin|$(DESTDIR)/usr/bin|g' \
        ntfsprogs/Makefile.in \
        src/Makefile.in

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --disable-static \
        --with-fuse=external \
        --disable-ldconfig

    install -d "${PKG}/lib"

    make
    make rootbindir=/usr/bin rootsbindir=/usr/bin rootlibdir=/usr/lib DESTDIR="${PKG}" install

    ln -s ntfs-3g "${PKG}/usr/bin/mount.ntfs"
    ln -s ntfs-3g.8 "${PKG}/usr/share/man/man8/mount.ntfs.8"

    rmdir "${PKG}/lib"
}
