#!/bin/sh

# shellcheck disable=SC2034
description="NTFS filesystem driver and utilities"
homepage="https://www.tuxera.com/community/open-source-ntfs-3g/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ntfs-3g
version=2026.11.23
release=1
source="${name}-${version}.tar.gz::https://github.com/tuxera/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    # shellcheck disable=SC2016
    sed 's|$(DESTDIR)/sbin|$(DESTDIR)/usr/bin|g' -i \
        ntfsprogs/Makefile.in \
        src/Makefile.in

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        \
        --with-fuse=external \
        \
        --disable-static \
        --disable-ldconfig

    make
    make rootbindir=/usr/bin rootsbindir=/usr/bin rootlibdir=/usr/lib DESTDIR="${PKG}" install

    ln -s "${name}" "${PKG}/usr/bin/mount.ntfs"
    ln -s "${name}.8" "${PKG}/usr/share/man/man8/mount.ntfs.8"
}
