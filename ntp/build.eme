#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Network Time Protocol reference implementation"
homepage="https://www.ntp.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ntp
version=4.2.8p18
release=3
backup="etc/${name}.conf"

source="https://www.eecis.udel.edu/~${name}/${name}_spool/ntp4/${name}-${version%.*}/${name}-${version}.tar.gz
    fix.build.patch
    ntp-4.2.8p18-openssl_4-1.patch
    ${name}.conf
    ntp.sysusers
    ntpd.service
    ntpdate.service"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    # l_stdlib.h re-declares memchr, which conflicts with glibc's _Generic macro
    sed -i '/extern void \*memchr/d' include/l_stdlib.h

    export CFLAGS="${CFLAGS} \
        -Wno-discarded-qualifiers \
        -Wno-incompatible-pointer-types"

    patch -Np1 -i "${SRC}/fix.build.patch"
    patch -Np1 -i "${SRC}/ntp-4.2.8p18-openssl_4-1.patch"

    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --enable-linuxcaps \
        --with-lineeditlibs=readline

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.conf" -t "${PKG}/etc/"
    install -Dm644 "${SRC}/ntpd.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 "${SRC}/ntpdate.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 "${SRC}/ntp.sysusers" "${PKG}/usr/lib/sysusers.d/ntp.conf"

    # remove unused (empty) dir
    rmdir "${PKG}/usr/sbin"
}
