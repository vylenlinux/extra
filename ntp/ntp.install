#!/bin/sh

pre_install() {
    getent group ntp >/dev/null || groupadd -g 87 ntp
    getent passwd ntp >/dev/null || useradd -r -M -g ntp -G ntp -c "Network Time Protocol" -d /var/lib/ntp -s /usr/bin/nologin -u 87 ntp
}

post_remove() {
    getent passwd ntp >/dev/null && userdel ntp
    getent group ntp >/dev/null && groupdel ntp
}
