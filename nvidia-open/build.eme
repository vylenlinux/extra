#!/bin/sh

# shellcheck disable=SC2034
description="NVIDIA Linux Display Driver (Latest Production Branch)"
homepage="https://www.nvidia.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nvidia-open
version=615.78.08
release=1

source="${name}-${version}.tar.xz::https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/NVIDIA-kernel-module-source-${version}.tar.xz
    buildmodules-${name}.sh
    dkms.conf.in"

build() {
    # shellcheck disable=SC2164
    cd "NVIDIA-kernel-module-source-${version}"

    # Attempt to make builds reproducible
    sed -i "s/^  HOSTNAME.*/  HOSTNAME = echo vylen/" utils.mk
    sed -i "s/^WHOAMI.*/WHOAMI = echo emerald/" utils.mk
    sed -i "s/^DATE.*/DATE = date -r version.mk/" utils.mk

    sed -i "s/__VERSION_STRING/${version}/" kernel-open/dkms.conf
    # shellcheck disable=SC2016
    sed -i 's/__JOBS/`nproc`/' kernel-open/dkms.conf
    sed -i 's/__EXCLUDE_MODULES//' kernel-open/dkms.conf
    sed -i 's/__DKMS_MODULES//' kernel-open/dkms.conf
    sed -i 's/NV_EXCLUDE_BUILD_MODULES/IGNORE_PREEMPT_RT_PRESENCE=1 NV_EXCLUDE_BUILD_MODULES/' kernel-open/dkms.conf

    # Additional parameters for open kernel modules
    cat "${SRC}/dkms.conf.in" >> kernel-open/dkms.conf

    install -dm755 "${PKG}/usr/src/nvidia-${version}"

    cp -dr --no-preserve=ownership . -t "${PKG}/usr/src/nvidia-${version}/"
    mv "${PKG}/usr/src/nvidia-${version}/kernel-open/dkms.conf" -t "${PKG}/usr/src/nvidia-${version}/"

    # dkms build modules script
    mkdir -p "${PKG}/var/lib/dkms"
    sed -e "s/@name@/nvidia/g" -e "s/@version@/${version}/g" "${SRC}/buildmodules-${name}.sh" > "${PKG}/var/lib/dkms/buildmodules-${name}.sh"
}
