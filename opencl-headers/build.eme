#!/bin/sh

# shellcheck disable=SC2034
description="OpenCL (Open Computing Language) header files"
homepage="https://www.khronos.org/opencl/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=opencl-headers
version=2026.05.29
release=1
source="${name}-${version}.tar.gz::https://github.com/KhronosGroup/${name}/archive/v${version}.tar.gz"

build() {
    cmake -S "OpenCL-Headers-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
