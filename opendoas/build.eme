#!/bin/sh

# shellcheck disable=SC2034
description="A portable fork of the OpenBSD 'doas' command"
homepage="https://github.com/Duncaen/OpenDoas"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=opendoas
version=6.8.2
release=1
backup="etc/doas.conf"

source="https://github.com/Duncaen/${name}/releases/download/v${version}/${name}-${version}.tar.xz
    better-wayland-support.patch
    doas.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/better-wayland-support.patch"

    ./configure \
        --prefix=/usr \
        --with-timestamp

    make
    make DESTDIR="${PKG}" install

    rm -rf "${PKG}/etc/pam.d"

    install -Dm644 "${SRC}/doas.conf" -t "${PKG}/etc/"
    do_pam doas
}
