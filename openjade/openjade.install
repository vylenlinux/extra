#!/bin/sh

update_openjade_catalog() {
    install-catalog --add \
        /etc/sgml/openjade-1.3.2.cat \
        /usr/share/sgml/openjade-1.3.2/catalog \
    > /dev/null 2>&1

    install-catalog --add \
        /etc/sgml/openjade.cat \
        /etc/sgml/openjade-1.3.2.cat \
    > /dev/null 2>&1
}

post_install() {
    update_openjade_catalog
}

post_upgrade() {
    update_openjade_catalog
}
