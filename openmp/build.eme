#!/usr/bin/env sh

# shellcheck disable=SC2034
description="LLVM OpenMP Runtime Library"
homepage="https://openmp.llvm.org/"
maintainer="Vylen Linux Team"

name=openmp
version=22.1.5
release=1
source="https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/llvm-project-${version}.src.tar.xz"

build() {
    CC=clang CXX=clang++ cmake -S "llvm-project-${version}.src/openmp" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DLIBOMP_INSTALL_ALIASES=OFF

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
