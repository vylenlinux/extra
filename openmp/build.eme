#!/bin/sh

# shellcheck disable=SC2034
description="LLVM OpenMP Runtime Library"
homepage="https://openmp.llvm.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=openmp
version=23.1.5
release=1
source="llvm-${version}.tar.xz::https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/llvm-project-${version}.src.tar.xz"

build() {
    export CC=clang
    export CXX=clang++

    cmake -S "llvm-project-${version}.src/runtimes" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DLLVM_ENABLE_RUNTIMES=openmp \
        -DLIBOMP_INSTALL_ALIASES=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
