#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Free version of the SSH connectivity tools"
homepage="https://www.openssh.com/"
maintainer="Vylen Linux Team"

name=openssh
version=10.3p1
release=1

source="https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/${name}-${version}.tar.gz
    run.sshd"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc/ssh \
        --libexecdir="/usr/lib/${name}" \
        --with-md5-passwords \
        --with-privsep-path=/var/lib/sshd \
        --without-zlib-version-check

    make
    make DESTDIR="${PKG}" install

    install -v -m755 contrib/ssh-copy-id "${PKG}/usr/bin"
    install -v -m644 contrib/ssh-copy-id.1 "${PKG}/usr/share/man/man1"

	sed '/^#ChallengeResponseAuthentication yes$/c ChallengeResponseAuthentication no' -i "${PKG}/etc/ssh/sshd_config"

	install -Dm755 "${SRC}/run.sshd" "${PKG}/etc/sv/sshd/run"
	ln -s /run/runit/supervise.sshd "${PKG}/etc/sv/sshd/supervise"
}
