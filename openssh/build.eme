#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Free version of the SSH connectivity tools"
homepage="https://www.openssh.com/"
maintainer="Vylen Linux Team"

name=openssh
version=10.4p1
release=1
source="https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/${name}-${version}.tar.gz"
backup="etc/ssh/sshd_config"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc/ssh \
        --libexecdir="/usr/lib/${name}" \
        --with-md5-passwords \
        --with-privsep-path=/var/lib/sshd \
        --without-zlib-version-check

    make
    make DESTDIR="${PKG}" install

    install -Dm755 contrib/ssh-copy-id -t "${PKG}/usr/bin/"
    install -Dm644 contrib/ssh-copy-id.1 -t "${PKG}/usr/share/man/man1/"

    sed '/^#ChallengeResponseAuthentication yes$/c ChallengeResponseAuthentication no' -i "${PKG}/etc/ssh/sshd_config"
    do_service sshd ssh-agent
}
