#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Management tools and libraries relating to cryptography"
homepage="https://www.openssl.org"
maintainer="Vylen Linux Team"

name=openssl
version=3.6.3
release=1
source="https://github.com/${name}/${name}/releases/download/${name}-${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./config \
        --prefix=/usr \
        --libdir=lib \
        --openssldir=/etc/ssl \
        enable-ec_nistp_64_gcc_128 \
        enable-camellia \
        enable-seed \
        enable-rfc3779 \
        enable-ktls \
        enable-argon2 \
        no-mdc2 \
        no-ec2m \
        no-sm2 \
        no-sm4 \
        shared \
        threads \
        zlib

    sed -i "s|-O3|${CFLAGS}|" Makefile

    make depend
    make
    make MANSUFFIX=ssl DESTDIR="${PKG}" install_sw install_ssldirs install_man_docs

    find "${PKG}" -name "*fips*" -delete

    # fix linkage of libnvidia.pkcs11.so
    ln -s libcrypto.so "${PKG}/usr/lib/libcrypto.so.1.1"
}
