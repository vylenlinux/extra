#!/bin/sh

# shellcheck disable=SC2034
description="Utility to detect other OSes on a set of drives"
homepage="https://joeyh.name/code/os-prober/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=os-prober
version=1.85
release=1
source="${name}-${version}.tar.xz::http://http.debian.net/debian/pool/main/o/${name}/${name}_${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make

    install -Dm755 linux-boot-prober -t "${PKG}/usr/bin/"
    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm755 newns -t "${PKG}/usr/lib/os-prober/"
    install -Dm755 common.sh -t "${PKG}/usr/share/os-prober/"

    for dir in os-probes os-probes/mounted os-probes/init linux-boot-probes linux-boot-probes/mounted; do
        install -Dm755 "${dir}/common"/* -t "${PKG}/usr/lib/${dir}/"
        [ -d "${dir}/x86" ] && cp -r "${dir}/x86"/* "${PKG}/usr/lib/${dir}/"
    done

    install -Dm755 os-probes/mounted/powerpc/20macosx "${PKG}/usr/lib/os-probes/mounted/"
    install -dm755 "${PKG}/var/lib/os-prober"
}
