#!/bin/sh

# shellcheck disable=SC2034
description="Operating system and container binary deployment and upgrades"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://ostreedev.github.io/ostree/"

name=ostree
version=2026.7
release=1
source="${name}-${version}.tar.xz::https://github.com/${name}dev/${name}/releases/download/v${version}/lib${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "lib${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        \
        --with-builtin-grub2-mkconfig \
        --with-ed25519-libsodium \
        --with-openssl \
        --with-curl

    make
    make DESTDIR="${PKG}" install
}
