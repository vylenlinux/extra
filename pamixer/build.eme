description="Pulseaudio command-line mixer like amixer"
homepage="https://github.com/cdemoulins/pamixer"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pamixer
version=1.6
release=1
source="https://github.com/cdemoulins/$name/archive/$version/$name-$version.tar.gz"

build() {
	cd $name-$version
        vylen-meson build
        meson compile -C build
        meson install --no-rebuild -C build --destdir=$PKG

}
