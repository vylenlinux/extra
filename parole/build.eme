#!/bin/sh

# shellcheck disable=SC2034
description="DVD/CD/music player for Xfce that uses GStreamer"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=parole
version=4.20.0
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/apps/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
