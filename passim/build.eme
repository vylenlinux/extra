#!/bin/sh

# shellcheck disable=SC2034
description="A local caching server"
homepage="https://github.com/hughsie/passim"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=passim
version=0.1.13
release=1
backup="etc/${name}.conf"
source="https://github.com/hughsie/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm "${PKG}/var/lib/${name}/data"/*
}
