#!/bin/sh

# shellcheck disable=SC2034
description="PCI bus configuration space access library and tools"
homepage="https://mj.ucw.cz/sw/pciutils/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pciutils
version=3.15.0
release=1
source="https://git.kernel.org/pub/scm/utils/${name}/${name}.git/snapshot/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make \
        OPT="${CFLAGS} -fPIC -DPIC" \
        PREFIX=/usr \
        SHAREDIR=/usr/share/hwdata \
        MANDIR=/usr/share/man \
        SHARED=yes
        SBINDIR=/usr/bin

    make \
        PREFIX=/usr \
        SHAREDIR=/usr/share/hwdata \
        MANDIR=/usr/share/man \
        SHARED=yes \
        SBINDIR=/usr/bin \
        DESTDIR="${PKG}" \
        install install-lib

    chmod 755 "${PKG}/usr/lib/libpci.so"
}
