description="Extremely fast and lightweight file manager"
homepage="https://lxde.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pcmanfm
version=1.4.0
release=1
source="https://github.com/lxde/$name/archive/refs/tags/$version.tar.gz
	pcmanfm-desktop-onlyshowin.patch  pcmanfm-transient-dialog.patch"

build() {
	cd $name-$version

	patch -Np1 -i $SRC/pcmanfm-desktop-onlyshowin.patch  
	patch -Np1 -i $SRC/pcmanfm-transient-dialog.patch

	autoreconf -fiv
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--with-gtk=3
	make
	make DESTDIR=$PKG install

}
