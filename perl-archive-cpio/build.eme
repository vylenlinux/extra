#!/bin/sh

# shellcheck disable=SC2034
description="Module for manipulations of cpio archives"
homepage="https://metacpan.org/pod/Archive::Cpio"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-archive-cpio
version=0.10
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/P/PI/PIXEL/Archive-Cpio-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Archive-Cpio-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
