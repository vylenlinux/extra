#!/bin/sh

# shellcheck disable=SC2034
description="Provide a perl interface to ZIP archive files"
homepage="https://search.cpan.org/dist/Archive-Zip/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-archive-zip
version=1.68
release=1
source="${name}-${version}.tar.gz::https://search.cpan.org/CPAN/authors/id/P/PH/PHRED/Archive-Zip-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Archive-Zip-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
