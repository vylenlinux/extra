#!/bin/sh

# shellcheck disable=SC2034
description="Parse and validate simple name/value option pairs"
homepage="https://metacpan.org/release/Data-OptList"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-data-optlist
version=0.115
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/R/RJ/RJBS/Data-OptList-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Data-OptList-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
