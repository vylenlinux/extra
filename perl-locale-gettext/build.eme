#!/bin/sh

# shellcheck disable=SC2034
description="Perl bindings for POSIX i18n gettext functions"
homepage="https://metacpan.org/release/Locale-gettext/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-locale-gettext
version=1.07
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/P/PV/PVANDRY/Locale-gettext-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Locale-gettext-${version}"

    # shellcheck disable=SC2155
    export CFLAGS="$(perl -MConfig -E 'say $Config{ccflags}')"
    perl -I. Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
