#!/bin/sh

# shellcheck disable=SC2034
description="Simple, compact and correct parameter-checking functions"
homepage="https://metacpan.org/dist/Params-SomeUtil"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-params-someutil
version=1.12
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/Params-SomeUtil-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Params-SomeUtil-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
