#!/bin/sh

# shellcheck disable=SC2034
description="Install subroutines into packages easily"
homepage="https://metacpan.org/release/Sub-Install"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-sub-install
version=0.929
release=1
source="${name}-${version}.tar.gz::https://search.cpan.org/CPAN/authors/id/R/RJ/RJBS/Sub-Install-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Sub-Install-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
