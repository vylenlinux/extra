#!/bin/sh

# shellcheck disable=SC2034
description="Set a sub's prototype"
homepage="https://metacpan.org/dist/Sub-Prototype"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-sub-prototype
version=0.03
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/E/ET/ETHER/Sub-Prototype-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Sub-Prototype-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
