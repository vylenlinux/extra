#!/bin/sh

# shellcheck disable=SC2034
description="Generic namespace helpers (ported from SAX2)"
homepage="https://search.cpan.org/dist/XML-NamespaceSupport"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-xml-namespacesupport
version=1.12
release=1
source="${name}-${version}.tar.gz::http://search.cpan.org/CPAN/authors/id/P/PE/PERIGRIN/XML-NamespaceSupport-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "XML-NamespaceSupport-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
