#!/bin/sh

# shellcheck disable=SC2034
description="Simple API for XML"
homepage="https://search.cpan.org/dist/XML-SAX"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-xml-sax
version=1.02
release=1
source="${name}-${version}.tar.gz::http://search.cpan.org/CPAN/authors/id/G/GR/GRANTM/XML-SAX-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "XML-SAX-${version}"
    perl Makefile.PL

    make
    PERLLIB=blib/lib make DESTDIR="${PKG}" install
}
