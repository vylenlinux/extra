description="Collection of simple PIN or pass-phrase entry dialogs which utilize the Assuan protocol"
homepage="https://gnupg.org/related_software/pinentry/"
maintainer="Vylen Linux Team"

name=pinentry
version=1.3.2
release=1
source="https://www.gnupg.org/ftp/gcrypt/$name/$name-$version.tar.bz2"

build() {
	cd $name-$version

	opt=""
	emerald isinstalled emacs || opt="$opt --disable-pinentry-emacs"
	emerald isinstalled gtk2 || opt="$opt --disable-pinentry-gtk2"
	emerald isinstalled qt5 || opt="$opt --disable-pinentry-qt5"
	emerald isinstalled qt6-base || opt="$opt --disable-pinentry-qt"
	emerald isinstalled gcr || opt="$opt --disable-pinentry-gnome3"

	CXXFLAGS="$CXXFLAGS -fPIC"

	./configure --prefix=/usr \
	    --enable-pinentry-tty \
	    --enable-pinentry-curses \
	    --enable-fallback-curses \
	    $opt
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share
}
