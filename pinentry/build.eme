#!/bin/sh

# shellcheck disable=SC2034
description="Collection of simple PIN or pass-phrase entry dialogs which utilize the Assuan protocol"
homepage="https://gnupg.org/related_software/pinentry/"
maintainer="Vylen Linux Team"

name=pinentry
version=1.3.3
release=1
source="https://www.gnupg.org/ftp/gcrypt/${name}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    emerald is-installed emacs || disable_emacs="--disable-pinentry-emacs"
    emerald is-installed gtk2 || disable_gtk2="--disable-pinentry-gtk2"
    emerald is-installed qt5 || disable_qt5="--disable-pinentry-qt5"
    emerald is-installed qt6-base || disable_qt6_base="--disable-pinentry-qt"
    emerald is-installed gcr || disable_gcr="--disable-pinentry-gnome3"

    CXXFLAGS="${CXXFLAGS} -fPIC"

    # shellcheck disable=SC2086
    ./configure \
        --prefix=/usr \
        --enable-pinentry-tty \
        --enable-pinentry-curses \
        --enable-fallback-curses \
        "${disable_emacs}" \
        "${disable_gtk2}" \
        "${disable_qt5}" \
        "${disable_qt6_base}" \
        "${disable_gcr}"

    make
    make DESTDIR="${PKG}" install
}
