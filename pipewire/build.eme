#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Server and user space API to deal with multimedia"
homepage="https://github.com/PipeWire/pipewire"
maintainer="Vylen Linux Team"

name=pipewire
version=1.6.7
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz
    vylen-pipewire-launcher
    ${name}.desktop"

build() {
    export CFLAGS="${CFLAGS} \
        -Wno-error=discarded-qualifiers"

    vylen-meson "${name}-${version}" build \
        -Ddocs=disabled \
        -Dvulkan=disabled \
        -Dexamples=disabled \
        -Dsession-managers=[]

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # enable alsa by default
    install -Dm644 /dev/null "${PKG}/usr/share/pipewire/media-session.d/with-alsa"
    mkdir -p "${PKG}/etc/alsa/conf.d"

    ln -s /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf -t "${PKG}/etc/alsa/conf.d/"
    ln -s /usr/share/alsa/alsa.conf.d/50-pipewire.conf -t "${PKG}/etc/alsa/conf.d/"

    # install vylen pipewire launcher
    install -Dm755 "${SRC}/vylen-pipewire-launcher" -t "${PKG}/usr/bin/"

    # install desktop file
    install -Dm644 "${SRC}/pipewire.desktop" -t "${PKG}/etc/xdg/autostart/"
}
