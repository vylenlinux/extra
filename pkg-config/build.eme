#!/bin/sh

# shellcheck disable=SC2034
description="A tool for passing the include path and/or library paths to build tools during the configure and make file execution"
homepage="https://pkg-config.freedesktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pkg-config
version=0.29.2
release=2

source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/${name}/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz
    copy-m4.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${name}-${version}"
    patch -Np1 -i "${SRC}/copy-m4.patch"

    ./autogen.sh --no-configure
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
