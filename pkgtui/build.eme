#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Interactive TUI for the emerald package manager"
maintainer="Vylen Linux Team"
homepage="https://gitlab.com/celestifyx/pkgtui"

name=pkgtui
version=1.0.3
release=1
source="https://gitlab.com/celestifyx/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build --release
    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
