#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Interactive TUI for the package manager"
maintainer="Vylen Linux Team"
homepage="https://gitlab.com/celestifyx/pkgtui"

name=pkgtui
version=1.0.0
release=1
source="https://gitlab.com/celestifyx/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    PKG_COMMAND=emerald \
        PKG_REPO_LIST=/etc/emerald.repo \
        PKG_INSTALLED_DB=/var/lib/emerald/db \
        PKG_MASK_FILE=/etc/emerald.mask \
        PKG_BUILDFILE_NAME=build.eme \
    cargo build --release

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
