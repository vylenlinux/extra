#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The base for Plasma Desktop, Mobile, and Bigscreen containing shared KCMs, applets and multiple libraries"
homepage="https://kde.org/plasma-desktop/"
maintainer="Vylen Linux Team"

name=plasma-workspace
version=6.7.4
release=2
source="https://download.kde.org/stable/plasma/${version}/${name}-${version}.tar.xz"

build() {
    # Fix doc build with libxml2 2.15
    # shellcheck disable=SC2038
    # shellcheck disable=SC2185
    find -name index.docbook | xargs sed -e 's|index.html "|index.html"|g' -i

    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DBUILD_TESTING=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
