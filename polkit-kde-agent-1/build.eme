#!/bin/sh

# shellcheck disable=SC2034
description="Daemon providing a Polkit authentication UI for Plasma"
homepage="https://invent.kde.org/plasma/polkit-kde-agent-1"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=polkit-kde-agent-1
version=6.8.2
release=1
source="${name}-${version}.tar.bz2::https://invent.kde.org/plasma/${name}/-/archive/v${version}/${name}-v${version}.tar.bz2"

build() {
    cmake -S "${name}-v${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR="lib/${name}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
