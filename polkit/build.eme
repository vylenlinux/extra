#!/bin/sh

# shellcheck disable=SC2034
description="Toolkit for defining and handling authorizations"
homepage="https://freedesktop.org/software/polkit/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=polkit
version=128
release=1

source="${name}-${version}.tar.gz::https://github.com/polkit-org/${name}/archive/refs/tags/${version}.tar.gz
    0003-meson-Enable-socket-activated-agent-helper-by-defaul.patch
    0004-agent-helper-Send-standard-error-to-journal.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/0003-meson-Enable-socket-activated-agent-helper-by-defaul.patch"
    patch -d "${name}-${version}" -Np1 -i "${SRC}/0004-agent-helper-Send-standard-error-to-journal.patch"

    vylen-meson "${name}-${version}" build -Dos_type=lfs
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    chown polkitd "${PKG}/etc/polkit-1/rules.d" \
        "${PKG}/usr/share/polkit-1/rules.d"

    chmod 700 "${PKG}/etc/polkit-1/rules.d" \
        "${PKG}/usr/share/polkit-1/rules.d"

    chmod 4775 "${PKG}/usr/bin/pkexec" \
        "${PKG}/usr/lib/polkit-1/polkit-agent-helper-1"
}
