#!/bin/sh

pre_install() {
    getent group polkitd >/dev/null || groupadd -r polkitd
    getent passwd polkitd >/dev/null || useradd -r -M -g polkitd -G polkitd -c "PolicyKit Daemon Owner" -d /etc/polkit-1 -s /usr/bin/nologin polkitd
}

post_remove() {
    getent passwd polkitd >/dev/null && userdel polkitd
    getent group polkitd >/dev/null && groupdel polkitd
}
