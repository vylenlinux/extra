#!/bin/sh

# shellcheck disable=SC2034
description="System76 Pop GTK+ Theme"
homepage="https://github.com/pop-os/gtk-theme"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pop-gtk-theme
version=5.5.1
release=1
source="${name}-${version}.tar.gz::https://github.com/pop-os/gtk-theme/archive/refs/tags/v${version}.tar.gz"

build() {
    vylen-meson "gtk-theme-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
