#!/bin/sh

# shellcheck disable=SC2034
description="Modular IPC-based desktop launcher service"
homepage="https://github.com/pop-os/launcher"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pop-launcher
version=1.11.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pop-os/launcher/archive/refs/tags/epoch-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "launcher-epoch-${version}"

    sed 's/lto = "fat"/lto = "thin"/g' -i Cargo.toml
    cargo fetch --locked

    export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=lld"
    export CC=clang

    just build-release --frozen
    just rootdir="${PKG}" install
}
