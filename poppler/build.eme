#!/bin/sh

# shellcheck disable=SC2034
description="PDF rendering library and command line tools used to manipulate PDF files"
homepage="https://poppler.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=poppler
version=26.11.0
release=1
source="https://poppler.freedesktop.org/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DENABLE_UNSTABLE_API_ABI_HEADERS=ON \
        -DENABLE_UTILS=ON \
        -DENABLE_CPP=ON \
        -DBUILD_CPP_TESTS=OFF \
        -DBUILD_MANUAL_TESTS=OFF \
        -DENABLE_QT5="$(emerald is-installed qt5 && printf "ON" || printf "OFF")" \
        -DBUILD_QT5_TESTS=OFF \
        -DENABLE_QT6="$(emerald is-installed qt6-base && printf "ON" || printf "OFF")" \
        -DBUILD_QT6_TESTS=OFF \
        -DENABLE_GPGME=OFF \
        -DENABLE_BOOST="$(emerald is-installed boost && printf "ON" || printf "OFF")" \
        -DENABLE_GLIB="$(emerald is-installed gobject-introspection && printf "ON" || printf "OFF")" \
        -DENABLE_LCMS="$(emerald is-installed lcms2 && printf "ON" || printf "OFF")" \
        -DENABLE_LIBTIFF="$(emerald is-installed libtiff && printf "ON" || printf "OFF")" \
        -DENABLE_NSS3="$(emerald is-installed nss && printf "ON" || printf "OFF")" \
        -DENABLE_LIBOPENJPEG="$(emerald is-installed openjpeg2 && echo "openjpeg2" || echo "none")" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # cleanup
    rm -rf "${PKG}/usr/include/${name}/glib" \
        "${PKG}/usr/include/${name}/qt5" \
        "${PKG}/usr/include/${name}/qt6" \
        "${PKG}/usr/lib"/gir* \
        "${PKG}/usr/share"/gir*

    rm -f "${PKG}/usr/lib/pkgconfig/${name}-glib.pc" \
        "${PKG}/usr/lib/pkgconfig/${name}-qt5.pc" \
        "${PKG}/usr/lib/pkgconfig/${name}-qt6.pc" \
        "${PKG}/usr/lib"/libpoppler-glib.* \
        "${PKG}/usr/lib"/libpoppler-qt5.* \
        "${PKG}/usr/lib"/libpoppler-qt6.*
}
