#!/bin/sh

# shellcheck disable=SC2034
description="Makes power profiles handling available over D-Bus"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://gitlab.freedesktop.org/upower/power-profiles-daemon"

name=power-profiles-daemon
version=0.30
release=1
source="https://gitlab.freedesktop.org/upower/${name}/-/archive/${version}/${name}-${version}.tar.bz2"

build() {
    vylen-meson "${name}-${version}" build \
        -Dgtk_doc=false \
        -Dpylint=disabled \
        -Dtests=false \
        -Dbashcomp=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
