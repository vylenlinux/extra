#!/bin/sh

# shellcheck disable=SC2034
description="Utilities for monitoring your system and processes on your system"
homepage="https://gitlab.com/procps-ng/procps"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=procps-ng
version=3.3.17
release=1
source="https://downloads.sourceforge.net/project/${name}/Production/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "procps-${version}"

    ./configure \
        --prefix=/usr \
        --exec-prefix=/ \
        --sysconfdir=/etc \
        --libdir=/usr/lib \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --enable-watch8bit \
        --with-elogind \
        --disable-modern-top \
        --disable-kill

    make
    make DESTDIR="${PKG}" install
}
