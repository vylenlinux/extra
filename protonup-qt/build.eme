#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Install and manage Proton-GE and Luxtorpeda for Steam and Wine-GE for Lutris"
homepage="https://davidotek.github.io/protonup-qt"
maintainer="Vylen Linux Team"

name=protonup-qt
version=2.15.0
release=1

_name="net.davidotek.pupgui2"

source="${name}-${version}.tar.gz::https://github.com/DavidoTek/${name}/archive/refs/tags/v${version}.tar.gz
    ${_name}.sh"

build() {
    # shellcheck disable=SC2164
    cd "ProtonUp-Qt-${version}"

    python3 -m build \
        --wheel \
        --no-isolation

    python3 -m installer --destdir="${PKG}" dist/*.whl

    cp -r share "${PKG}/usr/"
    ln -s "/usr/bin/${name}" "${PKG}/usr/bin/${_name}"
}
