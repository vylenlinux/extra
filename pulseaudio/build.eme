#!/bin/sh

# shellcheck disable=SC2034
description="iSound system for POSIX OSes"
homepage="https://www.freedesktop.org/wiki/Software/PulseAudio/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pulseaudio
version=17.0
release=4

backup="etc/pulse/daemon.conf
    etc/pulse/default.pa
    etc/pulse/system.pa"

source="https://www.freedesktop.org/software/${name}/releases/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dtests=false \
        -Ddoxygen="$(emerald is-installed doxygen && printf 'true' || printf 'false')" \
        -Dbluez5="$(emerald is-installed bluez && printf 'enabled' || printf 'disabled')" \
        -Delogind=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # remove the D-Bus configuration file for the system wide daemon to avoid creating unnecessary system users and groups
    rm -f "${PKG}/etc/dbus-1/system.d/pulseaudio-system.conf"

    # Superseded by socket activation
    sed -e '/autospawn/iautospawn = no' -i "${PKG}/etc/pulse/client.conf"

    # Disable cork-request module, can result in e.g. media players unpausing
    # when there's a Skype call incoming
    sed -e 's|/usr/bin/pactl load-module module-x11-cork-request|#&|' -i "${PKG}/usr/bin/start-pulseaudio-x11"

    # Required by qpaeq
    sed -e '/Load several protocols/aload-module module-dbus-protocol' -i "${PKG}/etc/pulse/default.pa"
}
