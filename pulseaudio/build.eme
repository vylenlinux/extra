#!/bin/sh

# shellcheck disable=SC2034
description="iSound system for POSIX OSes"
homepage="https://www.freedesktop.org/wiki/Software/PulseAudio/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pulseaudio
version=17.0
release=5

backup="etc/pulse/daemon.conf
    etc/pulse/default.pa
    etc/pulse/system.pa"

source="https://www.freedesktop.org/software/${name}/releases/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dtests=false \
        -Ddoxygen="$(emerald is-installed doxygen && printf 'true' || printf 'false')" \
        -Dbluez5="$(emerald is-installed bluez && printf 'enabled' || printf 'disabled')" \
        -Dudevrulesdir=/usr/lib/udev/rules.d

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # remove the D-Bus configuration file for the system wide daemon to avoid creating unnecessary system users and groups
    rm -f "${PKG}/etc/dbus-1/system.d/pulseaudio-system.conf"

    # Disable cork-request module, can result in e.g. media players unpausing
    # when there's a Skype call incoming
    sed -e 's|/usr/bin/pactl load-module module-x11-cork-request|#&|' -i "${PKG}/usr/bin/start-pulseaudio-x11"

    # Required by qpaeq
    sed -e '/Load several protocols/aload-module module-dbus-protocol' -i "${PKG}/etc/pulse/default.pa"

    # Avoid warning about nonexistent dir
    mkdir -p "${PKG}/etc/pulse/default.pa.d" \
        "${PKG}/etc/pulse/system.pa.d"

    # Moved to libpulse
    rm -f "${PKG}/etc/pulse/client.conf" \
        "${PKG}/usr/bin/pacat" \
        "${PKG}/usr/bin/pactl" \
        "${PKG}/usr/bin/padsp" \
        "${PKG}/usr/bin/pamon" \
        "${PKG}/usr/bin/paplay" \
        "${PKG}/usr/bin/parec" \
        "${PKG}/usr/bin/parecord" \
        "${PKG}/usr/lib"/libpulse.so* \
        "${PKG}/usr/lib"/libpulse-simple.so* \
        "${PKG}/usr/lib"/libpulse-mainloop-glib.so* \
        "${PKG}/usr/lib/pulseaudio"/libpulsedsp.so \
        "${PKG}/usr/lib/pulseaudio"/libpulsecommon-*.so \
        "${PKG}/usr/share/man/man1/pacat.1" \
        "${PKG}/usr/share/man/man1/pactl.1" \
        "${PKG}/usr/share/man/man1/padsp.1" \
        "${PKG}/usr/share/man/man1/pamon.1" \
        "${PKG}/usr/share/man/man1/paplay.1" \
        "${PKG}/usr/share/man/man1/parec.1" \
        "${PKG}/usr/share/man/man1/parecord.1" \
        "${PKG}/usr/share/man/man5/pulse-client.conf.5" \
        "${PKG}/usr/share/bash-completion/completions/pacap" \
        "${PKG}/usr/share/bash-completion/completions/pactl" \
        "${PKG}/usr/share/bash-completion/completions/padsp" \
        "${PKG}/usr/share/bash-completion/completions/paplay" \
        "${PKG}/usr/share/bash-completion/completions/parec" \
        "${PKG}/usr/share/bash-completion/completions/parecord"

    rm -rf "${PKG}/usr/lib/cmake" \
        "${PKG}/usr/lib/pkgconfig" \
        "${PKG}/usr/include" \
        "${PKG}/usr/share/vala"
}
