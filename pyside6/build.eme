#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Enables the use of Qt6 APIs in Python applications"
homepage="https://doc.qt.io/qtforpython-6/"
maintainer="Vylen Linux Team"

name=pyside6
version=6.11.0
release=1

source="${name}-${version}.tar.xz::https://download.qt.io/official_releases/QtForPython/${name}/${name}-$version-src/pyside-setup-everywhere-src-${version}.tar.xz
    c9d602ab4afa5c9834c4674a742dc9bab7f4b326.patch
    05e328476f2d6ef8a0f3f44aca1e5b1cdb7499fc.patch
    fix-header-install-dir.patch"

build() {
    patch -d "pyside-setup-everywhere-src-${version}" -Rp1 -i "${SRC}/c9d602ab4afa5c9834c4674a742dc9bab7f4b326.patch"
    patch -d "pyside-setup-everywhere-src-${version}" -Rp1 -i "${SRC}/05e328476f2d6ef8a0f3f44aca1e5b1cdb7499fc.patch"
    patch -d "pyside-setup-everywhere-src-${version}" -Np1 -i "${SRC}/fix-header-install-dir.patch"

    # shellcheck disable=SC2164
    cd "pyside-setup-everywhere-src-${version}"

    export CLANG_INSTALL_DIR=/usr/lib/llvm21
    export LLVM_INSTALL_DIR=/usr/lib/llvm21

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DSHIBOKEN_PYTHON_LIBRARIES="$(pkgconf python3-embed --libs)" \
        -DBUILD_TESTS=OFF \
        -DFORCE_LIMITED_API=no \
        -DNO_QT_TOOLS=yes \
        -Wno-dev

    PYTHONPATH="${PWD}/build/sources" cmake --build build

    DESTDIR="${PKG}" cmake --install build/sources/pyside6
    DESTDIR="${PKG}" cmake --install build/sources/shiboken6
    DESTDIR="${PKG}" cmake --install build/sources/shiboken6_generator

    # Install egg info
    export PATH="/usr/lib/qt6/bin:${PATH}"
    pythonpath="$(python3 -c "from sysconfig import get_path; print(get_path('platlib'))")"

    python3 setup.py egg_info --build-type=pyside6
    cp -r PySide6.egg-info "${PKG}/${pythonpath}"

    python3 setup.py egg_info --build-type=shiboken6
    python3 setup.py egg_info --build-type=shiboken6-generator

    cp -r shiboken6*.egg-info "${PKG}/${pythonpath}"

    unset CLANG_INSTALL_DIR
    unset LLVM_INSTALL_DIR
}
