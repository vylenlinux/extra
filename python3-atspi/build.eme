#!/bin/sh

# shellcheck disable=SC2034
description="Python3 bindings for the core components of the GNOME Accessibility"
homepage="https://gitlab.gnome.org/GNOME/pyatspi2"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-atspi
version=2.58.2
release=1
source="${name}-${version}.tar.gz::https://download.gnome.org/sources/pyatspi/${version%.*}/pyatspi-${version}.tar.xz"

build() {
    vylen-meson "pyatspi-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
