#!/bin/sh

# shellcheck disable=SC2034
description="A collection of tools for internationalizing Python applications"
homepage="https://babel.pocoo.org/en/latest/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-babel
version=2.19.0
release=1
source="https://github.com/python-babel/babel/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "babel-${version}"
    python3 scripts/download_import_cldr.py

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
