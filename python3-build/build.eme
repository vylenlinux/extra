#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A simple, correct PEP517 package builder"
homepage="https://github.com/pypa/build"
maintainer="Vylen Linux Team"

name=python3-build
version=1.6.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pypa/build/archive/refs/tags/${version}/py3-build-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "build-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/build*.whl
}
