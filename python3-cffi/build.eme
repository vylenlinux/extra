#!/bin/sh

# shellcheck disable=SC2034
description="Foreign Function Interface for Python calling C code"
homepage="https://cffi.readthedocs.io/en/stable/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-cffi
version=2.1.1
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/c/cffi/cffi-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "cffi-${version}"
    python3 setup.py build

    python3 setup.py install \
        --prefix=/usr \
        --root="${PKG}" \
        --optimize=1
}
