#!/bin/sh

# shellcheck disable=SC2034
description="Python module for character encoding auto-detection"
homepage="https://github.com/chardet/chardet"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-chardet
version=7.7.0
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/c/chardet/chardet-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "chardet-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
