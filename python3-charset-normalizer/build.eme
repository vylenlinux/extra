#!/bin/sh

# shellcheck disable=SC2034
description="Encoding and language detection alternative to chardet"
homepage="https://github.com/jawah/charset_normalizer"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-charset-normalizer
version=3.5.2
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/c/charset_normalizer/charset_normalizer-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "charset_normalizer-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
