#!/bin/sh

# shellcheck disable=SC2034
description="Python3 bindings to the D-Bus"
homepage="http://dbus.freedesktop.org/releases/dbus-python"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-dbus
version=1.4.0
release=2

source="${name}-${version}.tar.gz::https://dbus.freedesktop.org/releases/dbus-python/dbus-python-${version}.tar.xz
    fix-build-with-python3.15.patch"

build() {
    # shellcheck disable=SC2164
    cd "dbus-python-${version}"
    patch -Np1 -i "${SRC}/fix-build-with-python3.15.patch"

    vylen-meson build -Dtests=disabled
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    python3 tools/generate-pkginfo.py "${version}" PKG-INFO
    python3 -m compileall -d /usr/lib "${PKG}/usr/lib"
    python3 -O -m compileall -d /usr/lib "${PKG}/usr/lib"
}
