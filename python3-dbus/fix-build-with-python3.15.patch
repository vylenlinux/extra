+/* Connection owns Python objects that can participate in reference cycles.
+ * This was historically not visible to the cyclic GC, but managed weakrefs
+ * require the type to support the GC protocol on Python 3.15 and later.
+ */
+static int
+Connection_tp_traverse(Connection *self, visitproc visit, void *arg)
+{
+    Py_VISIT(self->filters);
+    Py_VISIT(self->object_paths);
+    return 0;
+}
+
+static int
+Connection_tp_clear(Connection *self)
+{
+    Py_CLEAR(self->filters);
+    Py_CLEAR(self->object_paths);
+    return 0;
+}
+
 /* Destructor */
 static void Connection_tp_dealloc(Connection *self)
 {
@@ -392,6 +412,7 @@
