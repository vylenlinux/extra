#!/bin/sh

# shellcheck disable=SC2034
description="Distribution utilities"
homepage="https://github.com/pypa/distlib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-distlib
version=0.4.4
release=1
source="${name}-${version}.tar.gz::https://github.com/pypa/distlib/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "distlib-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl

    rm "${PKG}/${PYTHON_SITE_PACKAGES}/distlib"/*.exe
}
