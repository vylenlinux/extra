#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Python library for creating editable wheels"
homepage="https://github.com/pfmoore/editables"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-editables
version=0.6
release=1
source="${name}-${version}.tar.gz::https://pypi.org/packages/source/e/editables/editables-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "editables-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
