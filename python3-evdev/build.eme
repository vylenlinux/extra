#!/bin/sh

# shellcheck disable=SC2034
description="Python bindings for the Linux input subsystem"
homepage="https://github.com/gvalkov/python-evdev"
maintainer="Vylen Linux Team"

name=python3-evdev
version=2.0.0
release=1
source="${name}-${version}.zip::https://github.com/gvalkov/python-evdev/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "python-evdev-${version}"
    python3 setup.py build

    python3 setup.py install \
        --root="${PKG}" \
        --optimize=1 \
        --skip-build
}
