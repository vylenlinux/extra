#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight in-process concurrent programming"
homepage="https://pypi.org/project/greenlet/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-greenlet
version=3.5.6
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/g/greenlet/greenlet-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "greenlet-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl

    rm -r "${PKG}/${PYTHON_SITE_PACKAGES}/greenlet/tests/"
}
