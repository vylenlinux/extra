#!/bin/sh

# shellcheck disable=SC2034
description="Modern, extensible Python project management"
homepage="https://github.com/pypa/hatch"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-hatchling
version=1.33.0
release=1
source="https://files.pythonhosted.org/packages/py3/h/hatchling/hatchling-${version}-py3-none-any.whl"

build() {
    # we use wheel to avoid circular dependencies
    python3 -m installer -d "${PKG}" "${SRC}/hatchling-${version}-py3-none-any.whl"
}
