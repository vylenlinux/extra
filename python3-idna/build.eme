#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Internationalized Domain Names in Applications (IDNA)"
homepage="https://github.com/kjd/idna"
maintainer="Vylen Linux Team"

name=python3-idna
version=3.13
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/i/idna/idna-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "idna-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
