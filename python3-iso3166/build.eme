#!/bin/sh

# shellcheck disable=SC2034
description="Self-contained ISO 3166-1 country definitions"
homepage="https://github.com/deactivated/python-iso3166"
maintainer="Vylen Linux Team"

name=python3-iso3166
version=3.0.0
release=1

source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/i/iso3166/iso3166-${version}.tar.gz
    remove-uv-build.patch"

build() {
    # shellcheck disable=SC2164
    cd "iso3166-${version}"
    patch -Np1 -i "${SRC}/remove-uv-build.patch"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
