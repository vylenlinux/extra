#!/bin/sh

# shellcheck disable=SC2034
description="A simple pythonic template language written in Python"
homepage="https://palletsprojects.com/p/jinja/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-jinja2
version=3.1.6
release=1
source="${name}-${version}.tar.gz::https://github.com/pallets/jinja/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "jinja-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
