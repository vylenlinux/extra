#!/bin/sh

# shellcheck disable=SC2034
description="An implementation of JSON Schema validation for Python"
maintainer="Vylen Linux Team"
homepage="https://github.com/python-jsonschema/jsonschema"

name=python3-jsonschema
version=4.26.0
release=1
source="https://github.com/python-jsonschema/jsonschema/releases/download/v${version}/jsonschema-${version}-py3-none-any.whl"

build() {
    python3 -m installer -d "${PKG}" "jsonschema-${version}-py3-none-any.whl"
}
