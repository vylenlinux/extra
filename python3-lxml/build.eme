#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Python3 bindings for libxslt and libxml2"
homepage="https://lxml.de/"
maintainer="Vylen Linux Team"

name=python3-lxml
version=6.1.3_1
release=1

_version="$(printf "%s" "${version}" | sed 's/_/-/')"
source="${name}-${version}.tar.gz::https://github.com/lxml/lxml/archive/refs/tags/lxml-${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "lxml-lxml-${_version}"
    export CFLAGS="${CFLAGS} -flto=auto"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
