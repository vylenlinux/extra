#!/bin/sh

# shellcheck disable=SC2034
description="Python3 bindings for libxslt and libxml2"
homepage="https://lxml.de/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-lxml
version=6.2.0
release=1
source="https://github.com/lxml/lxml/archive/lxml-${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "lxml-lxml-${version}"
    export CFLAGS="${CFLAGS} -flto=auto"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
