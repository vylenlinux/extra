#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Python module that implements hyperfast and lightweight templating for the Python platform"
homepage="https://github.com/sqlalchemy/mako"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-mako
version=1.4.3
release=1
source="${name}-${version}.tar.gz::https://pypi.org/packages/source/m/mako/mako-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "mako-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
