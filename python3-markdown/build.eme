#!/bin/sh

# shellcheck disable=SC2034
description="Python implementation of markdown"
homepage="https://pypi.org/project/markdown"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-markdown
version=3.11.3
release=1
source="${name}-${version}.tar.gz::https://github.com/Python-Markdown/markdown/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "markdown-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
