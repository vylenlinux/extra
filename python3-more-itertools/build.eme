#!/bin/sh

# shellcheck disable=SC2034
description="More routines for operating on iterables, beyond itertools"
homepage="https://github.com/more-itertools/more-itertools"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-more-itertools
version=11.1.0
release=1

source="${name}-${version}.tar.gz::https://github.com/more-itertools/more-itertools/archive/refs/tags/v${version}.tar.gz
    remove-version-constraint.patch"

build() {
    # shellcheck disable=SC2164
    cd "more-itertools-${version}"
    patch -Np1 -i "${SRC}/remove-version-constraint.patch"

    SETUPTOOLS_SCM_PRETEND_VERSION="${version}" python3 -m build \
        --wheel \
        --no-isolation

    python3 -m installer --destdir="${PKG}" dist/*.whl
}
