#!/bin/sh

# shellcheck disable=SC2034
description="Fast correct Python JSON library supporting dataclasses and datetimes"
homepage="https://github.com/ijl/orjson"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-orjson
version=3.13.0
release=1
source="${name}-${version}.tar.gz::https://github.com/ijl/orjson/archive/${version}/orjson-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "orjson-${version}"

    maturin build \
        --release \
        --strip

    python3 -m installer --destdir="${PKG}" target/wheels/*.whl
}
