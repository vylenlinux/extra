#!/bin/sh

# shellcheck disable=SC2034
description="Python Imaging Library (PIL) fork"
homepage="https://python-pillow.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pillow
version=13.0.0
release=1
source="${name}-${version}.tar.gz::https://github.com/python-pillow/Pillow/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Pillow-${version}"
    export CFLAGS="${CFLAGS} -O2 -L/lib -flto=auto"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
    _python_version="$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')"

    install -Dm644 src/libImaging/*.h -t "${PKG}/usr/include/${_python_version}/"
}
