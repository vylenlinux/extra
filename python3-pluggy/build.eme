#!/bin/sh

# shellcheck disable=SC2034
description="Plugin and hook calling mechanisms for python"
homepage="https://github.com/pytest-dev/pluggy"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pluggy
version=1.7.0
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/p/pluggy/pluggy-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pluggy-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
