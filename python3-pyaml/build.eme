#!/bin/sh

# shellcheck disable=SC2034
description="PyYAML-based module to produce pretty and readable YAML-serialized data"
homepage="https://github.com/mk-fg/pretty-yaml"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pyaml
version=26.7.0
release=1
source="${name}-${version}.tar.gz::https://github.com/mk-fg/pretty-yaml/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pretty-yaml-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl

    rm -r "${PKG}/${PYTHON_SITE_PACKAGES}/pyaml/tests"
}
