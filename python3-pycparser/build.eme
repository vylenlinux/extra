#!/bin/sh

# shellcheck disable=SC2034
description="C parser and AST generator written in Python"
homepage="https://pypi.org/project/pycparser/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pycparser
version=3.12
release=1
source="${name}-${version}.tar.gz::https://github.com/eliben/pycparser/archive/release_v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pycparser-release_v${version}"
    python3 setup.py build

    python3 setup.py install \
        --prefix=/usr \
        --root="${PKG}" \
        --optimize=1 \
        --skip-build
}
