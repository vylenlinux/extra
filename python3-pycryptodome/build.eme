#!/bin/sh

# shellcheck disable=SC2034
description="Cryptographic library for Python"
homepage="https://www.pycryptodome.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pycryptodome
version=4.3.0
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/p/pycryptodome/pycryptodome-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pycryptodome-${version}"
    python3 setup.py build

    python3 setup.py install \
        --root="${PKG}" \
        --optimize=1 \
        --skip-build
}
