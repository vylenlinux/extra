#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A Python 3.x interface to libcurl"
homepage="http://pycurl.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pycurl
version=7.48.0
release=1

_version="$(printf '%s' "${version}" | tr '.' '_')"
source="${name}-${version}.tar.gz::https://github.com/pycurl/pycurl/archive/REL_${_version}/python-pycurl-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pycurl-REL_${_version}"

    python3 setup.py install \
        --with-openssl \
        --root="${PKG}" \
        --skip-build
}
