#!/bin/sh

# shellcheck disable=SC2034
description="A Python 3.x interface to libcurl"
homepage="https://pycurl.github.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pycurl
version=7.49.0
release=1
source="${name}-${version}.tar.gz::https://github.com/pycurl/pycurl/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pycurl-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
