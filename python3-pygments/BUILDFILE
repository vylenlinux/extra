description="Python syntax highlighter"
homepage="https://pygments.org/"
maintainer="Vylen Linux Team"

name=python3-pygments
version=2.19.2
release=1
source="$name-$version.tar.gz::https://files.pythonhosted.org/packages/source/P/Pygments/pygments-$version.tar.gz
	setuptools.patch"

build() {
	cd pygments-$version
	patch -Np1 -i $SRC/setuptools.patch

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl
	ln -s pygmentize $PKG/usr/bin/pygmentize-3
}
