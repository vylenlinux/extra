#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Python syntax highlighter"
homepage="https://pygments.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pygments
version=2.21.0
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/P/Pygments/pygments-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pygments-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
    ln -s pygmentize "${PKG}/usr/bin/pygmentize-3"
}
