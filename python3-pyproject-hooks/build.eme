#!/bin/sh

# shellcheck disable=SC2034
description="A low-level library for calling build-backends in pyproject.toml-based project"
homepage="https://github.com/pypa/pyproject-hooks"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pyproject-hooks
version=1.3.0
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/p/pyproject_hooks/pyproject_hooks-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pyproject_hooks-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
