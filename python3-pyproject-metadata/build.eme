#!/bin/sh

# shellcheck disable=SC2034
description="PEP 621 metadata parsing"
homepage="https://github.com/pypa/pyproject-metadata"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pyproject-metadata
version=0.12.1
release=1
source="${name}-${version}.tar.gz::https://pypi.org/packages/source/p/pyproject_metadata/pyproject_metadata-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pyproject_metadata-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
