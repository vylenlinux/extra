description="Python bindings for QtWebEngine"
homepage="https://www.riverbankcomputing.com/software/pyqtwebengine/intro"
maintainer="Vylen Linux Team"

name=python3-pyqt6-webengine
version=6.10.0
release=1
source="https://pypi.python.org/packages/source/p/pyqt6-webengine/pyqt6_webengine-$version.tar.gz
	fix-build.patch"

build() {
	cd pyqt6_webengine-$version
	patch -Np1 -i $SRC/fix-build.patch
	sip-build --no-make --qmake=/usr/lib/qt6/bin/qmake6
	cd build
	make
	make INSTALL_ROOT=$PKG install
}
