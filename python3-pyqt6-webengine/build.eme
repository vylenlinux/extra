#!/bin/sh

# shellcheck disable=SC2034
description="Python bindings for QtWebEngine"
homepage="https://www.riverbankcomputing.com/software/pyqtwebengine/intro"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pyqt6-webengine
version=6.140.0
release=1
source="${name}-${version}.tar.gz::https://pypi.python.org/packages/source/p/pyqt6-webengine/pyqt6_webengine-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pyqt6_webengine-${version}"

    sip-build \
        --no-make \
        --qmake=/usr/lib/qt6/bin/qmake6

    # shellcheck disable=SC2164
    cd build

    make
    make INSTALL_ROOT="${PKG}" install
}
