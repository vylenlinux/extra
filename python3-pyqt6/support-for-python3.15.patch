+        PyObject *mro = PyObject_GetAttr(
+                (PyObject *)Py_TYPE((PyObject *)pySelf), qpycore_dunder_mro);
         Q_ASSERT(mro);

         for (Py_ssize_t i = 0; i < PyTuple_Size(mro); ++i)
