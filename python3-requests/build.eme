#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Python HTTP for Humans"
homepage="https://requests.readthedocs.io"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-requests
version=2.34.2
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/r/requests/requests-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "requests-${version}"

    sed -e '/certifi/d' -i setup.py
    python3 setup.py build

    python3 setup.py install \
        --prefix=/usr \
        --root="${PKG}" \
        --skip-build
}
