#!/bin/sh

# shellcheck disable=SC2034
description="Python bindings to the Rust rpds crate for persistent data structures"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/crate-py/rpds"

name=python3-rpds-py
version=2026.11.1
release=1
source="${name}-${version}.tar.gz::https://github.com/crate-py/rpds/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "rpds-${version}"
    cargo fetch --locked

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
