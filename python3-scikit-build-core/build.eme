#!/bin/sh

# shellcheck disable=SC2034
description="Build backend for Python that uses CMake to build extension modules"
homepage="https://github.com/scikit-build/scikit-build-core"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-scikit-build-core
version=1.1.2
release=1
source="${name}-${version}.tar.gz::https://github.com/scikit-build/scikit-build-core/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "scikit-build-core-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
