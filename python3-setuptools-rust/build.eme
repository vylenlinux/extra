#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Compile and distribute Python extensions written in rust as easily as if they were written in C"
homepage="https://github.com/PyO3/setuptools-rust"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-setuptools-rust
version=1.13.0
release=1
source="${name}-${version}.tar.gz::https://github.com/PyO3/setuptools-rust/archive/v${version}/python-setuptools-rust-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "setuptools-rust-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
