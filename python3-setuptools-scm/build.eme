#!/bin/sh

# shellcheck disable=SC2034
description="Handles managing your python package versions in scm metadata"
homepage="https://github.com/pypa/setuptools_scm"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-setuptools-scm
version=10.3.3
release=1
source="${name}-${version}.tar.gz::https://github.com/pypa/setuptools-scm/archive/refs/tags/setuptools-scm-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "setuptools-scm-setuptools-scm-v${version}/setuptools-scm"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
