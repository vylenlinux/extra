#!/bin/sh

# shellcheck disable=SC2034
description="A tool that makes it easy to create Python bindings for C and C++ libraries"
homepage="https://www.riverbankcomputing.com/software/sip/intro"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-sip
version=6.17.3
release=1

source="${name}-${version}.tar.gz::https://pypi.python.org/packages/source/s/sip/sip-${version}.tar.gz
    support-sip-abi-version-string.patch"

build() {
    # shellcheck disable=SC2164
    cd "sip-${version}"
    patch -Np1 -i "${SRC}/support-sip-abi-version-string.patch"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
