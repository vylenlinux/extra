#!/bin/sh

# shellcheck disable=SC2034
description="Snowball stemming library collection for Python."
homepage="https://github.com/snowballstem/snowball"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-snowballstemmer
version=3.2.0
release=1
source="stemmer-${version}.tar.gz::https://github.com/snowballstem/snowball/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "snowball-${version}"

    make dist_libstemmer_python
    python3 -m installer -d "${PKG}" dist/*.whl
}
