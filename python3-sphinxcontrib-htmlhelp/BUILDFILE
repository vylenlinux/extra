description="sphinx extension which renders HTML help files"
homepage="https://github.com/sphinx-doc/sphinxcontrib-htmlhelp/"
maintainer="Vylen Linux Team"

name=python3-sphinxcontrib-htmlhelp
_name=sphinxcontrib_htmlhelp
version=2.1.0
release=1
source="$name-$version.tar.gz::https://pypi.org/packages/source/s/$_name/$_name-$version.tar.gz"

build() {
	cd $_name-$version

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
