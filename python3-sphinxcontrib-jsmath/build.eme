#!/bin/sh

# shellcheck disable=SC2034
description="sphinx extension which renders display math in HTML via JavaScript"
homepage="https://github.com/sphinx-doc/sphinxcontrib-jsmath/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-sphinxcontrib-jsmath
version=2.0.0
release=1
source="${name}-${version}.tar.gz::https://github.com/sphinx-doc/sphinxcontrib-jsmath/archive/${version}/sphinxcontrib-jsmath-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "sphinxcontrib-jsmath-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
