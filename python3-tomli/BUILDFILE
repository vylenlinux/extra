description="A lil' TOML parser"
homepage="https://github.com/hukkin/tomli"
maintainer="Vylen Linux Team"

name=python3-tomli
version=2.4.0
release=1
source="$name-$version.tar.gz::https://github.com/hukkin/tomli/archive/$version/tomli-$version.tar.gz"

build() {
	cd tomli-$version
	
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d "$PKG" \
		.dist/tomli-$version-py3-none-any.whl


}
