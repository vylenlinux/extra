description="Canonical source for classifiers on PyPI (pypi.org)"
homepage="https://github.com/pypa/trove-classifiers"
maintainer="Vylen Linux Team"

name=python3-trove-classifiers
version=2026.1.14.14
release=1
source="$name-$version.tar.gz::https://github.com/pypa/trove-classifiers/archive/refs/tags/$version.tar.gz"

build() {
  cd trove-classifiers-$version

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d "$PKG" \
		.dist/*.whl

}
