#!/bin/sh

# shellcheck disable=SC2034
description="filters to make caring about typography on the web a bit easier"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/justinmayer/typogrify"

name=python3-typogrify
version=2.1.0
release=1
source="${name}-${version}.tar.gz::https://github.com/justinmayer/typogrify/archive/${version}/typogrify-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "typogrify-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
