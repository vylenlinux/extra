#!/bin/sh

# shellcheck disable=SC2034
description="The blessed package to manage your versions by vcs metadata"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/pypa/setuptools-scm"

name=python3-vcs-versioning
version=2.3.4
release=1
source="${name}-${version}.tar.gz::https://pypi.org/packages/source/v/vcs_versioning/vcs_versioning-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "vcs_versioning-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer --destdir="${PKG}" .dist/*.whl
}
