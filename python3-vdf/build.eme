#!/bin/sh

# shellcheck disable=SC2034
description="Pure python module for (de)serialization to and from VDF that works just like json"
homepage="https://github.com/ValvePython/vdf"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-vdf
version=4.0
release=1
source="${name}-${version}.tar.gz::https://github.com/solsticegamestudios/vdf/archive/v${version}/vdf-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "vdf-${version}"
    python3 setup.py build

    python3 setup.py install -O2 \
        --root="${PKG}" \
        --skip-build

    chmod 644 "${PKG}/usr/lib"/python3.*/site-packages/vdf-$version-*/*
}
