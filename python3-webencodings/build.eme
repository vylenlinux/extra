#!/bin/sh

# shellcheck disable=SC2034
description="Character encoding for the web."
homepage="https://github.com/gsnedders/python-webencodings"
maintainer="Vylen Linux Team"

name=python3-webencodings
version=0.6.1
release=1
source="${name}-${version}.tar.gz::https://pypi.org/packages/source/w/webencodings/webencodings-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name#*-}-${version}"

    python3 -m build \
        --wheel \
        --skip-dependency-check \
        --no-isolation

    python3 -m installer --destdir="${PKG}" dist/*.whl
}
