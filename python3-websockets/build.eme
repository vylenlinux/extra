#!/bin/sh

# shellcheck disable=SC2034
description="Python implementation of the WebSocket Protocol (RFC 6455)"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/python-websockets/websockets"

name=python3-websockets
version=17.4
release=1
source="https://github.com/aaugustin/websockets/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "websockets-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
