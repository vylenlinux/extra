#!/bin/sh

# shellcheck disable=SC2034
description="A built-package format for Python"
homepage="https://pypi.python.org/pypi/wheel"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-wheel
version=0.48.0
release=1
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/w/wheel/${name#*-}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "wheel-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
