description="A built-package format for Python"
homepage="https://pypi.python.org/pypi/wheel"
maintainer="Vylen Linux Team"

name=python3-wheel
version=0.46.3
release=1
source="https://files.pythonhosted.org/packages/source/w/wheel/${name#*-}-$version.tar.gz"

bsdtar() { tar $@;}

build() {

	cd ${name#*-}-$version

		gpep517 build-wheel \
		    --wheel-dir .dist \
		    --output-fd 3 3>&1 >&2

		python3 -m installer -d $PKG \
		    .dist/*.whl


}
