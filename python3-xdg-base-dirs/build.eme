#!/bin/sh

# shellcheck disable=SC2034
description="Python module for accessing XDG base directory paths"
homepage="https://github.com/srstevenson/xdg-base-dirs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-xdg-base-dirs
version=6.1.0
release=1

source="${name}-${version}.tar.gz::https://github.com/srstevenson/xdg-base-dirs/archive/refs/tags/v${version}.tar.gz
    avoid-uv.patch"

build() {
    # shellcheck disable=SC2164
    cd "xdg-base-dirs-${version}"
    patch -Np1 -i "${SRC}/avoid-uv.patch"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
