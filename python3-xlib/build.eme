#!/bin/sh

# shellcheck disable=SC2034
description="A fully functional X client library for Python programs"
homepage="hhttps://salsa.debian.org/python-team/packages/python-xlib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-xlib
version=1.0
release=1

source="${name}-${version}.tar.gz::https://salsa.debian.org/python-team/packages/python-xlib/-/archive/upstream/${version}/python-xlib-upstream-${version}.tar.gz
    avoid-uv.patch"

build() {
    # shellcheck disable=SC2164
    cd "python-xlib-upstream-${version}"
    patch -Np1 -i "${SRC}/avoid-uv.patch"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
