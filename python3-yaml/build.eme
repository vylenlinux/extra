#!/bin/sh

# shellcheck disable=SC2034
description="Python bindings for YAML, using fast libYAML library"
homepage="https://github.com/yaml/pyyaml"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-yaml
version=6.0.4
release=1
source="https://github.com/yaml/pyyaml/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pyyaml-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
