description="Backport of pathlib-compatible object wrapper for zip files"
homepage="https://pypi.org/project/zipp/"
maintainer="Vylen Linux Team"

name=python3-zipp
version=3.23.0
release=1
source="https://pypi.python.org/packages/source/z/zipp/zipp-$version.tar.gz"

build() {

	 cd zipp-$version
	 export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
        gpep517 build-wheel \
                --wheel-dir .dist \
                --output-fd 3 3>&1 >&2

        python3 -m installer -d $PKG \
                .dist/zipp*.whl
}
