#!/bin/sh

PYVERSION=$(awk -F'[=.]' '/^version=/{print $2"."$3}' build.eme)

# Rebuild with a mayor version upgrade
if [ "${PYVERSION}" != "3.14" ]; then
    PYREBUILD="python3-setuptools
        meson
        python3-gpep517
        python3-installer
        python3-flit-core
        python3-wheel
        python3-setuptools-scm
        python3-build
        python3-pip
        libxml2
        libxslt
        gobject-introspection
        python3-pyproject-hooks
        python3-mako
        python3-yaml
        python3-pygments
        python3-markupsafe"

    for p in $PYREBUILD; do
        emerald isinstalled "${p}" && emerald install -fr "${p}"
    done
fi
