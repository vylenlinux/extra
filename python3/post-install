#!/bin/sh

PYTHON_VERSION="$(awk -F'[=.]' '/^version=/{print $2"."$3}' build.eme)"

# Rebuild with a mayor version upgrade
if [ "${PYTHON_VERSION}" != "3.14" ]; then
    PYTHON_REBUILD="python3-setuptools
        meson
        python3-gpep517
        python3-installer
        python3-flit-core
        python3-wheel
        python3-setuptools-scm
        python3-build
        python3-pip
        libxml2
        libxslt
        gobject-introspection
        python3-pyproject-hooks
        python3-mako
        python3-yaml
        python3-pygments
        python3-markupsafe"

    for p in $PYTHON_REBUILD; do
        emerald is-installed "${p}" && emerald install -fr "${p}"
    done
fi
