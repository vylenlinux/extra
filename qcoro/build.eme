description="C++ Coroutines for Qt"
homepage="https://github.com/qcoro/qcoro"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=qcoro
version=0.13.0
release=1
source="https://github.com/danvratil/qcoro/archive/v$version/$name-$version.tar.gz"

build() {
    cmake -S $name-$version -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS -fPIC" \
        -D BUILD_TESTING=OFF \
        -D USE_QT_VERSION=6 \
        -D BUILD_SHARED_LIBS=ON \
        -Wno-author
    cmake --build build
    DESTDIR=$PKG cmake --install build
}
