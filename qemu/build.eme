#!/bin/sh

# shellcheck disable=SC2034
description="Virtualization for Linux on x86 hardware containing virtualization extensions (Intel VT or AMD-V)"
homepage="https://www.qemu.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=qemu
version=11.1.3
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz
    bridge.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    QEMU_OPTS="--enable-spice \
        --enable-tpm"

    # shellcheck disable=SC2086
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libdir="/usr/lib/${name}" \
        --libexecdir="/usr/lib/${name}" \
        --localstatedir=/var \
        --python=/usr/bin/python3 \
        --disable-docs \
        --disable-gtk \
        --enable-kvm \
        --enable-modules \
        --enable-sdl \
        --enable-slirp \
        --enable-usb-redir \
        --enable-vhost-net \
        --enable-virglrenderer \
        --smbd=/usr/bin/smbd \
        --with-coroutine=ucontext \
        ${QEMU_OPTS}

    make
    make DESTDIR="${PKG}" install

    do_sysusers "${name}"
    install -Dm644 "${SRC}/bridge.conf" -t "${PKG}/etc/${name}/"

    # moved to qemu-guest-agent
    rm -f "${PKG}/usr/bin/qemu-ga"

    # shellcheck disable=SC2115
    rm -rf "${PKG}/var"
}
