#!/bin/sh

# shellcheck disable=SC2034
description="Virtualization for Linux on x86 hardware containing virtualization extensions (Intel VT or AMD-V)"
homepage="https://www.qemu.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=qemu
version=11.1.2
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz
    60-kvm.rules"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # CBUILD: enable o disable CBUILD_QEMU_OPTS, source CBUILD_QEMU_OPTS from "qemu.opt" file
    CBUILD_QEMU_OPTS="--enable-spice \
        --enable-tpm"

    cbuild_options

    # shellcheck disable=SC2086
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libdir="/usr/lib/${name}" \
        --libexecdir="/usr/lib/${name}" \
        --localstatedir=/var \
        --python=/usr/bin/python3 \
        --disable-docs \
        --disable-gtk \
        --enable-kvm \
        --enable-modules \
        --enable-sdl \
        --enable-slirp \
        --enable-usb-redir \
        --enable-vhost-net \
        --enable-virglrenderer \
        --smbd=/usr/bin/smbd \
        --with-coroutine=ucontext \
        ${CBUILD_QEMU_OPTS}

    make
    make DESTDIR="${PKG}" install

    # moved to qemu-guest-agent
    rm -f "${PKG}/usr/bin/qemu-ga"

    install -Dm644 "${SRC}/60-kvm.rules" -t "${PKG}/etc/udev/rules.d/"
    rm -rf "${PKG}/var/run"
}
