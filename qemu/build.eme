#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Virtualization for Linux on x86 hardware containing virtualization extensions (Intel VT or AMD-V)"
homepage="https://www.qemu.org"
maintainer="Vylen Linux Team"

name=qemu
version=11.0.0
release=1

commit=ece408818d27f745ef1b05fb3cc99a1e7a5bf580

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/${commit}.tar.gz
    notest.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"
    patch -Np1 -i "${SRC}/notest.patch"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libdir="/usr/lib/${name}" \
        --libexecdir="/usr/lib/${name}" \
        --disable-docs \
        --disable-gtk \
        --localstatedir=/var \
        --python=/usr/bin/python3 \
        --enable-kvm \
        --enable-slirp \
        --enable-spice \
        --enable-usb-redir \
        --enable-vhost-net \
        --enable-virglrenderer \
        --enable-modules \
        --enable-sdl \
        --enable-tpm \
        --smbd=/usr/bin/smbd \
        --with-coroutine=ucontext

    make
    make DESTDIR="${PKG}" install

    install -d "${PKG}/etc/udev/rules.d/"
    echo 'KERNEL=="kvm", NAME="kvm", OWNER="root", GROUP="kvm", MODE="0660"' > "${PKG}/etc/udev/rules.d/60-kvm.rules"

    rm -fr "${PKG}/var/run"
}
