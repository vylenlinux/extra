#!/bin/sh

# shellcheck disable=SC2034
description="Create mapping solutions using data available from popular location service providers"
homepage="https://www.qt.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=qt6-location
version=6.12.0
release=1
source="${name}-${version}.tar.xz::https://download.qt.io/official_releases/qt/${version%.*}/${version}/submodules/qtlocation-everywhere-src-${version}.tar.xz"

build() {
    cmake -S "qtlocation-everywhere-src-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DINSTALL_PUBLICBINDIR=bin \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
