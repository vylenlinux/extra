#!/bin/sh

# shellcheck disable=SC2034
description="A family of player software for a certain json-based file format for describing 2d vector graphics animations"
homepage="https://www.qt.io/"
maintainer="Vylen Linux Team"

name=qt6-lottie
version=6.11.1
release=1
source="${name}-${version}.tar.xz::https://download.qt.io/official_releases/qt/${version%.*}/${version}/submodules/qtlottie-everywhere-src-${version}.tar.xz"

build() {
    cmake -S "qtlottie-everywhere-src-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DQT_USE_CCACHE="$(emerald is-installed ccache && printf "ON" || printf "OFF")" \
        -DINSTALL_PUBLICBINDIR=usr/bin

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
