description="Qt speech support"
homepage="https://www.qt.io/"
maintainer="Vylen Linux Team"

name=qt6-speech
version=6.11.0
release=1
source="https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtspeech-everywhere-src-$version.tar.xz"

build() {
	cmake -S qtspeech-everywhere-src-$version -B build -G Ninja $PKGMK_QT6 \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
