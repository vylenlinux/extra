#!/bin/sh

# shellcheck disable=SC2034
description="Provides a way to display web content in a QML application"
homepage="https://www.qt.io"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=qt6-webview
version=6.11.2
release=1
source="${name}-${version}.tar.xz::https://download.qt.io/official_releases/qt/${version%.*}/${version}/submodules/qtwebview-everywhere-src-${version}.tar.xz"

build() {
    cmake -S "qtwebview-everywhere-src-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DQT_USE_CCACHE="$(emerald is-installed ccache && printf "ON" || printf "OFF")" \
        -DINSTALL_PUBLICBINDIR=bin \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
