description="Runit bootscripts for Vylen Linux"
homepage="https://gitlab.com/vylen/runit-rc"
maintainer="Vylen Linux Team"

name=rc
version=20260312
release=1
source="https://gitlab.com/vylen/runit-${name}/-/archive/${version}/runit-${name}-${version}.tar.gz"

build() {
    cd "runit-${name}-${version}"
    make all
    DESTDIR="${PKG}" make install
}
