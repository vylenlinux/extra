#!/bin/sh

# shellcheck disable=SC2034
description="GNU readline library"
homepage="https://tiswww.case.edu/php/chet/readline/rltop.html"
maintainer="Vylen Linux Team"

name=readline
version=8.3.3
release=1

source="https://ftp.gnu.org/gnu/${name}/${name}-${version%.*}.tar.gz
    display-null-prompt.patch
    inputrc"

patch_name="$(printf '%s' "${version}" | awk -F. '{print "readline"$1$2"-"}')"
patch_version="${version##*.}"

# Download readline patches
if [ "${patch_version}" -gt 0 ] 2>/dev/null; then
    _p=1

    while [ "${_p}" -le "${patch_version}" ]; do
        source="${source} https://ftp.gnu.org/gnu/${name}/${name}-${version%.*}-patches/${patch_name}$(printf "%03d" "${_p}")"
        _p=$((_p + 1))
    done
fi

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version%.*}"

    # Apply readline patches
    if [ "${patch_version}" -gt 0 ] 2>/dev/null; then
        for p in "${SRC}/${patch_name}"*; do
            patch -Np0 -i "${p}"
        done
    fi

    sed -i '/MV.*old/d' Makefile.in
    sed -i '/{OLDSUFF}/c:' support/shlib-install

    ./configure \
        --prefix=/usr \
        --disable-static \
        --with-curses

    make SHLIB_LIBS="-lncursesw"
    make SHLIB_LIBS="-lncursesw" DESTDIR="${PKG}" install

    install -d "${PKG}/lib"

    mv "${PKG}/usr/lib"/libreadline.so.* \
        "${PKG}/usr/lib"/libhistory.so.* \
        "${PKG}/lib"

    ln -sfv "../../lib/$(readlink "${PKG}/usr/lib/libreadline.so")" "${PKG}/usr/lib/libreadline.so"
    ln -sfv "../../lib/$(readlink "${PKG}/usr/lib/libhistory.so")" "${PKG}/usr/lib/libhistory.so"

    install -Dm644 "${SRC}/inputrc" -t "${PKG}/etc/"
}
