#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Fast and lightweight image viewer for the Xfce desktop"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ristretto
version=0.14.0
release=1
source="http://archive.xfce.org/src/apps/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
