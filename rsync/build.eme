#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Utilities for synchronizing large file archives over a network"
homepage="https://rsync.samba.org/"
maintainer="Vylen Linux Team"

name=rsync
version=3.4.1
release=1

source="https://download.samba.org/pub/${name}/${name}-${version}.tar.gz
    fix-invalid-acces-array.patch
    rsyncd.conf"

backup="etc/rsyncd.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/fix-invalid-acces-array.patch"

    ./configure \
        --prefix=/usr \
        --with-included-popt=no \
        --with-included-zlib=no \
        --disable-xxhash

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/rsyncd.conf" -t "${PKG}/etc/"
    openrc_add rsyncd
}
