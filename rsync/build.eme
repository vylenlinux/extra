#!/bin/sh

# shellcheck disable=SC2034
description="Utilities for synchronizing large file archives over a network"
homepage="https://github.com/RsyncProject/rsync"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=rsync
version=3.5.2
release=1
backup="etc/rsyncd.conf"

source="https://github.com/RsyncProject/${name}/releases/download/v${version}/${name}-${version}.tar.gz
    rsyncd.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --with-rrsync \
        --with-included-popt=no \
        --with-included-zlib=no \
        --disable-xxhash

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/rsyncd.conf" -t "${PKG}/etc/"
    install -Dm644 packaging/systemd/rsync.service "${PKG}/usr/lib/systemd/system/rsyncd.service"
    install -Dm644 packaging/systemd/rsync.socket "${PKG}/usr/lib/systemd/system/rsyncd.socket"
    install -Dm644 packaging/systemd/rsync@.service "${PKG}/usr/lib/systemd/system/rsyncd@.service"
}
