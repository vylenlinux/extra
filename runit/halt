#!/bin/sh

name="$(basename "${0}")"

if [ "$(id -u)" != 0 ]; then
    printf '%s: must be superuser.\n' "${name}"
    exit 1
fi

case "${name}" in
    poweroff | halt) action=0 ;;
    reboot) action=6 ;;
    *) exit 1 ;;
esac

if [ "${action}" = 6 ]; then
    touch /run/runit.reboot
fi

/sbin/runit-init "${action}"
