#!/bin/sh

# shellcheck disable=SC2034
description="Automatically generates Rust FFI bindings to C (and some C++) libraries"
homepage="https://github.com/rust-lang/rust-bindgen"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=rust-bindgen
version=0.73.2
release=1
source="${name}-${version}.tar.gz::https://github.com/rust-lang/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build --release
    install -Dm755 target/release/bindgen -t "${PKG}/usr/bin/"
}
