#!/bin/sh

# shellcheck disable=SC2034
description="The Rust programming language is designed to be a safe, concurrent, practical language"
homepage="https://www.rust-lang.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=rust
version=1.100.0
release=1

source="${name}-${version}.tar.xz::https://static.rust-lang.org/dist/rustc-${version}-src.tar.xz
    bootstrap.toml
    0001-bootstrap-Change-libexec-dir.patch
    0002-bootstrap-Change-bash-completion-dir.patch
    0003-bootstrap-Workaround-for-system-stage0.patch
    0004-compiler-Change-LLVM-targets.patch
    0005-compiler-Use-ld.lld-by-default.patch
    0006-compiler-Swap-primary-and-secondary-lib-dirs.patch"

build() {
    # shellcheck disable=SC2164
    cd "rustc-${version}-src"

    # Patch bootstrap so that rust-analyzer-proc-macro-srv
    # is in /usr/lib instead of /usr/libexec
    patch -Np1 -i "${SRC}/0001-bootstrap-Change-libexec-dir.patch"

    # Put bash completions where they belong
    patch -Np1 -i "${SRC}/0002-bootstrap-Change-bash-completion-dir.patch"

    # Fix build with system rustc
    # https://github.com/rust-lang/rust/issues/143735
    patch -Np1 -i "${SRC}/0003-bootstrap-Workaround-for-system-stage0.patch"

    # Use our *-pc-linux-gnu targets, making LTO with clang simpler
    patch -Np1 -i "${SRC}/0004-compiler-Change-LLVM-targets.patch"

    # Use our ld.lld
    patch -Np1 -i "${SRC}/0005-compiler-Use-ld.lld-by-default.patch"

    # Prefer "lib" over "lib64"
    patch -Np1 -i "${SRC}/0006-compiler-Swap-primary-and-secondary-lib-dirs.patch"

    install -Dm644 "${SRC}/bootstrap.toml" -t .
    export RUST_BACKTRACE=1

    [ -e /usr/include/libssh2.h ] && export LIBSSH2_SYS_USE_PKG_CONFIG=1
    [ -e /usr/include/sqlite3.h ] && export LIBSQLITE3_SYS_USE_PKG_CONFIG=1

    python3 x.py build
    DESTDIR="${PKG}" python3 x.py install

    unset LIBSSH2_SYS_USE_PKG_CONFIG \
        LIBSQLITE3_SYS_USE_PKG_CONFIG

    # shellcheck disable=SC2115
    rm -rf "${PKG}/usr/lib/rustlib/components" \
        "${PKG}/usr/lib/rustlib/manifest-rustc" \
        "${PKG}/usr/lib/rustlib/rust-installer-version" \
        "${PKG}/etc"
}
