#!/bin/sh

# shellcheck disable=SC2034
description="File and print services to SMB/CIFS clients and Windows networking to Linux clients"
homepage="https://www.samba.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=samba
version=4.25.0
release=1

source="https://www.samba.org/ftp/${name}/stable/${name}-${version}.tar.gz
    remove-sysconfig.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/remove-sysconfig.patch"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --libdir=/usr/lib \
        --libexecdir="/usr/lib/${name}" \
        --localstatedir=/var \
        --with-piddir="/run/${name}" \
        --with-sockets-dir="/run/${name}" \
        --with-pammodulesdir=/usr/lib/security \
        --bundled-libraries=!tdb,!talloc \
        --enable-fhs \
        --without-json \
        --with-systemd \
        --systemd-install-services \
        --without-ad-dc \
        --without-ads \
        --without-ldap

    make
    make DESTDIR="${PKG}" install

    ln -s libnss_winbind.so.2 "${PKG}/usr/lib/libnss_winbind.so"
    ln -s libnss_wins.so.2 "${PKG}/usr/lib/libnss_wins.so"

    install -Dm644 examples/smb.conf.default -t "${PKG}/etc/${name}/"

    do_tmpfiles "${name}"
    do_pam "${name}"
}
