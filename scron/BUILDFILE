description="Suckless cron daemon"
homepage="http://git.2f30.org/scron"
maintainer="Vylen Linux Team"

name=scron
version=0.4
release=1

source="https://dl.2f30.org/releases/$name-$version.tar.gz
    run.${name}"

build() {
    cd $name-$version
    make
    make DESTDIR=$PKG PREFIX=/usr install

	install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
	ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
}
