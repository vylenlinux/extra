From 111907ad7c604d264ec7bd078a7bcf1721d6eab8 Mon Sep 17 00:00:00 2001
From: Fabian Vogt <fabian@ritter-vogt.de>
Date: Wed, 1 May 2024 21:19:44 +0200
Subject: [PATCH] sddm.service: Wait for driver loading to be complete

---
 services/sddm.service.in | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/services/sddm.service.in b/services/sddm.service.in
index 0b464439c..e8b016216 100644
--- a/services/sddm.service.in
+++ b/services/sddm.service.in
@@ -7,6 +7,11 @@ PartOf=graphical.target
 StartLimitIntervalSec=30
 StartLimitBurst=2
 
+# Wait for driver loading to be complete so that graphics work
+# (https://github.com/sddm/sddm/issues/1917)
+Wants=systemd-udev-settle.service
+After=systemd-udev-settle.service
+
 [Service]
 ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/sddm
 Restart=always
