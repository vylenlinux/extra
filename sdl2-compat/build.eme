#!/bin/sh

# shellcheck disable=SC2034
description="Compatibility layer between SDL2 and SDL3"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://www.libsdl.org"

name=sdl2-compat
version=2.32.74
release=1
source="https://github.com/libsdl-org/${name}/releases/download/release-${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
