#!/bin/sh

# shellcheck disable=SC2034
description="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 2)"
homepage="https://www.libsdl.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sdl3
version=3.4.20
release=1
source="https://github.com/libsdl-org/SDL/releases/download/release-${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "SDL3-${version}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DSDL_STATIC=OFF \
        -DSDL_RPATH=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
