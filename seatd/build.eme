#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Seat management daemon and library"
homepage="https://git.sr.ht/~kennylevinsen/seatd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=seatd
version=0.9.3
release=2

source="${name}-${version}.tar.gz::https://git.sr.ht/~kennylevinsen/${name}/archive/${version}.tar.gz
    sysuser.conf"

build() {
    vylen-meson "${name}-${version}" build \
        -Dlibseat-logind=systemd \
        -Dlibseat-seatd=enabled \
        -Dlibseat-builtin=enabled \
        -Dman-pages=enabled \
        -Dexamples=disabled \
        -Dserver=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 "${name}-${version}/contrib/systemd/seatd.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 sysuser.conf "${PKG}/usr/lib/sysusers.d/seatd.conf"

    # user can run seatd-launch
    chmod u+s "${PKG}/usr/bin/seatd-launch"
}
