#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Set the keyboard using the X Keyboard Extension"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=setxkbmap
version=1.3.5
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
