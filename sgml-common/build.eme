description="Tools for maintaining centralized SGML catalogs"
homepage="https://www.docbook.org/xml/"
maintainer="Vylen Linux Team"

name=sgml-common
version=0.6.3
release=1
source="https://sourceware.org/ftp/docbook-tools/new-trials/SOURCES/$name-$version.tgz
	$name-manpage-1.patch"

build() {
	cd $name-$version

	patch -Np1 -i ../$name-manpage-1.patch
	autoreconf -f -i

	./configure --prefix=/usr --sysconfdir=/etc
	make
	make docdir=/usr/share/doc DESTDIR=$PKG install

}
