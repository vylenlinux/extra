#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A collection of tools, libraries and tests for shader compilation"
homepage="https://github.com/google/shaderc"
maintainer="Vylen Linux Team"

name=shaderc
version=2026.2
release=1

source="${name}-${version}.tar.gz::https://github.com/google/${name}/archive/v${version}/${name}-v${version}.tar.gz
    no-vk14.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/no-vk14.patch"

    # de-vendor libs and disable git versioning
    sed '/examples/d;/third_party/d' -i CMakeLists.txt
    sed '/build-version/d' -i glslc/CMakeLists.txt

    cat <<-EOF > glslc/src/build-version.inc
"${version}\\n"
"$(prt-get printf '%v\n' --filter=spirv-tools)"
"$(prt-get printf '%v\n' --filter=glslang)"
EOF

    sed -i -e "s|\$<TARGET_FILE:spirv-dis>|spirv-dis|" glslc/test/CMakeLists.txt

    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DSHADERC_SKIP_TESTS=ON \
        -Dglslang_SOURCE_DIR:PATH=/usr/include/glslang \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # Remove unused shaderc_static.pc
    rm "${PKG}/usr/lib/pkgconfig/shaderc_static.pc"
}
