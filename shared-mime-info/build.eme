#!/bin/sh

# shellcheck disable=SC2034
description="Freedesktop.org Shared MIME Info"
homepage="https://www.freedesktop.org/wiki/Specifications/shared-mime-info-spec/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=shared-mime-info
version=2.5.1
release=1
source="https://gitlab.freedesktop.org/xdg/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dupdate-mimedb=false \
        -Dbuild-tests=false \
        -Dbuild-spec=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
