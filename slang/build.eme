#!/bin/sh

# shellcheck disable=SC2034
description="S-Lang is a powerful interpreted language"
homepage="https://www.jedsoft.org/slang/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=slang
version=2.3.3
release=1
source="https://www.jedsoft.org/releases/${name}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-readline=gnu

    make
    make DESTDIR="${PKG}" install_doc_dir="/usr/share/doc/${name}" SLSH_DOC_DIR="/usr/share/doc/${name}/slsh" install-all

    chmod 755 "${PKG}/usr/lib/libslang.so.${version}" \
	    "${PKG}/usr/lib/slang/v2/modules"/*.so
}
