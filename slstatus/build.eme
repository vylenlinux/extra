#!/bin/sh

# shellcheck disable=SC2034
description="suckless status monitor for window managers that use WM_NAME or stdin to fill the status bar"
homepage="https://tools.suckless.org/slstatus/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=slstatus
version=1.1
release=1
source="${name}-${version}.tar.gz::https://github.com/drkhsh/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    make PREFIX=/usr DESTDIR="${PKG}" install
}
