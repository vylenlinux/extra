#!/bin/sh

# shellcheck disable=SC2034
description="Select a region in a Wayland compositor and print it to the standard output. Works well with grim."
homepage="https://github.com/emersion/slurp"
maintainer="Vylen Linux Team"

name=slurp
version=1.5.0
release=1
source="${name}-${version}.tar.gz::https://github.com/emersion/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
