#!/bin/sh

# shellcheck disable=SC2034
description="Portable make utility from the Schily tool collection"
homepage="https://codeberg.org/schilytools/schilytools"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=smake
version=2024.03.21
release=1

_version="$(printf '%s' "${version}" | tr '.' '-')"
source="schilytools-${version}.tar.gz::https://codeberg.org/schilytools/schilytools/archive/${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd schilytools
    (cd psmake && sh ./MAKE-all)

    install -Dm755 "psmake/${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "${name}/defaults.smk" -t "${PKG}/usr/share/lib/${name}/"
    install -Dm644 "${name}/${name}.1" -t "${PKG}/usr/share/man/man1/"
}
