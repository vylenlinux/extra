#!/bin/sh

# shellcheck disable=SC2034
description="Portable make utility from the Schily tool collection"
homepage="https://codeberg.org/schilytools/schilytools"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=smake
version=2024.03.21
release=1

_version="$(printf '%s' "${version}" | tr '.' '-')"
source="schilytools-${version}.tar.gz::https://codeberg.org/schilytools/schilytools/archive/${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd schilytools

    find . -type f -exec sed -i 's|share/lib/smake/|share/smake|g' {} +
    (cd psmake && sh ./MAKE-all)

    install -Dm755 psmake/smake "${PKG}/usr/bin/smake"
    install -Dm644 smake/defaults.smk "${PKG}/usr/share/smake/defaults.smk"
    install -Dm644 smake/smake.1 "${PKG}/usr/share/man/man1/smake.1"
}
