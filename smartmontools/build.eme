#!/bin/sh

# shellcheck disable=SC2034
description="Control and monitor S.M.A.R.T. enabled ATA and SCSI Hard Drives"
homepage="http://smartmontools.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=smartmontools
version=7.5
release=1
backup="etc/smartd.conf"

source="https://sourceforge.net/projects/${name}/files/${name}/${version}/${name}-${version}.tar.gz
    remove-sysconfig.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/remove-sysconfig.patch"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --with-libsystemd=yes \
        --with-systemdsystemunitdir=/usr/lib/systemd/system \
        --with-smartdscriptdir=/usr/share/smartmontools \
        --with-smartdplugindir=/usr/share/smartmontools/smartd_warning.d

    make
    make DESTDIR="${PKG}" install
}
