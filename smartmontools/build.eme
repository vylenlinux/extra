#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Control and monitor S.M.A.R.T. enabled ATA and SCSI Hard Drives"
homepage="http://smartmontools.sourceforge.net/"
maintainer="Vylen Linux Team"

name=smartmontools
version=7.5
release=1
source="https://sourceforge.net/projects/${name}/files/${name}/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-initscriptdir=no

    make
    make DESTDIR="${PKG}" install

    runit_add smartd
}
