#!/bin/sh

# shellcheck disable=SC2034
description="A fast compressor/decompressor library"
homepage="https://google.github.io/snappy/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=snappy
version=1.3.0
release=1

source="https://github.com/google/${name}/archive/${version}/${name}-${version}.tar.gz
    ${name}.pc"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -DSNAPPY_BUILD_TESTS=OFF \
        -DSNAPPY_BUILD_BENCHMARKS=OFF \
        -DHAVE_LIBZ=NO \
        -DHAVE_LIBLZO2=NO \
        -DHAVE_LIBLZ4=NO \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    sed "s/%(version)/${version}/g" "${SRC}/${name}.pc" | install -Dm644 /dev/stdin "${PKG}/usr/lib/pkgconfig/${name}.pc"
}
