#!/bin/sh

# shellcheck disable=SC2034
description="Freedesktop sound theme"
homepage="https://freedesktop.org/wiki/Specifications/sound-theme-spec"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sound-theme-freedesktop
version=0.8
release=1
source="https://people.freedesktop.org/~mccann/dist/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
