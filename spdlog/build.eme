#!/bin/sh

# shellcheck disable=SC2034
description="Very fast, header-only/compiled, C++ logging library."
homepage="https://github.com/gabime/spdlog"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=spdlog
version=1.17.0
release=2
source="https://github.com/gabime/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DSPDLOG_BUILD_BENCH=OFF \
        -DSPDLOG_SANITIZE_ADDRESS=OFF \
        -DSPDLOG_FMT_EXTERNAL=ON \
        -DSPDLOG_BUILD_SHARED=ON \
        -DSPDLOG_BUILD_EXAMPLE=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    sed -e 's|.*#define SPDLOG_FMT_EXTERNAL|#define SPDLOG_FMT_EXTERNAL|' -i "${PKG}/usr/include/spdlog/tweakme.h"
    rm -f "${PKG}/usr/include/spdlog/sinks/systemd_sink.h"
}
