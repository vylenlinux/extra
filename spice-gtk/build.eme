#!/bin/sh

# shellcheck disable=SC2034
description="Spice gtk client and libraries"
homepage="https://www.spice-space.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=spice-gtk
version=0.43
release=1
source="https://gitlab.freedesktop.org/-/project/64/uploads/88f5d31a961da9921add46ca3f0be904/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        --libexecdir="/usr/lib/${name}" \
        -Dgtk=enabled \
        -Dgtk_doc=disabled \
        -Dusb-ids-path=/usr/share/hwdata/usb.ids

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
