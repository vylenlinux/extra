#!/bin/sh

# shellcheck disable=SC2034
description="Spice gtk client and libraries"
homepage="https://www.spice-space.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=spice-gtk
version=0.43
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        --libexecdir="/usr/lib/${name}" \
        -Dgtk=enabled \
        -Dgtk_doc="$(emerald is-installed gtk-doc && printf 'enabled' || printf 'disabled')" \
        -Dusb-ids-path=/usr/share/hwdata/usb.ids

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
