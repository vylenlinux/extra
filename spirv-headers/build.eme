#!/bin/sh

# shellcheck disable=SC2034
description="SPIR-V Headers"
homepage="https://www.khronos.org/registry/spir-v"
maintainer="Vylen Linux Team"

name=spirv-headers
version=1.4.350.1
release=2

commit=ad9184e76a66b1001c29db9b0a3e87f646c64de0
source="${name}-${version}-${commit}.tar.gz::https://github.com/KhronosGroup/${name}/archive/${commit}.tar.gz"
#source="${name}-${version}.tar.gz::https://github.com/KhronosGroup/${name}/archive/refs/tags/vulkan-sdk-${version}.tar.gz"

build() {
    cmake -S "SPIRV-Headers-${commit}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
