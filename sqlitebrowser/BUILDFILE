#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A light GUI editor for SQLite databases, built on top of Qt"
maintainer="Vylen Linux Team"
homepage="https://sqlitebrowser.org"

name=sqlitebrowser
version=nightly.2b39cef
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/nightly.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-nightly"

    cmake -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DQT_MAJOR=Qt6 \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    install -Dm0644 distri/sqlitebrowser.desktop "${PKG}/usr/share/applications/${name}.desktop"
    install -Dm0644 images/logo.png "${PKG}/usr/share/icons/hicolor/scalable/apps/${name}.svg"
}
