#!/bin/sh

# shellcheck disable=SC2034
description="Remote filesystem in userspace using SSH"
homepage="https://github.com/libfuse/sshfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sshfs-fuse
version=3.7.7
release=1
source="${name}-${version}.tar.xz::https://github.com/libfuse/sshfs/releases/download/sshfs-${version}/sshfs-${version}.tar.xz"

build() {
    vylen-meson "sshfs-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
