#!/bin/sh

# shellcheck disable=SC2034
description="Single-file public domain or MIT licensed libraries for C/C++"
homepage="https://github.com/nothings/stb"
maintainer="Vylen Linux Team"

name=stb
version=20260416
release=1

commit=2c980bb59875b0d32144a71867fbdebb2f77cd20
source="https://github.com/nothings/${name}/archive/${commit}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"

    # shellcheck disable=SC2035
    install -Dm644 *.c *.h deprecated/stb_image_resize.h -t "${PKG}/usr/include/${name}/"
}
