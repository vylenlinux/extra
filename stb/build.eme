description="Single-file public domain or MIT licensed libraries for C/C++"
homepage="https://github.com/nothings/stb"
maintainer="Vylen Linux Team"

name=stb
version=0_git20231012
_commit=beebb24b945efdea3b9bba23affb8eb3ba8982e7
release=1
source="$name-$version.tar.gz::https://github.com/nothings/stb/archive/$_commit.tar.gz"

build() {
       cd stb-$_commit
       install -Dm644 ./stb_*.h -t "$PKG"/usr/include/stb/
       install -Dm644 docs/* -t "$PKG"/usr/share/doc/stb/

}
