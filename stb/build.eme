#!/bin/sh

# shellcheck disable=SC2034
description="Single-file public domain or MIT licensed libraries for C/C++"
homepage="https://github.com/nothings/stb"
maintainer="Vylen Linux Team"

name=stb
version=0_git20231012
release=1

commit="beebb24b945efdea3b9bba23affb8eb3ba8982e7"
source="${name}-${version}.tar.gz::https://github.com/nothings/${name}/archive/${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"

    install -Dm644 ./stb_*.h -t "${PKG}/usr/include/${name}/"
    install -Dm644 docs/* -t "${PKG}/usr/share/doc/${name}/"
}
