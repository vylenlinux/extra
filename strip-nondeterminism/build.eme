#!/bin/sh

# shellcheck disable=SC2034
description="Tool for stripping bits of non-deterministic information from files"
homepage="https://salsa.debian.org/reproducible-builds/strip-nondeterminism"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=strip-nondeterminism
version=1.16.0
release=1
source="https://salsa.debian.org/reproducible-builds/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed 's|bin/dh_strip_nondeterminism ||g' -i Makefile.PL
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install

    # Don't install the internal handler documentation generated from pod documents
    rm -r "${PKG}/usr/share/man/man3"
}
