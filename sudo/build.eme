#!/bin/sh

# shellcheck disable=SC2034
description="Give certain users the ability to run some commands as root"
homepage="https://www.sudo.ws/sudo/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sudo
version=1.9.17p2
release=1
backup="etc/sudoers"

source="${name}-${version}.tar.gz::https://github.com/${name}-project/${name}/archive/refs/tags/v${version}.tar.gz
    0001-cve-2026-35535.patch
    0002-Fix-OpenSSL-4.0-compatibility.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/0001-cve-2026-35535.patch"
    patch -Np1 -i "${SRC}/0002-Fix-OpenSSL-4.0-compatibility.patch"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib \
        --with-secure-path \
        --with-all-insults \
        --with-env-editor \
        --with-passprompt="[sudo] password for %p: "

    make
    make DESTDIR="${PKG}" install

    rm -rf "${PKG}/var/run" \
        "${PKG}/run"

    do_pam "${name}"
}
