#!/bin/sh

# shellcheck disable=SC2034
description="Give certain users the ability to run some commands as root"
homepage="https://www.sudo.ws/sudo/"
maintainer="Vylen Linux Team"

name=sudo
version=1.9.17p2
release=2
backup="etc/sudoers"

source="https://www.sudo.ws/dist/${name}-${version}.tar.gz
    0001-cve-2026-35535.patch
    0002-Fix-OpenSSL-4.0-compatibility.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/0001-cve-2026-35535.patch"
    patch -Np1 -i "${SRC}/0002-Fix-OpenSSL-4.0-compatibility.patch"

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --with-secure-path \
        --with-all-insults \
        --with-env-editor \
        --with-passprompt="[sudo] password for %p: "

    make
    make DESTDIR="${PKG}" install

    ln -sf libsudo_util.so.0.0.0 "${PKG}/usr/lib/sudo/libsudo_util.so.0"
    sed -i 's/# %wheel ALL=(ALL) ALL/%wheel ALL=(ALL) ALL/' "${PKG}/etc/sudoers"

    rm -rf "${PKG}/var/run" \
        "${PKG}/run"

    do_pam "${name}"
}
