#!/bin/sh

# shellcheck disable=SC2034
description="Scalable Video Technology AV1 encoder and decoder"
homepage="https://github.com/AOMediaCodec/SVT-AV1"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=svt-av1
version=4.3.1
release=1
source="https://github.com/AOMediaCodec/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "SVT-AV1-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -DNATIVE=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
