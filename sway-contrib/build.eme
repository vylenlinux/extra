#!/bin/sh

# shellcheck disable=SC2034
description="A collection of user-contributed scripts for sway"
homepage="https://github.com/OctopusET/sway-contrib"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sway-contrib
version=1.12
release=1
source="${name}-${version}.tar.gz::https://github.com/OctopusET/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    for util in autoname-workspaces.py firefox-focus-monitor.py inactive-windows-transparency.py layout-per-window.py switch-top-level.py; do
        install -Dm755 "${util}" -t "${PKG}/usr/share/${name}/"
    done
}
