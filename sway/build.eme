#!/bin/sh

# shellcheck disable=SC2034
description="Tiling Wayland compositor and replacement for the i3 window manager"
homepage="https://github.com/swaywm/sway"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sway
version=1.12
release=1

source="https://github.com/swaywm/${name}/releases/download/${version}/${name}-${version}.tar.gz
    ${name}-portals.conf
    50-systemd-user.conf"

build() {
    SWAY_OPTS="-Ddefault-wallpaper=true \
        -Dzsh-completions=true \
        -Dbash-completions=true \
        -Dfish-completions=true \
        -Dswaybar=true \
        -Dswaynag=true \
        -Dtray=auto \
        -Dgdk-pixbuf=auto \
        -Dman-pages=auto"

    # shellcheck disable=SC2086
    vylen-meson "${name}-${version}" build \
        -Dsd-bus-provider=libsystemd \
        -Dwerror=false \
        ${SWAY_OPTS}

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 50-systemd-user.conf -t "${PKG}/etc/sway/config.d/"
    install -Dm644 "${name}-portals.conf" -t "${PKG}/usr/share/xdg-desktop-portal/portals/"
}
