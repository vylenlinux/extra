#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Tiling Wayland compositor and replacement for the i3 window manager "
homepage="https://github.com/swaywm/sway"
maintainer="Vylen Linux Team"

name=sway
version=1.12
release=1

source="https://github.com/swaywm/sway/releases/download/${version}-rc${release}/${name}-${version}-rc${release}.tar.gz
    ${name}-portals.conf
    ${name}.desktop"

build() {
    # CBUILD: enable or disable options, source CBUILD_SWAY_OPTS from "sway.opt" file
    CBUILD_SWAY_OPTS="-Ddefault-wallpaper=true \
        -Dzsh-completions=true \
        -Dbash-completions=true \
        -Dfish-completions=true \
        -Dswaybar=true \
        -Dswaynag=true \
        -Dtray=auto \
        -Dgdk-pixbuf=auto \
        -Dman-pages=auto"

    cbuild_options "${name}"

    # shellcheck disable=SC2086
    vylen-meson "${name}-${version}-rc${release}" build \
        -Dsd-bus-provider=basu \
        -Dwerror=false \
        ${CBUILD_SWAY_OPTS}

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm644 "${SRC}/${name}.desktop" -t "${PKG}/usr/share/wayland-sessions/"
    install -Dm644 "${SRC}/${name}-portals.conf" -t "${PKG}/usr/share/xdg-desktop-portal/portals/"
}
