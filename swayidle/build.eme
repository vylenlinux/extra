#!/bin/sh

# shellcheck disable=SC2034
description="Idle management daemon for Wayland"
homepage="https://github.com/swaywm/swayidle"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=swayidle
version=1.9.0
release=1
source="https://github.com/swaywm/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dbash-completions="$(emerald is-installed bash-completions && printf "true" || printf "false")" \
        -Dfish-completions="$(emerald is-installed fish-completions && printf "true" || printf "false")" \
        -Dzsh-completions="$(emerald is-installed zsh-completions && printf "true" || printf "false")" \
        -Dlogind=enabled \
        -Dlogind-provider=systemd \
        -Dman-pages=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
