#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Image viewer for Sway"
homepage="https://github.com/artemsen/swayimg"
maintainer="Vylen Linux Team"

name=swayimg
version=5.2
release=1
source="https://github.com/artemsen/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Djpeg=enabled \
        -Dpng=enabled \
        -Dheif="$(emerald is-installed libheif && printf "enabled" || printf "disabled")" \
        -Djxl="$(emerald is-installed libjxl && printf "enabled" || printf "disabled")" \
        -Dsvg="$(emerald is-installed librsvg && printf "enabled" || printf "disabled")" \
        -Dwebp="$(emerald is-installed libwebp && printf "enabled" || printf "disabled")" \
        -Dexr="$(emerald is-installed openxr && printf "enabled" || printf "disabled")" \
        -Dtiff="$(emerald is-installed libtiff && printf "enabled" || printf "disabled")" \
        -Dbash="$(emerald is-installed bash-completion && printf "enabled" || printf "disabled")" \
        -Dzsh="$(emerald is-installed zsh && printf "enabled" || printf "disabled")" \
        -Dversion="${version}"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
