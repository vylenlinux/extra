#!/bin/sh

# shellcheck disable=SC2034
description="Screen locker for Wayland"
homepage="https://github.com/swaywm/swaylock"
maintainer="Vylen Linux Team"

name=swaylock
version=1.8.5
release=1
source="https://github.com/swaywm/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	vylen-meson "${name}-${version}" build \
        -Dpam=enabled \
        -Dbash-completions="$(emerald is-installed bash-completions && printf "true" || printf "false")" \
        -Dfish-completions="$(emerald is-installed fish-completions && printf "true" || printf "false")" \
        -Dzsh-completions="$(emerald is-installed zsh-completions && printf "true" || printf "false")"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # Adapt pam file to vylen
    sed -i 's|login|system-auth|' "${PKG}/etc/pam.d/swaylock"
}
