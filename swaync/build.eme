#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A simple GTK based notification daemon for SwayWM"
homepage="https://github.com/ErikReider/SwayNotificationCenter"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=swaync
version=0.12.6
release=1
source="${name}-${version}.tar.gz::https://github.com/ErikReider/SwayNotificationCenter/archive/v${version}.tar.gz"

build() {
    vylen-meson "SwayNotificationCenter-${version}" build \
        -Dsystemd-service=false \
        -Dscripting=true

    meson compile -C build
    DESTDIR="${PKG}" meson install -C build
}
