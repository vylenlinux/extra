description="Generate scripting interfaces to C/C++ code"
homepage="http://www.swig.org/"
maintainer="Vylen Linux Team"

name=swig
version=4.4.1
release=1
source="$name-$version.tar.gz::https://github.com/swig/swig/archive/refs/tags/v$version.tar.gz"

build() {
	cd $name-$version
	./autogen.sh
	./configure \
		--prefix=/usr                      \
		--without-clisp                    \
 		--without-maximum-compile-warnings
	make
	make DESTDIR=$PKG install
}
