#!/bin/sh

# shellcheck disable=SC2034
description="Simple X Image Viewer"
homepage="https://github.com/xyb3rt/sxiv"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sxiv
version=26
release=1
source="https://github.com/xyb3rt/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    make PREFIX=/usr DESTDIR="${PKG}" install
    make -C icon PREFIX=/usr DESTDIR="${PKG}" install

    install -Dm644 "${name}.desktop" -t "${PKG}/usr/share/applications/"
}
