#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Logging system messages, such as those given by the kernel"
homepage="https://github.com/troglobit/sysklogd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sysklogd
version=2.7.2
release=1
backup="etc/syslog.conf"
source="https://github.com/troglobit/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --without-logger

    make
    make DESTDIR="${PKG}" install

    install -Dm644 syslog.conf -t "${PKG}/etc/"
    do_service "${name}"
}
