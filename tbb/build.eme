#!/bin/sh

# shellcheck disable=SC2034
description="High level abstract threading library"
homepage="https://www.threadingbuildingblocks.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tbb
version=2023.2.0
release=1

source="https://github.com/oneapi-src/oneTBB/archive/v${version}/${name}-${version}.tar.gz
    tbb-no-pip.patch"

build() {
    patch -d "oneTBB-${version}" -Np1 -i "${SRC}/tbb-no-pip.patch"

    cmake -S "oneTBB-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DTBB4PY_BUILD=ON \
        -DTBB_STRICT=OFF \
        -DTBB_TEST=OFF \
        -Wno-author

    cmake --build build --target all python_build
    DESTDIR="${PKG}" cmake --install build
}
