#!/bin/sh

# shellcheck disable=SC2034
description="Powerful, easy-to-learn dynamic programming language"
homepage="https://tcl.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tcl
version=9.1.0
release=1
source="${name}-${version}.tar.gz::https://downloads.sourceforge.net/${name}/${name}${version}-src.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}${version}/unix"

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --enable-shared \
        --enable-symbols \
        --without-tzdata

    make
    make INSTALL_ROOT="${PKG}" install install-libraries install-private-headers

    ln -s "${name}sh${version%.*}" "${PKG}/usr/bin/${name}sh"

    # conflict with perl
    rm "${PKG}/usr/share/man/man3/Thread.3"
}
