description="Trivial DataBase similar to gdbm"
homepage="https://tdb.samba.org/"
maintainer="Vylen Linux Team"

name=tdb
version=1.4.15
release=1
source="https://www.samba.org/ftp/$name/$name-$version.tar.gz"

build() {
	cd $name-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
