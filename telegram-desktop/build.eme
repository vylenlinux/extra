#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Official Telegram Desktop client"
homepage="https://telegram.org/"
maintainer="Vylen Linux Team"

name=telegram-desktop
version=6.8.5
release=1

td_commit=49b3bcbb6bfebf2ed44dd9f25102d2e1a94a58c4

source="${name}-${version}.tar.gz::https://github.com/telegramdesktop/tdesktop/releases/download/v${version}/tdesktop-${version}-full.tar.gz
    https://github.com/tdlib/td/archive/${td_commit}.tar.gz
    minizip.patch"

build() {
    patch -Np1 -d "tdesktop-${version}-full/Telegram/lib_base" -i "${SRC}/minizip.patch"

    cmake -S "${SRC}/td-${td_commit}" -B "${SRC}/td-${td_commit}/build" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX="${SRC}/td-${td_commit}/install" \
        -DTD_E2E_ONLY=ON \
        -Wno-dev

    cmake --build "${SRC}/td-${td_commit}/build"
    cmake --install "${SRC}/td-${td_commit}/build"

    cmake -S "tdesktop-${version}-full" -B build -G Ninja \
        -DCMAKE_VERBOSE_MAKEFILE=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -Dtde2e_DIR="${SRC}/td-${td_commit}/install/lib/cmake/tde2e" \
        -DTDESKTOP_API_ID=611335 \
        -DTDESKTOP_API_HASH=d524b414d21f4d37f08684c1df41ac9c \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
