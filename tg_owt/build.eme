#!/bin/sh

# shellcheck disable=SC2034
description="WebRTC library for Telegram-desktop"
homepage="https://github.com/desktop-app/tg_owt"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tg_owt
version=2ae9991
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DTG_OWT_PACKAGED_BUILD=True \
        -DBUILD_SHARED_LIBS=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
