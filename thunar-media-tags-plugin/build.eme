#!/usr/bin/env sh

# shellcheck disable=SC2034
description="adds special features for media files to the Thunar File Manager"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=thunar-media-tags-plugin
version=0.6.0
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/thunar-plugins/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
