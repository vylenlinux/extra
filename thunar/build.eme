#!/bin/sh

# shellcheck disable=SC2034
description="Xfce file manager, a GTK+3 GUI to organise the files on your computer"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=thunar
version=4.21.7
release=1
source="https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
