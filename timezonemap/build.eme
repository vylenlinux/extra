#!/bin/sh

# shellcheck disable=SC2034
description="Gtk3 timezone map widget, forked from gnome which forked from Ubiquity"
homepage="https://launchpad.net/timezonemap/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=timezonemap
version=0.4.6
release=1
source="${name}-${version}.tar.gz::https://deb.debian.org/debian/pool/main/libt/libtimezonemap/libtimezonemap_${version}.orig.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "libtimezonemap-${version}"
    NOCONFIGURE=1 autoreconf -fi

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --enable-introspection

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

    make
    make DESTDIR="${PKG}" install
}
