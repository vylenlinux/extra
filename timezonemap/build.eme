#!/bin/sh

# shellcheck disable=SC2034
description="Gtk3 timezone map widget, forked from gnome which forked from Ubiquity"
homepage="https://github.com/dashea/timezonemap"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=timezonemap
version=0.4.5.2
release=1
source="${name}-${version}.tar.gz::https://github.com/dashea/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

    make
    make DESTDIR="${PKG}" install
}
