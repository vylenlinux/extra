#!/bin/sh

# shellcheck disable=SC2034
description="Low-footprint RDF triple store with SPARQL 1.1 interface"
homepage="https://tinysparql.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tinysparql
version=3.12.0
release=1

source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz
    disable-cli-test.patch
    gh-ci-timeout.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/disable-cli-test.patch"
    patch -Np1 -i "${SRC}/gh-ci-timeout.patch"

    vylen-meson build \
        -Dtests_tap_protocol=true \
        -Ddocs=false \
        -Dman=true

    meson compile -C build
    meson install -C build --destdir "${PKG}"
}
