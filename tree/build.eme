#!/usr/bin/env sh

# shellcheck disable=SC2034
description="display directory contents, including directories, files, links, in a terminal"
homepage="https://gitlab.com/OldManProgrammer/unix-tree"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tree
version=2.3.2
release=1
source="https://gitlab.com/OldManProgrammer/unix-tree/-/archive/${version}/unix-tree-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "unix-${name}-${version}"

    make
    make PREFIX="${PKG}/usr" MANDIR="${PKG}/usr/share/man/man1" install
}
