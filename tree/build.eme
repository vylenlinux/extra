#!/bin/sh

# shellcheck disable=SC2034
description="A directory listing program displaying a depth indented list of files"
homepage="https://gitlab.com/OldManProgrammer/unix-tree"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tree
version=2.3.2
release=1
source="${name}-${version}.tar.gz::https://gitlab.com/OldManProgrammer/unix-${name}/-/archive/${version}/unix-${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "unix-${name}-${version}"

    make
    make PREFIX="${PKG}/usr" MANDIR="${PKG}/usr/share/man/man1" install
}
