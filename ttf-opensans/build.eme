#!/bin/sh

# shellcheck disable=SC2034
description="Sans-serif typeface commissioned by Google"
homepage="https://github.com/googlefonts/opensans"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-opensans
version=20261110
release=1

commit=6cbc400d4855abee59d85c4ed871d510399bce7b
source="https://github.com/googlefonts/opensans/archive/${commit}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "opensans-${commit}"
    install -Dm644 fonts/ttf/*.ttf -t "${PKG}/usr/share/fonts/TTF/"
}
