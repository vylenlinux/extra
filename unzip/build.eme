#!/bin/sh

# shellcheck disable=SC2034
description="For extracting and viewing files in .zip archives"
homepage="https://infozip.sourceforge.net/UnZip.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=unzip
version=6.0
release=1

_version="$(printf '%s' "${version}" | sed 's/\.//')"

source="${name}-${version}.tar.gz::https://downloads.sourceforge.net/infozip/${name}${_version}.tar.gz
    CVE-2021-4217.patch
    CVE-2022-0529.patch
    CVE-2022-0530.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}${_version}"

    # fix build with GCC 15
    export CFLAGS="${CFLAGS} -std=gnu17"

    patch -Np1 -i "${SRC}/CVE-2021-4217.patch"
    patch -Np1 -i "${SRC}/CVE-2022-0529.patch"
    patch -Np1 -i "${SRC}/CVE-2022-0530.patch"

    DEFINES="-DACORN_FTYPE_NFS -DWILD_STOP_AT_DIR -DLARGE_FILE_SUPPORT \
        -DUNICODE_SUPPORT -DUNICODE_WCHAR -DUTF8_MAYBE_NATIVE -DNO_LCHMOD \
        -DDATE_FORMAT=DF_YMD -DUSE_BZIP2 -DNOMEMCPY -DNO_WORKING_ISPRINT"

    make -f unix/Makefile unzips \
        prefix=/usr \
        D_USE_BZ2=-DUSE_BZIP2 L_BZ2=-lbz2 \
        LF2="${LDFLAGS}" CF="${CFLAGS} ${CPPFLAGS} -I. ${DEFINES}"

    make -f unix/Makefile install \
        prefix="${PKG}/usr" \
        MANDIR="${PKG}/usr/share/man/man1"
}
