#!/bin/sh

# shellcheck disable=SC2034
description="Abstraction for enumerating power devices, listening to device events and querying history and statistics"
homepage="https://upower.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=upower
version=1.91.5
release=1
source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    vylen-meson "${name}-v${version}" build \
        -Dgtk-doc="$(emerald is-installed gtk-doc && printf 'true' || printf 'false')" \
        -Dudevrulesdir=/usr/lib/udev/rules.d \
        -Dudevhwdbdir=/usr/lib/udev/hwdb.d

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
