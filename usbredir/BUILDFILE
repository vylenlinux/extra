description="USB traffic redirection protocol"
homepage="https://www.spice-space.org/usbredir.html"
maintainer="Vylen Linux Team"

name=usbredir
version=0.15.0
release=1
source="https://gitlab.freedesktop.org/spice/usbredir/-/archive/usbredir-${version}/usbredir-usbredir-${version}.tar.gz"

build() {
        vylen-meson $name-$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
