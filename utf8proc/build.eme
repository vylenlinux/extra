#!/bin/sh

# shellcheck disable=SC2034
description="C library for processing UTF-8 encoded Unicode strings"
homepage="https://github.com/JuliaStrings"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=utf8proc
version=2.12.0
release=1
source="${name}-${version}.tar.gz::https://github.com/JuliaStrings/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
