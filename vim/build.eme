#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Vi Improved, a highly configurable, improved version of the vi text editor"
homepage="https://www.vim.org/"
maintainer="Vylen Linux Team"

name=vim
version=9.2.0677
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/v$version/${name}-v${version}.tar.gz
    vimrc"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    echo '#define SYS_VIMRC_FILE "/etc/vimrc"' >> src/feature.h

    ./configure \
        --prefix=/usr \
        --enable-cscope \
        --enable-multibyte \
        --with-ex-name=vim-ex \
        --with-tlib=ncursesw \
        --with-view-name=vim-view \
        --disable-perlinterp \
        --disable-pythoninterp \
        --disable-rubyinterp \
        --disable-netbeans \
        --disable-canberra \
        --disable-gpm \
        --disable-xim \
        --disable-gui \
        --disable-nls \
        --with-x=no \
        --with-wayland=no \
        --with-compiledby='Vylen Linux'

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/vimrc" -t "${PKG}/etc/"
    ln -s vim "${PKG}/usr/bin/vi"

    # no desktop files and icons
    rm -r "${PKG}/usr/share/applications" \
        "${PKG}/usr/share/icons"

    rm -f "${PKG}/usr/share/vim/vim92"/*/systemd.vim
}
