#!/bin/sh

# shellcheck disable=SC2034
description="Additional support for proprietary codecs for Vivaldi"
homepage="https://chromium.googlesource.com/chromium/third_party/ffmpeg"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=vivaldi-ffmpeg-codecs
version=156.0.8078.85
release=1

_vivaldi_major_version=8.3
commit=9db86ce5b5b454dfc96c435f9f0723012980c37f

source="${name}-${version}.tar.gz::https://chromium.googlesource.com/chromium/third_party/ffmpeg/+archive/${commit}.tar.gz"
IGNORE_CHECKSUM=yes

build() {
    grep -o 'av[a-z0-9_]*(' chromium/ffmpeg.sigs | sed 's/($//' > sigs.txt
    printf '%s\n' "avformat_version" "avutil_version" "ff_h264_decode_init_vlc" >> sigs.txt

    printf '{\nglobal:\n' > export.map
    sed 's/$/;/' sigs.txt >> export.map
    printf 'local:\n*;\n};\n' >> export.map
    sed -i.bak 's/^ *\.p\.name *=.*/.p.name="libopus",/' libavcodec/opus/dec.c
    diff libavcodec/opus/dec.c.bak libavcodec/opus/dec.c || :

    ./configure \
        --prefix=/usr \
        --libdir=/ \
        --disable-debug \
        --disable-all \
        --disable-autodetect \
        --disable-doc \
        --disable-iconv \
        --disable-network \
        --disable-symver \
        --disable-large-tests \
        --disable-error-resilience \
        --disable-faan \
        --disable-iamf \
        --disable-shared \
        --enable-static \
        --enable-avformat \
        --enable-avcodec \
        --enable-avutil \
        --enable-swresample \
        --enable-pic \
        --enable-asm \
        --enable-hardcoded-tables \
        --enable-demuxer=ogg,matroska,webm,wav,flac,mp3,mov,aac \
        --enable-decoder=vorbis,opus,flac,pcm_s16le,mp3,aac,h264 \
        --enable-parser=aac,flac,h264,mpegaudio,opus,vorbis,vp9 \
        --extra-cflags="-DCHROMIUM_NO_LOGGING -fno-math-errno -fno-signed-zeros -fno-semantic-interposition -fomit-frame-pointer ${LTOFLAGS}"

    DESTDIR=build make install

    # shellcheck disable=SC2086
    gcc ${LTOFLAGS} -shared ${LDFLAGS} -Wl,--start-group build/libavcodec.a build/libavformat.a build/libavutil.a build/libswresample.a -Wl,--end-group "$(sed 's/^/-Wl,-u,/' sigs.txt | paste -sd ' ' -)" -Wl,--version-script=export.map -lm -Wl,-Bsymbolic -o build/libffmpeg.so
    install -Dm644 build/libffmpeg.so "${PKG}/opt/vivaldi/libffmpeg.so.${_vivaldi_major_version}"
}
