#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Experience the web in a whole new way with Vivaldi."
homepage="https://vivaldi.com/"
maintainer="Vylen Linux Team"

name=vivaldi
version=7.9.3970.59
release=1

source="${name}-${version}.rpm::https://downloads.vivaldi.com/stable/vivaldi-stable-${version}-${release}.x86_64.rpm
    0001-add-support-for-user-flags.patch"

build() {
    for dir in opt usr/bin usr/share; do
        cp -a --parents "${dir}" "${PKG}"
    done

    patch -p1 -i "${SRC}/0001-add-support-for-user-flags.patch" "${PKG}/opt/${name}/${name}"
    rm -f "${PKG}/opt/${name}/${name}.orig"

    chmod 4755 "${PKG}/opt/${name}/vivaldi-sandbox"
    install -dm755 "${PKG}/usr/bin"

    for bin in vivaldi-stable vivaldi; do
        binf="${PKG}/usr/bin/${bin}"

        if [ ! -e "${binf}" ] && [ ! -f "${binf}" ] && [ ! -L "${binf}" ]; then
            ln -s /opt/vivaldi/vivaldi "${binf}"
        fi
    done

    install -Dm644 "${PKG}/opt/${name}/resources/vivaldi/resources/welcomepage-vivaldi.svg" "${PKG}/usr/share/icons/hicolor/scalable/${name}.svg"
    install -Dm644 "${PKG}/opt/${name}/product_logo_256.png"                                "${PKG}/usr/share/icons/hicolor/256x256/apps/${name}.png"

    for _res in 128 64 48 32 22; do
        install -d "${PKG}/usr/share/icons/hicolor/${_res}x${_res}/apps"

        magick "${PKG}/opt/${name}/product_logo_256.png" -resize "${_res}x${_res}" "${PKG}/usr/share/icons/hicolor/${_res}x${_res}/apps/${name}.png"
        chmod 0644 "${PKG}/usr/share/icons/hicolor/${_res}x${_res}/apps/${name}.png"
    done

    install -Dm644 "${PKG}/opt/${name}/product_logo_256.png" "${PKG}/usr/share/pixmaps/${name}.png"
    rm -f "${PKG}/opt/${name}"/product_logo_*.png

    install -Dm644 "usr/share/appdata/${name}.appdata.xml" -t "${PKG}/usr/share/metainfo/"
    rm -rv "${PKG}/usr/share/appdata"
}
