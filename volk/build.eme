#!/bin/sh

# shellcheck disable=SC2034
description="Meta loader for Vulkan API"
homepage="https://github.com/zeux/volk"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=volk
version=1.4.357.0
release=1
source="${name}-${version}.tar.gz::https://github.com/zeux/${name}/archive/refs/tags/vulkan-sdk-${version}.tar.gz"

build() {
    cmake -S "${name}-vulkan-sdk-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DVOLK_INSTALL=True \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
