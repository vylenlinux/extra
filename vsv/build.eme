#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Manage and view runit services"
homepage="https://github.com/bahamas10/vsv"
maintainer="Vylen Linux Team"

name=vsv
version=2.0.0
release=1
source="https://github.com/bahamas10/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build \
        --release \
        --locked

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "man/${name}.8" -t "${PKG}/usr/share/man/man8/"
}
