#!/bin/sh

# shellcheck disable=SC2034
description="Vulkan Utilities and Tools"
homepage="https://www.khronos.org/vulkan"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=vulkan-tools
version=1.4.367
release=1
source="${name}-${version}.tar.gz::https://github.com/KhronosGroup/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cmake -S "Vulkan-Tools-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS} -ffat-lto-objects" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS} -ffat-lto-objects" \
        -DBUILD_ICD=OFF \
        -DBUILD_CUBE=True \
        -DBUILD_VULKANINFO=True \
        -DBUILD_WSI_XCB_SUPPORT=True \
        -DBUILD_WSI_XLIB_SUPPORT=True \
        -DBUILD_WSI_WAYLAND_SUPPORT=True \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
