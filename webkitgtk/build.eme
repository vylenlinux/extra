#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Web content engine for GTK"
homepage="https://webkitgtk.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=webkitgtk
version=2.54.0
release=1
source="https://webkitgtk.org/releases/${name}-${version}.tar.xz"

build() {
    # failed build with ccache, remove reom path
    PATH="$(printf "%s" "${PATH}" | awk -v RS=: -v ORS=: '/ccache/ {
        next;
    } {
        print;
    }' | sed 's/:*$//')"

    # build with GCC
    export CC=gcc
    export CXX=g++
    export CFLAGS="-O2 -pipe -march=x86-64 -fno-lto"
    export CXXFLAGS="-O2 -pipe -march=x86-64 -fno-lto -Wno-error"

    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # fix build ICU 76
    sed '/U_SHOW_CPLUSPLUS_API/a#define U_SHOW_CPLUSPLUS_HEADER_API 0' -i Source/WTF/wtf/Platform.h

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DPORT=GTK \
        -DENABLE_JIT=OFF \
        -DENABLE_GAMEPAD=OFF \
        -DENABLE_JOURNALD_LOG=OFF \
        -DENABLE_DOCUMENTATION=OFF \
        -DENABLE_GEOLOCATION=OFF \
        -DENABLE_MINIBROWSER=ON \
        -DUSE_AVIF=OFF \
        -DUSE_GTK4=OFF \
        -DUSE_LIBBACKTRACE=OFF \
        -DUSE_LIBHYPHEN=OFF \
        -DUSE_WOFF2=OFF \
        -DUSE_SYSTEM_SYSPROF_CAPTURE=NO \
        -Wno-dev

    ninja -C build -j"${CBUILD_JOBS}"
    DESTDIR="${PKG}" cmake --install build
}
