#!/bin/sh

# shellcheck disable=SC2034
description="Web content engine for GTK"
homepage="https://webkitgtk.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=webkitgtk
version=2.54.3
release=2
source="https://webkitgtk.org/releases/${name}-${version}.tar.xz"

build() {
    export CC=clang
    export CXX=clang++
    export LDFLAGS="${LDFLAGS} -fuse-ld=lld"

    emerald is-installed hyphen || LIBHYPHEN="-DUSE_LIBHYPHEN=OFF"
    emerald is-installed geoclue || GEOLOCATION="-DENABLE_GEOLOCATION=OFF"
    emerald is-installed libmanette || GAMEPAD="-DENABLE_GAMEPAD=OFF"
    emerald is-installed libavif || AVIF="-DUSE_AVIF=OFF"
    emerald is-installed woff2 || WOFF2="-DUSE_WOFF2=OFF"
    emerald is-installed flite || FLITE="-DUSE_FLITE=OFF"

    WEBKITGTK_OPTS="-DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DPORT=GTK \
        -DENABLE_DOCUMENTATION=ON \
        -DENABLE_MINIBROWSER=ON \
        -DENABLE_SPEECH_SYNTHESIS=OFF \
        -DUSE_LIBBACKTRACE=OFF \
        -DUSE_SYSTEM_SYSPROF_CAPTURE=NO \
        ${LIBHYPHEN} \
        ${GEOLOCATION} \
        ${GAMEPAD} \
        ${AVIF} \
        ${WOFF2} \
        ${FLITE}"

    # shellcheck disable=SC2086
    cmake -S "${name}-${version}" -B build4 -G Ninja \
        ${WEBKITGTK_OPTS} \
        -DUSE_GTK4=OFF \
        -Wno-author

    # shellcheck disable=SC2086
    cmake -S "${name}-${version}" -B build6 -G Ninja \
        ${WEBKITGTK_OPTS} \
        -DUSE_GTK4=ON \
        -Wno-author

    cmake --build build4
    cmake --build build6

    DESTDIR="${PKG}" cmake --install build4
    DESTDIR="${PKG}" cmake --install build6
}
