#!/bin/sh

# shellcheck disable=SC2034
description="Network utility to retrieve files from the Web"
homepage="https://www.gnu.org/software/wget/wget.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wget
version=1.25.0
release=1

source="https://ftp.gnu.org/gnu/${name}/${name}-${version}.tar.gz
    ${name}-${version}-openssl-4.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/${name}-${version}-openssl-4.patch"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-ssl=openssl

    make
    make DESTDIR="${PKG}" install
}
