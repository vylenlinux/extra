description="Network utility to retrieve files from the Web"
homepage="https://www.gnu.org/software/wget/wget.html"
maintainer="Vylen Linux Team"
# optionals	: bzip2 zstd zlib

name=wget2
version=2.2.1
release=1
source="https://ftp.gnu.org/gnu/wget/$name-$version.tar.gz"

build() {
	cd $name-$version

  	./configure --prefix=/usr \
	            --sysconfdir=/etc \
	            --with-ssl=openssl \
		    --without-libhsts \
		    --without-libidn \
		    --without-pcre
	make
	make DESTDIR=$PKG install
	rm -f $PKG/usr/bin/wget2_noinstall
	rm -f $PKG/usr/lib/libwget.a

}
