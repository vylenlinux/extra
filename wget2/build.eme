#!/bin/sh

# shellcheck disable=SC2034
description="Network utility to retrieve files from the Web"
homepage="https://www.gnu.org/software/wget/wget.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wget2
version=2.3.0
release=1
source="https://ftp.gnu.org/gnu/wget/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-ssl=openssl \
        --without-libhsts \
        --without-libidn \
        --without-pcre

    make
    make DESTDIR="${PKG}" install

    rm -f "${PKG}/usr/bin/wget2_noinstall" \
        "${PKG}/usr/lib/libwget.a"
}
