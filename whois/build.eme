description="Intelligent WHOIS client"
homepage="https://github.com/rfc1036/whois"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=whois
version=5.6.6
release=1
source="$name-$version.tar.xz::https://ftp.debian.org/debian/pool/main/w/whois/whois_$version.tar.xz"

build() {
	cd work
	make CONFIG_FILE='/etc/whois.conf' whois
	make DESTDIR=$PKG install
	install -Dm644 whois.conf -t $PKG/etc
}
