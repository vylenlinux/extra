#!/bin/sh

# shellcheck disable=SC2034
description="Wayland protocol extensions for wlroots and other compositors"
homepage="https://gitlab.freedesktop.org/wlroots/wlr-protocols"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wlr-protocols
version=1106a4a1
release=1
source="https://gitlab.freedesktop.org/wlroots/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make DESTDIR="${PKG}" install
}
