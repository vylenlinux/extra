#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Wayland protocol extensions for wlroots and other compositors"
homepage="https://gitlab.freedesktop.org/wlroots/wlr-protocols"
maintainer="Vylen Linux Team"

name=wlr-protocols
version=240126
release=1

commit=2b8d43325b7012cc3f9b55c08d26e50e42beac7d
source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/wlroots/${name}/-/archive/${commit}/${name}-${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"
    make DESTDIR="${PKG}" install
}
