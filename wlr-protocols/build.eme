#!/bin/sh

# shellcheck disable=SC2034
description="Wayland protocol extensions for wlroots and other compositors"
homepage="https://gitlab.freedesktop.org/wlroots/wlr-protocols"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wlr-protocols
version=20261016+1
release=1

commit=1106a4a1c57562ddd438c547da4c0d6dc150d624
source="https://gitlab.freedesktop.org/wlroots/${name}/-/archive/${commit}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"
    make DESTDIR="${PKG}" install
}
