#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Modular Wayland compositor library"
homepage="https://gitlab.freedesktop.org/wlroots/wlroots"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wlroots
version=0.20.2
release=1
source="https://gitlab.freedesktop.org/${name}/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dwerror=false \
        -Dexamples=false \
        -Dxwayland="$(emerald is-installed xwayland && printf "enabled" || printf "disabled")" \
        -Dbackends=drm,libinput,x11 \
        -Dlibliftoff=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
