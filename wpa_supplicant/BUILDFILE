#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A utility providing key negotiation for WPA wireless networks"
homepage="https://w1.fi"
maintainer="Vylen Linux Team"

name=wpa_supplicant
version=2.11
release=1

source="https://w1.fi/releases/${name}-${version}.tar.gz
    nl80211-add-extra-ies-only-if-allowed-by-driver.patch
    wpa_supplicant-Revert-Mark-authorization-completed-on-driver-indica.patch
    wpa_supplicant.conf"

backup="etc/wpa_supplicant.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/nl80211-add-extra-ies-only-if-allowed-by-driver.patch"
    patch -Np1 -i "${SRC}/wpa_supplicant-Revert-Mark-authorization-completed-on-driver-indica.patch"

    cat > wpa_supplicant/.config <<"EOF"
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=y
CONFIG_DEBUG_FILE=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_DRIVER_WIRED=y
CONFIG_EAP_GTC=y
CONFIG_EAP_LEAP=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_OTP=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLSV1_3=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_IPV6=y
CONFIG_LIBNL32=y
CONFIG_PEERKEY=y
CONFIG_PKCS12=y
CONFIG_READLINE=y
CONFIG_SMARTCARD=y
CONFIG_WPS=y
CFLAGS += -I/usr/include/libnl3
CONFIG_CTRL_IFACE_DBUS=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
EOF

    # shellcheck disable=SC2164
    cd "${name}"
    make BINDIR=/sbin LIBDIR=/lib

    for xx in cli passphrase supplicant; do
        install -Dm755 "wpa_${xx}" -t "${PKG}/sbin/"
        install -Dm644 "doc/docbook/wpa_${xx}.8" -t "${PKG}/usr/share/man/man8/"
    done

    install -Dm644 doc/docbook/wpa_supplicant.conf.5 -t "${PKG}/usr/share/man/man5/"

    install -Dm644 dbus/fi.w1.wpa_supplicant1.service -t "${PKG}/usr/share/dbus-1/system-services/"
    install -Dm644 dbus/dbus-wpa_supplicant.conf "${PKG}/etc/dbus-1/system.d/wpa_supplicant.conf"

    # wpa_supplicant.conf
    install -Dm600 "${SRC}/wpa_supplicant.conf" -t "${PKG}/etc/"
    openrc_add "${name}"
}
