#!/bin/sh

# shellcheck disable=SC2034
description="A utility providing key negotiation for WPA wireless networks"
homepage="https://w1.fi"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wpa_supplicant
version=2.12
release=1

source="https://w1.fi/releases/${name}-${version}.tar.gz
    nl80211-add-extra-ies-only-if-allowed-by-driver.patch
    0004-Tweak-D-Bus-systemd-service-activation-configuration.patch
    0006-Add-reload-support-to-the-systemd-unit-files.patch
    wpa_supplicant.conf
    config"

backup="etc/wpa_supplicant.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/nl80211-add-extra-ies-only-if-allowed-by-driver.patch"
    patch -Np1 -i "${SRC}/0004-Tweak-D-Bus-systemd-service-activation-configuration.patch"
    patch -Np1 -i "${SRC}/0006-Add-reload-support-to-the-systemd-unit-files.patch"

    install -Dm644 "${SRC}/config" wpa_supplicant/.config

    # shellcheck disable=SC2164
    cd "${name}"
    make BINDIR=/usr/bin LIBDIR=/usr/lib

    for xx in cli passphrase supplicant; do
        install -Dm755 "wpa_${xx}" -t "${PKG}/usr/bin/"
        install -Dm644 "doc/docbook/wpa_${xx}.8" -t "${PKG}/usr/share/man/man8/"
    done

    install -Dm644 doc/docbook/wpa_supplicant.conf.5 -t "${PKG}/usr/share/man/man5/"
    install -Dm644 dbus/fi.w1.wpa_supplicant1.service -t "${PKG}/usr/share/dbus-1/system-services/"
    install -Dm644 dbus/dbus-wpa_supplicant.conf "${PKG}/etc/dbus-1/system.d/wpa_supplicant.conf"

    # wpa_supplicant.conf
    install -Dm600 "${SRC}/wpa_supplicant.conf" -t "${PKG}/etc/"
    install -Dm644 systemd/*.service -t "${PKG}/usr/lib/systemd/system/"
}
