#!/bin/sh

# shellcheck disable=SC2034
description="Open Source H265/HEVC video encoder"
homepage="https://github.com/Multicorewareinc/x265"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=x265
version=4.3
release=1
source="${name}-${version}.tar.gz::https://github.com/Multicorewareinc/${name}/releases/download/${version}/${name}_${version}.tar.gz"

build() {
    cmake -S "${name}_${version}/source" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DGIT_ARCHETYPE=1 \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    rm "${PKG}/usr/lib/libx265.a"
}
