#!/bin/sh

# shellcheck disable=SC2034
description="Common library for X-Apps project"
homepage="https://github.com/linuxmint/xapp"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xapp
version=3.4.0
release=1
source="${name}-${version}.tar.gz::https://github.com/linuxmint/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    python3 -m compileall -o 0 -o 1 -o 2 --hardlink-dupes -s "${PKG}" "${PKG}/${PYTHON_SITE_PACKAGES}"
}
