description="X.Org authorization settings program"
homepage="https://xcb.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xauth
version=1.1.5
release=1
source="http://ftp.x.org/pub/individual/app/xauth-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
