#!/bin/sh

# shellcheck disable=SC2034
description="A backend implementation for xdg-desktop-portal using Qt/KDE Frameworks/libfm-qt"
homepage="https://github.com/lxqt/xdg-desktop-portal-lxqt"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xdg-desktop-portal-lxqt
version=1.5.0
release=1

source="https://github.com/lxqt/${name}/releases/download/${version}/${name}-${version}.tar.xz
    lxqt-portals.conf"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # fix detection with x-d-p 1.18
    install -Dm644 "${SRC}/lxqt-portals.conf" -t "${PKG}/usr/share/xdg-desktop-portal/"
}
