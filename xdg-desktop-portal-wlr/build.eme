#!/bin/sh

# shellcheck disable=SC2034
description="xdg-desktop-portal backend for wlroots"
homepage="https://github.com/emersion/xdg-desktop-portal-wlr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xdg-desktop-portal-wlr
version=0.8.5
release=1

source="https://github.com/emersion/${name}/archive/v${version}/${name}-${version}.tar.gz
    wlr-portals.conf"

build() {
    vylen-meson "${name}-${version}" build -Dsd-bus-provider=libsystemd
    meson compile -C build
    DESTDIR="${PKG}" meson install -C build

    # fix detection with x-d-p 1.18
    install -Dm644 wlr-portals.conf -t "${PKG}/usr/share/xdg-desktop-portal/"
}
