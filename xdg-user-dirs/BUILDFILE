description="Manage user directories like ~/Desktop and ~/Music"
homepage="https://www.freedesktop.org/wiki/Software/xdg-user-dirs"
maintainer="Vylen Linux Team"

name=xdg-user-dirs
version=0.19
release=1
source="$name-$version.tar.gz::https://gitlab.freedesktop.org/xdg/xdg-user-dirs/-/archive/v$version/$name-v$version.tar.gz"

build() {
	vylen-meson $name-v$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
