#!/bin/sh

# shellcheck disable=SC2034
description="A small and lightweight text editor"
homepage="https://github.com/linuxmint/xed"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xed
version=3.9.1
release=1
source="${name}-${version}.tar.gz::https://github.com/linuxmint/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
