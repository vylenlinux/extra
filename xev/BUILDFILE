description="Print contents of X events"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xev
version=1.2.6
release=1
source="http://ftp.x.org/pub/individual/app/xev-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
