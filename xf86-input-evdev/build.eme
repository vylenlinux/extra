description="X.org evdev input driver"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xf86-input-evdev
version=2.11.0
release=1
source="https://www.x.org/releases/individual/driver/$name-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
