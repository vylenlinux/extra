description="VMMouse input driver for the Xorg X server"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xf86-input-vmmouse
version=13.2.0
release=1
source="https://www.x.org/pub/individual/driver/$name-$version.tar.gz"

build() {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static \
		--without-hal-fdi-dir \
		--without-hal-callouts-dir \
		--with-udev-rules-dir=/lib/udev/rules.d
	make
	make DESTDIR=$PKG install
}
