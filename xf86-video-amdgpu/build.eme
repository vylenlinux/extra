description="X.Org Video Driver for newer AMD Radeon video cards starting from Volcanic Islands"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xf86-video-amdgpu
version=25.0.0
release=1
source="https://www.x.org/pub/individual/driver/$name-$version.tar.xz"

build() {

	vylen-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
