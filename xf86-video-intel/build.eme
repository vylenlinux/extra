#!/bin/sh

# shellcheck disable=SC2034
description="X.Org Video Driver for Intel integrated video cards including 8xx, 9xx, Gxx, Qxx and HD graphics processors"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xf86-video-intel
version=20230223
release=1
source="https://anduin.linuxfromscratch.org/BLFS/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./autogen.sh \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir="/usr/lib/${name}" \
        --localstatedir=/var \
        --disable-static \
        --enable-kms-only \
        --enable-uxa \
        --with-default-dri=3

    make
    make DESTDIR="${PKG}" install

    mkdir -p "${PKG}/usr/share/man/man1"
    mv "${PKG}/usr/share/man/man4/intel-virtual-output.4" "${PKG}/usr/share/man/man1/intel-virtual-output.1"

    sed -i '/\.TH/s/4/1/' "${PKG}/usr/share/man/man1/intel-virtual-output.1"
}
