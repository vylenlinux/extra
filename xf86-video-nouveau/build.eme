description="X.Org Video Driver for NVidia Cards"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xf86-video-nouveau
version=1.0.18
release=1
source="https://www.x.org/pub/individual/driver/$name-$version.tar.xz"

build() {
	cd $name-$version

	export CFLAGS="$CFLAGS -fPIC"

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
