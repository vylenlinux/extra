#!/bin/sh

# shellcheck disable=SC2034
description="Tool to find and launch installed applications by searching the .desktop files"
homepage="https://gitlab.xfce.org/xfce/xfce4-appfinder"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-appfinder
version=4.21.1
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/xfce/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
