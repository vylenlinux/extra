#!/usr/bin/env sh

# shellcheck disable=SC2034
description="CPU graph plugin for the Xfce4 panel"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-cpugraph-plugin
version=1.3.0
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/panel-plugins/${name}/-/archive/${name}-${version}/${name}-${name}-${name}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}-d6a659bdc10ded1c1b074261ac58b7524c363f1f" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
