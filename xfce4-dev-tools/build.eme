#!/bin/sh

# shellcheck disable=SC2034
description="Xfce developer tools"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-dev-tools
version=4.21.3
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/xfce/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
