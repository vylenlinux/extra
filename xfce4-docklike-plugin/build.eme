#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A modern, docklike, minimalist taskbar for XFCE"
homepage="https://docs.xfce.org/panel-plugins/xfce4-docklike-plugin/start"
maintainer="Vylen Linux Team"

name=xfce4-docklike-plugin
version=0.5.1
release=1
source="https://archive.xfce.org/src/panel-plugins/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
