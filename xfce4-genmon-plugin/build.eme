#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Plugin that monitors customizable programs stdout for the Xfce4 panel"
homepage="https://docs.xfce.org/panel-plugins/xfce4-genmon-plugin/start"
maintainer="Vylen Linux Team"

name=xfce4-genmon-plugin
version=4.3.0
release=1
source="https://archive.xfce.org/src/panel-plugins/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dwerror=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
