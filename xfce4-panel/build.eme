#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Xfce4 Panel"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-panel
version=4.20.8
release=1
source="https://archive.xfce.org/src/xfce/xfce4-panel/${version%.*}/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --enable-x11 \
        --enable-wayland \
        --enable-gio-unix \
        --disable-debug

    make
    make DESTDIR="${PKG}" install
}
