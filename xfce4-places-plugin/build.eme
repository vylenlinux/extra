#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Menu with quick access to folders, documents, and removable media"
homepage="https://xfce.org"
maintainer="Vylen Linux Team"

name=xfce4-places-plugin
version=1.9.0
release=1
source="https://archive.xfce.org/src/panel-plugins/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
