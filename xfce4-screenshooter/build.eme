#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Plugin that makes screenshots for the Xfce panel"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-screenshooter
version=1.11.3
release=1
source="https://archive.xfce.org/src/apps/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dwerror=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
