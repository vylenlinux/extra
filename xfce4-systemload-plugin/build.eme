#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A system load plugin for the Xfce4 panel"
homepage="https://xfce.org"
maintainer="Vylen Linux Team"

name=xfce4-systemload-plugin
version=1.4.0
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/panel-plugins/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
