#!/usr/bin/env sh

# shellcheck disable=SC2034
description="GTK+3 terminal emulator for xfce desktop"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-terminal
version=1.2.0
release=1
source="https://archive.xfce.org/src/apps/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
