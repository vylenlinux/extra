#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Alternate menu for Xfce4"
homepage="https://xfce.org"
maintainer="Vylen Linux Team"

name=xfce4-whiskermenu-plugin
version=2.10.1
release=1
source="${name}-${version}.tar.gz::https://gitlab.xfce.org/panel-plugins/${name}/-/archive/${name}-${version}/${name}-${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
