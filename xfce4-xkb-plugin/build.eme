#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Plugin to switch keyboard layouts for the Xfce4 panel"
homepage="https://xfce.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfce4-xkb-plugin
version=0.9.0
release=1
source="https://archive.xfce.org/src/panel-plugins/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
