#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The configuration storage system for Xfce"
homepage="https://xfce.org"
maintainer="Vylen Linux Team"

name=xfconf
version=4.21.2
release=1
source="http://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Dgtk-doc=true
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
