#!/bin/sh

# shellcheck disable=SC2034
description="Administration and debugging tools for the XFS file system"
homepage="https://xfs.wiki.kernel.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfsprogs
version=7.3.0
release=1
source="https://www.kernel.org/pub/linux/utils/fs/xfs/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make configure

    export DEBUG="-DNDEBUG"
    export OPTIMIZER="${CFLAGS}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --localstatedir=/var \
        --libexecdir=/usr/lib \
        --disable-libicu

    make

    make DIST_ROOT="${PKG}" install
    make DIST_ROOT="${PKG}" install-dev
}
