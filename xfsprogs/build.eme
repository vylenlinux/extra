#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Administration and debugging tools for the XFS file system"
homepage="https://xfs.wiki.kernel.org/"
maintainer="Vylen Linux Team"

name=xfsprogs
version=7.1.1
release=1
source="https://www.kernel.org/pub/linux/utils/fs/xfs/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make configure

    export DEBUG="-DNDEBUG"
    export OPTIMIZER="${CFLAGS}"

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --enable-readline \
        --disable-libicu

    make
    make -j1 DIST_ROOT="${PKG}" install install-dev

    rm -rf "${PKG}/usr/var"
}
