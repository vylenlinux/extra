From: Vylen Linux Team <wonkru-dev@proton.me>
Date: Tue, 3 Nov 2026 14:40:00 +0100
Subject: [PATCH] xfwl4: use libdisplay-info 0.4 Rust bindings

Use libdisplay-info-rs PR #20 as the libdisplay-info4 dependency, disable
smithay-drm-extras default display-info feature, and update Cargo.lock.

---
diff --git a/Cargo.lock b/Cargo.lock
index 89c60a9..5c3f1ca 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1365,9 +1365,8 @@ checksum = "68ab91017fe16c622486840e4c83c9a37afeff978bd239b5293d61ece587de66"

 [[package]]
 name = "libdisplay-info"
-version = "0.3.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "59fd96dbb2381ff31f314f07accbdf8550febdcc5cd8761ecaf7c1763361c359"
+version = "0.4.0"
+source = "git+https://github.com/Smithay/libdisplay-info-rs?rev=3911e0344bb2db5839f2c646d25e8c2a8b5223d9#3911e0344bb2db5839f2c646d25e8c2a8b5223d9"
 dependencies = [
  "bitflags 2.12.1",
  "libc",
@@ -1379,8 +1378,7 @@ dependencies = [
 [[package]]
 name = "libdisplay-info-derive"
 version = "0.1.1"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "8dc2c710cf5819e91220a446d9e64acc6814386cc22c509c3f0df83c0b874a98"
+source = "git+https://github.com/Smithay/libdisplay-info-rs?rev=3911e0344bb2db5839f2c646d25e8c2a8b5223d9#3911e0344bb2db5839f2c646d25e8c2a8b5223d9"
 dependencies = [
  "proc-macro2",
  "quote",
@@ -1389,9 +1387,8 @@ dependencies = [

 [[package]]
 name = "libdisplay-info-sys"
-version = "0.3.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "26590d55b8819f9c6b0d95d9d12dc9edbfd1f2413e88814a33b631ac049bb51f"
+version = "0.4.0"
+source = "git+https://github.com/Smithay/libdisplay-info-rs?rev=3911e0344bb2db5839f2c646d25e8c2a8b5223d9#3911e0344bb2db5839f2c646d25e8c2a8b5223d9"
 dependencies = [
  "semver",
  "system-deps 7.0.8",
@@ -2591,7 +2588,6 @@ version = "0.1.0"
 source = "git+https://github.com/smithay/smithay?rev=0a29aecf9e07a2227712ab470b0ab0ee56752272#0a29aecf9e07a2227712ab470b0ab0ee56752272"
 dependencies = [
  "drm",
- "libdisplay-info",
 ]

 [[package]]
diff --git a/Cargo.toml b/Cargo.toml
index 76dfb06..b0dec05 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -41,7 +41,7 @@ gtk = { version = "0.18", features = ["v3_24"] }
 image = { version = "0.25.1", default-features = false, features = ["png"] }
 indexmap = "2"
 libc = "0.2.183"
-libdisplay-info = { version = "0.3.0", optional = true }
+libdisplay-info4 = { package = "libdisplay-info", git = "https://github.com/Smithay/libdisplay-info-rs", rev = "3911e0344bb2db5839f2c646d25e8c2a8b5223d9", optional = true }
 input = { version = "0.10.0", default-features = false, features = ["libinput_1_28"], optional = true }
 pangocairo = "0.18"
 profiling = { version = "1.0" }
@@ -71,6 +71,7 @@ features = ["desktop", "wayland_frontend"]
 git = "https://github.com/smithay/smithay"
 rev = "0a29aecf9e07a2227712ab470b0ab0ee56752272"
 optional = true
+default-features = false

 [dependencies.x11rb]
 default-features = false
@@ -91,7 +92,7 @@ egl = ["smithay/use_system_lib", "smithay/backend_egl"]
 test_all_features = ["default", "debug"]
 udev = [
   "input",
-  "libdisplay-info",
+  "libdisplay-info4",
   "smithay-drm-extras",
   "smithay/backend_libinput",
   "smithay/backend_udev",
diff --git a/src/backend/udev/device.rs b/src/backend/udev/device.rs
index e488516..26806ea 100644
--- a/src/backend/udev/device.rs
+++ b/src/backend/udev/device.rs
@@ -160,7 +160,7 @@ pub(super) enum DeviceAddError {

 struct DisplayInfo {
     edid: Bytes,
-    info: Option<libdisplay_info::info::Info>,
+    info: Option<libdisplay_info4::info::Info>,
 }

 impl Xfwl4State<UdevData> {
@@ -911,7 +911,7 @@ fn display_info_for_connector(device: &impl Device, connector: connector::Handle
     let blob = info.value_type().convert_value(value).as_blob()?;
     let data = device.get_property_blob(blob).ok()?;

-    let info = libdisplay_info::info::Info::parse_edid(&data).ok();
+    let info = libdisplay_info4::info::Info::parse_edid(&data).ok();

     Some(DisplayInfo {
         edid: Bytes::from(data),
