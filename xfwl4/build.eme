#!/bin/sh

# shellcheck disable=SC2034
description="Wayland compositor for xfce4"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://gitlab.xfce.org/xfce/xfwl4"

name=xfwl4
version=4.21.1
release=1

source="https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.xz
    0001-${name}-use-libdisplay-info-0.4.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/0001-${name}-use-libdisplay-info-0.4.patch"

    vylen-meson "${name}-${version}" build \
        -Duse-system-gettext=true \
        -Db_lto=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
