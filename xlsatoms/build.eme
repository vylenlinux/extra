description="List interned atoms defined on server"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xlsatoms
version=1.1.4
release=1
source="http://ftp.x.org/pub/individual/app/xlsatoms-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
