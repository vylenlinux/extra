description="Front-end to an XSL toolchain"
homepage="https://pagure.io/xmlto"
maintainer="Vylen Linux Team"

name=xmlto
version=0.0.29
release=1
source="https://pagure.io/xmlto/archive/$version/xmlto-$version.tar.gz"

build() {
	cd $name-$version

	export XML_CATALOG_FILES=/etc/xml/catalog


	autoreconf -fvi
	LINKS="/usr/bin/links" ./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}

