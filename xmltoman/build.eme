#!/bin/sh

# shellcheck disable=SC2034
description="Convert xml to man pages in groff format or html"
homepage="https://github.com/atsb/xmltoman/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xmltoman
version=0.6
release=1
source="${name}-${version}.tar.gz::https://github.com/atsb/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make prefix=/usr
    make prefix=/usr DESTDIR="${PKG}" install
}
