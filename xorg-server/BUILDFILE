description="The core of the X Window system"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xorg-server
version=21.1.21
release=1
source="$name-$version.tar.gz::https://gitlab.freedesktop.org/xorg/xserver/-/archive/$name-$version/xserver-$name-$version.tar.gz"

build() {

    	vylen-meson xserver-$name-$version build \
		-D xkb_dir=/usr/share/X11/xkb \
		-D xkb_output_dir=/var/lib/xkb \
		-D suid_wrapper=true \
		-D systemd_logind=false \
		-D xorg=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	install -m 755 -d $PKG/etc/X11/xorg.conf.d
	echo "needs_root_rights = yes" >> $PKG/etc/X11/Xwrapper.config
}
