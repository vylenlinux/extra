#!/bin/sh

# shellcheck disable=SC2034
description="The core of the X Window system"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xorg-server
version=21.1.26
release=1

source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/xorg/xserver/-/archive/${name}-${version}/xserver-${name}-${version}.tar.gz
    Xwrapper.config"

build() {
    vylen-meson "xserver-${name}-${version}" build \
        -Dxkb_dir=/usr/share/X11/xkb \
        -Dxkb_output_dir=/var/lib/xkb \
        -Dsuid_wrapper=true \
        -Dsystemd_logind=true \
        -Dxorg=true

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -dm755 "${PKG}/etc/X11/xorg.conf.d"
    install -Dm644 "${SRC}/Xwrapper.config" -t "${PKG}/etc/X11/"
}
