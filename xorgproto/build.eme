#!/bin/sh

# shellcheck disable=SC2034
description="Combined X.Org X11 Protocol headers"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xorgproto
version=2026.1
release=1
source="https://xorg.freedesktop.org/archive/individual/proto/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # cleanup
    rm -f "${PKG}/usr/include/X11/extensions"/apple* \
        "${PKG}/usr/share/pkgconfig"/apple*
}
