#!/bin/sh

# shellcheck disable=SC2034
description="Print an X window dump from xwd"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xpr
version=1.2.1
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
