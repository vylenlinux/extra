#!/bin/sh

# shellcheck disable=SC2034
description="Classic X utility to set your root window background to a given pattern or color"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xsetroot
version=1.1.4
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
