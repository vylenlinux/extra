#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Terminal emulator for the X Window System"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xterm
version=409
release=1
source="http://invisible-mirror.net/archives/${name}/${name}-${version}.tgz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    TERMINFO=/usr/share/terminfo ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --enable-256-color \
        --enable-wide-chars \
        --with-app-defaults=/etc/X11/app-defaults

    make
    make DESTDIR="${PKG}" install

    cat >> "${PKG}/etc/X11/app-defaults/XTerm" <<'EOF'
*VT100*locale: true
*VT100*faceName: Monospace
*VT100*faceSize: 10
*backarrowKeyIsErase: true
*ptyInitialErase: true
EOF

    install -Dm644 xterm.desktop uxterm.desktop -t "${PKG}/usr/share/applications/"
}
