description="X transport library"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xtrans
version=1.6.0
release=1
source="http://ftp.x.org/pub/individual/lib/xtrans-$version.tar.xz"

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install

}
