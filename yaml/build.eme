#!/bin/sh

# shellcheck disable=SC2034
description="C library for parsing and emitting YAML"
homepage="https://pyyaml.org/wiki/LibYAML"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=yaml
version=0.2.5
release=1
source="https://pyyaml.org/download/libyaml/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
