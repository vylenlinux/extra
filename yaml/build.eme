#!/bin/sh

# shellcheck disable=SC2034
description="C library for parsing and emitting YAML"
homepage="https://github.com/yaml/libyaml"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=yaml
version=0.2.6
release=1
source="https://github.com/${name}/lib${name}/releases/download/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
