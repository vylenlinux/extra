#!/bin/sh

# shellcheck disable=SC2034
description="EPUB, PDF and XPS support based on MuPDF to zathura"
homepage="https://git.pwmt.org/pwmt/zathura-pdf-mupdf"
maintainer="Vylen Linux Team"

name=zathura-pdf-mupdf
version=2026.05.10
release=1
source="https://pwmt.org/projects/${name}/download/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
