#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Minimalistic document viewer"
homepage="https://pwmt.org/projects/zathura/"
maintainer="Vylen Linux Team"

name=zathura
version=2026.05.20
release=1
source="https://github.com/pwmt/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dconvert-icon=disabled \
        -Dmanpages=disabled \
        -Dseccomp=disabled \
        -Dsynctex=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
