#!/bin/sh

# shellcheck disable=SC2034
description="A general-purpose programming language and toolchain for maintaining robust, optimal, and reusable software"
homepage="https://ziglang.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=zig
version=0.17.1
release=1
source="${name}-${version}.tar.xz::https://ziglang.org/download/${version}/${name}-x86_64-linux-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-x86_64-linux-${version}"
    install -Dm755 "${name}" -t "${PKG}/usr/bin/"

    install -d "${PKG}/usr/lib/${name}/"
    cp -r lib/* -t "${PKG}/usr/lib/${name}/"

    install -d "${PKG}/usr/include/"
    ln -srf "${PKG}/usr/lib/${name}/${name}.h" -t "${PKG}/usr/include/"
}
