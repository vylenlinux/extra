description="Barcode encoding library supporting over 50 symbologies"
homepage="https://zint.org.uk/"
maintainer="Vylen Linux Team"

name=zint
version=2.16.0
release=1
source="https://downloads.sourceforge.net/zint/zint-$version-src.tar.gz"

build() {
	cmake -S $name-$version-src -B build zint \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D ZINT_QT6=ON \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
	rm "$PKG/usr/bin/zint-qt" \
        "$PKG/usr/include/qzint.h" \
        "$PKG/usr/lib/libQZint"*
	DESTDIR="$PKG" cmake --install build/backend_qt
    DESTDIR="$PKG" cmake --install build/frontend_qt


}
