description="Compressor/archiver for creating and modifying zipfiles"
homepage="https://infozip.sourceforge.net/Zip.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=zip
version=3.0
_version=$(printf '%s' "$version" | sed 's/\.//')
release=1
source="https://downloads.sourceforge.net/infozip/${name}${_version}.tar.gz"

build() {
	cd ${name}${_version}

  	make -f unix/Makefile prefix=/usr
	make prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 -f unix/Makefile install
}

