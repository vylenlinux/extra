#!/bin/sh

# shellcheck disable=SC2034
description="Systemd unit generator for zram devices"
homepage="https://github.com/systemd/zram-generator"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=zram-generator
version=1.2.1
release=1
source="${name}-${version}.tar.gz::https://github.com/systemd/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make CARGOFLAGS="--target-dir=target" NOMAN=true build
    make CARGOFLAGS="--target-dir=target" NOMAN=true DESTDIR="${PKG}" install
}
