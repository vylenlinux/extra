#!/bin/sh

# shellcheck disable=SC2034
description="A wrapper script for the zram linux kernel module with zsh and openrc support"
maintainer="Vylen Linux Team"
homepage="https://github.com/vaeth/zram-init"

name=zram-init
version=13.3
release=1

source="${name}-${version}.tar.gz::https://github.com/vaeth/${name}/archive/refs/tags/v${version}.tar.gz
    zram-single.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/zram-single.patch"
    make PREFIX=/usr

    make install \
        DESTDIR="${PKG}" \
        SYSTEMD=false \
        SYSCONFDIR=/etc \
        GETTEXT=false \
        PREFIX=/usr \
        ZSH_COMPLETION="$(emerald is-installed zsh && printf "true" || printf "false")"
}
