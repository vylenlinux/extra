#!/bin/sh

# shellcheck disable=SC2034
description="A Init-system-independent zram manager using Linux sysfs and syscalls"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://gitlab.com/celestifyx/zramctl-rs"

name=zramctl-rs
version=1.0.2
release=1
source="https://gitlab.com/celestifyx/${name}/-/archive/${version}/${name}-${version}.tar.gz"
backup="etc/${name}.toml"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    make DESTDIR="${PKG}" install install-systemd
}
