description="A very advanced and programmable command interpreter (shell) for UNIX"
homepage="http://www.zsh.org"
maintainer="Vylen Linux Team"

name=zsh
version=5.9
release=1
source="http://www.zsh.org/pub/$name-$version.tar.xz
	autocompletion.patch gcc14.patch pcre2.patch"

build() {
	cd $name-$version

	patch -Np1 -i $SRC/autocompletion.patch
	patch -Np1 -i $SRC/pcre2.patch
	patch -Np1 -i $SRC/gcc14.patch

	./configure \
		--prefix=/usr \
		--bindir=/bin \
		--sysconfdir=/etc/zsh \
		--enable-etcdir=/etc/zsh \
		--enable-zshrc=/etc/zsh/zshrc \
		--enable-zlogin=/etc/zsh/zshlogin \
		--enable-zshenv=/etc/zsh/zshenv
	make
	make DESTDIR=$PKG install
}
