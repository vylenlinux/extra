#!/bin/sh

# shellcheck disable=SC2034
description="A very advanced and programmable command interpreter (shell) for UNIX"
homepage="https://www.zsh.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=zsh
version=5.9.2
release=1
source="https://www.zsh.org/pub/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc/zsh \
        --enable-etcdir=/etc/zsh \
        --enable-zshrc=/etc/zsh/zshrc \
        --enable-zlogin=/etc/zsh/zshlogin \
        --enable-zshenv=/etc/zsh/zshenv

    make
    make DESTDIR="${PKG}" install
}
